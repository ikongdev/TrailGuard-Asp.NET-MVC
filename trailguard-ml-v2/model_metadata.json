      6,
      22,
      4
    ]
  },
  "out_of_fold_category_distribution": {
    "Good Match": 391,
    "Borderline": 233,
    "Not Recommended": 576
  },
  "out_of_fold_unsafe_good_match": 4,
  "out_of_fold_over_rejected": 5
