  "monotone_constraints": {
    "bmi": 0,
    "exercise_frequency": 1,
    "cardio_duration": 1,
    "exercise_consistency": 1,
    "hiking_experience": 1,
    "last_hike_recency": 1,
    "hardest_trail_completed": 1,
    "gear_score": 1,
    "has_asthma": -1,
    "has_cvd": -1,
    "has_joint_knee_injury": -1,
    "has_signs_symptoms": -1,
    "distance_km": -1,
    "elevation_gain_m": -1,
    "trail_class": -1,
    "typical_duration_hours": -1
  },
  "thresholds": {
    "borderline": 0.3,
    "good_match": 0.8
  },
  "cross_validation": {
    "method": "GroupKFold, 5 splits, grouped by participant_profile_id",
    "mean_accuracy": 0.9333,
    "std_accuracy": 0.0224,
    "fold_accuracies": [
      0.9292,
      0.9583,
      0.9292,
      0.8958,
      0.9542
