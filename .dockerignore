# MVC context: include only application sources and committed static assets.
**
!TrailGuard.csproj
!Program.cs
!Controllers/
!Controllers/**
!Data/
!Data/**
!Migrations/
!Migrations/**
!Models/
!Models/**
!Services/
!Services/**
!Views/
!Views/**
!wwwroot/
!wwwroot/**
# The only deployment artifact admitted to the MVC context is the public Supabase CA.
!deployment/
!deployment/certificates/
!deployment/certificates/supabase-prod-ca-2021.crt

# Defense in depth within the allowed directories.
**/bin
**/obj
**/node_modules
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.cache
**/*.log
**/.env
**/.env.*
**/secrets.json
**/appsettings*.json
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/*.xlsx
**/*.csv
**/App_Data
**/uploads
wwwroot/images/profiles
