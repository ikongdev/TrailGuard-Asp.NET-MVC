{
  "purpose": "Non-secret App Service configuration inventory. The selected secret-delivery mode is Key Vault references. Replace only bracketed placeholders at deployment time; do not import this file unchanged.",
  "selectedSecretDelivery": "KeyVaultReferences",
  "userAssignedIdentity": {
    "resourceId": "<USER_ASSIGNED_IDENTITY_RESOURCE_ID>",
    "clientId": "<HOSTING_MANAGED_IDENTITY_CLIENT_ID>",
    "principalId": "<HOSTING_MANAGED_IDENTITY_PRINCIPAL_ID>",
    "keyVaultReferenceIdentity": "<USER_ASSIGNED_IDENTITY_RESOURCE_ID>"
  },
  "appSettings": [
    { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
    { "name": "ASPNETCORE_HTTP_PORTS", "value": "8080" },
    { "name": "ASPNETCORE_HTTPS_PORT", "value": "443" },
    { "name": "TZ", "value": "Asia/Manila" },
    { "name": "AllowedHosts", "value": "<APP_NAME>.azurewebsites.net;<APPROVED_CUSTOM_HOSTNAME_IF_ANY>" },
    { "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE", "value": "false" },
    { "name": "WEBSITES_CONTAINER_START_TIME_LIMIT", "value": "230" },
    { "name": "DataProtection__Provider", "value": "AzureBlobKeyVault" },
    { "name": "DataProtection__ApplicationName", "value": "<STABLE_APPLICATION_NAME>" },
    { "name": "DataProtection__AzureBlobUri", "value": "https://<ACCOUNT>.blob.core.windows.net/<CONTAINER>/keyring.xml" },
    { "name": "DataProtection__KeyVaultKeyIdentifier", "value": "https://<VAULT>.vault.azure.net/keys/<KEY_NAME>" },
    { "name": "DataProtection__ManagedIdentityClientId", "value": "<HOSTING_MANAGED_IDENTITY_CLIENT_ID>" },
    { "name": "Database__Target", "value": "Supabase" },
    { "name": "ConnectionStrings__SupabaseConnection", "value": "@Microsoft.KeyVault(SecretUri=https://<VAULT>.vault.azure.net/secrets/<SUPABASE_CONNECTION_SECRET>)" },
    { "name": "Storage__Provider", "value": "Supabase" },
    { "name": "Storage__Namespace", "value": "supabase-main" },
    { "name": "Storage__Supabase__Url", "value": "https://<SUPABASE_PROJECT_REF>.supabase.co" },
    { "name": "Storage__Supabase__SecretKey", "value": "@Microsoft.KeyVault(SecretUri=https://<VAULT>.vault.azure.net/secrets/<SUPABASE_STORAGE_SECRET>)" },
    { "name": "TrailGuardV2Api__BaseUrl", "value": "http://127.0.0.1:8011" }
  ],
  "supabaseNpgsqlConnectionStringRequirements": {
    "sslMode": "VerifyFull",
    "rootCertificate": "/app/certificates/supabase-prod-ca-2021.crt",
    "note": "Keep both keywords in the secret ConnectionStrings__SupabaseConnection value; this public CA file is packaged in the MVC image."
  },
  "mustNeverBeSet": [
    "WEBSITES_PORT",
    "ASPNETCORE_FORWARDEDHEADERS_ENABLED",
    "DataProtection__KeyRingPath"
  ],
  "initiallyUnsetDuringProxyDiscovery": [
    "ForwardedHeaders__TrustedProxies__0",
    "ForwardedHeaders__TrustedNetworks__0"
  ],
  "setAfterVerifiedProxyDiscovery": [
    { "name": "ForwardedHeaders__TrustedProxies__0", "value": "<OBSERVED_EXACT_PROXY_IP>" },
    { "name": "ForwardedHeaders__TrustedNetworks__0", "value": "<OBSERVED_MINIMUM_NON_ZERO_CIDR_IF_NEEDED>" }
  ],
  "onlyDuringBoundedProxyObservation": [
    { "name": "ProxyHeaderObservation__Enabled", "value": "true" },
    { "name": "ProxyHeaderObservation__ExpiresAtUtc", "value": "<UTC_TIMESTAMP_WITHIN_ONE_HOUR_OF_STARTUP>" },
    { "name": "ProxyHeaderObservation__MaxEventCount", "value": "<INTEGER_1_TO_50>" }
  ],
  "directDeploymentSettingsAlternative": {
    "description": "Use only when Key Vault references are not selected. Supply secret values through the approved deployment interface, never this file or an image layer.",
    "sitePropertiesDoNotSet": [
      "keyVaultReferenceIdentity"
    ],
    "doesNotRequireRole": "Key Vault Secrets User"
  }
}
