@model TrailGuard.Models.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}
@section PageHero {
    <div class="min-h-screen flex items-center justify-center pt-18 pb-5 px-4 sm:px-6 lg:px-12 relative">
    
        <div class="max-w-6xl w-full flex flex-col md:flex-row items-center justify-between gap-12 lg:gap-20 z-10">
            
            <div class="w-full md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left">
                <h1 class="text-4xl md:text-5xl lg:text-4xl font-extrabold text-white leading-tight mb-4 tracking-tight">
                    Your <span class="text-accent">Next Hike</span> Awaits
                </h1>
                <p class="text-gray-400 text-base md:text-lg max-w-md">
                    Sign in to explore trails, check your hiking readiness, and manage your event registrations.
                </p>
                
                <div class="relative w-full max-w-sm hidden md:block">
                    <img src="/images/guide.png" alt="Hiker Character" class="w-full">
                </div>
            </div>

            <div class="w-full md:w-[45%] max-w-md bg-surface-card/80 backdrop-blur-xl rounded-xl border border-white/10 p-5 sm:p-10 relative">
                <div class="mb-8 text-center md:text-left">
                    <h2 class="text-3xl font-extrabold text-white mb-2">Welcome Back!</h2>
                    <p class="text-gray-400 text-sm">Sign in to continue your adventure.</p>
                </div>

                <form asp-action="Login" method="POST" class="space-y-6">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="All" class="text-red-400 text-xs mb-5"></div>
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email Address</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fa-regular fa-envelope text-gray-500"></i>
                            </div>
                            <input asp-for="Email" type="email" id="email" autocomplete="username" class="block w-full pl-11 pr-4 py-3 bg-surface-card border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" placeholder="you@example.com" required>
                        </div>
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-medium text-gray-300 mb-2">Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fa-solid fa-lock text-gray-500"></i>
                            </div>
                            <input asp-for="Password" type="password" id="password" autocomplete="current-password" class="block w-full pl-11 pr-12 py-3 bg-surface-card border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" placeholder="Enter your password" required>
                            <button type="button" id="togglePasswordBtn" aria-controls="password" aria-label="Show password" aria-pressed="false" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-500 hover:text-gray-300 focus:outline-none">
                                <i id="eyeIcon" class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        
                        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 mt-3">
                            <div class="flex items-center gap-2">
                                <input asp-for="RememberMe" class="h-4 w-4 shrink-0 cursor-pointer rounded border border-gray-600 bg-surface-card accent-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-card">
                                <label for="RememberMe" class="block text-sm text-gray-400 cursor-pointer">
                                    Remember me
                                </label>
                            </div>
                            <a href="#" class="text-sm font-medium text-accent hover:brightness-125 transition-all">Forgot Password?</a>
                        </div>
                    </div>

                    <button type="submit" class="w-full flex justify-center py-3.5 px-4 mt-2 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base transition duration-200 ease-out">
                        Sign In
                    </button>
                </form>

                <div class="mt-8 text-center text-sm text-gray-400">
                    Don't have an account? 
                    <a asp-controller="Account" asp-action="Register" class="font-semibold text-accent hover:brightness-125 transition-all">Create one now</a>
                </div>
            </div>

        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const togglePasswordBtn = document.getElementById("togglePasswordBtn");
            const passwordInput = document.getElementById("password");
            const eyeIcon = document.getElementById("eyeIcon");

            if (togglePasswordBtn && passwordInput && eyeIcon) {
                togglePasswordBtn.addEventListener("click", function () {
                    const isPassword = passwordInput.getAttribute("type") === "password";
                    
                    passwordInput.setAttribute("type", isPassword ? "text" : "password");
                
                    if (isPassword) {
                        eyeIcon.classList.remove("fa-eye");
                        eyeIcon.classList.add("fa-eye-slash");
                        togglePasswordBtn.setAttribute("aria-label", "Hide password");
                        togglePasswordBtn.setAttribute("aria-pressed", "true");
                    } else {
                        eyeIcon.classList.remove("fa-eye-slash");
                        eyeIcon.classList.add("fa-eye");
                        togglePasswordBtn.setAttribute("aria-label", "Show password");
                        togglePasswordBtn.setAttribute("aria-pressed", "false");
                    }
                });
            }
        });
    </script>
}
