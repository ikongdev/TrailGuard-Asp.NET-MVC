@{
    ViewData["Title"] = "Access Denied";
}

@* Layout already renders the page's single <main> around RenderBody(), so
   this is a plain wrapper - a second <main> here would nest landmarks. *@
<div class="min-h-screen flex items-center justify-center px-4 pt-24 pb-12">
    <div class="w-full max-w-md bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-8 sm:p-10 text-center"
         role="region" aria-labelledby="access-denied-heading">

        <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center mx-auto mb-5">
            <i class="fa-solid fa-lock text-lg text-red-400" aria-hidden="true"></i>
        </div>

        <p class="text-red-400 text-xs font-semibold tracking-widest uppercase mb-2">403</p>
        <h1 id="access-denied-heading" class="text-2xl font-bold text-white mb-3">Access Denied</h1>
        <p class="text-gray-300 mb-2">You don't have permission to access this page.</p>
        <p class="text-gray-400 text-sm mb-7">If you believe this is a mistake, contact an administrator.</p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a asp-controller="@ViewBag.DashboardController" asp-action="Index"
               class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-white font-medium bg-accent hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base transition-colors">
                <i class="fa-solid fa-gauge" aria-hidden="true"></i>
                Go to Dashboard
            </a>
        </div>
    </div>
</div>
