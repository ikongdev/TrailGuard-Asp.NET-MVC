@model TrailGuard.Models.RegisterViewModel
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions> IdentityOptionsAccessor
@{
    ViewData["Title"] = "Register";

    var passwordOptions = IdentityOptionsAccessor.Value.Password;
    var minimumPasswordLength = Math.Max(RegisterViewModel.MinimumPasswordLength, passwordOptions.RequiredLength);
    var passwordCharacterRequirements = new List<string>();
    if (passwordOptions.RequireUppercase) passwordCharacterRequirements.Add("an uppercase letter");
    if (passwordOptions.RequireLowercase) passwordCharacterRequirements.Add("a lowercase letter");
    if (passwordOptions.RequireDigit) passwordCharacterRequirements.Add("a number");
    if (passwordOptions.RequireNonAlphanumeric) passwordCharacterRequirements.Add("a symbol");
    if (passwordOptions.RequiredUniqueChars > 1)
    {
        passwordCharacterRequirements.Add($"at least {passwordOptions.RequiredUniqueChars} unique characters");
    }

    string JoinRequirements(List<string> requirements) => requirements.Count switch
    {
        0 => string.Empty,
        1 => requirements[0],
        2 => $"{requirements[0]} and {requirements[1]}",
        _ => $"{string.Join(", ", requirements.Take(requirements.Count - 1))}, and {requirements[^1]}"
    };

    var passwordRequirementsText = passwordCharacterRequirements.Count == 0
        ? $"Use at least {minimumPasswordLength} characters."
        : $"Use at least {minimumPasswordLength} characters, including {JoinRequirements(passwordCharacterRequirements)}.";
}

@section PageHero {
    <div class="min-h-screen flex items-center justify-center pt-24 pb-12 px-4 sm:px-6 lg:px-12 relative">
        <div class="max-w-6xl w-full flex flex-col md:flex-row-reverse items-center justify-between gap-12 lg:gap-20 z-10">
            
            <div class="w-full md:w-1/2 flex flex-col items-center md:items-end text-center md:text-right">
                <h1 class="text-4xl md:text-5xl lg:text-4xl font-extrabold text-white leading-tight tracking-tight mb-4">
                    Start Your <span class="text-accent">Adventure</span>
                </h1>
                <p class="text-gray-400 text-base md:text-lg max-w-md">
                    Create your TrailGuard account and join the community of adventurers across the Philippines.
                </p>
                
                <div class="relative w-full max-w-sm hidden md:block">
                    <img src="/images/guide.png" alt="Hiker Character" class="w-full">
                </div>
            </div>

            <div class="w-full md:w-full max-w-3xl bg-surface-card/80 backdrop-blur-xl rounded-xl border border-white/10 p-6 sm:p-12 relative">
                <div class="mb-6 text-center md:text-left">
                    <h2 class="text-2xl font-extrabold text-white mb-1">Create Account</h2>
                    <p class="text-gray-400 text-sm">Join the TrailGuard community.</p>
                </div>

                <form asp-action="Register" method="POST" class="space-y-4">
                    <div asp-validation-summary="All" class="text-red-400 text-xs"></div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="FirstName" class="block text-sm font-medium text-gray-300 mb-2">First Name</label>
                            <input asp-for="FirstName" autocomplete="given-name" placeholder="Enter first name" class="block w-full px-4 py-3 bg-surface-card border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" required>
                        </div>
                        <div>
                            <label asp-for="MiddleName" class="block text-sm font-medium text-gray-300 mb-2">Middle Name <span class="text-gray-500 text-xs">(Optional)</span></label>
                            <input asp-for="MiddleName" autocomplete="additional-name" placeholder="Enter middle name" class="block w-full px-4 py-3 bg-surface-card border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors">
                        </div>
                        <div>
                            <label asp-for="LastName" class="block text-sm font-medium text-gray-300 mb-2">Last Name</label>
                            <input asp-for="LastName" autocomplete="family-name" placeholder="Enter last name" class="block w-full px-4 py-3 bg-surface-card border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" required>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-300 mb-2">Email Address</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fa-regular fa-envelope text-gray-500"></i>
                            </div>
                            <input asp-for="Email" autocomplete="email" class="block w-full pl-11 pr-4 py-3 bg-surface-card border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" placeholder="you@example.com" required>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Password" class="block text-sm font-medium text-gray-300 mb-2">Password</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-lock text-gray-500"></i>
                                </div>
                                <input asp-for="Password" type="password" id="password" autocomplete="new-password" aria-describedby="passwordRequirements" class="block w-full pl-11 pr-12 py-3 bg-surface-card border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" placeholder="Create a password" required>
                                <button type="button" onclick="togglePasswordVisibility('password', 'eyeIcon1')" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-500 hover:text-gray-300 focus:outline-none">
                                    <i id="eyeIcon1" class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-300 mb-2">Confirm Password</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-lock text-gray-500"></i>
                                </div>
                                <input asp-for="ConfirmPassword" type="password" id="confirmPassword" autocomplete="new-password" class="block w-full pl-11 pr-12 py-3 bg-surface-card border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" placeholder="Confirm your password" required>
                                <button type="button" onclick="togglePasswordVisibility('confirmPassword', 'eyeIcon2')" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-500 hover:text-gray-300 focus:outline-none">
                                    <i id="eyeIcon2" class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <p id="passwordRequirements" class="md:col-span-2 text-xs leading-relaxed text-gray-400">@passwordRequirementsText</p>
                    </div>

                    <button type="submit" class="w-full flex justify-center py-3.5 px-4 mt-2 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base transition duration-200 ease-out">
                        Register Now
                    </button>
                </form>

                <div class="mt-6 text-center text-sm text-gray-400">
                    Already have an account? 
                    <a asp-controller="Account" asp-action="Login" class="font-semibold text-accent hover:brightness-125 transition-all">Sign in here</a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const eyeIcon = document.getElementById(iconId);

            if (passwordInput && eyeIcon) {
                const isPassword = passwordInput.getAttribute("type") === "password";
                
                passwordInput.setAttribute("type", isPassword ? "text" : "password");

                if (isPassword) {
                    eyeIcon.classList.remove("fa-eye");
                    eyeIcon.classList.add("fa-eye-slash");
                } else {
                    eyeIcon.classList.remove("fa-eye-slash");
                    eyeIcon.classList.add("fa-eye");
                }
            }
        }
    </script>
}
