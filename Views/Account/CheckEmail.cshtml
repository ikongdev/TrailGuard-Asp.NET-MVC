@{
    ViewData["Title"] = "Check your email";
    var notice = TempData["VerificationNotice"] as string;
}

<main class="min-h-screen pt-24 px-4 pb-12 flex justify-center">
    <section class="w-full max-w-lg bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 text-center">
        <span class="mx-auto w-12 h-12 rounded-full bg-accent/15 text-accent flex items-center justify-center text-xl" aria-hidden="true"><i class="fa-solid fa-envelope-circle-check"></i></span>
        <h1 class="mt-4 text-2xl font-bold text-white">Check your email</h1>
        <p class="mt-2 text-sm text-gray-300">Verify your email before signing in. Verification links expire after 24 hours.</p>
        @if (!string.IsNullOrWhiteSpace(notice))
        {
            <p class="mt-4 rounded-xl border border-white/10 bg-surface-card px-4 py-3 text-sm text-gray-200" role="status">@notice</p>
        }
        <form asp-action="ResendVerification" method="post" class="mt-6 text-left space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label for="resendEmail" class="block text-sm font-medium text-gray-300 mb-2">Email address</label>
                <input id="resendEmail" name="email" type="email" autocomplete="email" required maxlength="256" data-tg-email-address data-tg-email-error="resendEmailError" placeholder="you@example.com" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent" />
                <p id="resendEmailError" class="hidden mt-2 text-sm text-red-400" role="alert"></p>
            </div>
            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-white bg-accent hover:brightness-110 transition focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card" data-tg-pending-label="Sending…">
                Resend verification email
            </button>
        </form>
        <p class="mt-5 text-sm text-gray-400">Already verified? <a asp-action="Login" class="font-semibold text-accent hover:brightness-125 focus:outline-none focus:ring-2 focus:ring-accent rounded">Sign in</a></p>
    </section>
</main>
