@model TrailGuard.Controllers.ReportsViewModel
@using TrailGuard.Controllers
@{
    ViewData["Title"] = "Reports";
    var categories = new[] { "Good Match", "Borderline", "Not Recommended" };
}

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-linear-to-r from-blue-500 to-cyan-500 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-chart-line text-white text-2xl"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white">Model Validation Report</h1>
                <p class="text-gray-400 text-sm">Prediction-vs-outcome reporting across every event</p>
            </div>
        </div>
        <div class="text-right">
            <a asp-controller="Reports" asp-action="Export" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-linear-to-r from-orange-500 to-purple-600 hover:opacity-90 transition-all">
                <i class="fa-solid fa-download"></i> Export Retraining Data (CSV)
            </a>
            <p class="text-xs text-gray-400 mt-2">
                @Model.ExportIncludedCount included · @Model.ExportNonReadinessExcludedCount excluded as non-readiness · @Model.ExportIncompleteCaseKeys.Count excluded as incomplete data
            </p>
            @if (Model.ExportIncompleteCaseKeys.Any())
            {
                <p class="text-xs text-amber-300 mt-1">Investigate: @string.Join(", ", Model.ExportIncompleteCaseKeys)</p>
            }
        </div>
    </div>

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 mb-8">
        <h2 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-filter text-blue-400 mr-2"></i>Where the Data Comes From</h2>
        <p class="text-gray-400 text-sm mb-5">A recorded outcome exists only for an assessed, registered, accepted participant after a completed event. Every drop-off below has no recorded outcome, so the collected data is skewed toward participants the system approved.</p>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-black/20 border border-white/10 rounded-xl p-4 text-center"><p class="text-3xl font-bold text-white">@Model.TotalAssessments</p><p class="text-gray-400 text-xs mt-1">Assessments Taken</p></div>
            <div class="bg-black/20 border border-white/10 rounded-xl p-4 text-center"><p class="text-3xl font-bold text-white">@Model.TotalRegistrations</p><p class="text-gray-400 text-xs mt-1">Became Registrations</p></div>
            <div class="bg-black/20 border border-white/10 rounded-xl p-4 text-center"><p class="text-3xl font-bold text-white">@Model.TotalAccepted</p><p class="text-gray-400 text-xs mt-1">Accepted</p></div>
            <div class="bg-blue-500/10 border border-blue-500/30 rounded-xl p-4 text-center"><p class="text-3xl font-bold text-blue-400">@Model.TotalRecordedOutcomes</p><p class="text-gray-400 text-xs mt-1">Recorded Outcomes</p></div>
        </div>
    </div>

    @if (!Model.HasEnoughData)
    {
        <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-2xl p-5 mb-8 flex items-start gap-3">
            <i class="fa-solid fa-triangle-exclamation text-yellow-400 text-lg mt-0.5"></i>
            <div>
                <p class="text-yellow-300 font-semibold">Not enough recorded outcomes for reliable figures</p>
                <p class="text-yellow-300/70 text-sm mt-1">Only @Model.TotalRecordedOutcomes recorded outcome@(Model.TotalRecordedOutcomes == 1 ? "" : "s") so far — below the @ReportsController.MinSampleSize sample size needed for future percentage and agreement statistics.</p>
            </div>
        </div>
    }

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 mb-8">
        <h2 class="text-lg font-bold text-white mb-4">Live calibration</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead><tr class="text-gray-400"><th class="p-2 text-left">Predicted band</th><th>Cases</th><th>Observed completion</th></tr></thead>
                <tbody>
                    @foreach (var b in Model.CalibrationBands)
                    {
                        <tr class="border-t border-white/10"><td class="p-2">@b.Label</td><td class="text-center">@b.Total</td><td class="text-center">@(b.HasEnoughData ? $"{b.CompletionRate:F1}%" : "—")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-6 mb-8">
        <div class="bg-red-500/5 border border-red-500/30 rounded-3xl p-6">
            <h2 class="font-bold text-red-300">Safety-critical errors</h2>
            <p class="text-sm text-gray-400">Good Match predictions that did not complete.</p>
            <p class="text-3xl font-bold mt-3">@Model.GoodMatchSafety.NotCompleted <span class="text-sm text-gray-400">of @Model.GoodMatchSafety.Total</span></p>
            <p class="text-xs text-gray-400">@(Model.GoodMatchSafety.HasEnoughData ? $"{100 - Model.GoodMatchSafety.CompletionRate:F1}% did not complete" : "Rate unavailable below 20 cases")</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-3xl p-6">
            <h2 class="font-bold">Non-completion reasons</h2>
            @foreach (var r in Model.NonCompletionReasons)
            {
                <p class="text-sm text-gray-300 mt-2">@r.Reason: @r.Count</p>
            }
            @if (!Model.NonCompletionReasons.Any())
            {
                <p class="text-sm text-gray-500 mt-2">No non-completions recorded.</p>
            }
        </div>
    </div>

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 mb-8">
        <h2 class="font-bold mb-3">Predicted category against actual completion</h2>
        <table class="w-full text-center text-sm">
            <thead><tr class="text-gray-400"><th></th><th>Completed</th><th>Did not complete</th></tr></thead>
            <tbody>
                @for (var i = 0; i < 3; i++)
                {
                    <tr class="border-t border-white/10"><td class="p-2 text-left">@categories[i]</td><td>@Model.ConfusionMatrix[i, 0]</td><td>@Model.ConfusionMatrix[i, 1]</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 mb-8">
        <h2 class="font-bold mb-3">Threshold validation</h2>
        <p class="text-sm text-gray-400 mb-3">Live outcomes at the 0.30 and 0.80 operating points.</p>
        @foreach (var b in Model.ThresholdBands)
        {
            <p class="text-sm text-gray-300">@b.Label: @b.Completed completed of @b.Total @(b.HasEnoughData ? $"({b.CompletionRate:F1}%)" : "(rate unavailable below 20 cases)")</p>
        }
    </div>

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 mb-8">
        <h2 class="text-lg font-bold text-white mb-1">By Trail Class</h2>
        <p class="text-gray-400 text-sm mb-4">Recorded completion outcomes by a model feature.</p>
        @if (Model.ByTrailClass.Any())
        {
            <div class="space-y-2">
                @foreach (var group in Model.ByTrailClass)
                {
                    <div class="bg-black/20 border border-white/10 rounded-xl p-3">
                        <div class="flex items-center justify-between"><span class="text-white text-sm font-medium">@group.GroupName</span><span class="text-gray-500 text-xs">n = @group.Stats.Total</span></div>
                        <p class="text-xs text-gray-400 mt-1">Completed: @group.CompletedCount · Did not complete: @group.NotCompletedCount</p>
                        <p class="text-xs text-gray-500 mt-1">@(group.Stats.HasEnoughData ? $"Completion rate: {(double)group.CompletedCount / group.Stats.Total * 100:F1}%" : "Rate unavailable below 20 cases.")</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-gray-500 text-sm">No recorded outcomes yet.</p>
        }
    </div>

    <div class="bg-red-500/5 backdrop-blur-xl border border-red-500/20 rounded-3xl p-6">
        <h2 class="text-lg font-bold text-white mb-1">Not-Recommended Acknowledgement Pathway</h2>
        <p class="text-gray-400 text-sm mb-4">The system never blocks registration on a Not Recommended result; it requires acknowledgement and organizer review. @Model.NotRecommendedResolvedCount recorded outcome@(Model.NotRecommendedResolvedCount == 1 ? "" : "s") came through this pathway.</p>
        @if (Model.NotRecommendedResolvedCount > 0)
        {
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-green-400">@Model.NotRecommendedCompletedCount</p><p class="text-gray-400 text-xs mt-1">Completed</p></div>
                <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-yellow-400">@Model.NotRecommendedNotCompletedCount</p><p class="text-gray-400 text-xs mt-1">Did not complete</p></div>
            </div>
        }
        else
        {
            <p class="text-gray-500 text-sm">No participant who received a Not Recommended result has a recorded outcome yet.</p>
        }
    </div>
</div>
