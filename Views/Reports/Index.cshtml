@model TrailGuard.Controllers.ReportsViewModel
@using TrailGuard.Controllers
@{
    ViewData["Title"] = "Reports";
    var categories = new[] { "Good-Match", "Borderline", "Not Recommended" };
}

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-linear-to-r from-blue-500 to-cyan-500 flex items-center justify-center shrink-0"><i class="fa-solid fa-chart-line text-white text-2xl"></i></div>
            <div><h1 class="text-2xl font-bold text-white">Model Validation Report</h1><p class="text-gray-400 text-sm">Prediction-vs-outcome reporting across every event</p></div>
        </div>
        <a asp-controller="Reports" asp-action="Export" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-linear-to-r from-orange-500 to-purple-600 hover:opacity-90 transition-all"><i class="fa-solid fa-download"></i> Export Retraining Data (CSV)</a>
    </div>

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 mb-8">
        <h2 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-filter text-blue-400 mr-2"></i>Where the Data Comes From</h2>
        <p class="text-gray-400 text-sm mb-5">A recorded outcome exists only for an assessed, registered, accepted participant after a completed event. Every drop-off below has no recorded outcome, so the collected data is skewed toward participants the system approved.</p>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-black/20 border border-white/10 rounded-xl p-4 text-center"><p class="text-3xl font-bold text-white">@Model.TotalAssessments</p><p class="text-gray-400 text-xs mt-1">Assessments Taken</p></div>
            <div class="bg-black/20 border border-white/10 rounded-xl p-4 text-center"><p class="text-3xl font-bold text-white">@Model.TotalRegistrations</p><p class="text-gray-400 text-xs mt-1">Became Registrations</p></div>
            <div class="bg-black/20 border border-white/10 rounded-xl p-4 text-center"><p class="text-3xl font-bold text-white">@Model.TotalAccepted</p><p class="text-gray-400 text-xs mt-1">Accepted</p></div>
            <div class="bg-blue-500/10 border border-blue-500/30 rounded-xl p-4 text-center"><p class="text-3xl font-bold text-blue-400">@Model.TotalRecordedOutcomes</p><p class="text-gray-400 text-xs mt-1">Recorded Outcomes</p></div>
        </div>
    </div>

    <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-5 mb-8 flex items-start gap-3">
        <i class="fa-solid fa-circle-info text-amber-300 text-lg mt-0.5"></i>
        <div><p class="text-amber-200 font-semibold">Three-category agreement statistics are unavailable</p><p class="text-amber-200/75 text-sm mt-1">Stage 3 stores real completion outcomes separately from difficulty experience. Stage 5 will rebuild these metrics against the new data without fabricating three-category labels.</p></div>
    </div>

    @if (!Model.HasEnoughData)
    {
        <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-2xl p-5 mb-8 flex items-start gap-3"><i class="fa-solid fa-triangle-exclamation text-yellow-400 text-lg mt-0.5"></i><div><p class="text-yellow-300 font-semibold">Not enough recorded outcomes for reliable figures</p><p class="text-yellow-300/70 text-sm mt-1">Only @Model.TotalRecordedOutcomes recorded outcome@(Model.TotalRecordedOutcomes == 1 ? "" : "s") so far — below the @ReportsController.MinSampleSize sample size needed for future percentage and agreement statistics.</p></div></div>
    }

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 mb-8">
        <h2 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-bullseye text-blue-400 mr-2"></i>Overall Accuracy</h2>
        <p class="text-gray-400 text-sm mb-5">Pre-hike label (after the ACSM gate) against recorded outcome.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-center"><p class="text-sm font-bold text-green-400">Unavailable</p><p class="text-gray-400 text-xs mt-1">Accurate</p></div>
            <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-4 text-center"><p class="text-sm font-bold text-yellow-400">Unavailable</p><p class="text-gray-400 text-xs mt-1">Over-cautious</p></div>
            <div class="bg-red-500/10 border-2 border-red-500/40 rounded-xl p-4 text-center"><p class="text-sm font-bold text-red-400">Unavailable</p><p class="text-red-300 text-xs mt-1 font-semibold">Missed risk</p></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6"><div class="bg-blue-500/10 border border-blue-500/30 rounded-xl p-4"><p class="text-lg font-bold text-blue-400">Unavailable pending Stage 5</p><p class="text-gray-300 text-sm mt-1 font-medium">Quadratic Weighted Kappa</p></div><div class="bg-white/5 border border-white/10 rounded-xl p-4"><p class="text-lg font-bold text-gray-300">Unavailable pending Stage 5</p><p class="text-gray-300 text-sm mt-1 font-medium">Unweighted Cohen's Kappa</p></div></div>
        <div class="overflow-x-auto"><table class="w-full text-center border-collapse"><thead><tr><th class="p-3 text-xs text-gray-500 uppercase"></th><th colspan="3" class="p-2 text-xs text-gray-400 uppercase tracking-wider border-b border-white/10">Final Label (Actual)</th></tr><tr><th class="p-3 text-xs text-gray-500 uppercase text-right">Predicted</th>@foreach (var category in categories) { <th class="p-3 text-xs font-medium text-gray-400 uppercase">@category</th> }</tr></thead><tbody>@for (var i = 0; i < categories.Length; i++) { <tr class="border-t border-white/5"><td class="p-3 text-xs font-medium text-gray-400 text-right">@categories[i]</td>@for (var j = 0; j < categories.Length; j++) { <td class="p-3 text-gray-500">—</td> }</tr> }</tbody></table></div>
        <p class="text-gray-500 text-xs mt-3">The matrix structure remains for Stage 5. Its cells are unavailable because a binary outcome must not be invented into a three-category label.</p>
    </div>

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 mb-8">
        <h2 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-microchip text-blue-400 mr-2"></i>Model-Only Validation</h2>
        <p class="text-gray-400 text-sm mb-5">The model prediction before the ACSM gate against the recorded outcome.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6"><div class="bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-center"><p class="text-sm font-bold text-green-400">Unavailable</p><p class="text-gray-400 text-xs mt-1">Accurate</p></div><div class="bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-4 text-center"><p class="text-sm font-bold text-yellow-400">Unavailable</p><p class="text-gray-400 text-xs mt-1">Over-cautious</p></div><div class="bg-red-500/10 border-2 border-red-500/40 rounded-xl p-4 text-center"><p class="text-sm font-bold text-red-400">Unavailable</p><p class="text-red-300 text-xs mt-1 font-semibold">Missed risk</p></div></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><div class="bg-blue-500/10 border border-blue-500/30 rounded-xl p-4"><p class="text-lg font-bold text-blue-400">Unavailable pending Stage 5</p><p class="text-gray-300 text-sm mt-1 font-medium">Quadratic Weighted Kappa</p></div><div class="bg-white/5 border border-white/10 rounded-xl p-4"><p class="text-lg font-bold text-gray-300">Unavailable pending Stage 5</p><p class="text-gray-300 text-sm mt-1 font-medium">Unweighted Cohen's Kappa</p></div></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6"><h2 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-mountain-sun text-blue-400 mr-2"></i>By PinoyMountaineer Difficulty Tier</h2><p class="text-gray-400 text-sm mb-4">Recorded completion by event difficulty tier. Agreement values are pending Stage 5.</p>@if (Model.ByNpsBand.Any()) { <div class="space-y-2">@foreach (var group in Model.ByNpsBand) { <div class="bg-black/20 border border-white/10 rounded-xl p-3"><div class="flex items-center justify-between mb-1"><span class="text-white text-sm font-medium">@group.GroupName</span><span class="text-gray-500 text-xs">n = @group.Stats.Total</span></div><p class="text-xs text-gray-400">Completed: @group.CompletedCount · Did not complete: @group.NotCompletedCount</p><p class="text-xs text-gray-500 mt-1">Agreement values unavailable pending Stage 5.</p></div> }</div> } else { <p class="text-gray-500 text-sm">No recorded outcomes yet.</p> }</div>
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6"><h2 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-road text-blue-400 mr-2"></i>By Trail Class</h2><p class="text-gray-400 text-sm mb-4">Recorded completion by technical trail class. Agreement values are pending Stage 5.</p>@if (Model.ByTrailClass.Any()) { <div class="space-y-2">@foreach (var group in Model.ByTrailClass) { <div class="bg-black/20 border border-white/10 rounded-xl p-3"><div class="flex items-center justify-between mb-1"><span class="text-white text-sm font-medium">@group.GroupName</span><span class="text-gray-500 text-xs">n = @group.Stats.Total</span></div><p class="text-xs text-gray-400">Completed: @group.CompletedCount · Did not complete: @group.NotCompletedCount</p><p class="text-xs text-gray-500 mt-1">Agreement values unavailable pending Stage 5.</p></div> }</div> } else { <p class="text-gray-500 text-sm">No recorded outcomes yet.</p> }</div>
    </div>

    <div class="bg-red-500/5 backdrop-blur-xl border border-red-500/20 rounded-3xl p-6"><h2 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-triangle-exclamation text-red-400 mr-2"></i>Not-Recommended Acknowledgement Pathway</h2><p class="text-gray-400 text-sm mb-4">The system never blocks registration on a Not Recommended result; it requires acknowledgement and organizer review. @Model.NotRecommendedResolvedCount recorded outcome@(Model.NotRecommendedResolvedCount == 1 ? "" : "s") came through this pathway.</p>@if (Model.NotRecommendedResolvedCount > 0) { <div class="grid grid-cols-2 md:grid-cols-3 gap-4"><div class="bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-green-400">@Model.NotRecommendedCompletedCount</p><p class="text-gray-400 text-xs mt-1">Completed</p></div><div class="bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-yellow-400">@Model.NotRecommendedNotCompletedCount</p><p class="text-gray-400 text-xs mt-1">Did not complete</p></div><div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center"><p class="text-sm font-bold text-gray-400">Unavailable</p><p class="text-gray-400 text-xs mt-1">Label agreement pending Stage 5</p></div></div> } else { <p class="text-gray-500 text-sm">No participant who received a Not Recommended result has a recorded outcome yet.</p> }</div>
</div>
