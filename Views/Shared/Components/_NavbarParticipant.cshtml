@using Microsoft.AspNetCore.Identity
@using TrailGuard.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentUser = await UserManager.GetUserAsync(User);
    var profilePictureUrl = currentUser?.ProfilePictureUrl;
    var firstName = currentUser?.FirstName ?? "User";
    var initials = "";
    if (!string.IsNullOrEmpty(firstName) && !string.IsNullOrEmpty(currentUser?.LastName))
    {
        initials = (firstName[0].ToString() + currentUser.LastName[0].ToString()).ToUpper();
    }
    else if (!string.IsNullOrEmpty(firstName))
    {
        initials = firstName.Substring(0, 1).ToUpper();
    }
    else
    {
        initials = "U";
    }
}

<nav class="fixed top-0 left-0 w-full z-50 px-4 py-4">
    <div class="max-w-6xl mx-auto">
        <div class="relative flex items-center justify-between w-full lg:w-fit lg:max-w-full mx-auto gap-x-6 lg:gap-x-10 rounded-full border border-white/15 bg-[#060B1A]/55 backdrop-blur-md shadow-lg shadow-black/20 px-5 py-1 min-h-11.5">

            <a asp-controller="Participant" asp-action="Index"
                class="flex items-center gap-2 text-white font-bold whitespace-nowrap">
                    <img src="~/images/logo.png"
                        asp-append-version="true"
                        alt="TrailGuard Logo"
                        class="h-8 w-auto" />
                <span class="text-sm leading-none">TrailGuard</span>
            </a>

            <div class="hidden lg:flex items-center gap-2 whitespace-nowrap">
                <a asp-controller="Participant" asp-action="Index"
                   class="nav-link px-4 py-2 rounded-2xl text-sm font-medium transition-all duration-200
                          @(currentController == "Participant" && currentAction == "Index" ? "bg-white/10 text-white" : "text-white/80 hover:text-white hover:bg-white/10")">
                    Dashboard
                </a>
                <a asp-controller="Participant" asp-action="Trails"
                   class="nav-link px-4 py-2 rounded-2xl text-sm font-medium transition-all duration-200
                          @(currentController == "Participant" && currentAction == "Trails" ? "bg-white/10 text-white" : "text-white/80 hover:text-white hover:bg-white/10")">
                    Trails
                </a>
                <a asp-controller="Participant" asp-action="Events"
                   class="nav-link px-4 py-2 rounded-2xl text-sm font-medium transition-all duration-200
                          @(currentController == "Participant" && currentAction == "Events" ? "bg-white/10 text-white" : "text-white/80 hover:text-white hover:bg-white/10")">
                    Events
                </a>
                <a asp-controller="Registration" asp-action="MyRegistrations"
                   class="nav-link px-4 py-2 rounded-2xl text-sm font-medium transition-all duration-200
                          @(currentAction == "MyRegistrations" ? "bg-white/10 text-white" : "text-white/80 hover:text-white hover:bg-white/10")">
                    My Registrations
                </a>
            </div>

            <div class="hidden lg:flex items-center justify-end gap-3 whitespace-nowrap">
                @if (SignInManager.IsSignedIn(User))
                {
                    var mainRole = "Participant"; 

                    <div class="relative">
                        <button id="profileDropdownBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="profileDropdownMenu" class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 hover:bg-white/15 focus:outline-none transition-all">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold shadow-lg shadow-purple-500/30 overflow-hidden
                                    @(!string.IsNullOrEmpty(profilePictureUrl) ? "" : "bg-linear-to-r from-purple-600 to-pink-500")">
                                @if (!string.IsNullOrEmpty(profilePictureUrl))
                                {
                                    <img src="@profilePictureUrl" alt="Profile" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    @initials
                                }
                            </div>
                            <div class="text-left hidden sm:block">
                                <div class="text-xs text-center font-bold text-white leading-tight">@firstName</div>
                                <div class="text-[9px] text-center pt-1 font-medium text-purple-400 uppercase tracking-wide leading-tight">@mainRole</div>
                            </div>
                            <i id="profileDropdownChevron" class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform duration-200"></i>
                        </button>
                        <div id="profileDropdownMenu" class="absolute right-0 mt-3 w-48 bg-surface-card border border-gray-800 rounded-2xl shadow-2xl p-1.5 z-50 origin-top-right transition-all duration-200 ease-out opacity-0 scale-95 -translate-y-1 pointer-events-none">
                            <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800/60 rounded-xl transition-colors">
                                <i class="fa-solid fa-user text-gray-400 text-base w-4 text-center"></i> Profile
                            </a>
                            <a asp-controller="Settings" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800/60 rounded-xl transition-colors">
                                <i class="fa-solid fa-gear text-gray-400 text-base w-4 text-center"></i> Settings
                            </a>
                            <div class="h-px bg-gray-800 my-1 mx-2"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="block w-full m-0 p-0">
                                <button type="submit" class="flex items-center gap-3 w-full text-left px-3 py-2.5 text-sm font-medium text-red-500 hover:text-red-400 hover:bg-red-500/10 rounded-xl transition-colors">
                                    <i class="fa-solid fa-arrow-right-from-bracket text-base w-4 text-center"></i> Sign out
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <button id="mobileMenuBtn" type="button" aria-expanded="false" aria-controls="mobileMenuPanel" aria-label="Toggle menu"
                    class="lg:hidden relative w-8 h-8 rounded-full text-white/80 hover:text-white hover:bg-white/10 transition flex items-center justify-center cursor-pointer">
                <i id="mobileMenuIconBars" class="fa-solid fa-bars text-sm absolute transition-all duration-200"></i>
                <i id="mobileMenuIconClose" class="fa-solid fa-xmark text-sm absolute transition-all duration-200" style="opacity: 0; transform: rotate(-90deg) scale(0.75);"></i>
            </button>
        </div>

        <div id="mobileMenuPanel" class="lg:hidden grid overflow-hidden transition-[grid-template-rows] duration-200 ease-out" style="grid-template-rows: 0fr;">
          <div id="mobileMenuContent" class="min-h-0 mt-3 rounded-3xl bg-[#060B1A]/80 backdrop-blur-md shadow-lg shadow-black/20 p-3 transition-all duration-200 ease-out opacity-0 -translate-y-2">
            <div class="flex flex-col gap-1">
                <a asp-controller="Participant" asp-action="Index"
                   class="px-4 py-2 rounded-2xl text-sm font-medium transition-all duration-200
                          @(currentController == "Participant" && currentAction == "Index" ? "bg-white/10 text-white" : "text-white/80 hover:text-white hover:bg-white/10")">
                    Dashboard
                </a>
                <a asp-controller="Participant" asp-action="Trails"
                   class="px-4 py-2 rounded-2xl text-sm font-medium transition-all duration-200
                          @(currentController == "Participant" && currentAction == "Trails" ? "bg-white/10 text-white" : "text-white/80 hover:text-white hover:bg-white/10")">
                    Trails
                </a>
                <a asp-controller="Participant" asp-action="Events"
                   class="px-4 py-2 rounded-2xl text-sm font-medium transition-all duration-200
                          @(currentController == "Participant" && currentAction == "Events" ? "bg-white/10 text-white" : "text-white/80 hover:text-white hover:bg-white/10")">
                    Events
                </a>
                <a asp-controller="Registration" asp-action="MyRegistrations"
                   class="px-4 py-2 rounded-2xl text-sm font-medium transition-all duration-200
                          @(currentAction == "MyRegistrations" ? "bg-white/10 text-white" : "text-white/80 hover:text-white hover:bg-white/10")">
                    My Registrations
                </a>
                <div class="h-px bg-white/10 my-2"></div>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="Profile" asp-action="Index" class="px-4 py-2 rounded-2xl text-sm text-gray-300 hover:text-white hover:bg-white/5 transition">
                        <i class="fa-solid fa-user w-5"></i> Profile
                    </a>
                    <a asp-controller="Settings" asp-action="Index" class="px-4 py-2 rounded-2xl text-sm text-gray-300 hover:text-white hover:bg-white/5 transition">
                        <i class="fa-solid fa-gear w-5"></i> Settings
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="block w-full m-0 p-0">
                        <button type="submit" class="w-full text-left px-4 py-2 rounded-2xl text-sm text-red-400 hover:text-red-300 hover:bg-red-500/10 transition">
                            <i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Log out
                        </button>
                    </form>
                }
            </div>
          </div>
        </div>
    </div>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const profileBtn = document.getElementById("profileDropdownBtn");
        const profileMenu = document.getElementById("profileDropdownMenu");
        const profileChevron = document.getElementById("profileDropdownChevron");

        if (profileBtn && profileMenu) {
            // Single source of truth: the menu's own state drives the chevron,
            // aria-expanded, and the panel's own fade/slide, rather than a separate
            // click-counter that can desync once the menu closes via an outside
            // click or Escape. No display toggle - display can't be transitioned,
            // which is why an opacity/transform/pointer-events approach is used
            // instead; the element persists through the closing animation.
            function setMenuOpen(isOpen) {
                profileMenu.classList.toggle("opacity-0", !isOpen);
                profileMenu.classList.toggle("scale-95", !isOpen);
                profileMenu.classList.toggle("-translate-y-1", !isOpen);
                profileMenu.classList.toggle("pointer-events-none", !isOpen);
                profileBtn.setAttribute("aria-expanded", String(isOpen));
                profileChevron?.classList.toggle("rotate-180", isOpen);
            }

            profileBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                setMenuOpen(profileMenu.classList.contains("pointer-events-none"));
            });

            document.addEventListener("click", function (e) {
                if (!profileBtn.contains(e.target) && !profileMenu.contains(e.target)) {
                    setMenuOpen(false);
                }
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    setMenuOpen(false);
                }
            });
        }

        const mobileMenuBtn = document.getElementById("mobileMenuBtn");
        const mobileMenuPanel = document.getElementById("mobileMenuPanel");
        const mobileMenuContent = document.getElementById("mobileMenuContent");
        const mobileMenuIconBars = document.getElementById("mobileMenuIconBars");
        const mobileMenuIconClose = document.getElementById("mobileMenuIconClose");

        if (mobileMenuBtn && mobileMenuPanel && mobileMenuContent) {
            // Same pattern as the profile dropdown: the panel's own open state
            // drives the icon morph and aria-expanded, so closing via an outside
            // click or Escape can't leave the hamburger icon out of sync.
            function setMobileMenuOpen(isOpen) {
                mobileMenuPanel.style.gridTemplateRows = isOpen ? "1fr" : "0fr";
                mobileMenuContent.classList.toggle("opacity-0", !isOpen);
                mobileMenuContent.classList.toggle("-translate-y-2", !isOpen);
                mobileMenuBtn.setAttribute("aria-expanded", String(isOpen));

                if (mobileMenuIconBars && mobileMenuIconClose) {
                    mobileMenuIconBars.style.opacity = isOpen ? "0" : "1";
                    mobileMenuIconBars.style.transform = isOpen ? "rotate(90deg) scale(0.75)" : "rotate(0deg) scale(1)";
                    mobileMenuIconClose.style.opacity = isOpen ? "1" : "0";
                    mobileMenuIconClose.style.transform = isOpen ? "rotate(0deg) scale(1)" : "rotate(-90deg) scale(0.75)";
                }
            }

            mobileMenuBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                setMobileMenuOpen(mobileMenuPanel.style.gridTemplateRows !== "1fr");
            });

            document.addEventListener("click", function (e) {
                if (!mobileMenuBtn.contains(e.target) && !mobileMenuPanel.contains(e.target)) {
                    setMobileMenuOpen(false);
                }
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    setMobileMenuOpen(false);
                }
            });
        }
    });
</script>