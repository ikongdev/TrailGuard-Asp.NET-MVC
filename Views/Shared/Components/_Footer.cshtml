@{
    // Role-aware Browse Trails destination, computed once and reused below -
    // mirrors Home/Index.cshtml's Popular Trails cards exactly. Anonymous
    // falls through to the Participant route too: ParticipantController's own
    // [Authorize(Roles="Participant")] then challenges to Login with a local
    // ReturnUrl back to the current page (see AccountController.Login),
    // rather than this partial deciding anything about authentication itself.
    var footerTrailsUrl = (User.IsInRole("Admin") || User.IsInRole("Organizer"))
        ? Url.Action("Index", "Trail")
        : Url.Action("Trails", "Participant");

    var footerLinkClasses = "text-gray-400 hover:text-white transition focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 rounded-sm";
}

<footer class="bg-gray-900 text-white py-12 mt-auto">
    <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-3 gap-10">
            <div>
                <div class="flex items-center gap-3 mb-4">
                    <img src="~/images/logo.png"
                    asp-append-version="true"
                    alt=""
                    class="h-10 w-auto" />
                    <h3 class="text-xl font-bold">TrailGuard</h3>
                </div>

                <p class="text-gray-400 text-sm">
                    TrailGuard is a hiking event and trail management platform built for safer adventures and smarter decisions.
                </p>
                <p class="text-gray-400 text-sm mt-2">
                    &copy; @DateTime.Now.Year TrailGuard. All rights reserved.
                </p>
            </div>

            <nav aria-label="Footer explore">
                <h4 class="font-bold mb-4">Explore</h4>
                <ul class="space-y-2 text-sm">
                    <li><a asp-controller="Home" asp-action="Index" class="@footerLinkClasses">Home</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="about" class="@footerLinkClasses">About TrailGuard</a></li>
                    <li><a href="@footerTrailsUrl" class="@footerLinkClasses">Browse Trails</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="how-it-works" class="@footerLinkClasses">How It Works</a></li>
                </ul>
            </nav>

            <nav aria-label="Footer legal">
                <h4 class="font-bold mb-4">Legal</h4>
                <ul class="space-y-2 text-sm">
                    <li><a asp-controller="Home" asp-action="Privacy" class="@footerLinkClasses">Privacy Policy</a></li>
                </ul>
            </nav>
        </div>
    </div>
</footer>
