@model TrailGuard.Models.EventManagementViewModel
@{
    ViewData["Title"] = "Event Management";
    var currentSearch = ViewData["CurrentFilter"] as string ?? string.Empty;
    var currentStatus = ViewData["CurrentStatus"] as string ?? "All";
    var currentTrailId = ViewData["CurrentTrailId"] as string ?? "All";
    var currentDifficulty = ViewData["CurrentDifficulty"] as string ?? "All";
    var currentSort = ViewData["CurrentSort"] as string ?? TrailGuard.Controllers.EventController.DefaultSortOrder;
    var totalEventCount = Model.StatusGroups.Sum(g => g.Events.Count);

    // Reuses the exact pill shell from Participant/Events.cshtml's Difficulty badge
    // (dark tinted fill + thin semantic border, not a bright solid fill) - only the
    // shell is borrowed, the meaning stays Event.Status. Upcoming/Cancelled reuse
    // the same badge-easy/badge-hard classes that pill already relies on (green/red
    // are shared DifficultyCalculator.BadgeClass tokens, not new colours); Completed
    // reuses this page's own established neutral pill treatment (see the header
    // summary and status-count badges below), with a thin border added so it
    // carries the same three-part shell as the other three arms. The fallback
    // is DifficultyCalculator.BadgeClass's own unrecognized-value arm plus that
    // same thin border, for a stray status the free-text EditEvent Status field
    // could still write.
    string EventStatusBadgeClass(string s) => s switch
    {
        "Upcoming" => "badge-easy",
        "Completed" => "bg-white/10 text-gray-300 border border-white/15",
        "Cancelled" => "badge-hard",
        _ => "text-slate-400 bg-slate-500/15 border border-slate-500/30"
    };
}

@* Success/Error feedback for this page now goes through the canonical global
   toast host in _Layout.cshtml (window.showToast, fed by TempData via
   #tg-toast-tempdata) instead of a page-local fixed banner - see the
   notification centralization pass. *@

@section PageHero {
    <div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
        <header class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
            <div>
                <h1 class="text-3xl font-bold text-white">Event Management</h1>
                <p class="text-gray-400 mt-1 text-sm">Manage upcoming, completed, and other hiking events.</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <span class="bg-white/5 border border-white/10 px-4 py-2 rounded-full text-sm text-gray-300">
                    <i class="fa-solid fa-calendar-check text-accent mr-2" aria-hidden="true"></i>Upcoming Events: <strong class="text-white" id="upcomingEventsCount">@Model.UpcomingEventsCount</strong>
                </span>

                <button type="button" onclick="openAddEventModal()" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base transition duration-200 ease-out">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>Add Event
                </button>
            </div>
        </header>

        <form method="get" asp-action="Index" id="filterForm" onsubmit="return false" class="mb-2">
            <div class="flex flex-col lg:flex-row gap-3 mb-8 bg-white/5 backdrop-blur-xl p-5 rounded-xl border border-white/10">

                <div class="relative grow">
                    <label for="searchInput" class="sr-only">Search events by title, location, or trail</label>
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
                    <input type="search" name="searchString" id="searchInput" value="@currentSearch" placeholder="Search events by title, location, or trail..." autocomplete="off"
                        class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-11 pr-4 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none transition-colors placeholder-gray-500">
                </div>

                <div class="flex flex-wrap sm:flex-nowrap gap-3">
                    <div class="relative shrink-0 w-full sm:w-44">
                        <label for="trailFilter" class="sr-only">Filter by trail</label>
                        <select id="trailFilter" name="trailId" data-custom-select data-custom-select-portal
                                data-cs-decorative-chevron="trailFilterChevron"
                                data-cs-trigger-class="flex w-full items-center justify-between gap-2 px-4 py-3 rounded-full bg-black/20 border border-white/10 text-white text-sm text-left focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors cursor-pointer hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed"
                                onchange="document.getElementById('filterForm').submit()"
                                class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors">
                            <option value="All" selected="@(currentTrailId == "All" ? "selected" : null)" class="bg-surface-card text-white">All Trails</option>
                            @{
                                var distinctTrails = ViewBag.Trails as List<TrailGuard.Models.Trail>;
                                if (distinctTrails != null)
                                {
                                    foreach (var trail in distinctTrails)
                                    {
                                        <option value="@trail.Id" selected="@(currentTrailId == trail.Id.ToString() ? "selected" : null)" class="bg-surface-card text-white">@trail.Name</option>
                                    }
                                }
                            }
                        </select>
                        <div id="trailFilterChevron" class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                        </div>
                    </div>

                    <div class="relative shrink-0 w-full sm:w-48">
                        <label for="difficultyFilter" class="sr-only">Filter by difficulty</label>
                        <select id="difficultyFilter" name="difficulty" data-custom-select data-custom-select-portal
                                data-cs-decorative-chevron="difficultyFilterChevron"
                                data-cs-trigger-class="flex w-full items-center justify-between gap-2 px-4 py-3 rounded-full bg-black/20 border border-white/10 text-white text-sm text-left focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors cursor-pointer hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed"
                                onchange="document.getElementById('filterForm').submit()"
                                class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors">
                            <option value="All" selected="@(currentDifficulty == "All" ? "selected" : null)" class="bg-surface-card text-white">All Difficulties</option>
                            @foreach (var band in TrailGuard.Services.DifficultyCalculator.Bands)
                            {
                                <option value="@band" selected="@(currentDifficulty == band ? "selected" : null)" class="bg-surface-card text-white">@band</option>
                            }
                        </select>
                        <div id="difficultyFilterChevron" class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                        </div>
                    </div>

                    <div class="relative shrink-0 w-full sm:w-40">
                        <label for="statusFilter" class="sr-only">Filter by status</label>
                        <select id="statusFilter" name="status" data-custom-select data-custom-select-portal
                                data-cs-decorative-chevron="statusFilterChevron"
                                data-cs-trigger-class="flex w-full items-center justify-between gap-2 px-4 py-3 rounded-full bg-black/20 border border-white/10 text-white text-sm text-left focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors cursor-pointer hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed"
                                onchange="document.getElementById('filterForm').submit()"
                                class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors">
                            <option value="All" selected="@(currentStatus == "All" ? "selected" : null)" class="bg-surface-card text-white">All Status</option>
                            @foreach (var s in Model.AvailableStatuses)
                            {
                                <option value="@s" selected="@(currentStatus == s ? "selected" : null)" class="bg-surface-card text-white">@s</option>
                            }
                        </select>
                        <div id="statusFilterChevron" class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                        </div>
                    </div>

                    <div class="relative shrink-0 w-full sm:w-48">
                        <label for="sortFilter" class="sr-only">Sort events by</label>
                        <select id="sortFilter" name="sortOrder" data-custom-select data-custom-select-portal
                                data-cs-decorative-chevron="sortFilterChevron"
                                data-cs-trigger-class="flex w-full items-center justify-between gap-2 px-4 py-3 rounded-full bg-black/20 border border-white/10 text-white text-sm text-left focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors cursor-pointer hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed"
                                onchange="document.getElementById('filterForm').submit()"
                                class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors">
                            <option value="date_asc" selected="@(currentSort == "date_asc" ? "selected" : null)" class="bg-surface-card text-white">Sort by: Soonest</option>
                            <option value="date_desc" selected="@(currentSort == "date_desc" ? "selected" : null)" class="bg-surface-card text-white">Sort by: Latest</option>
                        </select>
                        <div id="sortFilterChevron" class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <p id="resultCountAnnouncer" class="sr-only" role="status" aria-live="polite"></p>

        <div id="eventsContainer">
            @if (!Model.HasAnyResults)
            {
                <div id="overallEmptyState" class="text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl">
                    <i class="fa-solid fa-calendar-times text-4xl text-slate-600 mb-4" aria-hidden="true"></i>
                    @if (currentStatus != "All")
                    {
                        <h3 class="text-xl font-bold text-gray-300">No @currentStatus events found</h3>
                        <p class="text-gray-500 mt-2">No @currentStatus.ToLower() events match your search and filters.</p>
                    }
                    else
                    {
                        <h3 class="text-xl font-bold text-gray-300">No events found</h3>
                        <p class="text-gray-500 mt-2">Try adjusting your search or filters, or click "Add Event" to create one.</p>
                    }
                </div>
            }
            else
            {
                @foreach (var group in Model.StatusGroups)
                {
                    var headingId = "statusHeading-" + group.Status.Replace(" ", "-");
                    <section class="status-section mb-10" data-status="@group.Status" aria-labelledby="@headingId">
                        <div class="flex items-center gap-3 mb-4 pb-3 border-b border-gray-700">
                            <h2 id="@headingId" class="text-xl font-bold text-white">@group.Status</h2>
                            <span class="text-xs px-3 py-1 bg-white/10 rounded-full text-gray-300">
                                <span class="status-count">@group.Events.Count</span> event(s)
                            </span>
                        </div>

                        <div class="events-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            @foreach (var eventItem in group.Events)
                            {
                                // Completed Events are immutable historical records (see
                                // CLAUDE.md, Event Lifecycle) - Edit/Delete are never
                                // rendered for one, not merely hidden, so there is no
                                // markup for the delegated delete-button handler or
                                // openEditModal's trigger to find in the first place.
                                // The server independently enforces this regardless of
                                // what the client renders - see EventController.GetEvent/
                                // EditEvent/DeleteEvent.
                                var isCompleted = eventItem.Status == "Completed";
                                <div class="event-card group bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden hover:border-white/20 transition-colors flex flex-col"
                                     data-search="@eventItem.EventTitle @eventItem.Location @eventItem.TrailNameSnapshot">

                                    <div class="relative h-48 overflow-hidden bg-black/30">
                                        @* Trail Snapshot thumbnail/name (Event's own frozen copy), never a
                                           live Event.Trail read - see CLAUDE.md, "Event Trail Snapshot". *@
                                        @if (!string.IsNullOrEmpty(eventItem.TrailThumbnailUrlSnapshot))
                                        {
                                            <img src="@eventItem.TrailThumbnailUrlSnapshot" alt="@eventItem.TrailNameSnapshot" class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transform-none motion-reduce:transition-none" onerror="handleEventImageError(this)">
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center">
                                                <i class="fa-solid fa-image text-4xl text-slate-700" aria-hidden="true"></i>
                                            </div>
                                        }
                                        <div class="absolute inset-0 bg-linear-to-t from-surface-card to-transparent opacity-90"></div>

                                        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-medium @EventStatusBadgeClass(eventItem.Status)">
                                            @eventItem.Status
                                        </span>
                                        <div class="absolute bottom-3 left-3">
                                            <span class="text-xs text-white/90 bg-black/50 px-2.5 py-1 rounded-full flex items-center gap-1.5">
                                                <i class="fa-regular fa-calendar" aria-hidden="true"></i> @eventItem.EventDate.ToString("MMM dd, yyyy")
                                            </span>
                                        </div>
                                    </div>

                                    <div class="p-6 flex flex-col grow relative z-10 -mt-10">
                                        <h3 class="text-xl font-bold text-white mb-1">@eventItem.EventTitle</h3>
                                        <p class="text-gray-400 text-sm mb-5 flex items-center gap-1.5">
                                            <i class="fa-solid fa-location-dot text-accent" aria-hidden="true"></i> @eventItem.Location
                                        </p>

                                        <div class="grid grid-cols-2 gap-4 mb-4">
                                            <div>
                                                <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Start Time</p>
                                                <p class="text-gray-200 text-sm font-medium flex items-center gap-2">
                                                    <i class="fa-regular fa-clock text-gray-400" aria-hidden="true"></i> @eventItem.FormattedEventTime
                                                </p>
                                            </div>
                                            <div>
                                                <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Slots</p>
                                                <p class="text-gray-200 text-sm font-medium flex items-center gap-2">
                                                    <i class="fa-solid fa-users text-gray-400" aria-hidden="true"></i> @(eventItem.Capacity - eventItem.RegisteredCount) / @eventItem.Capacity
                                                </p>
                                            </div>
                                        </div>

                                        <div class="flex flex-wrap gap-1.5 mb-6">
                                            <span class="px-2.5 py-1 rounded-full text-xs font-medium @TrailGuard.Services.DifficultyCalculator.BadgeClass(eventItem.Difficulty)">@eventItem.Difficulty</span>
                                            <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-gray-300">@eventItem.EstimatedDuration hrs</span>
                                        </div>

                                        <div class="flex gap-2 mt-auto">
                                            <a asp-controller="Event" asp-action="Details" asp-route-id="@eventItem.Id"
                                               aria-label="View details for @eventItem.EventTitle"
                                               class="@(isCompleted ? "w-full" : "flex-1") bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-gray-300 hover:text-white py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                                <i class="fa-regular fa-eye" aria-hidden="true"></i> View
                                            </a>
                                            @if (!isCompleted)
                                            {
                                                <button type="button" onclick="openEditModal(this, @eventItem.Id)"
                                                        aria-label="Edit @eventItem.EventTitle"
                                                        class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-gray-300 hover:text-white py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                                    <i class="fa-solid fa-pen" aria-hidden="true"></i> Edit
                                                </button>
                                                <button type="button"
                                                        data-event-id="@eventItem.Id"
                                                        data-event-title="@eventItem.EventTitle"
                                                        aria-label="Delete @eventItem.EventTitle"
                                                        class="delete-event-btn bg-red-500/20 hover:bg-red-500 border border-red-500/30 hover:border-red-500 text-red-400 hover:text-white py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center w-12 focus:outline-none focus:ring-2 focus:ring-accent">
                                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                <div id="noSearchResults" hidden class="text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl">
                    <i class="fa-solid fa-magnifying-glass text-4xl text-slate-600 mb-4" aria-hidden="true"></i>
                    <h3 class="text-xl font-bold text-gray-300">No events found</h3>
                    <p class="text-gray-500 mt-2">No events match your search. Try a different title, location, or trail.</p>
                </div>
            }
        </div>
    </div>
}

@section Modals {
<div id="addEventModal" class="fixed inset-0 z-60 hidden items-center justify-center p-4">
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-60" onclick="closeAddEventModal()" aria-hidden="true"></div>
    <div role="dialog" aria-modal="true" aria-labelledby="addEventModalTitle"
         class="relative bg-surface-card border border-white/10 rounded-xl shadow-2xl w-full max-w-4xl max-h-[calc(100vh-2rem)] overflow-hidden flex flex-col z-60">

        <div class="flex items-start justify-between gap-4 px-6 py-4 border-b border-white/10 shrink-0">
            <div class="flex items-center gap-3 min-w-0">
                <span class="w-9 h-9 rounded-full bg-linear-to-r from-orange-500 to-violet-500 flex items-center justify-center shrink-0" aria-hidden="true">
                    <i class="fa-solid fa-plus text-white text-sm"></i>
                </span>
                <div class="min-w-0">
                    <h2 id="addEventModalTitle" class="text-lg font-bold text-white">Add Event</h2>
                    <p class="text-xs text-gray-400">A guided three-step setup for a new hiking event.</p>
                </div>
            </div>
            <button type="button" onclick="closeAddEventModal()" aria-label="Close" class="shrink-0 text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded">
                <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
            </button>
        </div>

        <div class="px-6 pt-5 pb-4 border-b border-white/10 shrink-0">
            <div class="flex items-start justify-between max-w-xl mx-auto" role="list" aria-label="Event setup steps">
                <div class="flex flex-col items-center text-center flex-1 min-w-0" role="listitem" data-step-item="1">
                    <span class="w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors" data-step-circle="1">
                        <span data-step-number>1</span>
                    </span>
                    <span class="text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors" data-step-label>Trail &amp; Capacity</span>
                    <span class="sr-only" data-step-status></span>
                </div>
                <div class="flex-1 h-0.5 bg-gray-700 mt-4 mx-1 sm:mx-2 transition-colors" data-step-line="1" aria-hidden="true"></div>
                <div class="flex flex-col items-center text-center flex-1 min-w-0" role="listitem" data-step-item="2">
                    <span class="w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors" data-step-circle="2">
                        <span data-step-number>2</span>
                    </span>
                    <span class="text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors" data-step-label>Schedule &amp; Weather</span>
                    <span class="sr-only" data-step-status></span>
                </div>
                <div class="flex-1 h-0.5 bg-gray-700 mt-4 mx-1 sm:mx-2 transition-colors" data-step-line="2" aria-hidden="true"></div>
                <div class="flex flex-col items-center text-center flex-1 min-w-0" role="listitem" data-step-item="3">
                    <span class="w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors" data-step-circle="3">
                        <span data-step-number>3</span>
                    </span>
                    <span class="text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors" data-step-label>Event Details</span>
                    <span class="sr-only" data-step-status></span>
                </div>
            </div>
        </div>

        <form id="addEventForm" class="flex flex-col flex-1 overflow-hidden">
            <div class="overflow-y-auto custom-scrollbar flex-1 p-6">
                <!-- Step 1 -->
                <div id="step1" class="step-content">
                    <h3 id="addEventStep1Heading" tabindex="-1" class="text-sm font-semibold text-white mb-4 focus:outline-none">Trail &amp; Capacity</h3>
                    <div class="mb-6">
                        <label for="eventTrailId" class="block text-sm font-medium text-gray-300 mb-2">Select Trail <span class="text-red-400">*</span></label>
                        <select id="eventTrailId" name="TrailId" required data-custom-select
                                class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm appearance-none cursor-pointer">
                            <option value="" disabled selected>-- Select a trail --</option>
                            @{
                                var trails = ViewBag.Trails as List<TrailGuard.Models.Trail>;
                                if (trails != null)
                                {
                                    foreach (var trail in trails)
                                    {
                                        <option value="@trail.Id" class="bg-surface-card">@trail.Name - @trail.Location</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Difficulty</p>
                            <p id="previewDifficulty" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Distance</p>
                            <p id="previewDistance" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Elevation Gain</p>
                            <p id="previewElevation" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Location</p>
                            <p id="previewLocation" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Terrain</p>
                            <p id="previewTerrain" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Trail Class</p>
                            <p id="previewTerrainType" class="text-white font-semibold">-</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="eventDuration" class="block text-sm font-medium text-gray-300 mb-2">Estimated Duration (Hours) <span class="text-red-400">*</span></label>
                            <input type="number" step="any" min="0.1" id="eventDuration" name="EstimatedDuration" required
                                   class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., 6">
                            <p class="text-xs text-gray-500 mt-2">Prefilled from the NPS pace estimate — adjust as needed.</p>
                        </div>
                        <div>
                            <label for="eventCapacity" class="block text-sm font-medium text-gray-300 mb-2">Slots Available (Capacity) <span class="text-red-400">*</span></label>
                            <input type="number" id="eventCapacity" name="Capacity" required min="1"
                                   class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., 20">
                        </div>
                    </div>
                </div>

                <!-- Step 2 -->
                <div id="step2" class="step-content hidden">
                    <h3 id="addEventStep2Heading" tabindex="-1" class="text-sm font-semibold text-white mb-4 focus:outline-none">Schedule &amp; Weather</h3>
                    <div class="mb-6">
                        <p id="pickupSchedulesLabel" class="block text-sm font-medium text-gray-300 mb-2">Pickup Schedules <span class="text-red-400">*</span></p>
                        <div role="group" aria-labelledby="pickupSchedulesLabel" class="rounded-xl border border-white/10 bg-white/5 p-3">
                            <div class="flex flex-col sm:flex-row gap-2">
                                <input type="text" id="pickupScheduleLocationInput"
                                       class="block w-full px-4 py-2.5 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm"
                                       placeholder="e.g., Cubao Bus Terminal" aria-label="Pickup location">
                                <input type="time" id="pickupScheduleTimeInput"
                                       class="add-event-datetime block w-full sm:w-36 shrink-0 px-4 py-2.5 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm"
                                       aria-label="Pickup time">
                                <button type="button" id="pickupScheduleAddBtn"
                                        class="inline-flex w-full sm:w-auto items-center justify-center gap-2 px-4 py-2.5 rounded-full text-sm font-semibold text-white bg-accent hover:brightness-110 transition focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card shrink-0">
                                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                    <span id="pickupScheduleAddBtnLabel">Add Schedule</span>
                                </button>
                            </div>
                            <button type="button" id="pickupScheduleCancelEditBtn" hidden
                                    class="mt-2 text-xs font-medium text-gray-400 hover:text-white transition-colors underline decoration-dotted underline-offset-2 focus:outline-none focus:ring-2 focus:ring-accent rounded">
                                Cancel editing
                            </button>

                            <p id="pickupSchedulesEmptyState" class="text-xs text-gray-500 mt-3">No pickup schedules added yet.</p>
                            <div id="pickupSchedulesList" class="flex flex-col gap-2 mt-3 empty:mt-0"></div>
                            <p id="pickupSchedulesStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Participants will choose one of these schedules during registration.</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                        <div>
                            <label for="eventDate" class="block text-sm font-medium text-gray-300 mb-2">Event Date <span class="text-red-400">*</span></label>
                            <input type="date" id="eventDate" name="EventDate" required
                                   class="add-event-datetime block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm">
                        </div>
                        <div>
                            <label for="eventTime" class="block text-sm font-medium text-gray-300 mb-2">Event Time <span class="text-red-400">*</span></label>
                            <input type="time" id="eventTime" name="EventTime" required
                                   class="add-event-datetime block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm">
                        </div>
                    </div>

                    <div class="mb-4">
                        <!-- Not a <label for="eventWeather"> - #eventWeather is a hidden, non-
                             focusable backing input (already excluded from the accessibility tree
                             and in no need of a <label>). This text instead labels the visible
                             four-state region below it via aria-labelledby. -->
                        <p id="eventWeatherAdvisoryLabel" class="block text-sm font-medium text-gray-300 mb-2">Weather Forecast Advisory</p>
                        <!-- The raw multiline forecast string still exists and is still what the
                             Add Event payload submits under WeatherForecastAdvisory - it just isn't
                             the visible UI anymore. A hidden input keeps id="eventWeather" and
                             name="WeatherForecastAdvisory" so the rest of the JS (and the payload
                             builder) needs no changes, and (unlike a visually-hidden textarea) it's
                             never keyboard-focusable. -->
                        <input type="hidden" id="eventWeather" name="WeatherForecastAdvisory">
                        <div id="eventWeatherRegion" role="group" aria-labelledby="eventWeatherAdvisoryLabel" aria-busy="false">
                            <!-- Four mutually exclusive states (waiting/loading/result/unavailable).
                                 Every state root only ever toggles its own 'hidden' class - never a
                                 competing flex/grid/block class - so a root defaults to plain block
                                 display the instant 'hidden' is removed. flex/grid only ever live on
                                 an always-present inner wrapper. This is what makes
                                 setAddEventWeatherState's "hide all four, then unhide one" safe: no
                                 state can end up simultaneously hidden-and-shown the way the earlier
                                 Create Event button was. -->

                            <!-- State 1: waiting on trail + date -->
                            <div id="weatherWaitingPanel" class="rounded-xl border border-white/10 bg-white/5 p-4 min-h-32">
                                <div class="flex flex-col items-center justify-center gap-2 h-full text-center">
                                    <span class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0" aria-hidden="true">
                                        <i class="fa-solid fa-cloud-sun text-gray-500 text-sm"></i>
                                    </span>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-300">Weather forecast</p>
                                        <p class="text-xs text-gray-500 mt-0.5">Select a trail and event date to view the forecast.</p>
                                    </div>
                                </div>
                            </div>

                            <!-- State 2: loading (approved design, unchanged) -->
                            <div id="weatherLoadingPanel" role="status" aria-live="polite" aria-atomic="true"
                                 class="hidden rounded-xl border border-white/10 bg-surface-card/90 p-3 min-h-32 overflow-hidden">
                                <div class="flex flex-col items-center justify-center gap-2 h-full text-center">
                                    <span class="w-8 h-8 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                        <i class="fa-solid fa-cloud-sun text-accent text-sm"></i>
                                    </span>
                                    <div class="min-w-0 max-w-full">
                                        <p class="text-sm font-semibold text-white">Checking trail weather</p>
                                        <p id="weatherLoadingContext" class="text-xs text-gray-400 mt-0.5 wrap-break-word px-1"></p>
                                    </div>
                                    <div class="w-full max-w-55 grid grid-cols-3 gap-2 mt-1" aria-hidden="true">
                                        <div class="flex flex-col items-center gap-1">
                                            <i class="fa-solid fa-temperature-half text-gray-500 text-[10px]"></i>
                                            <span class="text-[9px] uppercase tracking-wide text-gray-500">Temp</span>
                                            <span class="h-1 w-7 rounded-full bg-white/10 animate-pulse motion-reduce:animate-none"></span>
                                        </div>
                                        <div class="flex flex-col items-center gap-1">
                                            <i class="fa-solid fa-droplet text-gray-500 text-[10px]"></i>
                                            <span class="text-[9px] uppercase tracking-wide text-gray-500">Rain</span>
                                            <span class="h-1 w-7 rounded-full bg-white/10 animate-pulse motion-reduce:animate-none"></span>
                                        </div>
                                        <div class="flex flex-col items-center gap-1">
                                            <i class="fa-solid fa-wind text-gray-500 text-[10px]"></i>
                                            <span class="text-[9px] uppercase tracking-wide text-gray-500">Wind</span>
                                            <span class="h-1 w-7 rounded-full bg-white/10 animate-pulse motion-reduce:animate-none"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- State 3: structured result card -->
                            <div id="weatherResultPanel" role="status" aria-live="polite" aria-atomic="true"
                                 class="hidden rounded-xl border border-white/10 bg-white/5 p-3 min-h-32">
                                <div class="flex flex-col gap-2 h-full">
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="w-8 h-8 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                                <i id="weatherResultIcon" class="fa-solid fa-cloud text-accent text-sm"></i>
                                            </span>
                                            <p id="weatherResultCondition" class="text-sm font-semibold text-white wrap-break-word min-w-0"></p>
                                        </div>
                                        <!-- The one eventWeatherRiskBadge element in the page - moved
                                             here from beside the Weather Reminder label below. -->
                                        <span id="eventWeatherRiskBadge" class="hidden shrink-0 px-2.5 py-0.5 rounded-full text-xs font-semibold"></span>
                                    </div>
                                    <div class="grid grid-cols-3 gap-2">
                                        <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                            <i class="fa-solid fa-temperature-half text-gray-500 text-xs" aria-hidden="true"></i>
                                            <p id="weatherResultTemp" class="text-sm font-semibold text-white mt-1">—</p>
                                            <p class="text-[10px] text-gray-500 uppercase tracking-wide">Temperature</p>
                                        </div>
                                        <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                            <i class="fa-solid fa-droplet text-gray-500 text-xs" aria-hidden="true"></i>
                                            <p id="weatherResultRainfall" class="text-sm font-semibold text-white mt-1">—</p>
                                            <p class="text-[10px] text-gray-500 uppercase tracking-wide">Expected rainfall</p>
                                        </div>
                                        <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                            <i class="fa-solid fa-wind text-gray-500 text-xs" aria-hidden="true"></i>
                                            <p id="weatherResultWind" class="text-sm font-semibold text-white mt-1">—</p>
                                            <p id="weatherResultWindDescription" class="text-[10px] text-gray-500 uppercase tracking-wide wrap-break-word"></p>
                                        </div>
                                    </div>
                                    <p id="weatherResultUpdated" class="text-[11px] text-gray-500 text-right mt-auto"></p>
                                </div>
                            </div>

                            <!-- State 4: unavailable -->
                            <div id="weatherUnavailablePanel" role="status" aria-live="polite" aria-atomic="true"
                                 class="hidden rounded-xl border border-white/10 bg-white/5 p-4 min-h-32">
                                <div class="flex flex-col items-center justify-center gap-2 h-full text-center">
                                    <span class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0" aria-hidden="true">
                                        <i class="fa-solid fa-cloud text-gray-500 text-sm"></i>
                                    </span>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-300">Weather forecast</p>
                                        <p id="weatherUnavailableMessage" class="text-xs text-gray-500 mt-0.5 wrap-break-word px-1"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Auto-fills based on trail location and event date.</p>
                    </div>

                    <div class="mb-2">
                        <label for="eventWeatherReminder" class="block text-sm font-medium text-gray-300 mb-2">Weather Reminder</label>
                        <input type="hidden" id="eventWeatherRiskLevel" name="WeatherRiskLevel">
                        <textarea id="eventWeatherReminder" name="WeatherReminder" rows="3"
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Preparation advice will auto-fill based on the forecast..."></textarea>
                        <p class="text-xs text-gray-500 mt-2">Generated from the forecast — review and adjust the wording before publishing.</p>
                    </div>
                </div>

                <!-- Step 3 -->
                <div id="step3" class="step-content hidden">
                    <h3 id="addEventStep3Heading" tabindex="-1" class="text-sm font-semibold text-white mb-4 focus:outline-none">Event Details</h3>
                    <div class="mb-6">
                        <label for="eventTitle" class="block text-sm font-medium text-gray-300 mb-2">Event Title <span class="text-red-400">*</span></label>
                        <input type="text" id="eventTitle" name="EventTitle" required
                               class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., Mount Pulag Sunrise Hike">
                    </div>

                    <div class="mb-6">
                        @if (User.IsInRole("Admin"))
                        {
                            var addEventOrganizers = ViewBag.Organizers as List<TrailGuard.Models.ApplicationUser>;
                            <label for="eventOrganizerId" class="block text-sm font-medium text-gray-300 mb-2">Select Organizer <span class="text-red-400">*</span></label>
                            @if (addEventOrganizers != null && addEventOrganizers.Count > 0)
                            {
                                <select id="eventOrganizerId" name="OrganizerId" required data-custom-select
                                        class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm appearance-none cursor-pointer">
                                    <option value="" disabled selected>-- Select organizer --</option>
                                    @foreach (var org in addEventOrganizers)
                                    {
                                        <option value="@org.Id" class="bg-surface-card">@org.FirstName @org.LastName - @org.Email</option>
                                    }
                                </select>
                                <p class="text-xs text-gray-500 mt-2">The event will be assigned to the organizer you select here.</p>
                            }
                            else
                            {
                                <select id="eventOrganizerId" name="OrganizerId" required disabled data-custom-select
                                        class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-gray-500 focus:outline-none transition-colors text-sm appearance-none cursor-not-allowed">
                                    <option value="" selected>No organizer accounts available</option>
                                </select>
                                <p class="text-xs text-red-400 mt-2 flex items-center gap-1.5">
                                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                                    <span>No Organizer accounts exist yet. Create one before adding an event.</span>
                                </p>
                            }
                        }
                        else
                        {
                            <p class="block text-sm font-medium text-gray-300 mb-2">Organizer</p>
                            <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 flex items-start gap-3">
                                <i class="fa-solid fa-circle-info text-accent mt-0.5 shrink-0" aria-hidden="true"></i>
                                <p class="text-sm text-gray-300">This event will automatically be assigned to your organizer account.</p>
                            </div>
                        }
                    </div>

                    <div class="mb-6">
                        <label for="eventDescription" class="block text-sm font-medium text-gray-300 mb-2">Event Description <span class="text-red-400">*</span></label>
                        <textarea id="eventDescription" name="Description" required rows="4"
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Provide a detailed description about the event..."></textarea>
                    </div>

                    <div class="mb-6">
                        <label for="eventPaymentDetails" class="block text-sm font-medium text-gray-300 mb-2">Payment Details <span class="text-gray-500 font-normal">(Optional)</span></label>
                        <textarea id="eventPaymentDetails" name="PaymentDetails" rows="4"
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Registration fee, GCash number, bank details..."></textarea>
                        <p class="text-xs text-gray-500 mt-2">Include registration fee and payment instructions here.</p>
                    </div>

                    <div class="mb-2">
                        <label for="eventAnnouncements" class="block text-sm font-medium text-gray-300 mb-2">Notes &amp; Reminders <span class="text-gray-500 font-normal">(Optional)</span></label>
                        <textarea id="eventAnnouncements" name="NotesAndReminders" rows="3"
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Important reminders and things participants should know..."></textarea>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-white/10 shrink-0">
                <button type="button" id="prevBtn" class="hidden px-5 py-2.5 rounded-full text-sm font-semibold text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back
                </button>
                <div class="flex items-center gap-3 ml-auto">
                    <button type="button" onclick="closeAddEventModal()" class="px-5 py-2.5 rounded-full text-sm font-semibold text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
                        Cancel
                    </button>
                    <button type="button" id="nextBtn" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base">
                        Next <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                    <button type="submit" id="submitBtn" class="hidden items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base disabled:opacity-60 disabled:pointer-events-none">
                        <i class="fa-solid fa-check" aria-hidden="true" id="submitBtnIcon"></i>
                        <span id="submitBtnLabel">Create Event</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="editEventModal" class="fixed inset-0 z-60 hidden items-center justify-center p-4">
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-60" onclick="closeEditEventModal()" aria-hidden="true"></div>
    <div role="dialog" aria-modal="true" aria-labelledby="editEventModalTitle"
         class="relative bg-surface-card border border-white/10 rounded-xl shadow-2xl w-full max-w-4xl max-h-[calc(100vh-2rem)] overflow-hidden flex flex-col z-60">

        <div class="flex items-start justify-between gap-4 px-6 py-4 border-b border-white/10 shrink-0">
            <div class="flex items-center gap-3 min-w-0">
                <span class="w-9 h-9 rounded-full bg-linear-to-r from-orange-500 to-violet-500 flex items-center justify-center shrink-0" aria-hidden="true">
                    <i class="fa-solid fa-pen text-white text-sm"></i>
                </span>
                <div class="min-w-0">
                    <h2 id="editEventModalTitle" class="text-lg font-bold text-white">Edit Event</h2>
                    <p class="text-xs text-gray-400">Update this event's trail, schedule, and details.</p>
                </div>
            </div>
            <button type="button" onclick="closeEditEventModal()" aria-label="Close" class="shrink-0 text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded">
                <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
            </button>
        </div>

        <div class="px-6 pt-5 pb-4 border-b border-white/10 shrink-0">
            <div class="flex items-start justify-between max-w-xl mx-auto" role="list" aria-label="Event edit steps">
                <div class="flex flex-col items-center text-center flex-1 min-w-0" role="listitem" data-edit-step-item="1">
                    <span class="w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors" data-edit-step-circle="1">
                        <span data-edit-step-number>1</span>
                    </span>
                    <span class="text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors" data-edit-step-label>Trail &amp; Capacity</span>
                    <span class="sr-only" data-edit-step-status></span>
                </div>
                <div class="flex-1 h-0.5 bg-gray-700 mt-4 mx-1 sm:mx-2 transition-colors" data-edit-step-line="1" aria-hidden="true"></div>
                <div class="flex flex-col items-center text-center flex-1 min-w-0" role="listitem" data-edit-step-item="2">
                    <span class="w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors" data-edit-step-circle="2">
                        <span data-edit-step-number>2</span>
                    </span>
                    <span class="text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors" data-edit-step-label>Schedule &amp; Weather</span>
                    <span class="sr-only" data-edit-step-status></span>
                </div>
                <div class="flex-1 h-0.5 bg-gray-700 mt-4 mx-1 sm:mx-2 transition-colors" data-edit-step-line="2" aria-hidden="true"></div>
                <div class="flex flex-col items-center text-center flex-1 min-w-0" role="listitem" data-edit-step-item="3">
                    <span class="w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors" data-edit-step-circle="3">
                        <span data-edit-step-number>3</span>
                    </span>
                    <span class="text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors" data-edit-step-label>Event Details</span>
                    <span class="sr-only" data-edit-step-status></span>
                </div>
            </div>
        </div>

        <form id="editEventForm" class="flex flex-col flex-1 overflow-hidden">
            <input type="hidden" id="editEventId" name="Id" />
            <div class="overflow-y-auto custom-scrollbar flex-1 p-6">
                <!-- Edit Step 1 -->
                <div id="editStep1" class="edit-step-content">
                    <h3 id="editEventStep1Heading" tabindex="-1" class="text-sm font-semibold text-white mb-4 focus:outline-none">Trail &amp; Capacity</h3>
                    <div class="mb-6">
                        <label for="editEventTrailId" class="block text-sm font-medium text-gray-300 mb-2">Select Trail <span class="text-red-400">*</span></label>
                        <select id="editEventTrailId" name="TrailId" required data-custom-select
                                class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm appearance-none cursor-pointer">
                            <option value="" disabled selected>-- Select a trail --</option>
                            @{
                                var editTrails = ViewBag.Trails as List<TrailGuard.Models.Trail>;
                                if (editTrails != null)
                                {
                                    foreach (var trail in editTrails)
                                    {
                                        <option value="@trail.Id" class="bg-surface-card">@trail.Name - @trail.Location</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Difficulty</p>
                            <p id="editPreviewDifficulty" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Distance</p>
                            <p id="editPreviewDistance" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Elevation Gain</p>
                            <p id="editPreviewElevation" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Location</p>
                            <p id="editPreviewLocation" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Terrain</p>
                            <p id="editPreviewTerrain" class="text-white font-semibold">-</p>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                            <p class="text-gray-500 text-xs uppercase tracking-wider">Trail Class</p>
                            <p id="editPreviewTerrainType" class="text-white font-semibold">-</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="editEventDuration" class="block text-sm font-medium text-gray-300 mb-2">Estimated Duration (Hours) <span class="text-red-400">*</span></label>
                            <input type="number" step="any" min="0.1" id="editEventDuration" name="EstimatedDuration" required
                                   class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., 6">
                            <p class="text-xs text-gray-500 mt-2">Prefilled from the NPS pace estimate — adjust as needed.</p>
                        </div>
                        <div>
                            <label for="editEventCapacity" class="block text-sm font-medium text-gray-300 mb-2">Slots Available (Capacity) <span class="text-red-400">*</span></label>
                            <input type="number" id="editEventCapacity" name="Capacity" required min="1"
                                   class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., 20">
                        </div>
                    </div>
                </div>

                <!-- Edit Step 2 -->
                <div id="editStep2" class="edit-step-content hidden">
                    <h3 id="editEventStep2Heading" tabindex="-1" class="text-sm font-semibold text-white mb-4 focus:outline-none">Schedule &amp; Weather</h3>
                    <div class="mb-6">
                        <p id="editPickupSchedulesLabel" class="block text-sm font-medium text-gray-300 mb-2">Pickup Schedules <span class="text-red-400">*</span></p>
                        <div role="group" aria-labelledby="editPickupSchedulesLabel" class="rounded-xl border border-white/10 bg-white/5 p-3">
                            <div class="flex flex-col sm:flex-row gap-2">
                                <input type="text" id="editPickupScheduleLocationInput"
                                       class="block w-full px-4 py-2.5 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm"
                                       placeholder="e.g., Cubao Bus Terminal" aria-label="Pickup location">
                                <input type="time" id="editPickupScheduleTimeInput"
                                       class="add-event-datetime block w-full sm:w-36 shrink-0 px-4 py-2.5 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm"
                                       aria-label="Pickup time">
                                <button type="button" id="editPickupScheduleAddBtn"
                                        class="inline-flex w-full sm:w-auto items-center justify-center gap-2 px-4 py-2.5 rounded-full text-sm font-semibold text-white bg-accent hover:brightness-110 transition focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card shrink-0">
                                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                    <span id="editPickupScheduleAddBtnLabel">Add Schedule</span>
                                </button>
                            </div>
                            <button type="button" id="editPickupScheduleCancelEditBtn" hidden
                                    class="mt-2 text-xs font-medium text-gray-400 hover:text-white transition-colors underline decoration-dotted underline-offset-2 focus:outline-none focus:ring-2 focus:ring-accent rounded">
                                Cancel editing
                            </button>

                            <p id="editPickupSchedulesEmptyState" class="text-xs text-gray-500 mt-3">No pickup schedules added yet.</p>
                            <div id="editPickupSchedulesList" class="flex flex-col gap-2 mt-3 empty:mt-0"></div>
                            <p id="editPickupSchedulesStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Participants will choose one of these schedules during registration.</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                        <div>
                            <label for="editEventDate" class="block text-sm font-medium text-gray-300 mb-2">Event Date <span class="text-red-400">*</span></label>
                            <input type="date" id="editEventDate" name="EventDate" required
                                   class="add-event-datetime block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm">
                        </div>
                        <div>
                            <label for="editEventTime" class="block text-sm font-medium text-gray-300 mb-2">Event Time <span class="text-red-400">*</span></label>
                            <input type="time" id="editEventTime" name="EventTime" required
                                   class="add-event-datetime block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm">
                        </div>
                    </div>

                    <div class="mb-4">
                        <p id="editEventWeatherAdvisoryLabel" class="block text-sm font-medium text-gray-300 mb-2">Weather Forecast Advisory</p>
                        <input type="hidden" id="editEventWeather" name="WeatherForecastAdvisory">
                        <div id="editEventWeatherRegion" role="group" aria-labelledby="editEventWeatherAdvisoryLabel" aria-busy="false">
                            <!-- Five mutually exclusive states (saved/waiting/loading/result/unavailable) -
                                 same "root only ever toggles hidden" safety as Add Event's four states. -->

                            <div id="editWeatherSavedPanel" class="hidden rounded-xl border border-white/10 bg-white/5 p-3 min-h-32">
                                <div class="flex flex-col gap-2 h-full">
                                    <div class="flex items-center gap-2">
                                        <span class="w-8 h-8 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                            <i class="fa-solid fa-cloud-sun text-accent text-sm"></i>
                                        </span>
                                        <p id="editWeatherSavedHeading" class="text-sm font-semibold text-white">Saved weather advisory</p>
                                    </div>
                                    <p id="editWeatherSavedText" class="text-xs text-gray-300 wrap-break-word whitespace-pre-wrap"></p>
                                    <!-- Two distinct notes, shown independently: staleContextNote applies at
                                         hydration when a stored snapshot's own trail/date no longer matches the
                                         event's current one; refreshFailedNote applies when a deliberate
                                         trail/date change's forecast refresh attempt itself failed. -->
                                    <p id="editWeatherStaleContextNote" hidden class="text-xs text-gray-400 mt-auto">
                                        <span class="flex items-center gap-1.5">
                                            <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                                            <span>This advisory was saved for a previous trail or date and may no longer be accurate.</span>
                                        </span>
                                    </p>
                                    <p id="editWeatherRefreshFailedNote" hidden class="text-xs text-amber-400 mt-auto">
                                        <span class="flex items-center gap-1.5">
                                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                                            <span>The latest refresh attempt failed. Showing the previously saved advisory.</span>
                                        </span>
                                    </p>
                                </div>
                            </div>

                            <div id="editWeatherWaitingPanel" class="hidden rounded-xl border border-white/10 bg-white/5 p-4 min-h-32">
                                <div class="flex flex-col items-center justify-center gap-2 h-full text-center">
                                    <span class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0" aria-hidden="true">
                                        <i class="fa-solid fa-cloud-sun text-gray-500 text-sm"></i>
                                    </span>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-300">Weather forecast</p>
                                        <p class="text-xs text-gray-500 mt-0.5">Select a trail and event date to view the forecast.</p>
                                    </div>
                                </div>
                            </div>

                            <div id="editWeatherLoadingPanel" role="status" aria-live="polite" aria-atomic="true"
                                 class="hidden rounded-xl border border-white/10 bg-surface-card/90 p-3 min-h-32 overflow-hidden">
                                <div class="flex flex-col items-center justify-center gap-2 h-full text-center">
                                    <span class="w-8 h-8 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                        <i class="fa-solid fa-cloud-sun text-accent text-sm"></i>
                                    </span>
                                    <div class="min-w-0 max-w-full">
                                        <p class="text-sm font-semibold text-white">Checking trail weather</p>
                                        <p id="editWeatherLoadingContext" class="text-xs text-gray-400 mt-0.5 wrap-break-word px-1"></p>
                                    </div>
                                    <div class="w-full max-w-55 grid grid-cols-3 gap-2 mt-1" aria-hidden="true">
                                        <div class="flex flex-col items-center gap-1">
                                            <i class="fa-solid fa-temperature-half text-gray-500 text-[10px]"></i>
                                            <span class="text-[9px] uppercase tracking-wide text-gray-500">Temp</span>
                                            <span class="h-1 w-7 rounded-full bg-white/10 animate-pulse motion-reduce:animate-none"></span>
                                        </div>
                                        <div class="flex flex-col items-center gap-1">
                                            <i class="fa-solid fa-droplet text-gray-500 text-[10px]"></i>
                                            <span class="text-[9px] uppercase tracking-wide text-gray-500">Rain</span>
                                            <span class="h-1 w-7 rounded-full bg-white/10 animate-pulse motion-reduce:animate-none"></span>
                                        </div>
                                        <div class="flex flex-col items-center gap-1">
                                            <i class="fa-solid fa-wind text-gray-500 text-[10px]"></i>
                                            <span class="text-[9px] uppercase tracking-wide text-gray-500">Wind</span>
                                            <span class="h-1 w-7 rounded-full bg-white/10 animate-pulse motion-reduce:animate-none"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="editWeatherResultPanel" role="status" aria-live="polite" aria-atomic="true"
                                 class="hidden rounded-xl border border-white/10 bg-white/5 p-3 min-h-32">
                                <div class="flex flex-col gap-2 h-full">
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="w-8 h-8 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                                <i id="editWeatherResultIcon" class="fa-solid fa-cloud text-accent text-sm"></i>
                                            </span>
                                            <p id="editWeatherResultCondition" class="text-sm font-semibold text-white wrap-break-word min-w-0"></p>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-3 gap-2">
                                        <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                            <i class="fa-solid fa-temperature-half text-gray-500 text-xs" aria-hidden="true"></i>
                                            <p id="editWeatherResultTemp" class="text-sm font-semibold text-white mt-1">—</p>
                                            <p class="text-[10px] text-gray-500 uppercase tracking-wide">Temperature</p>
                                        </div>
                                        <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                            <i class="fa-solid fa-droplet text-gray-500 text-xs" aria-hidden="true"></i>
                                            <p id="editWeatherResultRainfall" class="text-sm font-semibold text-white mt-1">—</p>
                                            <p class="text-[10px] text-gray-500 uppercase tracking-wide">Expected rainfall</p>
                                        </div>
                                        <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                            <i class="fa-solid fa-wind text-gray-500 text-xs" aria-hidden="true"></i>
                                            <p id="editWeatherResultWind" class="text-sm font-semibold text-white mt-1">—</p>
                                            <p id="editWeatherResultWindDescription" class="text-[10px] text-gray-500 uppercase tracking-wide wrap-break-word"></p>
                                        </div>
                                    </div>
                                    <p id="editWeatherResultUpdated" class="text-[11px] text-gray-500 text-right mt-auto"></p>
                                </div>
                            </div>

                            <div id="editWeatherUnavailablePanel" role="status" aria-live="polite" aria-atomic="true"
                                 class="hidden rounded-xl border border-white/10 bg-white/5 p-4 min-h-32">
                                <div class="flex flex-col items-center justify-center gap-2 h-full text-center">
                                    <span class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0" aria-hidden="true">
                                        <i class="fa-solid fa-cloud text-gray-500 text-sm"></i>
                                    </span>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-300">Weather forecast</p>
                                        <p id="editWeatherUnavailableMessage" class="text-xs text-gray-500 mt-0.5 wrap-break-word px-1"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Refreshes automatically when you change the trail or event date.</p>
                    </div>

                    <div class="mb-2">
                        <div class="flex items-center gap-2 mb-2">
                            <label for="editEventWeatherReminder" class="block text-sm font-medium text-gray-300">Weather Reminder</label>
                            <span id="editEventWeatherRiskBadge" class="hidden px-2.5 py-0.5 rounded-full text-xs font-semibold"></span>
                        </div>
                        <input type="hidden" id="editEventWeatherRiskLevel" name="WeatherRiskLevel">
                        <textarea id="editEventWeatherReminder" name="WeatherReminder" rows="3"
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Preparation advice will auto-fill based on the forecast..."></textarea>
                        <p class="text-xs text-gray-500 mt-2">Generated from the forecast — review and adjust the wording before publishing. Your existing wording is kept unless the risk level changes.</p>
                    </div>
                </div>

                <!-- Edit Step 3 -->
                <div id="editStep3" class="edit-step-content hidden">
                    <h3 id="editEventStep3Heading" tabindex="-1" class="text-sm font-semibold text-white mb-4 focus:outline-none">Event Details</h3>
                    <div class="mb-6">
                        <label for="editEventTitle" class="block text-sm font-medium text-gray-300 mb-2">Event Title <span class="text-red-400">*</span></label>
                        <input type="text" id="editEventTitle" name="EventTitle" required
                               class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., Mount Pulag Sunrise Hike">
                    </div>

                    <div class="mb-6">
                        @if (User.IsInRole("Admin"))
                        {
                            var editOrganizers = ViewBag.Organizers as List<TrailGuard.Models.ApplicationUser>;
                            <label for="editEventOrganizerId" class="block text-sm font-medium text-gray-300 mb-2">Select Organizer <span class="text-red-400">*</span></label>
                            @if (editOrganizers != null && editOrganizers.Count > 0)
                            {
                                <select id="editEventOrganizerId" name="OrganizerId" required data-custom-select
                                        class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm appearance-none cursor-pointer">
                                    <option value="" disabled selected>-- Select organizer --</option>
                                    @foreach (var org in editOrganizers)
                                    {
                                        <option value="@org.Id" data-display-name="@org.FirstName @org.LastName" class="bg-surface-card">@org.FirstName @org.LastName - @org.Email</option>
                                    }
                                </select>
                                <p class="text-xs text-gray-500 mt-2">The event will be reassigned to the organizer you select here.</p>
                                <p id="editEventOrganizerAmbiguousWarning" hidden class="text-xs text-amber-400 mt-2">
                                    <span class="flex items-start gap-1.5">
                                        <i class="fa-solid fa-triangle-exclamation mt-0.5" aria-hidden="true"></i>
                                        <span id="editEventOrganizerAmbiguousWarningText"></span>
                                    </span>
                                </p>
                            }
                            else
                            {
                                <select id="editEventOrganizerId" name="OrganizerId" required disabled data-custom-select
                                        class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-gray-500 focus:outline-none transition-colors text-sm appearance-none cursor-not-allowed">
                                    <option value="" selected>No organizer accounts available</option>
                                </select>
                                <p class="text-xs text-red-400 mt-2 flex items-center gap-1.5">
                                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                                    <span>No Organizer accounts exist yet. Update is unavailable until one exists.</span>
                                </p>
                            }
                        }
                        else
                        {
                            <p class="block text-sm font-medium text-gray-300 mb-2">Organizer</p>
                            <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 flex items-start gap-3">
                                <i class="fa-solid fa-circle-info text-accent mt-0.5 shrink-0" aria-hidden="true"></i>
                                <p class="text-sm text-gray-300">This event remains assigned to its organizer account.</p>
                            </div>
                        }
                    </div>

                    <div class="mb-6">
                        <label for="editEventStatus" class="block text-sm font-medium text-gray-300 mb-2">Status</label>
                        <select id="editEventStatus" name="Status" data-custom-select
                                class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm appearance-none cursor-pointer">
                            <option value="Upcoming" class="bg-surface-card">Upcoming</option>
                            <option value="Cancelled" class="bg-surface-card">Cancelled</option>
                            <option value="Postponed" class="bg-surface-card">Postponed</option>
                            <option value="Completed" class="bg-surface-card">Completed</option>
                        </select>
                    </div>

                    <div class="mb-6">
                        <label for="editEventDescription" class="block text-sm font-medium text-gray-300 mb-2">Event Description <span class="text-red-400">*</span></label>
                        <textarea id="editEventDescription" name="Description" required rows="4"
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Provide a detailed description about the event..."></textarea>
                    </div>

                    <div class="mb-6">
                        <label for="editEventPaymentDetails" class="block text-sm font-medium text-gray-300 mb-2">Payment Details <span class="text-gray-500 font-normal">(Optional)</span></label>
                        <textarea id="editEventPaymentDetails" name="PaymentDetails" rows="4"
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Registration fee, GCash number, bank details..."></textarea>
                        <p class="text-xs text-gray-500 mt-2">Include registration fee and payment instructions here.</p>
                    </div>

                    <div class="mb-2">
                        <label for="editEventAnnouncements" class="block text-sm font-medium text-gray-300 mb-2">Notes &amp; Reminders <span class="text-gray-500 font-normal">(Optional)</span></label>
                        <textarea id="editEventAnnouncements" name="NotesAndReminders" rows="3"
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Important reminders and things participants should know..."></textarea>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-white/10 shrink-0">
                <button type="button" id="editPrevBtn" class="hidden px-5 py-2.5 rounded-full text-sm font-semibold text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back
                </button>
                <div class="flex items-center gap-3 ml-auto">
                    <button type="button" onclick="closeEditEventModal()" class="px-5 py-2.5 rounded-full text-sm font-semibold text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
                        Cancel
                    </button>
                    <button type="button" id="editNextBtn" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base">
                        Next <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                    <button type="submit" id="editSubmitBtn" class="hidden items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base disabled:opacity-60 disabled:pointer-events-none">
                        <i class="fa-solid fa-check" aria-hidden="true" id="editSubmitBtnIcon"></i>
                        <span id="editSubmitBtnLabel">Update Event</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
}

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .primary-btn {
        background: linear-gradient(to right, #f97316, #9333ea);
    }
    .primary-btn:hover {
        opacity: 0.9;
        transform: scale(1.02);
    }
    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin {
        animation: spin 1s linear infinite;
    }
</style>

<script>
    let currentStep = 1;
    const totalSteps = 3;

    // In-memory Pickup Schedules state - persists across Back/Next (nothing
    // clears it on step change) and is only ever reset by
    // resetAddEventPickupSchedules() (closeAddEventModal). addEventPickupEditIndex
    // is the array index currently loaded into the inputs for editing, or null
    // when the Add/Update button would append a new schedule.
    let addEventPickupSchedules = [];
    let addEventPickupEditIndex = null;

    // The structured result of the most recent SUCCESSFUL forecast for the
    // currently-selected trail/date, in the shape EventCreateModel.WeatherSnapshot
    // expects (PascalCase, matching the rest of the Add Event payload) - or
    // null when no successful forecast currently exists for the current
    // trail/date. Cleared at the start of every new fetch (see
    // fetchWeatherForecast) so a stale result from a since-changed trail/date
    // can never be submitted as if it were current; set only inside
    // renderAddEventWeatherResult, i.e. only on an actual success.
    let addEventWeatherSnapshot = null;

    // Pure/parameterized - reused as-is from Edit Event's own equivalent
    // success path (see renderEditEventWeatherResult), since neither trailId/
    // eventDate/data reference any Add- or Edit-specific DOM id or state.
    function buildWeatherSnapshotPayload(trailId, eventDate, data) {
        return {
            Version: 1,
            TrailId: parseInt(trailId, 10),
            ForecastDate: eventDate,
            Condition: data.condition || null,
            WeatherCode: (typeof data.weatherCode === 'number') ? data.weatherCode : null,
            TemperatureMinC: (typeof data.temperatureMinC === 'number') ? data.temperatureMinC : null,
            TemperatureMaxC: (typeof data.temperatureMaxC === 'number') ? data.temperatureMaxC : null,
            ExpectedRainfallMm: (typeof data.expectedRainfallMm === 'number') ? data.expectedRainfallMm : null,
            WindSpeedKmh: (typeof data.windSpeedKmh === 'number') ? data.windSpeedKmh : null,
            WindDescription: data.windDescription || null,
            RiskLevel: data.riskLevel || null,
            UpdatedAt: data.updatedAt || null
        };
    }

    // Trail/Difficulty/Status/Sort are real <select name="..."> fields inside
    // #filterForm and submit a normal GET on change (see the custom-select-enhanced
    // markup above) - EventController.Index applies them server-side, including the
    // status grouping and Soonest/Latest ordering. Only free-text search stays
    // client-side here, mirroring Trail Management's finalized search behavior:
    // realtime, debounced, no reload, and it scans every card already loaded for the
    // current Trail/Difficulty/Status selection (never a stale, previously-searched
    // subset), with the URL kept in sync via replaceState so it never navigates.
    (function initEventSearch() {
        const searchInput = document.getElementById('searchInput');
        const eventsContainer = document.getElementById('eventsContainer');
        const announcerEl = document.getElementById('resultCountAnnouncer');
        const noMatchEl = document.getElementById('noSearchResults');
        if (!searchInput || !eventsContainer) return;

        const totalEventCount = @totalEventCount;
        let debounceTimer = null;

        function getSections() {
            return Array.from(eventsContainer.querySelectorAll('.status-section'));
        }

        function buildResultText(term, visibleCount) {
            if (term) {
                return 'Showing ' + visibleCount + ' of ' + totalEventCount +
                    ' event' + (totalEventCount === 1 ? '' : 's') + ' for “' + term + '”';
            }
            return 'Showing ' + totalEventCount + ' event' + (totalEventCount === 1 ? '' : 's');
        }

        // Runs on every keystroke - hides/shows cards, collapses a status section
        // to nothing if none of its cards match, and updates the visible count.
        // The URL and the screen-reader announcement are handled separately
        // (debounced) by the caller so this stays cheap.
        function applySearchFilter() {
            const rawTerm = searchInput.value;
            const term = rawTerm.trim();
            const normalizedTerm = term.toLowerCase();
            let visibleCount = 0;

            getSections().forEach(function (section) {
                const cards = Array.from(section.querySelectorAll('.event-card'));
                let visibleInSection = 0;

                cards.forEach(function (card) {
                    const haystack = (card.getAttribute('data-search') || '').toLowerCase();
                    const matches = !normalizedTerm || haystack.includes(normalizedTerm);
                    card.hidden = !matches;
                    if (matches) { visibleInSection++; visibleCount++; }
                });

                const countEl = section.querySelector('.status-count');
                if (countEl) countEl.textContent = visibleInSection;
                section.hidden = visibleInSection === 0;
            });

            const text = buildResultText(term, visibleCount);
            if (noMatchEl) noMatchEl.hidden = !(totalEventCount > 0 && visibleCount === 0);

            return { term: term, text: text };
        }

        function updateUrlSearchParam(term) {
            const url = new URL(window.location.href);
            if (term) {
                url.searchParams.set('searchString', term);
            } else {
                url.searchParams.delete('searchString');
            }
            history.replaceState(history.state, '', url.pathname + url.search + url.hash);
        }

        function handleSearchInput() {
            const result = applySearchFilter();
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function () {
                updateUrlSearchParam(result.term);
                if (announcerEl) announcerEl.textContent = result.text;
            }, 400);
        }

        function syncSearchFromUrl() {
            const url = new URL(window.location.href);
            searchInput.value = url.searchParams.get('searchString') || '';
            const result = applySearchFilter();
            if (announcerEl) announcerEl.textContent = result.text;
        }

        searchInput.addEventListener('input', handleSearchInput);
        window.addEventListener('popstate', syncSearchFromUrl);

        // Restores the filtered view immediately on load (including after a
        // Trail/Difficulty/Status/Sort navigation that carried the search text
        // along) and sets the initial announcer text without waiting on the debounce.
        const initialResult = applySearchFilter();
        if (announcerEl) announcerEl.textContent = initialResult.text;
    })();

    // Same approved fallback as the Trail Management card (Views/Trail/Index.cshtml)
    // for a missing/failed thumbnail - kept as its own copy here since this view has
    // no shared script include with that page (see AGENTS.md on not touching
    // unrelated pages). A missing ThumbnailUrl and a failed image request render
    // identically; the fallback carries no group-hover scale class, so it never zooms.
    function handleEventImageError(img) {
        img.onerror = null;
        const fallback = document.createElement('div');
        fallback.className = 'w-full h-full flex items-center justify-center';
        const icon = document.createElement('i');
        icon.className = 'fa-solid fa-image text-4xl text-slate-700';
        icon.setAttribute('aria-hidden', 'true');
        fallback.appendChild(icon);
        img.replaceWith(fallback);
    }

    // The Admin-only organizer <select> only exists in the DOM when the
    // logged-in user is an Admin (see the role-dependent Step 3 markup) -
    // an Organizer never has one, and the server always assigns the
    // authenticated Organizer regardless of anything sent from the client.
    // Whether it's disabled is fixed at page load (ViewBag.Organizers is
    // resolved server-side), so this is read once rather than re-queried.
    // Declared here (module scope) but assigned inside the deferred init
    // below - see the comment on that block for why the assignment can't
    // happen at this point in the script.
    let addEventOrganizerSelect = null;
    let addEventOrganizerUnavailable = false;

    // custom-select.js gives the enhanced Trail select's visible trigger
    // button the id "<select id>-trigger" (the native select itself is
    // moved off-screen via sr-only/tabindex="-1" once enhanced) - focusing
    // that trigger, not the native select, is what actually puts visible
    // keyboard focus somewhere a sighted user can see.
    function focusAddEventField(nativeFieldId) {
        const trigger = document.getElementById(nativeFieldId + '-trigger');
        const target = trigger || document.getElementById(nativeFieldId);
        if (target && typeof target.focus === 'function') target.focus();
    }

    // Deterministic "HH:mm" -> "h:mm AM/PM" formatter - splits the string by
    // hand rather than routing it through `new Date(...)`, which needs a full
    // date to parse reliably and would be one more place a time-only value
    // could be misread.
    function formatAddEventPickupTime(time) {
        if (!time) return '';
        const parts = time.split(':');
        const hours24 = parseInt(parts[0], 10);
        const minutes = parseInt(parts[1], 10);
        if (!Number.isInteger(hours24) || !Number.isInteger(minutes)) return '';

        const period = hours24 >= 12 ? 'PM' : 'AM';
        let hours12 = hours24 % 12;
        if (hours12 === 0) hours12 = 12;
        return hours12 + ':' + String(minutes).padStart(2, '0') + ' ' + period;
    }

    function announceAddEventPickupSchedules(message) {
        const statusEl = document.getElementById('pickupSchedulesStatus');
        if (statusEl) statusEl.textContent = message;
    }

    // Builds one schedule row with document.createElement/textContent only -
    // organizer-entered location text never passes through innerHTML.
    function buildAddEventPickupRow(schedule, index) {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-surface-card px-4 py-2.5';
        row.setAttribute('data-schedule-index', String(index));

        const textWrap = document.createElement('div');
        textWrap.className = 'min-w-0';

        const locationEl = document.createElement('p');
        locationEl.className = 'text-sm font-medium text-white wrap-break-word';
        locationEl.textContent = schedule.location;

        const timeEl = document.createElement('p');
        timeEl.className = 'text-xs text-gray-400';
        timeEl.textContent = formatAddEventPickupTime(schedule.time);

        textWrap.appendChild(locationEl);
        textWrap.appendChild(timeEl);

        const formattedTime = formatAddEventPickupTime(schedule.time);

        const actions = document.createElement('div');
        actions.className = 'flex items-center gap-1 shrink-0';

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'w-8 h-8 rounded-full flex items-center justify-center text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent';
        editBtn.setAttribute('data-action', 'edit');
        editBtn.setAttribute('aria-label', 'Edit pickup schedule: ' + schedule.location + ' at ' + formattedTime);
        const editIcon = document.createElement('i');
        editIcon.className = 'fa-solid fa-pen text-xs';
        editIcon.setAttribute('aria-hidden', 'true');
        editBtn.appendChild(editIcon);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'w-8 h-8 rounded-full flex items-center justify-center text-red-400 hover:text-white bg-red-500/20 hover:bg-red-500 border border-red-500/30 hover:border-red-500 transition-colors focus:outline-none focus:ring-2 focus:ring-accent';
        removeBtn.setAttribute('data-action', 'remove');
        removeBtn.setAttribute('aria-label', 'Remove pickup schedule: ' + schedule.location + ' at ' + formattedTime);
        const removeIcon = document.createElement('i');
        removeIcon.className = 'fa-solid fa-trash text-xs';
        removeIcon.setAttribute('aria-hidden', 'true');
        removeBtn.appendChild(removeIcon);

        actions.appendChild(editBtn);
        actions.appendChild(removeBtn);

        row.appendChild(textWrap);
        row.appendChild(actions);
        return row;
    }

    // Rebuilds the whole list from addEventPickupSchedules every time, same
    // discipline as updateStepUI's step indicators - the DOM is always a pure
    // reflection of the array, never patched piecemeal, so add/edit/remove/
    // reset can't leave a stale row behind.
    function renderAddEventPickupSchedules() {
        const list = document.getElementById('pickupSchedulesList');
        const emptyState = document.getElementById('pickupSchedulesEmptyState');
        if (!list) return;

        list.replaceChildren();
        if (emptyState) emptyState.classList.toggle('hidden', addEventPickupSchedules.length > 0);

        addEventPickupSchedules.forEach(function (schedule, index) {
            list.appendChild(buildAddEventPickupRow(schedule, index));
        });
    }

    function enterAddEventPickupEditMode(index) {
        const schedule = addEventPickupSchedules[index];
        if (!schedule) return;

        addEventPickupEditIndex = index;

        const locationInput = document.getElementById('pickupScheduleLocationInput');
        const timeInput = document.getElementById('pickupScheduleTimeInput');
        if (locationInput) locationInput.value = schedule.location;
        if (timeInput) timeInput.value = schedule.time;

        const addBtnLabel = document.getElementById('pickupScheduleAddBtnLabel');
        if (addBtnLabel) addBtnLabel.textContent = 'Update Schedule';

        document.getElementById('pickupScheduleCancelEditBtn')?.removeAttribute('hidden');

        locationInput?.focus();
    }

    // preserveInputs is used by the successful-update path in
    // commitAddEventPickupCandidate, which clears the inputs itself right
    // after (the just-saved row shouldn't flash back into the inputs first).
    // Every other caller wants the inputs actually cleared here.
    function exitAddEventPickupEditMode(preserveInputs) {
        addEventPickupEditIndex = null;

        const addBtnLabel = document.getElementById('pickupScheduleAddBtnLabel');
        if (addBtnLabel) addBtnLabel.textContent = 'Add Schedule';

        document.getElementById('pickupScheduleCancelEditBtn')?.setAttribute('hidden', '');

        if (!preserveInputs) {
            const locationInput = document.getElementById('pickupScheduleLocationInput');
            const timeInput = document.getElementById('pickupScheduleTimeInput');
            if (locationInput) locationInput.value = '';
            if (timeInput) timeInput.value = '';
        }
    }

    // Shared by the Add/Update button and the Step 2 -> Next auto-add path,
    // so the two can't enforce slightly different rules for the same
    // candidate schedule. Validates, checks for an exact duplicate (case-
    // insensitive location, exact time - the row currently being edited is
    // excluded from its own duplicate check), then adds or updates
    // addEventPickupSchedules and re-renders. Server-side
    // PickupScheduleHelper.ValidateAndFormat re-checks all of this
    // independently - this is for immediate feedback only.
    function commitAddEventPickupCandidate(rawLocation, time) {
        const location = (rawLocation || '').trim();

        if (location.length === 0) {
            return { success: false, error: 'Please enter a pickup location.', focus: 'location' };
        }
        if (/[\r\n]/.test(location) || location.indexOf('—') !== -1) {
            return { success: false, error: 'Pickup location can’t contain a line break or “—”.', focus: 'location' };
        }
        if (!time) {
            return { success: false, error: 'Please enter a pickup time.', focus: 'time' };
        }

        const editIndex = addEventPickupEditIndex;
        const isDuplicate = addEventPickupSchedules.some(function (schedule, index) {
            if (index === editIndex) return false;
            return schedule.location.toLowerCase() === location.toLowerCase() && schedule.time === time;
        });
        if (isDuplicate) {
            return { success: false, error: 'That pickup location and time is already on the list.', focus: 'location' };
        }

        const formattedTime = formatAddEventPickupTime(time);

        if (editIndex !== null && editIndex >= 0 && editIndex < addEventPickupSchedules.length) {
            addEventPickupSchedules[editIndex] = { location: location, time: time };
            exitAddEventPickupEditMode(true);
            announceAddEventPickupSchedules('Updated pickup schedule: ' + location + ' at ' + formattedTime + '.');
        } else {
            addEventPickupSchedules.push({ location: location, time: time });
            announceAddEventPickupSchedules('Added pickup schedule: ' + location + ' at ' + formattedTime + '.');
        }

        renderAddEventPickupSchedules();
        return { success: true };
    }

    function handleAddEventPickupAddClick() {
        const locationInput = document.getElementById('pickupScheduleLocationInput');
        const timeInput = document.getElementById('pickupScheduleTimeInput');

        const result = commitAddEventPickupCandidate(locationInput?.value, timeInput?.value);
        if (!result.success) {
            showToast(result.error, 'error');
            (result.focus === 'time' ? timeInput : locationInput)?.focus();
            return;
        }

        if (locationInput) locationInput.value = '';
        if (timeInput) timeInput.value = '';
        locationInput?.focus();
    }

    // Enter inside either pending-schedule input would otherwise trigger the
    // form's native implicit submission (there IS a type="submit" button in
    // this form, just hidden on steps 1-2) - intercepted here so it adds/
    // updates the pending schedule instead of attempting to submit the whole
    // wizard early.
    function handleAddEventPickupInputKeydown(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            handleAddEventPickupAddClick();
        }
    }

    function handleAddEventPickupCancelEditClick() {
        exitAddEventPickupEditMode();
        document.getElementById('pickupScheduleLocationInput')?.focus();
    }

    function removeAddEventPickupSchedule(index) {
        const removed = addEventPickupSchedules[index];
        if (!removed) return;

        addEventPickupSchedules.splice(index, 1);

        if (addEventPickupEditIndex !== null) {
            if (addEventPickupEditIndex === index) {
                exitAddEventPickupEditMode();
            } else if (addEventPickupEditIndex > index) {
                addEventPickupEditIndex -= 1;
            }
        }

        renderAddEventPickupSchedules();
        announceAddEventPickupSchedules('Removed pickup schedule: ' + removed.location + ' at ' + formatAddEventPickupTime(removed.time) + '.');
    }

    // One delegated listener on the list container (bound once, in the
    // deferred init block) instead of a listener per row - rows are rebuilt
    // on every render, so per-row listeners would need constant rebinding.
    function handleAddEventPickupListClick(event) {
        const actionBtn = event.target.closest('[data-action]');
        if (!actionBtn) return;

        const row = actionBtn.closest('[data-schedule-index]');
        if (!row) return;

        const index = parseInt(row.getAttribute('data-schedule-index'), 10);
        if (!Number.isInteger(index) || index < 0 || index >= addEventPickupSchedules.length) return;

        const action = actionBtn.getAttribute('data-action');
        if (action === 'edit') {
            enterAddEventPickupEditMode(index);
        } else if (action === 'remove') {
            removeAddEventPickupSchedule(index);
        }
    }

    // Implements the Step 2 -> Next contract: complete pending input auto-
    // commits, an incomplete pending pair blocks with a specific message and
    // moves focus to the actual problem field, and empty pending input is
    // only a problem when no schedule exists yet at all.
    function resolveAddEventPickupSchedulesForNext() {
        const locationInput = document.getElementById('pickupScheduleLocationInput');
        const timeInput = document.getElementById('pickupScheduleTimeInput');
        const pendingLocation = (locationInput?.value || '').trim();
        const pendingTime = timeInput?.value || '';

        if (!pendingLocation && !pendingTime) {
            if (addEventPickupSchedules.length === 0) {
                showToast('Please add at least one pickup schedule.', 'error');
                locationInput?.focus();
                return false;
            }
            return true;
        }

        if (pendingLocation && !pendingTime) {
            showToast('Please enter a pickup time for "' + pendingLocation + '".', 'error');
            timeInput?.focus();
            return false;
        }

        if (!pendingLocation && pendingTime) {
            showToast('Please enter a pickup location.', 'error');
            locationInput?.focus();
            return false;
        }

        const result = commitAddEventPickupCandidate(pendingLocation, pendingTime);
        if (!result.success) {
            showToast(result.error, 'error');
            (result.focus === 'time' ? timeInput : locationInput)?.focus();
            return false;
        }

        if (locationInput) locationInput.value = '';
        if (timeInput) timeInput.value = '';
        return true;
    }

    // Called from closeAddEventModal() - clears schedules, pending inputs,
    // edit state, and the rendered list/empty-state together so a reopened
    // modal always starts from zero schedules.
    function resetAddEventPickupSchedules() {
        addEventPickupSchedules = [];
        exitAddEventPickupEditMode();
        renderAddEventPickupSchedules();
        announceAddEventPickupSchedules('');
    }

    function validateStep(step) {
        if (step === 1) {
            const trailId = document.getElementById('eventTrailId')?.value;
            const duration = parseFloat(document.getElementById('eventDuration')?.value);
            const capacity = parseInt(document.getElementById('eventCapacity')?.value, 10);

            if (!trailId) {
                showToast('Please select a trail', 'error');
                focusAddEventField('eventTrailId');
                return false;
            }
            if (!Number.isFinite(duration) || duration <= 0) {
                showToast('Please enter estimated duration', 'error');
                document.getElementById('eventDuration')?.focus();
                return false;
            }
            if (!Number.isInteger(capacity) || capacity <= 0) {
                showToast('Please enter valid capacity', 'error');
                document.getElementById('eventCapacity')?.focus();
                return false;
            }
            return true;
        }

        if (step === 2) {
            // Auto-adds/updates a complete pending schedule, blocks with a
            // specific message and moves focus for an incomplete pending pair,
            // and only objects to empty pending input when no schedule exists
            // yet at all - see the function's own comment for the full contract.
            if (!resolveAddEventPickupSchedulesForNext()) {
                return false;
            }

            const eventDate = document.getElementById('eventDate')?.value;
            const eventTime = document.getElementById('eventTime')?.value;

            if (!eventDate) {
                showToast('Please select event date', 'error');
                return false;
            }
            if (!eventTime) {
                showToast('Please select event time', 'error');
                return false;
            }
            return true;
        }

        if (step === 3) {
            const title = document.getElementById('eventTitle')?.value;
            const description = document.getElementById('eventDescription')?.value;

            if (!title) {
                showToast('Please enter event title', 'error');
                return false;
            }

            // Only require (and validate) an organizer selection when the
            // Admin dropdown actually exists - an Organizer's Step 3 has no
            // such control at all, by design.
            if (addEventOrganizerSelect) {
                if (addEventOrganizerUnavailable) {
                    showToast('No organizer accounts are available. Create one before adding an event.', 'error');
                    return false;
                }
                const organizerId = (addEventOrganizerSelect.value || '').trim();
                if (!organizerId) {
                    showToast('Please select an organizer', 'error');
                    return false;
                }
            }

            if (!description) {
                showToast('Please enter event description', 'error');
                return false;
            }
            return true;
        }

        return true;
    }

    // A button that toggles between hidden and an inline-flex layout must
    // never carry both classes at once: Tailwind's compiled .inline-flex
    // rule happens to be ordered after .hidden in output.css, so with both
    // classes present the browser's cascade shows the element regardless of
    // 'hidden' being set (this is what let Create Event show through on
    // Step 1). Always add/remove the pair together, never just one.
    function setAddEventFooterButtonVisible(button, visible) {
        if (!button) return;
        if (visible) {
            button.classList.remove('hidden');
            button.classList.add('inline-flex');
        } else {
            button.classList.add('hidden');
            button.classList.remove('inline-flex');
        }
    }

    // Rebuilds every step indicator's full class list from scratch each call
    // (never classList.add/remove deltas) so repeated Back/Next navigation
    // can't accumulate stale classes - each state (upcoming/active/completed)
    // is fully self-describing every time this runs. The circle always shows
    // only its step number - completed/active/upcoming are communicated
    // through fill/border/ring/connector/label-weight and aria-current, not
    // an icon swap. A screen-reader-only status string on the item still
    // announces "completed" without any visible checkmark.
    function updateStepUI() {
        for (let i = 1; i <= totalSteps; i++) {
            const content = document.getElementById(`step${i}`);
            const item = document.querySelector(`[data-step-item="${i}"]`);
            const circle = document.querySelector(`[data-step-circle="${i}"]`);
            const label = item?.querySelector('[data-step-label]');
            const status = item?.querySelector('[data-step-status]');
            const line = document.querySelector(`[data-step-line="${i}"]`);

            if (content) content.classList.toggle('hidden', i !== currentStep);

            if (item) {
                if (i === currentStep) {
                    item.setAttribute('aria-current', 'step');
                } else {
                    item.removeAttribute('aria-current');
                }
            }

            if (circle) {
                if (i < currentStep) {
                    circle.className = 'w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors bg-accent text-white';
                } else if (i === currentStep) {
                    circle.className = 'w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors bg-accent text-white ring-2 ring-accent ring-offset-2 ring-offset-surface-card';
                } else {
                    circle.className = 'w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors border-2 border-gray-700 text-gray-400';
                }
            }

            if (label) {
                label.className = i === currentStep
                    ? 'text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors text-white font-semibold'
                    : 'text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors text-gray-400';
            }

            if (status) status.textContent = i < currentStep ? 'Completed' : '';

            if (line) {
                line.className = i < currentStep
                    ? 'flex-1 h-0.5 mt-4 mx-1 sm:mx-2 transition-colors bg-accent'
                    : 'flex-1 h-0.5 mt-4 mx-1 sm:mx-2 transition-colors bg-gray-700';
            }
        }

        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const submitBtn = document.getElementById('submitBtn');

        prevBtn?.classList.toggle('hidden', currentStep === 1);
        setAddEventFooterButtonVisible(nextBtn, currentStep !== totalSteps);
        setAddEventFooterButtonVisible(submitBtn, currentStep === totalSteps);
    }

    // Moving between steps always scrolls the modal body back to the top and
    // (unless explicitly skipped, e.g. the initial open - AddEventModal.open()
    // already places focus on the first control) moves focus to the newly
    // shown step's own heading, so keyboard/screen-reader users get a clear
    // signal a new step just appeared without yanking focus somewhere
    // surprising for mouse users.
    function goToAddEventStep(step, skipFocus) {
        currentStep = step;
        updateStepUI();

        const scrollContainer = document.querySelector('#addEventModal .overflow-y-auto');
        if (scrollContainer) scrollContainer.scrollTop = 0;

        if (!skipFocus) {
            const heading = document.getElementById(`addEventStep${step}Heading`);
            if (heading && typeof heading.focus === 'function') heading.focus();
        }
    }

    // Declared here but bound later (see the deferred init block near the
    // end of the Add Event script) - #nextBtn/#prevBtn now live inside
    // @@section Modals, which the layout renders after this page's own body
    // content, so binding at this point in the script (synchronous,
    // top-level execution) would run before those elements exist in the DOM
    // and silently attach nothing.
    function handleAddEventNextClick() {
        if (validateStep(currentStep) && currentStep < totalSteps) {
            goToAddEventStep(currentStep + 1);
        }
    }

    function handleAddEventPrevClick() {
        if (currentStep > 1) {
            goToAddEventStep(currentStep - 1);
        }
    }

    function getRiskBadgeClasses(riskLevel) {
        switch (riskLevel) {
            case 'Low': return 'bg-green-500/20 text-green-400';
            case 'Moderate': return 'bg-amber-500/20 text-amber-400';
            case 'Moderate to High': return 'bg-orange-500/20 text-orange-400';
            case 'High (Thunderstorm)': return 'bg-red-500/20 text-red-400';
            default: return 'bg-gray-500/20 text-gray-400';
        }
    }

    function applyWeatherRiskFields(data, riskLevelInput, riskBadge, reminderTextarea) {
        if (riskLevelInput) riskLevelInput.value = data.riskLevel || '';

        if (riskBadge) {
            if (data.riskLevel) {
                riskBadge.textContent = data.riskLevel;
                riskBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-semibold ' + getRiskBadgeClasses(data.riskLevel);
            } else {
                riskBadge.classList.add('hidden');
            }
        }

        if (reminderTextarea) reminderTextarea.value = data.suggestedReminder || '';
    }

    // Builds the "<trail> • <date>" context line shown under "Checking trail
    // weather". Reads the selected native #eventTrailId option's own text
    // (never innerHTML) rather than looking the trail up separately, so it
    // can't disagree with what's actually selected. The date is parsed from
    // its yyyy-MM-dd numeric parts and built as a local Date - `new
    // Date("yyyy-MM-dd")` parses as UTC midnight, which can display a day
    // off depending on the browser's time zone.
    function formatAddEventWeatherContext(trailSelect, dateValue) {
        const parts = [];

        const selectedOption = trailSelect && trailSelect.options ? trailSelect.options[trailSelect.selectedIndex] : null;
        const trailText = selectedOption && selectedOption.value ? selectedOption.text.trim() : '';
        if (trailText) parts.push(trailText);

        if (dateValue) {
            const segments = dateValue.split('-');
            const year = parseInt(segments[0], 10);
            const month = parseInt(segments[1], 10);
            const day = parseInt(segments[2], 10);

            if (Number.isInteger(year) && Number.isInteger(month) && Number.isInteger(day)) {
                const localDate = new Date(year, month - 1, day);
                try {
                    parts.push(new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(localDate));
                } catch (error) {
                    console.error('Error formatting weather context date:', error);
                }
            }
        }

        return parts.length > 0 ? parts.join(' • ') : 'the selected trail and date';
    }

    // Fixed allowlist mapping a trusted numeric Open-Meteo weather code to one
    // of this app's own bundled Font Awesome classes - never string-built from
    // server text, so there's no way a response value could name an arbitrary
    // class. Categories mirror WeatherService.GetWeatherDescription's code
    // groupings (kept in sync deliberately - see that method if either needs
    // to change) with one further icon-only split: code 1 ("mainly clear")
    // reads as sunnier than 2/3 ("partly cloudy"/"overcast") even though the
    // C# text bucket for all three is the same "Partly cloudy".
    function getAddEventWeatherIconClass(weatherCode) {
        switch (weatherCode) {
            case 0: return 'fa-sun';
            case 1: return 'fa-cloud-sun';
            case 2:
            case 3: return 'fa-cloud';
            case 45:
            case 48: return 'fa-smog';
            case 51: case 53: case 55:
            case 56: case 57:
            case 61: case 63: case 65:
            case 66: case 67:
                return 'fa-cloud-rain';
            case 80: case 81: case 82:
                return 'fa-cloud-showers-heavy';
            case 71: case 73: case 75:
                return 'fa-snowflake';
            case 95: case 96: case 99:
                return 'fa-cloud-bolt';
            default:
                return 'fa-cloud';
        }
    }

    // Rounds to one decimal place and lets JS's own Number-to-string drop a
    // trailing zero (10 -> "10", 10.5 -> "10.5") - mirrors
    // WeatherService.FormatRainfall's "0.#" behavior for the same value shown
    // server-side inside ForecastDetails, just applied client-side to the
    // separate structured expectedRainfallMm field the result card reads.
    function formatAddEventRainfall(rainfallMm) {
        return String(Math.round(rainfallMm * 10) / 10);
    }

    // updatedAt arrives as a full ISO 8601 DateTimeOffset string (unlike the
    // date-only yyyy-MM-dd value formatAddEventWeatherContext parses by hand
    // above), so `new Date(...)` is safe here - no UTC-midnight ambiguity,
    // since the string already carries a time and offset. Renders in the
    // viewer's own local time via Intl.DateTimeFormat with no explicit time
    // zone. Returns '' (never "Invalid Date") for anything missing or
    // unparseable - the caller can just leave the footer line blank.
    function formatAddEventWeatherUpdatedAt(updatedAtValue) {
        if (!updatedAtValue) return '';
        const parsed = new Date(updatedAtValue);
        if (Number.isNaN(parsed.getTime())) return '';
        try {
            return 'Updated ' + new Intl.DateTimeFormat(undefined, {
                month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit'
            }).format(parsed);
        } catch (error) {
            console.error('Error formatting weather updated timestamp:', error);
            return '';
        }
    }

    // The four forecast states are mutually exclusive panels that each only
    // ever toggle their own 'hidden' class (see the markup comment) - so
    // showing one is just "hide the other three, unhide this one." Repeated
    // date changes and modal open/close cycles can never leave two states
    // visible at once, because every call starts from "all four hidden."
    const ADD_EVENT_WEATHER_PANEL_ID_BY_STATE = {
        waiting: 'weatherWaitingPanel',
        loading: 'weatherLoadingPanel',
        result: 'weatherResultPanel',
        unavailable: 'weatherUnavailablePanel'
    };

    function setAddEventWeatherState(state) {
        Object.keys(ADD_EVENT_WEATHER_PANEL_ID_BY_STATE).forEach(function (key) {
            const panel = document.getElementById(ADD_EVENT_WEATHER_PANEL_ID_BY_STATE[key]);
            if (panel) panel.classList.add('hidden');
        });

        const targetId = ADD_EVENT_WEATHER_PANEL_ID_BY_STATE[state];
        const target = targetId ? document.getElementById(targetId) : null;
        if (target) target.classList.remove('hidden');

        const weatherRegion = document.getElementById('eventWeatherRegion');
        if (weatherRegion) weatherRegion.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    }

    // Populates the structured result card and shows it. data.forecastDetails
    // (the legacy multiline string) still goes straight into the hidden
    // #eventWeather backing field for the Add Event payload - never parsed,
    // never displayed - while every visible metric below reads only the
    // dedicated structured response fields.
    function renderAddEventWeatherResult(data, riskLevelInput, riskBadge, reminderTextarea, trailId, eventDate) {
        const weatherInput = document.getElementById('eventWeather');
        if (weatherInput) weatherInput.value = data.forecastDetails || '';

        // The only place addEventWeatherSnapshot is ever set - i.e. only on
        // an actual successful, current-trail/date result. Submitted as-is
        // during Add Event's own submit handler; the server independently
        // re-validates its TrailId/ForecastDate against the submitted
        // event's before persisting it either way.
        addEventWeatherSnapshot = buildWeatherSnapshotPayload(trailId, eventDate, data);

        const iconEl = document.getElementById('weatherResultIcon');
        if (iconEl) iconEl.className = 'fa-solid ' + getAddEventWeatherIconClass(data.weatherCode) + ' text-accent text-sm';
        if (iconEl) iconEl.setAttribute('aria-hidden', 'true');

        const conditionEl = document.getElementById('weatherResultCondition');
        if (conditionEl) conditionEl.textContent = data.condition || 'Forecast available';

        const tempEl = document.getElementById('weatherResultTemp');
        if (tempEl) {
            tempEl.textContent = (typeof data.temperatureMinC === 'number' && typeof data.temperatureMaxC === 'number')
                ? Math.round(data.temperatureMinC) + '–' + Math.round(data.temperatureMaxC) + '°C'
                : '—';
        }

        const rainfallEl = document.getElementById('weatherResultRainfall');
        if (rainfallEl) {
            rainfallEl.textContent = typeof data.expectedRainfallMm === 'number'
                ? formatAddEventRainfall(data.expectedRainfallMm) + ' mm'
                : '—';
        }

        const windEl = document.getElementById('weatherResultWind');
        if (windEl) {
            windEl.textContent = (typeof data.windSpeedKmh === 'number' && data.windSpeedKmh > 0)
                ? Math.round(data.windSpeedKmh) + ' km/h'
                : '—';
        }

        const windDescriptionEl = document.getElementById('weatherResultWindDescription');
        if (windDescriptionEl) windDescriptionEl.textContent = data.windDescription || '';

        const updatedEl = document.getElementById('weatherResultUpdated');
        if (updatedEl) updatedEl.textContent = formatAddEventWeatherUpdatedAt(data.updatedAt);

        applyWeatherRiskFields(data, riskLevelInput, riskBadge, reminderTextarea);

        setAddEventWeatherState('result');
    }

    // Mirrors the pre-existing unavailable handling exactly (same backing-
    // field text, same risk-badge/reminder clearing) - only the visible
    // presentation is new.
    function renderAddEventWeatherUnavailable(message, riskLevelInput, riskBadge, reminderTextarea) {
        const weatherInput = document.getElementById('eventWeather');
        if (weatherInput) weatherInput.value = message;

        const messageEl = document.getElementById('weatherUnavailableMessage');
        if (messageEl) messageEl.textContent = message;

        if (riskLevelInput) riskLevelInput.value = '';
        if (riskBadge) riskBadge.classList.add('hidden');
        if (reminderTextarea) reminderTextarea.value = '';

        setAddEventWeatherState('unavailable');
    }

    // Returns every forecast display element to its start-of-wizard state:
    // empty backing value, waiting panel shown, no stale condition/metrics/
    // risk badge/timestamp left over from a previous trail or date. Called
    // from closeAddEventModal() alongside the existing trail-preview reset.
    function resetAddEventWeatherDisplay() {
        addEventWeatherSnapshot = null;

        const weatherInput = document.getElementById('eventWeather');
        if (weatherInput) weatherInput.value = '';

        const riskLevelInput = document.getElementById('eventWeatherRiskLevel');
        if (riskLevelInput) riskLevelInput.value = '';

        const riskBadge = document.getElementById('eventWeatherRiskBadge');
        if (riskBadge) riskBadge.classList.add('hidden');

        const conditionEl = document.getElementById('weatherResultCondition');
        if (conditionEl) conditionEl.textContent = '';

        const tempEl = document.getElementById('weatherResultTemp');
        if (tempEl) tempEl.textContent = '—';

        const rainfallEl = document.getElementById('weatherResultRainfall');
        if (rainfallEl) rainfallEl.textContent = '—';

        const windEl = document.getElementById('weatherResultWind');
        if (windEl) windEl.textContent = '—';

        const windDescriptionEl = document.getElementById('weatherResultWindDescription');
        if (windDescriptionEl) windDescriptionEl.textContent = '';

        const updatedEl = document.getElementById('weatherResultUpdated');
        if (updatedEl) updatedEl.textContent = '';

        const unavailableMessageEl = document.getElementById('weatherUnavailableMessage');
        if (unavailableMessageEl) unavailableMessageEl.textContent = '';

        setAddEventWeatherState('waiting');
    }

    async function fetchWeatherForecast(trailId, eventDate) {
        if (!trailId || !eventDate) return;

        const weatherInput = document.getElementById('eventWeather');
        const reminderTextarea = document.getElementById('eventWeatherReminder');
        const riskLevelInput = document.getElementById('eventWeatherRiskLevel');
        const riskBadge = document.getElementById('eventWeatherRiskBadge');
        const trailSelect = document.getElementById('eventTrailId');

        if (!weatherInput) return;

        // Invalidated for the duration of this fetch (and permanently if it
        // doesn't succeed) - a stale result from whatever trail/date was
        // selected before this call can never be submitted as if it were
        // current. Only renderAddEventWeatherResult below sets it again, and
        // only on an actual success for THIS trailId/eventDate.
        addEventWeatherSnapshot = null;

        setAddEventWeatherState('loading');
        const loadingContext = document.getElementById('weatherLoadingContext');
        if (loadingContext) loadingContext.textContent = formatAddEventWeatherContext(trailSelect, eventDate);

        try {
            const response = await fetch(`/Event/GetWeatherForecast?trailId=${trailId}&eventDate=${eventDate}`);
            const data = await response.json();

            if (data.success && data.forecastDetails && !data.unavailableReason) {
                renderAddEventWeatherResult(data, riskLevelInput, riskBadge, reminderTextarea, trailId, eventDate);
            } else {
                renderAddEventWeatherUnavailable(
                    data.forecastDetails || 'Weather forecast temporarily unavailable. Please check manually.',
                    riskLevelInput, riskBadge, reminderTextarea
                );
            }
        } catch (error) {
            console.error('Error fetching weather:', error);
            renderAddEventWeatherUnavailable(
                'Error loading weather forecast. Please check manually.',
                riskLevelInput, riskBadge, reminderTextarea
            );
        } finally {
            // Belt-and-suspenders: both render helpers above already leave
            // aria-busy="false" via setAddEventWeatherState, but this
            // guarantees the region is never left stuck busy if some future
            // change adds a path that returns before either branch runs.
            const weatherRegion = document.getElementById('eventWeatherRegion');
            if (weatherRegion && weatherRegion.getAttribute('aria-busy') === 'true') {
                weatherRegion.setAttribute('aria-busy', 'false');
            }
        }
    }

    // Preview values are only ever populated from a successful response -
    // never invented - so a failed fetch resets every preview field back to
    // its empty placeholder rather than leaving stale data from a previous
    // trail on screen. Reselecting the trail (the change event firing again)
    // is the retry path; nothing about this state is unrecoverable.
    function resetAddEventTrailPreview() {
        document.getElementById('previewDifficulty').textContent = '-';
        document.getElementById('previewDistance').textContent = '-';
        document.getElementById('previewElevation').textContent = '-';
        document.getElementById('previewLocation').textContent = '-';
        document.getElementById('previewTerrain').textContent = '-';
        document.getElementById('previewTerrainType').textContent = '-';
    }

    // Named (not anonymous) so it's bound exactly once, from the deferred
    // init block below, to the native #eventTrailId select - the same
    // select custom-select.js keeps as the actual source of truth and
    // dispatches a single native 'change' event on for a genuine selection.
    // Declared as `function`, not an arrow function, so `this` inside it is
    // the select element the listener fired on, matching how the browser
    // invokes a regular function passed to addEventListener.
    async function handleAddEventTrailChange() {
        const trailId = this.value;
        if (!trailId) return;

        try {
            const response = await fetch(`/Event/GetTrailDetails?trailId=${trailId}`);
            const data = await response.json();

            if (!data.success) {
                resetAddEventTrailPreview();
                showToast('Unable to load details for this trail. Please reselect it.', 'error');
                return;
            }

            document.getElementById('previewDifficulty').textContent = 'Calculating...';
            document.getElementById('previewDistance').textContent = data.distance + ' km';
            document.getElementById('previewElevation').textContent = data.elevationGainMeters + ' m';
            document.getElementById('previewLocation').textContent = data.location;
            document.getElementById('previewTerrain').textContent = data.terrain;
            document.getElementById('previewTerrainType').textContent = data.trailClassLabel;

            const diffResponse = await fetch(`/Event/GetCalculatedDifficulty?trailId=${trailId}`);
            const diffData = await diffResponse.json();
            if (diffData.success) {
                document.getElementById('previewDifficulty').textContent = diffData.difficulty;
                const durationInput = document.getElementById('eventDuration');
                if (durationInput && !durationInput.value) {
                    durationInput.value = diffData.suggestedDurationHours;
                }
            } else {
                document.getElementById('previewDifficulty').textContent = '-';
                showToast('Unable to calculate difficulty for this trail. You can still continue.', 'error');
            }

            const eventDate = document.getElementById('eventDate')?.value;
            if (eventDate) {
                await fetchWeatherForecast(trailId, eventDate);
            }
        } catch (error) {
            console.error('Error:', error);
            resetAddEventTrailPreview();
            showToast('Unable to load trail details. Please try again.', 'error');
        }
    }

    async function handleAddEventDateChange() {
        const trailId = document.getElementById('eventTrailId')?.value;
        const eventDate = this.value;

        if (trailId && eventDate) {
            await fetchWeatherForecast(trailId, eventDate);
        }
    }

    // Updates only the label/icon inside the existing submit button rather
    // than replacing its contents wholesale, so the button's internal
    // icon/label structure survives a save cycle intact.
    function setAddEventSubmitting(isSubmitting) {
        const submitBtn = document.getElementById('submitBtn');
        const icon = document.getElementById('submitBtnIcon');
        const label = document.getElementById('submitBtnLabel');
        if (!submitBtn) return;

        submitBtn.disabled = isSubmitting;
        if (icon) icon.className = isSubmitting ? 'fa-solid fa-spinner fa-spin motion-reduce:animate-none' : 'fa-solid fa-check';
        if (label) label.textContent = isSubmitting ? 'Creating Event...' : 'Create Event';
    }

    // Named (not anonymous) so it's bound exactly once from the deferred
    // init block below - #addEventForm now lives inside @@section Modals,
    // so it doesn't exist yet at the point in the script where this used to
    // be bound directly.
    async function handleAddEventSubmit(e) {
        e.preventDefault();

        // Defensive - not just a Next-button gate. This is what actually
        // enforces "an organizer is required only when the Admin dropdown
        // exists" (and the no-organizer-accounts case) at the moment of
        // submission, since native `required` alone can't express either.
        if (!validateStep(3)) return;

        const trailId = parseInt(document.getElementById('eventTrailId')?.value, 10);
        const duration = parseFloat(document.getElementById('eventDuration')?.value);
        const capacity = parseInt(document.getElementById('eventCapacity')?.value, 10);

        const eventData = {
            EventTitle: document.getElementById('eventTitle')?.value,
            Description: document.getElementById('eventDescription')?.value,
            EventDate: document.getElementById('eventDate')?.value,
            EventTime: document.getElementById('eventTime')?.value,
            TrailId: Number.isFinite(trailId) ? trailId : null,
            EstimatedDuration: Number.isFinite(duration) ? duration : null,
            Capacity: Number.isFinite(capacity) ? capacity : null,
            // Present only for an Admin caller (the only role whose Step 3
            // renders this select at all). An Organizer's request always
            // sends null here; EventController.AddEvent ignores this field
            // entirely for a non-Admin caller regardless of what's sent.
            OrganizerId: addEventOrganizerSelect ? (addEventOrganizerSelect.value || null) : null,
            WeatherForecastAdvisory: document.getElementById('eventWeather')?.value,
            WeatherRiskLevel: document.getElementById('eventWeatherRiskLevel')?.value,
            WeatherReminder: document.getElementById('eventWeatherReminder')?.value,
            // Only present when a successful forecast currently exists for
            // the selected trail/date (null otherwise - see
            // addEventWeatherSnapshot's own comment). EventController.AddEvent
            // re-validates its trail/date against this same request before
            // ever persisting it.
            WeatherSnapshot: addEventWeatherSnapshot,
            NotesAndReminders: document.getElementById('eventAnnouncements')?.value,
            PaymentDetails: document.getElementById('eventPaymentDetails')?.value,
            // Structured schedules, never a raw PickupPoints string -
            // EventController.AddEvent (via PickupScheduleHelper) is the sole
            // authority that turns these into the canonical stored lines.
            PickupSchedules: addEventPickupSchedules.map(function (schedule) {
                return { Location: schedule.location, Time: schedule.time };
            })
        };

        setAddEventSubmitting(true);

        try {
            const response = await postJson('/Event/AddEvent', eventData);
            const result = await response.json();

            if (result.success) {
                showToast('Event added successfully!', 'success');
                closeAddEventModal();
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast(result.message || 'Unable to add event.', 'error');
                setAddEventSubmitting(false);
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('Error adding event', 'error');
            setAddEventSubmitting(false);
        }
    }

    // Accessible modal lifecycle for Add Event only - mirrors TrailModal in
    // Views/Trail/Index.cshtml (focus trap, focus restoration, Escape,
    // background inert, scroll lock) but only ever manages this one modal,
    // so there's no multi-modal replace() support to carry over. Edit
    // Event's own open/close functions are untouched and deliberately kept
    // out of this - see the Add Event modal task scope.
    const AddEventModal = (function () {
        const modalId = 'addEventModal';
        let isOpen = false;
        let lastFocusedElement = null;
        let inertedElements = [];
        let bodyOverflowBeforeModal = null;

        function getFocusableElements(container) {
            return Array.from(container.querySelectorAll(
                'a[href], button:not([disabled]), textarea:not([disabled]), ' +
                'input:not([disabled]):not([type="hidden"]), select:not([disabled]), ' +
                '[tabindex]:not([tabindex="-1"])'
            )).filter(function (el) { return el.offsetParent !== null; });
        }

        function makeBackgroundInert(modalRoot) {
            inertedElements = [];
            let current = modalRoot;

            while (current && current !== document.body) {
                const parent = current.parentElement;
                if (!parent) break;

                Array.from(parent.children).forEach(function (sibling) {
                    if (sibling === current || sibling.hasAttribute('inert')) return;
                    // The global toast host must stay interactive and in the
                    // accessibility tree no matter which modal is open - see
                    // wwwroot/js/toast.js.
                    if (window.tgToastHostExempt && window.tgToastHostExempt(sibling)) return;
                    sibling.setAttribute('inert', '');
                    inertedElements.push(sibling);
                });

                current = parent;
            }
        }

        function restoreBackgroundInert() {
            inertedElements.forEach(function (element) { element.removeAttribute('inert'); });
            inertedElements = [];
        }

        function handleKeydown(event) {
            if (!isOpen) return;
            const modal = document.getElementById(modalId);
            if (!modal) return;

            if (event.key === 'Escape') {
                // Routed through the outer closeAddEventModal() wrapper (not
                // this module's own close()) so Escape runs exactly the same
                // cleanup - form reset, preview reset, submit-state reset -
                // as the backdrop, Cancel, and close button.
                closeAddEventModal();
                return;
            }

            if (event.key === 'Tab') {
                // A visible toast's dismiss button is a permitted extra stop in
                // this trap (see wwwroot/js/toast.js) - nothing else in the
                // background is ever included.
                const toastCloseButtons = window.tgGetToastCloseButtons ? window.tgGetToastCloseButtons() : [];
                const focusable = getFocusableElements(modal).concat(toastCloseButtons);
                if (focusable.length === 0) {
                    event.preventDefault();
                    return;
                }
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            }
        }

        function open() {
            const modal = document.getElementById(modalId);
            if (!modal || isOpen) return;

            lastFocusedElement = document.activeElement;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            isOpen = true;
            makeBackgroundInert(modal);
            bodyOverflowBeforeModal = document.body.style.overflow;
            document.body.style.overflow = 'hidden';
            document.addEventListener('keydown', handleKeydown);

            const focusable = getFocusableElements(modal);
            const target = focusable[0] || modal;
            if (target && typeof target.focus === 'function') target.focus();
        }

        function close() {
            const modal = document.getElementById(modalId);
            if (!modal) return;

            // Any open custom-select dropdown must close before the modal
            // does, so it can't be left floating (position: fixed) once its
            // trigger is no longer visible.
            if (window.CustomSelect) window.CustomSelect.closeAll();

            modal.classList.add('hidden');
            modal.classList.remove('flex');

            if (!isOpen) return;
            isOpen = false;
            restoreBackgroundInert();
            document.body.style.overflow = bodyOverflowBeforeModal || '';
            bodyOverflowBeforeModal = null;
            document.removeEventListener('keydown', handleKeydown);

            if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                lastFocusedElement.focus();
            }
            lastFocusedElement = null;
        }

        return { open: open, close: close };
    })();

    function openAddEventModal() {
        if (!document.getElementById('addEventModal')) return;
        goToAddEventStep(1, true);
        AddEventModal.open();
    }

    // Called from the deferred init block below, not invoked immediately -
    // it reads #addEventModal (via openAddEventModal) which, like every
    // other Add Event element, doesn't exist yet at top-level script
    // execution time now that the modal lives in @@section Modals.
    function openRequestedAddEventModal() {
        const url = new URL(window.location.href);
        if (url.searchParams.get('openModal') !== 'add') return;

        url.searchParams.delete('openModal');
        history.replaceState(history.state, '', url.pathname + url.search + url.hash);
        openAddEventModal();
    }

    function closeAddEventModal() {
        AddEventModal.close();

        const form = document.getElementById('addEventForm');
        if (form) form.reset();
        setAddEventSubmitting(false);

        const scrollContainer = document.querySelector('#addEventModal .overflow-y-auto');
        if (scrollContainer) scrollContainer.scrollTop = 0;

        resetAddEventTrailPreview();
        resetAddEventWeatherDisplay();
        resetAddEventPickupSchedules();
    }

    // Everything Add Event needs from the DOM - #nextBtn, #prevBtn,
    // #eventTrailId, #eventDate, #addEventForm, the Admin-only
    // #eventOrganizerId select - now lives inside @@section Modals, which
    // the layout renders after this page's own body content (RenderBody).
    // Binding at top-level script execution (as this used to) runs before
    // that markup exists in the DOM, so every addEventListener call above
    // would silently attach to nothing. DOMContentLoaded fires only after
    // the *entire* initial HTML document - including the Modals section -
    // has been parsed, regardless of where in the source this script tag
    // sits, which is what custom-select.js itself already relies on for the
    // same reason. Everything here runs exactly once.
    document.addEventListener('DOMContentLoaded', function initAddEventModalBindings() {
        addEventOrganizerSelect = document.getElementById('eventOrganizerId');
        addEventOrganizerUnavailable = !!(addEventOrganizerSelect && addEventOrganizerSelect.disabled);

        document.getElementById('nextBtn')?.addEventListener('click', handleAddEventNextClick);
        document.getElementById('prevBtn')?.addEventListener('click', handleAddEventPrevClick);
        document.getElementById('eventTrailId')?.addEventListener('change', handleAddEventTrailChange);
        document.getElementById('eventDate')?.addEventListener('change', handleAddEventDateChange);
        document.getElementById('addEventForm')?.addEventListener('submit', handleAddEventSubmit);

        document.getElementById('pickupScheduleAddBtn')?.addEventListener('click', handleAddEventPickupAddClick);
        document.getElementById('pickupScheduleCancelEditBtn')?.addEventListener('click', handleAddEventPickupCancelEditClick);
        document.getElementById('pickupSchedulesList')?.addEventListener('click', handleAddEventPickupListClick);
        document.getElementById('pickupScheduleLocationInput')?.addEventListener('keydown', handleAddEventPickupInputKeydown);
        document.getElementById('pickupScheduleTimeInput')?.addEventListener('keydown', handleAddEventPickupInputKeydown);

        openRequestedAddEventModal();
    });

    let editCurrentStep = 1;
    const editTotalSteps = 3;

    // Edit-namespaced state, kept fully separate from Add Event's own
    // addEvent* variables per this task's scope (avoid a broad refactor of
    // the approved Add Event implementation - see AGENTS.md).
    let editEventPickupSchedules = [];
    let editEventPickupEditIndex = null;

    // The structured snapshot Update will submit, in the shape
    // EventEditModel.WeatherSnapshot expects (PascalCase) - or null when
    // there's currently nothing valid to submit. Set in exactly two places:
    // populateEditEventForm, when the event's saved snapshot already matches
    // its current trail/date (resubmitting it unchanged preserves it), and
    // renderEditEventWeatherResult, on an actual successful refresh. Cleared
    // at the start of every new fetch (editFetchWeatherForecast) so a stale
    // result from a since-changed trail/date is never submitted as current -
    // note that submitting null is always safe either way, since
    // EventController.EditEvent preserves the event's existing stored
    // snapshot whenever no valid new one is supplied.
    let editEventWeatherSnapshot = null;

    let editEventOrganizerSelect = null;
    let editEventOrganizerUnavailable = false;

    // Stale-response guards. editEventLoadToken is bumped every time
    // openEditModal starts a new GetEvent request; a response is only
    // applied if the token it captured is still current when it resolves -
    // opening a different event (or the same one again) before the first
    // request returns invalidates it, so a late Event A response can never
    // overwrite Event B. editEventWeatherRequestToken does the same
    // independently for weather refreshes, which can outlive a GetEvent
    // load and race against a second trail/date change.
    let editEventLoadToken = 0;
    let editEventWeatherRequestToken = 0;
    let editEventCurrentEventId = null;
    let editEventAbortController = null;

    // Accessible modal lifecycle for Edit Event - structurally identical to
    // AddEventModal above (focus trap, focus restoration, Escape, background
    // inert, scroll lock), kept as its own separate instance so the two
    // modals' open/closed state can never be confused and so this task's
    // changes can't regress AddEventModal's own behavior. open() accepts an
    // explicit trigger element because openEditModal awaits a fetch before
    // calling it - document.activeElement could have drifted by then.
    const EditEventModal = (function () {
        const modalId = 'editEventModal';
        let isOpen = false;
        let lastFocusedElement = null;
        let inertedElements = [];
        let bodyOverflowBeforeModal = null;

        function getFocusableElements(container) {
            return Array.from(container.querySelectorAll(
                'a[href], button:not([disabled]), textarea:not([disabled]), ' +
                'input:not([disabled]):not([type="hidden"]), select:not([disabled]), ' +
                '[tabindex]:not([tabindex="-1"])'
            )).filter(function (el) { return el.offsetParent !== null; });
        }

        function makeBackgroundInert(modalRoot) {
            inertedElements = [];
            let current = modalRoot;

            while (current && current !== document.body) {
                const parent = current.parentElement;
                if (!parent) break;

                Array.from(parent.children).forEach(function (sibling) {
                    if (sibling === current || sibling.hasAttribute('inert')) return;
                    // The global toast host must stay interactive and in the
                    // accessibility tree no matter which modal is open - see
                    // wwwroot/js/toast.js.
                    if (window.tgToastHostExempt && window.tgToastHostExempt(sibling)) return;
                    sibling.setAttribute('inert', '');
                    inertedElements.push(sibling);
                });

                current = parent;
            }
        }

        function restoreBackgroundInert() {
            inertedElements.forEach(function (element) { element.removeAttribute('inert'); });
            inertedElements = [];
        }

        function handleKeydown(event) {
            if (!isOpen) return;
            const modal = document.getElementById(modalId);
            if (!modal) return;

            if (event.key === 'Escape') {
                closeEditEventModal();
                return;
            }

            if (event.key === 'Tab') {
                // A visible toast's dismiss button is a permitted extra stop in
                // this trap (see wwwroot/js/toast.js) - nothing else in the
                // background is ever included.
                const toastCloseButtons = window.tgGetToastCloseButtons ? window.tgGetToastCloseButtons() : [];
                const focusable = getFocusableElements(modal).concat(toastCloseButtons);
                if (focusable.length === 0) {
                    event.preventDefault();
                    return;
                }
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            }
        }

        function open(explicitTrigger) {
            const modal = document.getElementById(modalId);
            if (!modal || isOpen) return;

            lastFocusedElement = explicitTrigger || document.activeElement;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            isOpen = true;
            makeBackgroundInert(modal);
            bodyOverflowBeforeModal = document.body.style.overflow;
            document.body.style.overflow = 'hidden';
            document.addEventListener('keydown', handleKeydown);

            const focusable = getFocusableElements(modal);
            const target = focusable[0] || modal;
            if (target && typeof target.focus === 'function') target.focus();
        }

        function close() {
            const modal = document.getElementById(modalId);
            if (!modal) return;

            if (window.CustomSelect) window.CustomSelect.closeAll();

            modal.classList.add('hidden');
            modal.classList.remove('flex');

            if (!isOpen) return;
            isOpen = false;
            restoreBackgroundInert();
            document.body.style.overflow = bodyOverflowBeforeModal || '';
            bodyOverflowBeforeModal = null;
            document.removeEventListener('keydown', handleKeydown);

            if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                lastFocusedElement.focus();
            }
            lastFocusedElement = null;
        }

        return { open: open, close: close };
    })();

    // ---- Pickup Schedules builder (Edit-namespaced) -----------------------
    // Structurally mirrors the Add Event pickup builder above, with one
    // addition: a legacy stored entry without a valid canonical time
    // (requiresTime true) stays visible, editable, and blocks Next/Update
    // until a time is supplied - never dropped, never given an invented time.
    // Pure/parameterized helpers (formatAddEventPickupTime, showToast,
    // postJson, getRiskBadgeClasses, applyWeatherRiskFields,
    // focusAddEventField, setAddEventFooterButtonVisible,
    // formatAddEventWeatherContext, formatAddEventWeatherUpdatedAt,
    // formatAddEventRainfall, getAddEventWeatherIconClass) are reused as-is -
    // none of them reference Add Event's own DOM ids or state, so calling
    // them from here cannot regress Add Event.

    function announceEditEventPickupSchedules(message) {
        const statusEl = document.getElementById('editPickupSchedulesStatus');
        if (statusEl) statusEl.textContent = message;
    }

    function buildEditEventPickupRow(schedule, index) {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-surface-card px-4 py-2.5';
        row.setAttribute('data-edit-schedule-index', String(index));

        const textWrap = document.createElement('div');
        textWrap.className = 'min-w-0';

        const locationEl = document.createElement('p');
        locationEl.className = 'text-sm font-medium text-white wrap-break-word';
        locationEl.textContent = schedule.location;

        const formattedTime = schedule.requiresTime ? '' : formatAddEventPickupTime(schedule.time);
        const timeEl = document.createElement('p');
        timeEl.className = schedule.requiresTime ? 'text-xs text-amber-400 font-medium' : 'text-xs text-gray-400';
        timeEl.textContent = schedule.requiresTime ? 'Time required' : formattedTime;

        textWrap.appendChild(locationEl);
        textWrap.appendChild(timeEl);

        const actions = document.createElement('div');
        actions.className = 'flex items-center gap-1 shrink-0';

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'w-8 h-8 rounded-full flex items-center justify-center text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent';
        editBtn.setAttribute('data-edit-action', 'edit');
        editBtn.setAttribute('aria-label', 'Edit pickup schedule: ' + schedule.location + (schedule.requiresTime ? ', time required' : ' at ' + formattedTime));
        const editIcon = document.createElement('i');
        editIcon.className = 'fa-solid fa-pen text-xs';
        editIcon.setAttribute('aria-hidden', 'true');
        editBtn.appendChild(editIcon);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'w-8 h-8 rounded-full flex items-center justify-center text-red-400 hover:text-white bg-red-500/20 hover:bg-red-500 border border-red-500/30 hover:border-red-500 transition-colors focus:outline-none focus:ring-2 focus:ring-accent';
        removeBtn.setAttribute('data-edit-action', 'remove');
        removeBtn.setAttribute('aria-label', 'Remove pickup schedule: ' + schedule.location + (schedule.requiresTime ? ', time required' : ' at ' + formattedTime));
        const removeIcon = document.createElement('i');
        removeIcon.className = 'fa-solid fa-trash text-xs';
        removeIcon.setAttribute('aria-hidden', 'true');
        removeBtn.appendChild(removeIcon);

        actions.appendChild(editBtn);
        actions.appendChild(removeBtn);

        row.appendChild(textWrap);
        row.appendChild(actions);
        return row;
    }

    function renderEditEventPickupSchedules() {
        const list = document.getElementById('editPickupSchedulesList');
        const emptyState = document.getElementById('editPickupSchedulesEmptyState');
        if (!list) return;

        list.replaceChildren();
        if (emptyState) emptyState.classList.toggle('hidden', editEventPickupSchedules.length > 0);

        editEventPickupSchedules.forEach(function (schedule, index) {
            list.appendChild(buildEditEventPickupRow(schedule, index));
        });
    }

    function enterEditEventPickupEditMode(index) {
        const schedule = editEventPickupSchedules[index];
        if (!schedule) return;

        editEventPickupEditIndex = index;

        const locationInput = document.getElementById('editPickupScheduleLocationInput');
        const timeInput = document.getElementById('editPickupScheduleTimeInput');
        if (locationInput) locationInput.value = schedule.location;
        if (timeInput) timeInput.value = schedule.requiresTime ? '' : (schedule.time || '');

        const addBtnLabel = document.getElementById('editPickupScheduleAddBtnLabel');
        if (addBtnLabel) addBtnLabel.textContent = 'Update Schedule';

        document.getElementById('editPickupScheduleCancelEditBtn')?.removeAttribute('hidden');

        locationInput?.focus();
    }

    function exitEditEventPickupEditMode(preserveInputs) {
        editEventPickupEditIndex = null;

        const addBtnLabel = document.getElementById('editPickupScheduleAddBtnLabel');
        if (addBtnLabel) addBtnLabel.textContent = 'Add Schedule';

        document.getElementById('editPickupScheduleCancelEditBtn')?.setAttribute('hidden', '');

        if (!preserveInputs) {
            const locationInput = document.getElementById('editPickupScheduleLocationInput');
            const timeInput = document.getElementById('editPickupScheduleTimeInput');
            if (locationInput) locationInput.value = '';
            if (timeInput) timeInput.value = '';
        }
    }

    function commitEditEventPickupCandidate(rawLocation, time) {
        const location = (rawLocation || '').trim();

        if (location.length === 0) {
            return { success: false, error: 'Please enter a pickup location.', focus: 'location' };
        }
        if (/[\r\n]/.test(location) || location.indexOf('—') !== -1) {
            return { success: false, error: 'Pickup location can’t contain a line break or “—”.', focus: 'location' };
        }
        if (!time) {
            return { success: false, error: 'Please enter a pickup time.', focus: 'time' };
        }

        const editIndex = editEventPickupEditIndex;
        const isDuplicate = editEventPickupSchedules.some(function (schedule, index) {
            if (index === editIndex) return false;
            return !schedule.requiresTime && schedule.location.toLowerCase() === location.toLowerCase() && schedule.time === time;
        });
        if (isDuplicate) {
            return { success: false, error: 'That pickup location and time is already on the list.', focus: 'location' };
        }

        const formattedTime = formatAddEventPickupTime(time);
        const committed = { location: location, time: time, requiresTime: false };

        if (editIndex !== null && editIndex >= 0 && editIndex < editEventPickupSchedules.length) {
            editEventPickupSchedules[editIndex] = committed;
            exitEditEventPickupEditMode(true);
            announceEditEventPickupSchedules('Updated pickup schedule: ' + location + ' at ' + formattedTime + '.');
        } else {
            editEventPickupSchedules.push(committed);
            announceEditEventPickupSchedules('Added pickup schedule: ' + location + ' at ' + formattedTime + '.');
        }

        renderEditEventPickupSchedules();
        return { success: true };
    }

    function handleEditEventPickupAddClick() {
        const locationInput = document.getElementById('editPickupScheduleLocationInput');
        const timeInput = document.getElementById('editPickupScheduleTimeInput');

        const result = commitEditEventPickupCandidate(locationInput?.value, timeInput?.value);
        if (!result.success) {
            showToast(result.error, 'error');
            (result.focus === 'time' ? timeInput : locationInput)?.focus();
            return;
        }

        if (locationInput) locationInput.value = '';
        if (timeInput) timeInput.value = '';
        locationInput?.focus();
    }

    function handleEditEventPickupInputKeydown(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            handleEditEventPickupAddClick();
        }
    }

    function handleEditEventPickupCancelEditClick() {
        exitEditEventPickupEditMode();
        document.getElementById('editPickupScheduleLocationInput')?.focus();
    }

    function removeEditEventPickupSchedule(index) {
        const removed = editEventPickupSchedules[index];
        if (!removed) return;

        editEventPickupSchedules.splice(index, 1);

        if (editEventPickupEditIndex !== null) {
            if (editEventPickupEditIndex === index) {
                exitEditEventPickupEditMode();
            } else if (editEventPickupEditIndex > index) {
                editEventPickupEditIndex -= 1;
            }
        }

        renderEditEventPickupSchedules();
        announceEditEventPickupSchedules('Removed pickup schedule: ' + removed.location + '.');
    }

    function handleEditEventPickupListClick(event) {
        const actionBtn = event.target.closest('[data-edit-action]');
        if (!actionBtn) return;

        const row = actionBtn.closest('[data-edit-schedule-index]');
        if (!row) return;

        const index = parseInt(row.getAttribute('data-edit-schedule-index'), 10);
        if (!Number.isInteger(index) || index < 0 || index >= editEventPickupSchedules.length) return;

        const action = actionBtn.getAttribute('data-edit-action');
        if (action === 'edit') {
            enterEditEventPickupEditMode(index);
        } else if (action === 'remove') {
            removeEditEventPickupSchedule(index);
        }
    }

    // Step 2 -> Next contract, extended over Add Event's equivalent with one
    // extra check that runs first: any legacy schedule still needing a time
    // blocks navigation and jumps straight into editing that row, before
    // pending input is even looked at.
    function resolveEditEventPickupSchedulesForNext() {
        const incompleteIndex = editEventPickupSchedules.findIndex(function (schedule) { return schedule.requiresTime; });
        if (incompleteIndex !== -1) {
            const incomplete = editEventPickupSchedules[incompleteIndex];
            showToast('Please add a pickup time for "' + incomplete.location + '" before continuing.', 'error');
            enterEditEventPickupEditMode(incompleteIndex);
            return false;
        }

        const locationInput = document.getElementById('editPickupScheduleLocationInput');
        const timeInput = document.getElementById('editPickupScheduleTimeInput');
        const pendingLocation = (locationInput?.value || '').trim();
        const pendingTime = timeInput?.value || '';

        if (!pendingLocation && !pendingTime) {
            if (editEventPickupSchedules.length === 0) {
                showToast('Please add at least one pickup schedule.', 'error');
                locationInput?.focus();
                return false;
            }
            return true;
        }

        if (pendingLocation && !pendingTime) {
            showToast('Please enter a pickup time for "' + pendingLocation + '".', 'error');
            timeInput?.focus();
            return false;
        }

        if (!pendingLocation && pendingTime) {
            showToast('Please enter a pickup location.', 'error');
            locationInput?.focus();
            return false;
        }

        const result = commitEditEventPickupCandidate(pendingLocation, pendingTime);
        if (!result.success) {
            showToast(result.error, 'error');
            (result.focus === 'time' ? timeInput : locationInput)?.focus();
            return false;
        }

        if (locationInput) locationInput.value = '';
        if (timeInput) timeInput.value = '';
        return true;
    }

    function resetEditEventPickupSchedules() {
        editEventPickupSchedules = [];
        exitEditEventPickupEditMode();
        renderEditEventPickupSchedules();
        announceEditEventPickupSchedules('');
    }

    // ---- Weather (Edit-namespaced, five states) ----------------------------

    const EDIT_WEATHER_PANEL_ID_BY_STATE = {
        saved: 'editWeatherSavedPanel',
        waiting: 'editWeatherWaitingPanel',
        loading: 'editWeatherLoadingPanel',
        result: 'editWeatherResultPanel',
        unavailable: 'editWeatherUnavailablePanel'
    };

    function setEditEventWeatherState(state) {
        Object.keys(EDIT_WEATHER_PANEL_ID_BY_STATE).forEach(function (key) {
            const panel = document.getElementById(EDIT_WEATHER_PANEL_ID_BY_STATE[key]);
            if (panel) panel.classList.add('hidden');
        });

        const targetId = EDIT_WEATHER_PANEL_ID_BY_STATE[state];
        const target = targetId ? document.getElementById(targetId) : null;
        if (target) target.classList.remove('hidden');

        const weatherRegion = document.getElementById('editEventWeatherRegion');
        if (weatherRegion) weatherRegion.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    }

    // isFromSnapshot distinguishes a persisted snapshot being restored on
    // hydration (true) from an actual live refresh result (false, the
    // default) - the only visible difference is the "Updated" line's
    // wording, so a snapshot-restored card can't be mistaken for one just
    // fetched this second. trailId/eventDate are the context this result
    // belongs to; when called from a live refresh they're the same values
    // just used for the fetch, and when called from hydration they're the
    // saved snapshot's own trailId/forecastDate (already confirmed to match
    // the event's current ones by the caller - see populateEditEventForm).
    function renderEditEventWeatherResult(data, trailId, eventDate, isFromSnapshot) {
        // A persisted WeatherSnapshot has no forecastDetails property at all
        // (only the live GetWeatherForecast response does) - restoring one
        // on hydration must leave #editEventWeather exactly as
        // populateEditEventForm already set it (the real saved
        // WeatherForecastAdvisory text), not blank it out.
        const weatherInput = document.getElementById('editEventWeather');
        if (weatherInput && typeof data.forecastDetails === 'string') weatherInput.value = data.forecastDetails;

        editEventWeatherSnapshot = buildWeatherSnapshotPayload(trailId, eventDate, data);

        const iconEl = document.getElementById('editWeatherResultIcon');
        if (iconEl) iconEl.className = 'fa-solid ' + getAddEventWeatherIconClass(data.weatherCode) + ' text-accent text-sm';

        const conditionEl = document.getElementById('editWeatherResultCondition');
        if (conditionEl) conditionEl.textContent = data.condition || 'Forecast available';

        const tempEl = document.getElementById('editWeatherResultTemp');
        if (tempEl) {
            tempEl.textContent = (typeof data.temperatureMinC === 'number' && typeof data.temperatureMaxC === 'number')
                ? Math.round(data.temperatureMinC) + '–' + Math.round(data.temperatureMaxC) + '°C'
                : '—';
        }

        const rainfallEl = document.getElementById('editWeatherResultRainfall');
        if (rainfallEl) {
            rainfallEl.textContent = typeof data.expectedRainfallMm === 'number'
                ? formatAddEventRainfall(data.expectedRainfallMm) + ' mm'
                : '—';
        }

        const windEl = document.getElementById('editWeatherResultWind');
        if (windEl) {
            windEl.textContent = (typeof data.windSpeedKmh === 'number' && data.windSpeedKmh > 0)
                ? Math.round(data.windSpeedKmh) + ' km/h'
                : '—';
        }

        const windDescriptionEl = document.getElementById('editWeatherResultWindDescription');
        if (windDescriptionEl) windDescriptionEl.textContent = data.windDescription || '';

        // "Saved forecast" prefix only for a restored snapshot, so it can
        // never be mistaken for a result just fetched this second - matches
        // Add Event's plain "Updated <time>" wording exactly when it isn't.
        const updatedEl = document.getElementById('editWeatherResultUpdated');
        if (updatedEl) {
            const updatedText = formatAddEventWeatherUpdatedAt(data.updatedAt);
            updatedEl.textContent = isFromSnapshot ? ('Saved forecast' + (updatedText ? ' · ' + updatedText : '')) : updatedText;
        }

        // riskLevel is present on both a live response and a persisted
        // snapshot, so this part is shared safely either way. suggestedReminder
        // is NOT part of a persisted snapshot (see WeatherSnapshot) - inlined
        // here (not routed through the shared applyWeatherRiskFields) so a
        // snapshot restore can leave #editEventWeatherReminder exactly as
        // populateEditEventForm already set it, without touching
        // applyWeatherRiskFields' behavior for Add Event's or Edit Event's
        // own live-refresh call sites.
        const riskLevelInput = document.getElementById('editEventWeatherRiskLevel');
        if (riskLevelInput) riskLevelInput.value = data.riskLevel || '';

        const riskBadge = document.getElementById('editEventWeatherRiskBadge');
        if (riskBadge) {
            if (data.riskLevel) {
                riskBadge.textContent = data.riskLevel;
                riskBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-semibold ' + getRiskBadgeClasses(data.riskLevel);
            } else {
                riskBadge.classList.add('hidden');
            }
        }

        if (!isFromSnapshot) {
            const reminderTextarea = document.getElementById('editEventWeatherReminder');
            if (reminderTextarea) reminderTextarea.value = data.suggestedReminder || '';
        }

        document.getElementById('editWeatherRefreshFailedNote')?.setAttribute('hidden', '');
        document.getElementById('editWeatherStaleContextNote')?.setAttribute('hidden', '');
        setEditEventWeatherState('result');
    }

    // A failed/unavailable refresh never touches #editEventWeather - the
    // saved advisory (if any) is exactly what was there before this refresh
    // attempt started, so falling back to the 'saved' state here shows real
    // prior data, never an invented one. Only an event with no saved
    // advisory at all falls through to the plain 'unavailable' state.
    function handleEditEventWeatherRefreshFailure() {
        const weatherInput = document.getElementById('editEventWeather');
        const hasSavedAdvisory = !!(weatherInput && weatherInput.value);

        if (hasSavedAdvisory) {
            const headingEl = document.getElementById('editWeatherSavedHeading');
            if (headingEl) headingEl.textContent = 'Saved weather advisory';
            const savedTextEl = document.getElementById('editWeatherSavedText');
            if (savedTextEl) savedTextEl.textContent = weatherInput.value;
            document.getElementById('editWeatherStaleContextNote')?.setAttribute('hidden', '');
            document.getElementById('editWeatherRefreshFailedNote')?.removeAttribute('hidden');
            setEditEventWeatherState('saved');
        } else {
            const unavailableEl = document.getElementById('editWeatherUnavailableMessage');
            if (unavailableEl) unavailableEl.textContent = 'Weather forecast temporarily unavailable. Please check manually.';
            setEditEventWeatherState('unavailable');
        }
    }

    async function editFetchWeatherForecast(trailId, eventDate) {
        if (!trailId || !eventDate) return;

        const weatherInput = document.getElementById('editEventWeather');
        if (!weatherInput) return;

        // Invalidated for the duration of this fetch (and permanently if it
        // doesn't succeed) - mirrors Add Event's addEventWeatherSnapshot
        // handling exactly (see fetchWeatherForecast's own comment). A
        // failed fetch leaving this null is safe: EventController.EditEvent
        // preserves the event's existing stored snapshot whenever no valid
        // new one is submitted, so nothing needs to be resubmitted here for
        // that to work.
        editEventWeatherSnapshot = null;

        const requestToken = ++editEventWeatherRequestToken;

        setEditEventWeatherState('loading');
        const loadingContext = document.getElementById('editWeatherLoadingContext');
        const trailSelectForContext = document.getElementById('editEventTrailId');
        if (loadingContext) loadingContext.textContent = formatAddEventWeatherContext(trailSelectForContext, eventDate);

        try {
            const eventIdParam = editEventCurrentEventId ? `&eventId=${editEventCurrentEventId}` : '';
            const response = await fetch(`/Event/GetWeatherForecast?trailId=${trailId}&eventDate=${eventDate}${eventIdParam}`);
            const data = await response.json();

            // Stale-response guard: a second trail/date change started a
            // newer request before this one resolved - discard rather than
            // overwrite whatever that newer request already showed.
            if (requestToken !== editEventWeatherRequestToken) return;

            if (data.success && data.forecastDetails && !data.unavailableReason) {
                renderEditEventWeatherResult(data, trailId, eventDate, false);
            } else {
                handleEditEventWeatherRefreshFailure();
            }
        } catch (error) {
            if (requestToken !== editEventWeatherRequestToken) return;
            console.error('Error fetching weather:', error);
            handleEditEventWeatherRefreshFailure();
        }
    }

    function resetEditEventWeatherDisplay() {
        editEventWeatherSnapshot = null;

        const weatherInput = document.getElementById('editEventWeather');
        if (weatherInput) weatherInput.value = '';

        const riskLevelInput = document.getElementById('editEventWeatherRiskLevel');
        if (riskLevelInput) riskLevelInput.value = '';

        const riskBadge = document.getElementById('editEventWeatherRiskBadge');
        if (riskBadge) riskBadge.classList.add('hidden');

        const headingEl = document.getElementById('editWeatherSavedHeading');
        if (headingEl) headingEl.textContent = 'Saved weather advisory';

        const savedTextEl = document.getElementById('editWeatherSavedText');
        if (savedTextEl) savedTextEl.textContent = '';

        document.getElementById('editWeatherRefreshFailedNote')?.setAttribute('hidden', '');
        document.getElementById('editWeatherStaleContextNote')?.setAttribute('hidden', '');

        const conditionEl = document.getElementById('editWeatherResultCondition');
        if (conditionEl) conditionEl.textContent = '';

        const tempEl = document.getElementById('editWeatherResultTemp');
        if (tempEl) tempEl.textContent = '—';

        const rainfallEl = document.getElementById('editWeatherResultRainfall');
        if (rainfallEl) rainfallEl.textContent = '—';

        const windEl = document.getElementById('editWeatherResultWind');
        if (windEl) windEl.textContent = '—';

        const windDescriptionEl = document.getElementById('editWeatherResultWindDescription');
        if (windDescriptionEl) windDescriptionEl.textContent = '';

        const updatedEl = document.getElementById('editWeatherResultUpdated');
        if (updatedEl) updatedEl.textContent = '';

        const unavailableEl = document.getElementById('editWeatherUnavailableMessage');
        if (unavailableEl) unavailableEl.textContent = '';

        setEditEventWeatherState('waiting');
    }

    // ---- Step 1 trail preview / trail & date change (Edit-namespaced) ------

    function resetEditEventTrailPreview() {
        document.getElementById('editPreviewDifficulty').textContent = '-';
        document.getElementById('editPreviewDistance').textContent = '-';
        document.getElementById('editPreviewElevation').textContent = '-';
        document.getElementById('editPreviewLocation').textContent = '-';
        document.getElementById('editPreviewTerrain').textContent = '-';
        document.getElementById('editPreviewTerrainType').textContent = '-';
    }

    // Bound once to #editEventTrailId's native 'change' event - only ever
    // fires for a deliberate user selection, never during hydration.
    // populateEditEventForm sets the select's value directly and resyncs via
    // CustomSelect.refresh(), neither of which dispatches 'change' (see that
    // function's own comment and custom-select.js's syncFromSelect/refresh).
    async function handleEditEventTrailChange() {
        const trailId = this.value;
        if (!trailId) return;

        try {
            const response = await fetch(`/Event/GetTrailDetails?trailId=${trailId}`);
            const data = await response.json();

            if (!data.success) {
                resetEditEventTrailPreview();
                showToast('Unable to load details for this trail. Please reselect it.', 'error');
                return;
            }

            document.getElementById('editPreviewDifficulty').textContent = 'Calculating...';
            document.getElementById('editPreviewDistance').textContent = data.distance + ' km';
            document.getElementById('editPreviewElevation').textContent = data.elevationGainMeters + ' m';
            document.getElementById('editPreviewLocation').textContent = data.location;
            document.getElementById('editPreviewTerrain').textContent = data.terrain;
            document.getElementById('editPreviewTerrainType').textContent = data.trailClassLabel;

            const diffResponse = await fetch(`/Event/GetCalculatedDifficulty?trailId=${trailId}`);
            const diffData = await diffResponse.json();
            if (diffData.success) {
                document.getElementById('editPreviewDifficulty').textContent = diffData.difficulty;
                const durationInput = document.getElementById('editEventDuration');
                if (durationInput && !durationInput.value) {
                    durationInput.value = diffData.suggestedDurationHours;
                }
            } else {
                document.getElementById('editPreviewDifficulty').textContent = '-';
            }

            const eventDate = document.getElementById('editEventDate')?.value;
            if (eventDate) {
                await editFetchWeatherForecast(trailId, eventDate);
            }
        } catch (error) {
            console.error('Error:', error);
            resetEditEventTrailPreview();
            showToast('Unable to load trail details. Please try again.', 'error');
        }
    }

    async function handleEditEventDateChange() {
        const trailId = document.getElementById('editEventTrailId')?.value;
        const eventDate = this.value;

        if (trailId && eventDate) {
            await editFetchWeatherForecast(trailId, eventDate);
        }
    }

    // ---- Stepper (Edit-namespaced) ------------------------------------------

    function editUpdateStepUI() {
        for (let i = 1; i <= editTotalSteps; i++) {
            const content = document.getElementById(`editStep${i}`);
            const item = document.querySelector(`[data-edit-step-item="${i}"]`);
            const circle = document.querySelector(`[data-edit-step-circle="${i}"]`);
            const label = item?.querySelector('[data-edit-step-label]');
            const status = item?.querySelector('[data-edit-step-status]');
            const line = document.querySelector(`[data-edit-step-line="${i}"]`);

            if (content) content.classList.toggle('hidden', i !== editCurrentStep);

            if (item) {
                if (i === editCurrentStep) {
                    item.setAttribute('aria-current', 'step');
                } else {
                    item.removeAttribute('aria-current');
                }
            }

            if (circle) {
                if (i < editCurrentStep) {
                    circle.className = 'w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors bg-accent text-white';
                } else if (i === editCurrentStep) {
                    circle.className = 'w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors bg-accent text-white ring-2 ring-accent ring-offset-2 ring-offset-surface-card';
                } else {
                    circle.className = 'w-8 h-8 rounded-full flex items-center justify-center mb-1.5 text-sm font-semibold transition-colors border-2 border-gray-700 text-gray-400';
                }
            }

            if (label) {
                label.className = i === editCurrentStep
                    ? 'text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors text-white font-semibold'
                    : 'text-[11px] sm:text-xs leading-tight wrap-break-word px-1 transition-colors text-gray-400';
            }

            if (status) status.textContent = i < editCurrentStep ? 'Completed' : '';

            if (line) {
                line.className = i < editCurrentStep
                    ? 'flex-1 h-0.5 mt-4 mx-1 sm:mx-2 transition-colors bg-accent'
                    : 'flex-1 h-0.5 mt-4 mx-1 sm:mx-2 transition-colors bg-gray-700';
            }
        }

        const prevBtn = document.getElementById('editPrevBtn');
        const nextBtn = document.getElementById('editNextBtn');
        const submitBtn = document.getElementById('editSubmitBtn');

        prevBtn?.classList.toggle('hidden', editCurrentStep === 1);
        // setAddEventFooterButtonVisible is a pure function of (button,
        // visible) - reused here exactly as Add Event's own footer uses it,
        // never redefined, so neither modal's button-visibility logic can
        // drift from the other. See its own comment above.
        setAddEventFooterButtonVisible(nextBtn, editCurrentStep !== editTotalSteps);
        setAddEventFooterButtonVisible(submitBtn, editCurrentStep === editTotalSteps);
    }

    function editGoToStep(step, skipFocus) {
        editCurrentStep = step;
        editUpdateStepUI();

        const scrollContainer = document.querySelector('#editEventModal .overflow-y-auto');
        if (scrollContainer) scrollContainer.scrollTop = 0;

        if (!skipFocus) {
            const heading = document.getElementById(`editEventStep${step}Heading`);
            if (heading && typeof heading.focus === 'function') heading.focus();
        }
    }

    function handleEditEventNextClick() {
        if (editValidateStep(editCurrentStep) && editCurrentStep < editTotalSteps) {
            editGoToStep(editCurrentStep + 1);
        }
    }

    function handleEditEventPrevClick() {
        if (editCurrentStep > 1) {
            editGoToStep(editCurrentStep - 1);
        }
    }

    function editValidateStep(step) {
        if (step === 1) {
            const trailId = document.getElementById('editEventTrailId')?.value;
            const duration = parseFloat(document.getElementById('editEventDuration')?.value);
            const capacity = parseInt(document.getElementById('editEventCapacity')?.value, 10);

            if (!trailId) {
                showToast('Please select a trail', 'error');
                focusAddEventField('editEventTrailId');
                return false;
            }
            if (!Number.isFinite(duration) || duration <= 0) {
                showToast('Please enter estimated duration', 'error');
                document.getElementById('editEventDuration')?.focus();
                return false;
            }
            if (!Number.isInteger(capacity) || capacity <= 0) {
                showToast('Please enter valid capacity', 'error');
                document.getElementById('editEventCapacity')?.focus();
                return false;
            }
            return true;
        }

        if (step === 2) {
            // Auto-adds/updates a complete pending schedule, blocks with a
            // specific message and moves focus for an incomplete pending
            // pair or a legacy entry still needing a time, and only objects
            // to empty pending input when no schedule exists yet at all.
            if (!resolveEditEventPickupSchedulesForNext()) {
                return false;
            }

            const eventDate = document.getElementById('editEventDate')?.value;
            const eventTime = document.getElementById('editEventTime')?.value;

            if (!eventDate) {
                showToast('Please select event date', 'error');
                return false;
            }
            if (!eventTime) {
                showToast('Please select event time', 'error');
                return false;
            }
            return true;
        }

        if (step === 3) {
            const title = document.getElementById('editEventTitle')?.value;
            const description = document.getElementById('editEventDescription')?.value;

            if (!title) {
                showToast('Please enter event title', 'error');
                return false;
            }

            // Only require (and validate) an organizer selection when the
            // Admin dropdown actually exists - an Organizer's Step 3 has no
            // such control at all, by design.
            if (editEventOrganizerSelect) {
                if (editEventOrganizerUnavailable) {
                    showToast('No organizer accounts are available. Create one before updating this event.', 'error');
                    return false;
                }
                const organizerId = (editEventOrganizerSelect.value || '').trim();
                if (!organizerId) {
                    showToast('Please select an organizer', 'error');
                    return false;
                }
            }

            if (!description) {
                showToast('Please enter event description', 'error');
                return false;
            }
            return true;
        }

        return true;
    }

    // ---- Open / hydrate / close (Edit-namespaced) ---------------------------

    function resetEditEventDisplay() {
        resetEditEventTrailPreview();
        resetEditEventWeatherDisplay();
        resetEditEventPickupSchedules();
        document.getElementById('editEventOrganizerAmbiguousWarning')?.setAttribute('hidden', '');
    }

    // Populates every field from a validated GetEvent response. Only called
    // after openEditModal has confirmed the response still belongs to the
    // currently-requested event (see its own stale-response guard).
    function populateEditEventForm(data) {
        document.getElementById('editEventId').value = data.id;
        document.getElementById('editEventTitle').value = data.eventTitle;
        document.getElementById('editEventDescription').value = data.description;
        document.getElementById('editEventDate').value = data.eventDate;
        document.getElementById('editEventTime').value = data.eventTime;
        document.getElementById('editEventDuration').value = data.estimatedDuration;
        document.getElementById('editEventCapacity').value = data.capacity;
        document.getElementById('editEventAnnouncements').value = data.announcements || '';
        document.getElementById('editEventPaymentDetails').value = data.paymentDetails || '';

        // Trail select: set the value directly and resync via
        // CustomSelect.refresh() (custom-select.js's own supported
        // synchronization path) rather than dispatching a synthetic
        // 'change' - refresh() updates the visible trigger/listbox without
        // ever firing 'change', so hydration can't accidentally trigger
        // handleEditEventTrailChange's trail-detail/weather fetch. The
        // preview cards below are filled directly from this same GetEvent
        // response instead, so no extra request is needed at all, and
        // duration/capacity (already set above) are never touched by one.
        const trailSelect = document.getElementById('editEventTrailId');
        if (trailSelect) {
            trailSelect.value = String(data.trailId);
            if (window.CustomSelect) window.CustomSelect.refresh(trailSelect);
        }

        document.getElementById('editPreviewDifficulty').textContent = data.trailDifficulty || '-';
        document.getElementById('editPreviewDistance').textContent = (data.trailDistanceKm != null ? data.trailDistanceKm + ' km' : '-');
        document.getElementById('editPreviewElevation').textContent = (data.trailElevationGainMeters != null ? data.trailElevationGainMeters + ' m' : '-');
        document.getElementById('editPreviewLocation').textContent = data.trailLocation || '-';
        document.getElementById('editPreviewTerrain').textContent = data.trailTerrain || '-';
        document.getElementById('editPreviewTerrainType').textContent = data.trailClassLabel || '-';

        // Pickup Schedules: structured hydration, including legacy entries
        // with requiresTime true.
        editEventPickupSchedules = (data.pickupSchedules || []).map(function (schedule) {
            return {
                location: schedule.location,
                time: schedule.time,
                requiresTime: !!schedule.requiresTime
            };
        });
        editEventPickupEditIndex = null;
        renderEditEventPickupSchedules();

        // Weather: the advisory text/risk/reminder hydrate the same way
        // regardless of what follows - never parsed into fake structured
        // metrics either way.
        const weatherInput = document.getElementById('editEventWeather');
        if (weatherInput) weatherInput.value = data.weatherForecastAdvisory || '';
        document.getElementById('editEventWeatherRiskLevel').value = data.weatherRiskLevel || '';
        document.getElementById('editEventWeatherReminder').value = data.weatherReminder || '';

        const riskBadge = document.getElementById('editEventWeatherRiskBadge');
        if (riskBadge) {
            if (data.weatherRiskLevel) {
                riskBadge.textContent = data.weatherRiskLevel;
                riskBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-semibold ' + getRiskBadgeClasses(data.weatherRiskLevel);
            } else {
                riskBadge.classList.add('hidden');
            }
        }

        document.getElementById('editWeatherRefreshFailedNote')?.setAttribute('hidden', '');
        document.getElementById('editWeatherStaleContextNote')?.setAttribute('hidden', '');

        // Three outcomes:
        //   1. A saved structured snapshot whose own TrailId/ForecastDate
        //      match this event's current trailId/eventDate -> render the
        //      full modern card, restored (never re-fetched), clearly
        //      marked "Saved forecast" (see renderEditEventWeatherResult).
        //   2. A saved snapshot that does NOT match (the event's trail/date
        //      changed since it was captured, with no successful refresh
        //      saved since) -> its metrics are never shown as current; the
        //      existing saved/stale advisory panel is used instead, with
        //      wording that makes the mismatch explicit. The old snapshot
        //      and advisory text are only read here, never mutated.
        //   3. No snapshot at all (legacy event, or one that's never had a
        //      successful forecast saved) -> exactly the prior behavior:
        //      the text-only advisory panel, or waiting if there's no
        //      advisory text either.
        const snapshot = data.weatherSnapshot;
        const snapshotMatchesCurrent = !!(snapshot && snapshot.trailId === data.trailId && snapshot.forecastDate === data.eventDate);

        if (snapshotMatchesCurrent) {
            renderEditEventWeatherResult(snapshot, snapshot.trailId, snapshot.forecastDate, true);
        } else {
            editEventWeatherSnapshot = null;

            if (data.weatherForecastAdvisory) {
                const headingEl = document.getElementById('editWeatherSavedHeading');
                if (headingEl) headingEl.textContent = 'Saved weather advisory';
                const savedTextEl = document.getElementById('editWeatherSavedText');
                if (savedTextEl) savedTextEl.textContent = data.weatherForecastAdvisory;
                if (snapshot) {
                    // Stale, not missing - a real snapshot exists, it just
                    // no longer matches the current trail/date.
                    document.getElementById('editWeatherStaleContextNote')?.removeAttribute('hidden');
                }
                setEditEventWeatherState('saved');
            } else {
                setEditEventWeatherState('waiting');
            }
        }

        // Organizer: Admin sees a select pre-selected only on an exact,
        // unique match against the currently stored display name - zero or
        // multiple matches leave it unselected with a visible warning rather
        // than guessing. An Organizer sees no control at all (see the
        // role-dependent Step 3 markup), so this block simply doesn't apply.
        const organizerSelect = document.getElementById('editEventOrganizerId');
        const warning = document.getElementById('editEventOrganizerAmbiguousWarning');
        const warningText = document.getElementById('editEventOrganizerAmbiguousWarningText');

        if (organizerSelect && !organizerSelect.disabled) {
            const matches = Array.from(organizerSelect.options).filter(function (opt) {
                return opt.value && opt.dataset.displayName === data.organizedBy;
            });

            if (matches.length === 1) {
                organizerSelect.value = matches[0].value;
                warning?.setAttribute('hidden', '');
            } else {
                organizerSelect.value = '';
                if (warningText) {
                    warningText.textContent = matches.length === 0
                        ? 'Could not automatically match the current organizer ("' + (data.organizedBy || 'none recorded') + '"). Please select the correct organizer.'
                        : 'Multiple organizer accounts match the current organizer name ("' + data.organizedBy + '"). Please select the correct one.';
                }
                warning?.removeAttribute('hidden');
            }
            if (window.CustomSelect) window.CustomSelect.refresh(organizerSelect);
        }

        const statusSelect = document.getElementById('editEventStatus');
        if (statusSelect) {
            statusSelect.value = data.status || 'Upcoming';
            if (window.CustomSelect) window.CustomSelect.refresh(statusSelect);
        }
    }

    // Fetch-first, open-second: the modal never opens on a failed load, so
    // there's no jarring open-then-close, and "leave the page usable" on
    // failure is automatic - nothing about the page changed except a toast.
    // editEventLoadToken (bumped per call) plus an AbortController together
    // guard against a late response from an earlier open overwriting a
    // newer one; the AbortController also cancels the actual in-flight
    // request instead of just ignoring its result.
    async function openEditModal(triggerEl, id) {
        if (!Number.isInteger(id) || id <= 0) return;

        if (editEventAbortController) editEventAbortController.abort();
        const abortController = new AbortController();
        editEventAbortController = abortController;

        const requestToken = ++editEventLoadToken;

        try {
            const response = await fetch(`/Event/GetEvent?id=${id}`, { signal: abortController.signal });
            const data = await response.json();

            if (requestToken !== editEventLoadToken) return;

            if (!data.success) {
                showToast(data.message || 'Unable to load this event. Please try again.', 'error');
                return;
            }

            editEventCurrentEventId = data.id;
            resetEditEventDisplay();
            populateEditEventForm(data);

            editCurrentStep = 1;
            editUpdateStepUI();

            EditEventModal.open(triggerEl);
        } catch (error) {
            if (abortController.signal.aborted) return;
            if (requestToken !== editEventLoadToken) return;
            console.error('Error loading event:', error);
            showToast('Unable to load this event. Please try again.', 'error');
        }
    }

    function closeEditEventModal() {
        if (editEventAbortController) {
            editEventAbortController.abort();
            editEventAbortController = null;
        }
        // Invalidates any in-flight GetEvent/weather response for this
        // close, same mechanism as a newer openEditModal call.
        editEventLoadToken++;
        editEventWeatherRequestToken++;

        EditEventModal.close();

        const form = document.getElementById('editEventForm');
        if (form) form.reset();
        setEditEventSubmitting(false);

        editEventCurrentEventId = null;
        resetEditEventDisplay();
    }

    function setEditEventSubmitting(isSubmitting) {
        const submitBtn = document.getElementById('editSubmitBtn');
        const icon = document.getElementById('editSubmitBtnIcon');
        const label = document.getElementById('editSubmitBtnLabel');
        if (!submitBtn) return;

        submitBtn.disabled = isSubmitting;
        if (icon) icon.className = isSubmitting ? 'fa-solid fa-spinner fa-spin motion-reduce:animate-none' : 'fa-solid fa-check';
        if (label) label.textContent = isSubmitting ? 'Updating Event...' : 'Update Event';
    }

    async function handleEditEventSubmit(e) {
        e.preventDefault();

        if (!editValidateStep(3)) return;

        const eventId = parseInt(document.getElementById('editEventId')?.value, 10);
        const trailId = parseInt(document.getElementById('editEventTrailId')?.value, 10);
        const duration = parseFloat(document.getElementById('editEventDuration')?.value);
        const capacity = parseInt(document.getElementById('editEventCapacity')?.value, 10);

        const eventData = {
            Id: Number.isFinite(eventId) ? eventId : null,
            EventTitle: document.getElementById('editEventTitle')?.value,
            Description: document.getElementById('editEventDescription')?.value,
            EventDate: document.getElementById('editEventDate')?.value,
            EventTime: document.getElementById('editEventTime')?.value,
            TrailId: Number.isFinite(trailId) ? trailId : null,
            EstimatedDuration: Number.isFinite(duration) ? duration : null,
            Capacity: Number.isFinite(capacity) ? capacity : null,
            // Present only for an Admin caller. An Organizer's request always
            // sends null here; EventController.EditEvent ignores this field
            // for a non-Admin caller and preserves the event's existing
            // organizer instead.
            OrganizerId: editEventOrganizerSelect ? (editEventOrganizerSelect.value || null) : null,
            WeatherForecastAdvisory: document.getElementById('editEventWeather')?.value,
            WeatherRiskLevel: document.getElementById('editEventWeatherRiskLevel')?.value,
            WeatherReminder: document.getElementById('editEventWeatherReminder')?.value,
            // Present only when a snapshot currently matching the selected
            // trail/date exists (either restored unchanged from hydration or
            // just successfully refreshed - see editEventWeatherSnapshot's
            // own comment). Null otherwise, in which case
            // EventController.EditEvent preserves whatever snapshot the
            // event already had rather than erasing it - a failed refresh or
            // an unrelated field edit never needs to resubmit anything here.
            WeatherSnapshot: editEventWeatherSnapshot,
            NotesAndReminders: document.getElementById('editEventAnnouncements')?.value,
            PaymentDetails: document.getElementById('editEventPaymentDetails')?.value,
            // Structured schedules, never a raw PickupPoints string -
            // EventController.EditEvent (via PickupScheduleHelper) is the
            // sole authority that turns these into the canonical stored lines.
            PickupSchedules: editEventPickupSchedules.map(function (schedule) {
                return { Location: schedule.location, Time: schedule.time };
            }),
            Status: document.getElementById('editEventStatus')?.value
        };

        setEditEventSubmitting(true);

        try {
            const response = await postJson('/Event/EditEvent', eventData);
            const result = await response.json();

            if (result.success) {
                showToast('Event updated successfully!', 'success');
                closeEditEventModal();
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast(result.message || 'Unable to update event.', 'error');
                setEditEventSubmitting(false);
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('Error updating event', 'error');
            setEditEventSubmitting(false);
        }
    }

    // Everything Edit Event needs from the DOM now lives inside
    // @@section Modals alongside Add Event's own modal, which the layout
    // renders after this page's own body content (RenderBody) - so, exactly
    // like Add Event, every listener has to be bound after DOMContentLoaded
    // rather than at top-level script execution. Kept as its own separate
    // DOMContentLoaded handler (not merged into Add Event's
    // initAddEventModalBindings) so the two modals' initialization can never
    // become entangled.
    document.addEventListener('DOMContentLoaded', function initEditEventModalBindings() {
        editEventOrganizerSelect = document.getElementById('editEventOrganizerId');
        editEventOrganizerUnavailable = !!(editEventOrganizerSelect && editEventOrganizerSelect.disabled);

        document.getElementById('editNextBtn')?.addEventListener('click', handleEditEventNextClick);
        document.getElementById('editPrevBtn')?.addEventListener('click', handleEditEventPrevClick);
        document.getElementById('editEventTrailId')?.addEventListener('change', handleEditEventTrailChange);
        document.getElementById('editEventDate')?.addEventListener('change', handleEditEventDateChange);
        document.getElementById('editEventForm')?.addEventListener('submit', handleEditEventSubmit);

        document.getElementById('editPickupScheduleAddBtn')?.addEventListener('click', handleEditEventPickupAddClick);
        document.getElementById('editPickupScheduleCancelEditBtn')?.addEventListener('click', handleEditEventPickupCancelEditClick);
        document.getElementById('editPickupSchedulesList')?.addEventListener('click', handleEditEventPickupListClick);
        document.getElementById('editPickupScheduleLocationInput')?.addEventListener('keydown', handleEditEventPickupInputKeydown);
        document.getElementById('editPickupScheduleTimeInput')?.addEventListener('keydown', handleEditEventPickupInputKeydown);
    });

    async function deleteEvent(id, title) {
        if (!confirm(`Are you sure you want to delete "${title}"? This action cannot be undone.`)) {
            return;
        }
        
        try {
            const response = await postJson('/Event/DeleteEvent', { id: id });
            
            const result = await response.json();
            
            if (result.success) {
                showToast('Event deleted successfully', 'success');
                setTimeout(() => {
                    location.reload();
                }, 1500);
            } else {
                showToast('Error deleting event: ' + result.message, 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('Error deleting event', 'error');
        }
    }

    // Event ID and title travel as data-* attributes (Razor-encoded on render,
    // read back as plain text via getAttribute) rather than as literal arguments in
    // an inline onclick - a title containing an apostrophe, backslash, or line break
    // could otherwise break the generated JavaScript outright. Mirrors the delete
    // binding on Views/Trail/Index.cshtml's trail cards.
    document.addEventListener('click', function (e) {
        const deleteEventBtn = e.target.closest('.delete-event-btn');
        if (deleteEventBtn) {
            const eventId = Number(deleteEventBtn.getAttribute('data-event-id'));
            const eventTitle = deleteEventBtn.getAttribute('data-event-title') || '';
            if (Number.isInteger(eventId) && eventId > 0) {
                deleteEvent(eventId, eventTitle);
            }
        }
    });

    // showToast(message, type) is now the canonical implementation in
    // wwwroot/js/toast.js, loaded globally from _Layout.cshtml.
</script>
