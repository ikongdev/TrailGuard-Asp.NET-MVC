                    </div>
                    <button type="button" id="cancelEventModalCloseBtn" aria-label="Close" class="shrink-0 text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded">
                        <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="overflow-y-auto custom-scrollbar flex-1 p-6 space-y-4">
                    <p class="text-gray-400 text-sm">This cancels the event for all participants and cannot be undone.</p>
                    <div>
                        <label for="cancelReason" class="block text-sm font-medium text-gray-300 mb-2">Cancellation Reason <span class="text-red-400">*</span></label>
                        <textarea id="cancelReason" rows="4" required
                                  class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-red-500/60 focus:ring-1 focus:ring-red-500/60 transition-colors text-sm resize-none"
                                  placeholder="e.g. Trail closed due to weather advisory"></textarea>
                    </div>
