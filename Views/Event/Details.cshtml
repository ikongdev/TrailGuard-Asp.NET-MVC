                <div class="flex gap-3 px-6 py-4 border-t border-white/10 shrink-0">
                    <button type="button" id="cancelEventKeepBtn"
                            class="flex-1 px-4 py-2.5 rounded-full text-gray-300 hover:text-white text-sm font-medium bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
                        Keep Event
                    </button>
                    <button type="button" id="cancelEventConfirmBtn"
                            class="flex-1 px-4 py-2.5 rounded-full text-red-200 hover:text-white text-sm font-semibold bg-red-950 hover:bg-red-900 border border-red-500/40 hover:border-red-400/60 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500/60 focus:ring-offset-2 focus:ring-offset-surface-card disabled:opacity-60 disabled:pointer-events-none">
                        <i class="fa-solid fa-ban mr-1" aria-hidden="true"></i> Confirm Cancellation
                    </button>
                </div>
            </div>
        </div>
    }
}

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }
    .max-h-125 {
        max-height: 125px;
    }
    .truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .break-all {
        word-break: break-all;
    }
    /* 🔥 Para sa disabled buttons */
    button:disabled {
        pointer-events: none;
    }
</style>

<script>
    const eventId = @Model.Id;

    function confirmCompleteEvent() {
        if (!confirm('Mark this event as completed?\n\nAny Pending, Awaiting Payment, or For Payment Verification registrations will be voided. This cannot be undone.')) return;

        postJson('/Event/CompleteEvent', { id: eventId })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                showToast(result.message, 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(result.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Error completing event', 'error');
        });
    }

    // Accessible modal lifecycle for Reschedule - mirrors AddEventModal in
    // Views/Event/Index.cshtml and TrailModal in Views/Trail/Index.cshtml
    // (focus trap, focus restoration, Escape, background inert, scroll lock),
    // kept as its own small single-purpose instance since this modal is just
    // two fields, not a multi-step wizard. Cancel Event's own modal is
    // deliberately left out of this repair - see the task scope.
    const RescheduleModal = (function () {
        const modalId = 'rescheduleModal';
        let isOpen = false;
        let lastFocusedElement = null;
        let inertedElements = [];
        let bodyOverflowBeforeModal = null;

        function getFocusableElements(container) {
            return Array.from(container.querySelectorAll(
                'a[href], button:not([disabled]), textarea:not([disabled]), ' +
                'input:not([disabled]):not([type="hidden"]), select:not([disabled]), ' +
                '[tabindex]:not([tabindex="-1"])'
            )).filter(function (el) { return el.offsetParent !== null; });
        }

        function makeBackgroundInert(modalRoot) {
            inertedElements = [];
            let current = modalRoot;

            while (current && current !== document.body) {
                const parent = current.parentElement;
                if (!parent) break;

                Array.from(parent.children).forEach(function (sibling) {
                    if (sibling === current || sibling.hasAttribute('inert')) return;
                    // The global toast host must stay interactive and in the
                    // accessibility tree no matter which modal is open - see
                    // wwwroot/js/toast.js.
                    if (window.tgToastHostExempt && window.tgToastHostExempt(sibling)) return;
                    sibling.setAttribute('inert', '');
                    inertedElements.push(sibling);
                });

                current = parent;
            }
        }

        function restoreBackgroundInert() {
            inertedElements.forEach(function (element) { element.removeAttribute('inert'); });
            inertedElements = [];
        }

        function handleKeydown(event) {
            if (!isOpen) return;
            const modal = document.getElementById(modalId);
            if (!modal) return;

            if (event.key === 'Escape') {
                close();
                return;
            }

            if (event.key === 'Tab') {
                // A visible toast's dismiss button is a permitted extra stop in
                // this trap (see wwwroot/js/toast.js) - nothing else in the
                // background is ever included.
                const toastCloseButtons = window.tgGetToastCloseButtons ? window.tgGetToastCloseButtons() : [];
                const focusable = getFocusableElements(modal).concat(toastCloseButtons);
                if (focusable.length === 0) {
                    event.preventDefault();
                    return;
                }
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            }
        }

        function open() {
            const modal = document.getElementById(modalId);
            if (!modal || isOpen) return;

            lastFocusedElement = document.activeElement;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            isOpen = true;
            makeBackgroundInert(modal);
            bodyOverflowBeforeModal = document.body.style.overflow;
            document.body.style.overflow = 'hidden';
            document.addEventListener('keydown', handleKeydown);

            const dateInput = document.getElementById('rescheduleDate');
            const target = dateInput || getFocusableElements(modal)[0] || modal;
            if (target && typeof target.focus === 'function') target.focus();
        }

        function close() {
            const modal = document.getElementById(modalId);
            if (!modal) return;

            if (window.CustomSelect) window.CustomSelect.closeAll();

            modal.classList.add('hidden');
            modal.classList.remove('flex');

            if (!isOpen) return;
            isOpen = false;
            restoreBackgroundInert();
            document.body.style.overflow = bodyOverflowBeforeModal || '';
            bodyOverflowBeforeModal = null;
            document.removeEventListener('keydown', handleKeydown);

            const confirmBtn = document.getElementById('rescheduleConfirmBtn');
            if (confirmBtn) confirmBtn.disabled = false;

            if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                lastFocusedElement.focus();
            }
            lastFocusedElement = null;
        }

        return { open: open, close: close };
    })();

    function submitReschedule() {
        const date = document.getElementById('rescheduleDate').value;
        const time = document.getElementById('rescheduleTime').value;

        if (!date || !time) {
            showToast('Please provide both a date and time', 'error');
            return;
        }

        const confirmBtn = document.getElementById('rescheduleConfirmBtn');
        if (confirmBtn) confirmBtn.disabled = true;

        postJson('/Event/RescheduleEvent', { id: eventId, newDate: date, newTime: time })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                showToast(result.message, 'success');
                RescheduleModal.close();
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(result.message, 'error');
                if (confirmBtn) confirmBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Error rescheduling event', 'error');
            if (confirmBtn) confirmBtn.disabled = false;
        });
    }

    // Bound once here rather than via inline onclick, per the Reschedule
    // modal's accessible-lifecycle requirements - every other lifecycle
    // action (Escape, backdrop, close, Cancel) routes through the same
    // RescheduleModal.close() cleanup path.
    document.addEventListener('DOMContentLoaded', function initRescheduleModalBindings() {
        document.getElementById('openRescheduleModalBtn')?.addEventListener('click', RescheduleModal.open);
        document.getElementById('rescheduleModalCloseBtn')?.addEventListener('click', RescheduleModal.close);
        document.getElementById('rescheduleCancelBtn')?.addEventListener('click', RescheduleModal.close);
        document.getElementById('rescheduleConfirmBtn')?.addEventListener('click', submitReschedule);
        document.querySelector('#rescheduleModal [data-reschedule-backdrop]')?.addEventListener('click', RescheduleModal.close);
    });

    // Accessible modal lifecycle for Cancel Event - structurally identical to
    // RescheduleModal above (focus trap, focus restoration, Escape,
    // background inert, scroll lock), kept as its own separate instance so
    // the two modals' open/closed state can never be confused. Since both
    // now live as top-level siblings in @@section Modals, opening either one
    // inerts every other top-level sibling - including the other modal and
    // both trigger buttons in the page content - which is what actually
    // guarantees Reschedule and Cancel can never be open at the same time.
    const CancelEventModal = (function () {
        const modalId = 'cancelEventModal';
        let isOpen = false;
        let lastFocusedElement = null;
        let inertedElements = [];
        let bodyOverflowBeforeModal = null;

        function getFocusableElements(container) {
            return Array.from(container.querySelectorAll(
                'a[href], button:not([disabled]), textarea:not([disabled]), ' +
                'input:not([disabled]):not([type="hidden"]), select:not([disabled]), ' +
                '[tabindex]:not([tabindex="-1"])'
            )).filter(function (el) { return el.offsetParent !== null; });
        }

        function makeBackgroundInert(modalRoot) {
            inertedElements = [];
            let current = modalRoot;

            while (current && current !== document.body) {
                const parent = current.parentElement;
                if (!parent) break;

                Array.from(parent.children).forEach(function (sibling) {
                    if (sibling === current || sibling.hasAttribute('inert')) return;
                    // The global toast host must stay interactive and in the
                    // accessibility tree no matter which modal is open - see
                    // wwwroot/js/toast.js.
                    if (window.tgToastHostExempt && window.tgToastHostExempt(sibling)) return;
                    sibling.setAttribute('inert', '');
                    inertedElements.push(sibling);
                });

                current = parent;
            }
        }

        function restoreBackgroundInert() {
            inertedElements.forEach(function (element) { element.removeAttribute('inert'); });
            inertedElements = [];
        }

        function handleKeydown(event) {
            if (!isOpen) return;
            const modal = document.getElementById(modalId);
            if (!modal) return;

            if (event.key === 'Escape') {
                close();
                return;
            }

            if (event.key === 'Tab') {
                // A visible toast's dismiss button is a permitted extra stop in
                // this trap (see wwwroot/js/toast.js) - nothing else in the
                // background is ever included.
                const toastCloseButtons = window.tgGetToastCloseButtons ? window.tgGetToastCloseButtons() : [];
                const focusable = getFocusableElements(modal).concat(toastCloseButtons);
                if (focusable.length === 0) {
                    event.preventDefault();
                    return;
                }
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            }
        }

        function open() {
            const modal = document.getElementById(modalId);
            if (!modal || isOpen) return;

            lastFocusedElement = document.activeElement;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            isOpen = true;
            makeBackgroundInert(modal);
            bodyOverflowBeforeModal = document.body.style.overflow;
            document.body.style.overflow = 'hidden';
            document.addEventListener('keydown', handleKeydown);

            const reasonInput = document.getElementById('cancelReason');
            const target = reasonInput || getFocusableElements(modal)[0] || modal;
            if (target && typeof target.focus === 'function') target.focus();
        }

        function close() {
            const modal = document.getElementById(modalId);
            if (!modal) return;

            if (window.CustomSelect) window.CustomSelect.closeAll();

            modal.classList.add('hidden');
            modal.classList.remove('flex');

            if (!isOpen) return;
            isOpen = false;
            restoreBackgroundInert();
            document.body.style.overflow = bodyOverflowBeforeModal || '';
            bodyOverflowBeforeModal = null;
            document.removeEventListener('keydown', handleKeydown);

            const confirmBtn = document.getElementById('cancelEventConfirmBtn');
            if (confirmBtn) confirmBtn.disabled = false;

            if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                lastFocusedElement.focus();
            }
            lastFocusedElement = null;
        }

        return { open: open, close: close };
    })();

    // Clicking "Confirm Cancellation" is itself the deliberate destructive
    // confirmation step (modal open + a required typed reason + this
    // explicit click) - a native confirm() used to run after this too,
    // which was a redundant second confirmation on top of an already-
    // deliberate action and is removed here, not preserved.
    function submitCancelEvent() {
        const reason = document.getElementById('cancelReason').value.trim();

        if (!reason) {
            showToast('A cancellation reason is required', 'error');
            return;
        }

        const confirmBtn = document.getElementById('cancelEventConfirmBtn');
        if (confirmBtn) confirmBtn.disabled = true;

        postJson('/Event/CancelEvent', { id: eventId, reason: reason })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                showToast(result.message, 'success');
                CancelEventModal.close();
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(result.message, 'error');
                if (confirmBtn) confirmBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Error cancelling event', 'error');
            if (confirmBtn) confirmBtn.disabled = false;
        });
    }

    // Bound once here rather than via inline onclick, matching Reschedule's
    // own binding block - every other lifecycle action (Escape, backdrop,
    // close, Keep Event) routes through the same CancelEventModal.close()
    // cleanup path.
    document.addEventListener('DOMContentLoaded', function initCancelEventModalBindings() {
        document.getElementById('openCancelEventModalBtn')?.addEventListener('click', CancelEventModal.open);
        document.getElementById('cancelEventModalCloseBtn')?.addEventListener('click', CancelEventModal.close);
        document.getElementById('cancelEventKeepBtn')?.addEventListener('click', CancelEventModal.close);
        document.getElementById('cancelEventConfirmBtn')?.addEventListener('click', submitCancelEvent);
        document.querySelector('#cancelEventModal [data-cancel-event-backdrop]')?.addEventListener('click', CancelEventModal.close);
    });

    // showToast(message, type) is now the canonical implementation in
    // wwwroot/js/toast.js, loaded globally from _Layout.cshtml.
</script>