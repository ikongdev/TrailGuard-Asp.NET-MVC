@model TrailGuard.Models.Event
@using TrailGuard.Models
@{
    ViewData["Title"] = Model.EventTitle;
    var trail = ViewBag.Trail as TrailGuard.Models.Trail;
    var registrations = ViewBag.Registrations as List<EventRegistration> ?? new List<EventRegistration>();
    var registeredCount = ViewBag.RegisteredCount ?? 0;
    var availableSlots = ViewBag.AvailableSlots ?? 0;
    var isFull = availableSlots <= 0;
    var organizer = ViewBag.Organizer as ApplicationUser;
    var isCompleted = Model.Status == "Completed";
    var isCancelled = Model.Status == "Cancelled";
    var isUpcoming = Model.Status == "Upcoming";

    var joinedParticipants = registrations
        .Where(r => r.Status == "Accepted" || r.Status == "Pending")
        .OrderBy(r => r.RegisteredAt)
        .ToList();
    var totalJoined = joinedParticipants.Count;
    var hasMoreParticipants = totalJoined > 5;

    string statusSelectClasses = Model.Status switch
    {
        "Upcoming" => "bg-green-500/10 border-green-500/40 text-green-300",
        "Cancelled" => "bg-red-500/10 border-red-500/40 text-red-300",
        "Postponed" => "bg-yellow-500/10 border-yellow-500/40 text-yellow-300",
        "Completed" => "bg-gray-500/10 border-gray-500/40 text-gray-300",
        _ => "bg-gray-500/10 border-gray-500/40 text-gray-300"
    };
    string statusDotClasses = Model.Status switch
    {
        "Upcoming" => "bg-green-400",
        "Cancelled" => "bg-red-400",
        "Postponed" => "bg-yellow-400",
        "Completed" => "bg-gray-400",
        _ => "bg-gray-400"
    };

    // One switch reused for every risk badge on this page, regardless of
    // whether the badge is driven by a matching structured snapshot or the
    // legacy Model.WeatherRiskLevel field - see the Weather card below.
    string WeatherRiskBadgeClasses(string? risk) => risk switch
    {
        "Low" => "bg-green-500/20 text-green-400 border-green-500/30",
        "Moderate" => "bg-amber-500/20 text-amber-400 border-amber-500/30",
        "Moderate to High" => "bg-orange-500/20 text-orange-400 border-orange-500/30",
        "High (Thunderstorm)" => "bg-red-500/20 text-red-400 border-red-500/30",
        _ => "bg-gray-500/20 text-gray-400 border-gray-500/30"
    };

    // Terrain chips: safe split of the stored comma-delimited value - trimmed,
    // blanks dropped, first-occurrence order preserved, case-insensitive
    // de-duplication added here since the read-only display context (unlike
    // the editable checkbox chips in Trail/_TerrainChips.cshtml, which aren't
    // compatible with a non-form display) has no built-in dedupe of its own.
    // Trail.Terrain itself is never modified.
    var terrainChips = (trail?.Terrain ?? string.Empty)
        .Split(',')
        .Select(t => t.Trim())
        .Where(t => t.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    // Weather snapshot: only ever treated as "current" through the same
    // TryValidateForSubmission check Add/Edit Event uses before persisting
    // one, so "does this snapshot still match the event" can't drift into a
    // second, slightly different definition here.
    var weatherSnapshot = TrailGuard.Services.WeatherSnapshotHelper.TryDeserialize(Model.WeatherSnapshotJson);
    var weatherSnapshotIsCurrent = weatherSnapshot != null &&
        TrailGuard.Services.WeatherSnapshotHelper.TryValidateForSubmission(weatherSnapshot, Model.TrailId, Model.EventDate, out _);
    var weatherSnapshotIsStale = weatherSnapshot != null && !weatherSnapshotIsCurrent;

    var pickupScheduleEntries = TrailGuard.Services.PickupScheduleHelper.ParseStoredEntries(Model.PickupPoints);
}

<div class="pt-24 px-4 max-w-6xl mx-auto min-h-screen text-white pb-12">

    @* Success/Error feedback now goes through the canonical global toast host
       in _Layout.cshtml instead of a page-local banner. *@

    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors group">
            <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
            Back to Events
        </a>
    </div>

    <div class="relative rounded-3xl overflow-hidden mb-8">
        @if (!string.IsNullOrEmpty(trail?.ThumbnailUrl))
        {
            <img src="@trail.ThumbnailUrl" alt="@trail.Name" class="w-full h-80 object-cover">
        }
        else
        {
            <div class="w-full h-80 bg-linear-to-r from-orange-500/30 to-purple-500/30 flex items-center justify-center">
                <i class="fa-solid fa-mountain text-6xl text-white/50"></i>
            </div>
        }
        <div class="absolute inset-0 bg-linear-to-t from-surface-card via-surface-card/50 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8">
            <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex items-center gap-2 pl-4 pr-4 py-1.5 rounded-full text-xs font-semibold border @statusSelectClasses">
                    <span class="w-1.5 h-1.5 rounded-full @statusDotClasses"></span>
                    @Model.Status
                </span>

                @if (isFull && isUpcoming)
                {
                    <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-red-500/20 text-red-400">
                        <i class="fa-solid fa-circle-exclamation mr-1"></i> Full
                    </span>
                }
            </div>
            <h1 class="text-4xl font-bold text-white mb-2">@Model.EventTitle</h1>
            <div class="flex flex-wrap gap-4 text-gray-300">
                <span><i class="fa-regular fa-calendar text-orange-400 mr-2"></i>@Model.EventDate.ToString("MMMM dd, yyyy")</span>
                <span><i class="fa-regular fa-clock text-orange-400 mr-2"></i>@($"{Model.EventTime.Hours:D2}:{Model.EventTime.Minutes:D2} {(Model.EventTime.Hours >= 12 ? "PM" : "AM")}")</span>
                <span><i class="fa-solid fa-location-dot text-orange-400 mr-2"></i>@Model.Location</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <div class="lg:col-span-2 space-y-6">

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-info-circle text-orange-400 mr-2"></i>Event Overview</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-mountain text-orange-400 mr-1"></i>Trail</p>
                        <p class="text-white font-semibold">@trail?.Name</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-route text-orange-400 mr-1"></i>Distance</p>
                        <p class="text-white font-semibold">@trail?.DistanceKm km</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider mb-1.5"><i class="fa-solid fa-tree text-orange-400 mr-1"></i>Terrain</p>
                        @if (terrainChips.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var chip in terrainChips)
                                {
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-gray-300">@chip</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-gray-500 text-sm italic">Not specified</p>
                        }
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider mb-1.5"><i class="fa-solid fa-signal text-orange-400 mr-1"></i>Difficulty</p>
                        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium @TrailGuard.Services.DifficultyCalculator.BadgeClass(Model.Difficulty)">@(string.IsNullOrEmpty(Model.Difficulty) ? "Unknown" : Model.Difficulty)</span>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-arrow-trend-up text-orange-400 mr-1"></i>Elevation Gain</p>
                        <p class="text-white font-semibold">@trail?.ElevationGainMeters m</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-hand text-orange-400 mr-1"></i>Trail Class</p>
                        <p class="text-white font-semibold">@TrailGuard.Services.DifficultyCalculator.TrailClassLabel(trail?.TrailClass ?? 0)</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-clock text-orange-400 mr-1"></i>Estimated Duration</p>
                        <p class="text-white font-semibold">@Model.EstimatedDuration hours</p>
                    </div>
                </div>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-cloud-sun text-orange-400 mr-2"></i>Weather</h2>

                @if (weatherSnapshotIsCurrent)
                {
                    var snap = weatherSnapshot!;
                    <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                        <div class="flex items-start justify-between gap-2 mb-3">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-9 h-9 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                    <i class="fa-solid @TrailGuard.Services.WeatherSnapshotHelper.GetIconClass(snap.WeatherCode) text-accent text-sm"></i>
                                </span>
                                <p class="text-sm font-semibold text-white wrap-break-word min-w-0">@snap.Condition</p>
                            </div>
                            @if (!string.IsNullOrEmpty(snap.RiskLevel))
                            {
                                <span class="shrink-0 px-2.5 py-0.5 rounded-full text-xs font-semibold border @WeatherRiskBadgeClasses(snap.RiskLevel)">@snap.RiskLevel Risk</span>
                            }
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                <i class="fa-solid fa-temperature-half text-gray-500 text-xs" aria-hidden="true"></i>
                                <p class="text-sm font-semibold text-white mt-1">
                                    @(snap.TemperatureMinC.HasValue && snap.TemperatureMaxC.HasValue ? $"{snap.TemperatureMinC:F0}°–{snap.TemperatureMaxC:F0}°C" : "—")
                                </p>
                                <p class="text-[10px] text-gray-500 uppercase tracking-wide">Temperature</p>
                            </div>
                            <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                <i class="fa-solid fa-droplet text-gray-500 text-xs" aria-hidden="true"></i>
                                <p class="text-sm font-semibold text-white mt-1">@(snap.ExpectedRainfallMm.HasValue ? $"{snap.ExpectedRainfallMm.Value.ToString("0.#")} mm" : "—")</p>
                                <p class="text-[10px] text-gray-500 uppercase tracking-wide">Expected rainfall</p>
                            </div>
                            <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                <i class="fa-solid fa-wind text-gray-500 text-xs" aria-hidden="true"></i>
                                <p class="text-sm font-semibold text-white mt-1">@(snap.WindSpeedKmh.HasValue ? $"{snap.WindSpeedKmh.Value:F0} km/h" : "—")</p>
                                <p class="text-[10px] text-gray-500 uppercase tracking-wide wrap-break-word">@snap.WindDescription</p>
                            </div>
                        </div>
                        @if (snap.UpdatedAt.HasValue)
                        {
                            <p class="text-[11px] text-gray-500 text-right mt-2">Updated @snap.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</p>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.WeatherForecastAdvisory))
                {
                    <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                        <div class="flex items-center justify-between gap-2 mb-2">
                            <p class="text-sm font-semibold text-gray-300"><i class="fa-solid fa-cloud text-gray-500 mr-1.5" aria-hidden="true"></i>Saved forecast</p>
                            @if (!string.IsNullOrEmpty(Model.WeatherRiskLevel))
                            {
                                <span class="shrink-0 px-2.5 py-0.5 rounded-full text-xs font-semibold border @WeatherRiskBadgeClasses(Model.WeatherRiskLevel)">@Model.WeatherRiskLevel Risk</span>
                            }
                        </div>
                        <p class="text-gray-300 text-sm whitespace-pre-wrap">@Model.WeatherForecastAdvisory</p>
                        @if (weatherSnapshotIsStale)
                        {
                            <div class="mt-3 bg-amber-500/10 border border-amber-500/30 rounded-lg p-3 flex items-start gap-2">
                                <i class="fa-solid fa-triangle-exclamation text-amber-400 mt-0.5 shrink-0" aria-hidden="true"></i>
                                <p class="text-amber-300 text-xs">This structured forecast was saved for a previous trail or date and no longer matches this event - showing the last saved advisory instead.</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-gray-500 italic text-sm">Weather forecast not recorded for this event.</p>
                }

                @if (!string.IsNullOrEmpty(Model.WeatherReminder))
                {
                    <div class="mt-4 pt-4 border-t border-white/10">
                        <p class="text-gray-500 text-xs uppercase tracking-wider mb-1"><i class="fa-regular fa-lightbulb mr-1"></i>Weather Reminder</p>
                        <p class="text-gray-300 text-sm whitespace-pre-wrap">@Model.WeatherReminder</p>
                    </div>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-file-lines text-orange-400 mr-2"></i>Event Description</h2>
                <p class="text-gray-300 leading-relaxed whitespace-pre-wrap">@Model.Description</p>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-regular fa-calendar-plus text-orange-400 mr-2"></i>Schedule and Capacity</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider">Date</p>
                        <p class="text-white font-semibold">@Model.EventDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider">Time</p>
                        <p class="text-white font-semibold">@($"{Model.EventTime.Hours:D2}:{Model.EventTime.Minutes:D2} {(Model.EventTime.Hours >= 12 ? "PM" : "AM")}")</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider">Total Capacity</p>
                        <p class="text-white font-semibold">@Model.Capacity slots</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider">Available Slots</p>
                        <p class="text-white font-semibold @(availableSlots <= 5 ? "text-orange-400" : "")">
                            @availableSlots
                            @if (availableSlots <= 5 && availableSlots > 0)
                            {
                                <span class="text-xs text-orange-400/70 ml-1">(limited)</span>
                            }
                            @if (availableSlots <= 0)
                            {
                                <span class="text-xs text-red-400 ml-1">(full)</span>
                            }
                        </p>
                    </div>
                </div>

                @if (Model.Capacity > 0)
                {
                    var fillPercentage = (registeredCount * 100) / Model.Capacity;
                    <div class="mt-4">
                        <div class="flex justify-between text-xs text-gray-400 mb-1">
                            <span>@registeredCount registered</span>
                            <span>@fillPercentage% full</span>
                        </div>
                        <div class="w-full h-2 bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-500 @(fillPercentage >= 90 ? "bg-red-500" : fillPercentage >= 70 ? "bg-yellow-500" : "bg-green-500")"
                                 style="width: @fillPercentage%"></div>
                        </div>
                    </div>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-credit-card text-orange-400 mr-2"></i>Payment Details</h2>
                @if (!string.IsNullOrEmpty(Model.PaymentDetails))
                {
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 whitespace-pre-wrap">@Model.PaymentDetails</p>
                    </div>
                }
                else
                {
                    <p class="text-gray-500 italic">No payment details provided for this event.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-bus text-orange-400 mr-2"></i>Pickup Schedules</h2>
                @if (pickupScheduleEntries.Count > 0)
                {
                    <ul class="space-y-2">
                        @foreach (var entry in pickupScheduleEntries)
                        {
                            <li class="flex items-center gap-3 rounded-lg bg-white/5 border border-white/10 px-4 py-2.5">
                                <i class="fa-solid fa-location-dot text-orange-400 shrink-0" aria-hidden="true"></i>
                                <span class="text-gray-300 text-sm wrap-break-word">@entry</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-gray-500 italic">No pickup schedules specified for this event.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-bullhorn text-orange-400 mr-2"></i>Notes & Reminders</h2>
                @if (!string.IsNullOrEmpty(Model.NotesAndReminders))
                {
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 whitespace-pre-wrap">@Model.NotesAndReminders</p>
                    </div>
                }
                else
                {
                    <p class="text-gray-500 italic">No announcements for this event.</p>
                }
            </div>
        </div>

        <div class="space-y-6 self-start">

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-user-tie text-orange-400 mr-2"></i>Organizer Details</h2>
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-12 h-12 rounded-full bg-linear-to-r from-orange-500 to-purple-500 flex items-center justify-center overflow-hidden shrink-0">
                        @if (organizer != null && !string.IsNullOrEmpty(organizer.ProfilePictureUrl))
                        {
                            <img src="@organizer.ProfilePictureUrl" alt="Organizer" class="w-12 h-12 rounded-full object-cover">
                        }
                        else
                        {
                            <i class="fa-solid fa-user text-white text-lg"></i>
                        }
                    </div>
                    <div>
                        <h3 class="text-white font-bold">
                            @if (organizer != null)
                            {
                                @(organizer.FirstName + " " + organizer.LastName)
                            }
                            else
                            {
                                @Model.OrganizedBy
                            }
                        </h3>
                        <p class="text-gray-500 text-xs">Event Organizer</p>
                    </div>
                </div>
                @if (organizer != null)
                {
                    <div class="space-y-2">
                        @if (!string.IsNullOrEmpty(organizer.FacebookLink))
                        {
                            <a href="@organizer.FacebookLink" target="_blank" class="flex items-center gap-2 text-gray-400 hover:text-orange-400 transition-colors text-sm break-all">
                                <i class="fa-brands fa-facebook w-5 shrink-0"></i>
                                <span class="break-all">@organizer.FacebookLink</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.Email))
                        {
                            <a href="mailto:@organizer.Email" class="flex items-center gap-2 text-gray-400 hover:text-orange-400 transition-colors text-sm">
                                <i class="fa-regular fa-envelope w-5 shrink-0"></i>
                                <span class="break-all">@organizer.Email</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.PhoneNumber))
                        {
                            <a href="tel:@organizer.PhoneNumber" class="flex items-center gap-2 text-gray-400 hover:text-orange-400 transition-colors text-sm">
                                <i class="fa-solid fa-phone w-5 shrink-0"></i>
                                <span>@organizer.PhoneNumber</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.Bio))
                        {
                            <p class="text-gray-400 text-sm mt-2 border-t border-white/10 pt-2">@organizer.Bio</p>
                        }
                    </div>
                }
                else
                {
                    <p class="text-gray-500 text-sm">Organizer contact details not available.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-lg font-bold text-white mb-4">
                    <i class="fa-solid fa-users-viewfinder text-orange-400 mr-2"></i>Registered Participants
                    <span class="text-sm font-normal text-gray-400 ml-2">(@totalJoined)</span>
                </h2>
                <div class="max-h-125 overflow-y-auto custom-scrollbar">
                    @if (joinedParticipants.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var reg in joinedParticipants.Take(5))
                            {
                                <div class="flex items-center gap-3 p-2 rounded-lg hover:bg-white/5 transition-colors">
                                    <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center overflow-hidden shrink-0">
                                        @if (!string.IsNullOrEmpty(reg.User?.ProfilePictureUrl))
                                        {
                                            <img src="@reg.User.ProfilePictureUrl" alt="Participant" class="w-8 h-8 rounded-full object-cover">
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-user text-gray-400 text-xs"></i>
                                        }
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-white text-sm font-medium truncate">@reg.ParticipantName</p>
                                        <p class="text-gray-500 text-xs">
                                            @if (reg.Status == "Accepted")
                                            {
                                                <span class="text-green-400"><i class="fa-solid fa-check-circle"></i> Confirmed</span>
                                            }
                                            else if (reg.Status == "Pending")
                                            {
                                                <span class="text-yellow-400"><i class="fa-solid fa-clock"></i> Pending</span>
                                            }
                                            else if (reg.Status == "Rejected")
                                            {
                                                <span class="text-red-400"><i class="fa-solid fa-xmark-circle"></i> Rejected</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            }

                            @if (hasMoreParticipants)
                            {
                                <div class="text-center text-gray-500 text-sm py-2">
                                    <i class="fa-solid fa-user-plus mb-1 block"></i>
                                    <span>+ @(totalJoined - 5) more participants</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center text-gray-500">
                                <i class="fa-regular fa-user text-2xl mb-2 block"></i>
                                <p class="text-sm">No participants registered yet.</p>
                                <p class="text-xs text-gray-600">Waiting for participants to join.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Lifecycle Actions Section -->
    <div class="mt-8 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

            <div class="flex flex-wrap items-center justify-center gap-2">
                <span class="inline-flex items-center gap-1.5 bg-white/5 border border-white/10 text-gray-400 text-sm rounded-full px-3 py-1.5">
                    <i class="fa-solid fa-users text-orange-400" aria-hidden="true"></i>
                    <span class="text-white font-semibold">@registeredCount</span> registered
                </span>

                @if (isUpcoming && !isFull)
                {
                    <span class="inline-flex items-center gap-1.5 bg-green-500/10 border border-green-500/30 text-green-400 text-sm rounded-full px-3 py-1.5">
                        <i class="fa-solid fa-circle-check" aria-hidden="true"></i> @availableSlots slots available
                    </span>
                }
                @if (isFull && isUpcoming)
                {
                    <span class="inline-flex items-center gap-1.5 bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-full px-3 py-1.5">
                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Event is full
                    </span>
                }
                @if (isCompleted)
                {
                    <span class="inline-flex items-center gap-1.5 bg-gray-500/10 border border-gray-500/30 text-gray-400 text-sm rounded-full px-3 py-1.5">
                        <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i>
                        Completed on @Model.CompletedAt?.ToString("MMM dd, yyyy h:mm tt")@(!string.IsNullOrEmpty(Model.CompletedBy) ? $" by {Model.CompletedBy}" : "")
                    </span>
                }
                @if (isCancelled)
                {
                    <span class="inline-flex items-center gap-1.5 bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-full px-3 py-1.5">
                        <i class="fa-solid fa-ban" aria-hidden="true"></i>
                        Cancelled on @Model.CancelledAt?.ToString("MMM dd, yyyy")
                    </span>
                }
            </div>

            <div class="flex flex-wrap items-center justify-center gap-3">
                @if (isUpcoming)
                {
                    <button type="button" onclick="confirmCompleteEvent()"
                       class="px-5 py-2.5 rounded-xl text-white text-sm font-semibold bg-emerald-600 hover:bg-emerald-500 transition-colors flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-surface-card">
                        <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> Mark as Complete
                    </button>
                    <button type="button" id="openRescheduleModalBtn"
                       class="px-5 py-2.5 rounded-xl text-blue-300 hover:text-white text-sm font-semibold bg-blue-500/15 hover:bg-blue-500/25 border border-blue-500/30 hover:border-blue-500/50 transition-colors flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-surface-card">
                        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i> Reschedule
                    </button>
                    <button type="button" id="openCancelEventModalBtn"
                       class="px-5 py-2.5 rounded-xl text-red-200 hover:text-white text-sm font-semibold bg-red-950/80 hover:bg-red-900 border border-red-500/40 hover:border-red-400/60 transition-colors flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-red-500/60 focus:ring-offset-2 focus:ring-offset-surface-card">
                        <i class="fa-solid fa-ban" aria-hidden="true"></i> Cancel Event
                    </button>
                }
                else if (isCompleted)
                {
                    @* Organizer-only feature - hidden from Admin-only and dual-role
                       Admin+Organizer users, matching CanAssessEventAsync in
                       OrganizerController (a dual-role account holds the Admin role
                       too and follows the Admin branch everywhere else in this app).
                       Computed server-side from the authenticated user's roles and
                       the Event's own stable OrganizerId - see EventController.Details'
                       ViewBag.CanAssessParticipants. *@
                    @if ((bool)(ViewBag.CanAssessParticipants ?? false))
                    {
                        <a asp-controller="Organizer" asp-action="PostEventAssessment" asp-route-eventId="@Model.Id"
                           class="px-5 py-2.5 rounded-xl text-blue-100 hover:text-white text-sm font-semibold bg-blue-950 hover:bg-blue-900 border border-blue-500/40 hover:border-blue-400/60 transition-colors flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-blue-500/60 focus:ring-offset-2 focus:ring-offset-surface-card">
                            <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i> Assess Participants
                        </a>
                    }
                    @* Comparison's destination (OrganizerController.EventComparison)
                       is Organizer-only but, unlike assessment, does not exclude a
                       dual-role Admin+Organizer account - only ownership is
                       required. So a dual-role user may see this link for an
                       Event they own; an Admin-only account (no Organizer role)
                       never does. See EventController.Details' ViewBag.CanViewComparison. *@
                    @if ((bool)(ViewBag.CanViewComparison ?? false))
                    {
                        <a asp-controller="Organizer" asp-action="EventComparison" asp-route-eventId="@Model.Id"
                           class="px-5 py-2.5 rounded-xl text-violet-200 hover:text-white text-sm font-semibold bg-violet-950/80 hover:bg-violet-900 border border-violet-500/40 hover:border-violet-400/60 transition-colors flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-violet-500/60 focus:ring-offset-2 focus:ring-offset-surface-card">
                            <i class="fa-solid fa-chart-simple" aria-hidden="true"></i> View Comparison
                        </a>
                    }
                }
            </div>
        </div>

        @if (isCancelled && !string.IsNullOrEmpty(Model.CancellationReason))
        {
            <div class="mt-4 pt-4 border-t border-white/10">
                <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">Cancellation Reason</p>
                <p class="text-gray-300 text-sm whitespace-pre-wrap">@Model.CancellationReason</p>
            </div>
        }
    </div>
</div>

@section Modals {
    @if (isUpcoming)
    {
        <!-- Reschedule Modal - repaired to the established @@section Modals /
             z-60 pattern (see DESIGN.md > Modals) instead of the broken z-100
             class + inline z-index that let it render underneath the navbar
             and footer. Mirrors AddEventModal's shell and lifecycle
             (Views/Event/Index.cshtml) as a small single-purpose instance. -->
        <div id="rescheduleModal" class="fixed inset-0 z-60 hidden items-center justify-center p-4">
            <div data-reschedule-backdrop class="fixed inset-0 bg-black/70 backdrop-blur-sm z-60" aria-hidden="true"></div>
            <div role="dialog" aria-modal="true" aria-labelledby="rescheduleModalTitle"
                 class="relative bg-surface-card border border-white/10 rounded-xl shadow-2xl w-full max-w-md max-h-[calc(100vh-2rem)] overflow-hidden flex flex-col z-60">

                <div class="flex items-start justify-between gap-4 px-6 py-4 border-b border-white/10 shrink-0">
                    <div class="flex items-center gap-3 min-w-0">
                        <span class="w-9 h-9 rounded-full bg-blue-500/15 border border-blue-500/30 flex items-center justify-center shrink-0" aria-hidden="true">
                            <i class="fa-solid fa-calendar-days text-blue-400 text-sm"></i>
                        </span>
                        <div class="min-w-0">
                            <h2 id="rescheduleModalTitle" class="text-lg font-bold text-white">Reschedule Event</h2>
                            <p class="text-xs text-gray-400">Choose a new date and time for this event.</p>
                        </div>
                    </div>
                    <button type="button" id="rescheduleModalCloseBtn" aria-label="Close" class="shrink-0 text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded">
                        <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="overflow-y-auto custom-scrollbar flex-1 p-6 space-y-4">
                    <div>
                        <label for="rescheduleDate" class="block text-sm font-medium text-gray-300 mb-2">New Date</label>
                        <input type="date" id="rescheduleDate" value="@Model.EventDate.ToString("yyyy-MM-dd")"
                               class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" />
                    </div>
                    <div>
                        <label for="rescheduleTime" class="block text-sm font-medium text-gray-300 mb-2">New Time</label>
                        <input type="time" id="rescheduleTime" value="@($"{Model.EventTime.Hours:D2}:{Model.EventTime.Minutes:D2}")"
                               class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" />
                    </div>
                    <p class="text-gray-500 text-xs flex items-start gap-1.5">
                        <i class="fa-solid fa-circle-info mt-0.5 shrink-0" aria-hidden="true"></i>
                        <span>Existing registrations carry over automatically - participants aren't asked to re-register.</span>
                    </p>
                </div>

                <div class="flex gap-3 px-6 py-4 border-t border-white/10 shrink-0">
                    <button type="button" id="rescheduleCancelBtn"
                            class="flex-1 px-4 py-2.5 rounded-full text-gray-300 hover:text-white text-sm font-medium bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
                        Cancel
                    </button>
                    <button type="button" id="rescheduleConfirmBtn"
                            class="flex-1 px-4 py-2.5 rounded-full text-blue-100 hover:text-white text-sm font-semibold bg-blue-950 hover:bg-blue-900 border border-blue-500/40 hover:border-blue-400/60 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500/60 focus:ring-offset-2 focus:ring-offset-surface-card disabled:opacity-60 disabled:pointer-events-none">
                        Confirm Reschedule
                    </button>
                </div>
            </div>
        </div>

        <!-- Cancel Event Modal - repaired to the same @@section Modals / z-60
             pattern as Reschedule above, replacing the broken z-100 class +
             inline z-index that let it render underneath the navbar and
             footer with no focus trap or background inert handling. Its own
             separate lifecycle instance (CancelEventModal), structurally
             identical to RescheduleModal, so the two can never be confused
             and one repair can't regress the other. -->
        <div id="cancelEventModal" class="fixed inset-0 z-60 hidden items-center justify-center p-4">
            <div data-cancel-event-backdrop class="fixed inset-0 bg-black/70 backdrop-blur-sm z-60" aria-hidden="true"></div>
            <div role="dialog" aria-modal="true" aria-labelledby="cancelEventModalTitle"
                 class="relative bg-surface-card border border-white/10 rounded-xl shadow-2xl w-full max-w-md max-h-[calc(100vh-2rem)] overflow-hidden flex flex-col z-60">

                <div class="flex items-start justify-between gap-4 px-6 py-4 border-b border-white/10 shrink-0">
                    <div class="flex items-center gap-3 min-w-0">
                        <span class="w-9 h-9 rounded-full bg-red-500/15 border border-red-500/30 flex items-center justify-center shrink-0" aria-hidden="true">
                            <i class="fa-solid fa-triangle-exclamation text-red-400 text-sm"></i>
                        </span>
                        <div class="min-w-0">
                            <h2 id="cancelEventModalTitle" class="text-lg font-bold text-white">Cancel Event</h2>
                            <p class="text-xs text-gray-400">This cannot be undone.</p>
