@using TrailGuard.Services
@model IEnumerable<EventBrowseCardViewModel>
@{
    ViewData["Title"] = "Browse Events";
}

@* Success/Error feedback now goes through the canonical global toast host
   in _Layout.cshtml instead of a page-local banner. *@

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Browse Events</h1>
            <p class="text-gray-400 mt-1 text-sm">Discover upcoming hiking events and register for your next adventure.</p>
        </div>
        <div class="bg-white/5 border border-white/10 px-4 py-2 rounded-full flex items-center gap-2">
            <i class="fa-regular fa-calendar text-accent"></i>
            <span class="text-sm text-gray-300"><strong class="text-white" id="eventCount">@Model.Count()</strong> events available</span>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-4 mb-8 bg-white/5 backdrop-blur-xl p-5 rounded-xl border border-white/10">
        <div class="relative grow">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="searchInput" placeholder="Search events by title or location..." 
                   class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-11 pr-4 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none transition-colors placeholder-gray-500">
        </div>

        <div class="flex flex-wrap sm:flex-nowrap gap-3">
            <div class="relative">
                <select id="trailFilter" class="bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors w-full">
                    <option value="All" class="bg-surface-card">All Trails</option>
                    @{
                        var trails = ViewBag.Trails as List<TrailGuard.Models.Trail>;
                        if (trails != null)
                        {
                            foreach (var trail in trails)
                            {
                                <option value="@trail.Id" class="bg-surface-card">@trail.Name</option>
                            }
                        }
                    }
                </select>
                <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                </div>
            </div>

            <div class="relative">
                <select id="difficultyFilter" class="bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors w-full">
                    <option value="All" class="bg-surface-card">All Difficulties</option>
                    <option value="Easy" class="bg-surface-card">Easy (PM 1–2/9)</option>
                    <option value="Minor Climb" class="bg-surface-card">Minor Climb (PM 3–4/9)</option>
                    <option value="Major Climb" class="bg-surface-card">Major Climb (PM 5–6/9)</option>
                    <option value="Major Climb — Difficult" class="bg-surface-card">Major Climb — Difficult (PM 7–9/9)</option>
                </select>
                <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                </div>
            </div>

            <div class="relative">
                <select id="sortFilter" class="bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors w-full">
                    <option value="date_asc" class="bg-surface-card">Date (Earliest)</option>
                    <option value="date_desc" class="bg-surface-card">Date (Latest)</option>
                    <option value="title_asc" class="bg-surface-card">Title (A-Z)</option>
                    <option value="title_desc" class="bg-surface-card">Title (Z-A)</option>
                    <option value="difficulty_asc" class="bg-surface-card">Difficulty (Low to High)</option>
                    <option value="difficulty_desc" class="bg-surface-card">Difficulty (High to Low)</option>
                </select>
                <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="events-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var card in Model)
            {
                var eventItem = card.Event;
                var diffBadge = DifficultyCalculator.BadgeClass(eventItem.Difficulty);
                var slotsLeft = eventItem.Capacity - eventItem.RegisteredCount;
                var adjustedRating = eventItem.Trail != null ? DifficultyCalculator.ComputeAdjustedRating(eventItem.Trail) : 0;
                var buttonState = RegistrationButtonHelper.GetState(card.RegistrationStatus, slotsLeft <= 0);

                var buttonClasses = buttonState.Style switch
                {
                    RegisterButtonStyle.Primary => "flex-1 bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] text-white py-2 rounded-full text-sm font-semibold transition duration-200 ease-out flex items-center justify-center gap-2",
                    RegisterButtonStyle.Muted => "flex-1 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-gray-300 hover:text-white py-2 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-2",
                    _ => "flex-1 bg-white/5 border border-white/10 text-gray-500 py-2 rounded-full text-sm font-semibold flex items-center justify-center gap-2 cursor-not-allowed"
                };

                <div class="event-card bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden hover:border-white/20 transition-colors flex flex-col"
                     data-title="@eventItem.EventTitle.ToLower()"
                     data-location="@eventItem.Location.ToLower()"
                     data-difficulty="@eventItem.Difficulty"
                     data-adjusted-rating="@adjustedRating.ToString("0.0")"
                     data-date="@eventItem.EventDate.ToString("yyyy-MM-dd")"
                     data-trail-id="@eventItem.TrailId">

                    <div class="relative h-40 overflow-hidden bg-black/30">
                        @if (!string.IsNullOrEmpty(eventItem.Trail?.ThumbnailUrl))
                        {
                            <img src="@eventItem.Trail.ThumbnailUrl" alt="@eventItem.Trail.Name" class="w-full h-full object-cover">
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center">
                                <i class="fa-solid fa-mountain text-4xl text-slate-700"></i>
                            </div>
                        }
                        <div class="absolute inset-0 bg-linear-to-t from-surface-card to-transparent opacity-80"></div>
                        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-medium @diffBadge">
                            @eventItem.Difficulty
                        </span>
                        <span class="absolute bottom-3 left-3 text-xs text-gray-300 bg-black/50 backdrop-blur-sm px-2.5 py-1 rounded-full">
                            <i class="fa-regular fa-calendar mr-1"></i> @eventItem.EventDate.ToString("MMM dd, yyyy")
                        </span>
                    </div>

                    <div class="p-4 flex flex-col grow">
                        <h3 class="text-lg font-bold text-white mb-1">@eventItem.EventTitle</h3>
                        <p class="text-gray-400 text-sm mb-1">
                            <i class="fa-solid fa-mountain text-accent mr-1"></i> @(eventItem.Trail?.Name ?? "Unknown Trail")
                        </p>
                        <p class="text-gray-400 text-sm mb-3">
                            <i class="fa-solid fa-location-dot text-accent mr-1"></i> @eventItem.Location
                        </p>

                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-400 mb-4">
                            <span><i class="fa-regular fa-clock mr-1.5"></i>@eventItem.EstimatedDuration hrs</span>
                            <span class="@(slotsLeft <= 3 ? "text-amber-400" : "")">
                                <i class="fa-solid fa-users mr-1.5"></i>@slotsLeft slots left
                            </span>
                        </div>

                        <div class="flex gap-2 mt-auto">
                            <a asp-controller="Participant" asp-action="Details" asp-route-id="@eventItem.Id"
                               class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-gray-300 hover:text-white py-2 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                <i class="fa-regular fa-eye"></i> View
                            </a>
                            @if (buttonState.Target == RegisterButtonTarget.Assessment)
                            {
                                <a asp-controller="Assessment" asp-action="Form" asp-route-eventId="@eventItem.Id"
                                   class="@buttonClasses">
                                    <i class="fa-regular fa-clipboard"></i> @buttonState.Label
                                </a>
                            }
                            else if (buttonState.Target == RegisterButtonTarget.MyRegistrations)
                            {
                                <a asp-controller="Registration" asp-action="MyRegistrations"
                                   class="@buttonClasses">
                                    <i class="fa-regular fa-clipboard"></i> @buttonState.Label
                                </a>
                            }
                            else
                            {
                                <span class="@buttonClasses">
                                    <i class="fa-regular fa-clipboard"></i> @buttonState.Label
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="noResultsMessage" class="hidden text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl">
            <i class="fa-solid fa-calendar-xmark text-4xl text-slate-600 mb-4"></i>
            <h3 class="text-xl font-bold text-gray-300">No events match your filters</h3>
            <p class="text-gray-500 mt-2">Try a different search or clear the filters.</p>
        </div>
    }
    else
    {
        <div class="text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl">
            <i class="fa-solid fa-calendar-plus text-4xl text-slate-600 mb-4"></i>
            <h3 class="text-xl font-bold text-gray-300">No events available</h3>
            <p class="text-gray-500 mt-2">Check back later for new hiking events.</p>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const searchInput = document.getElementById('searchInput');
        const trailFilter = document.getElementById('trailFilter');
        const difficultyFilter = document.getElementById('difficultyFilter');
        const sortFilter = document.getElementById('sortFilter');
        const noResults = document.getElementById('noResultsMessage');
        const eventCount = document.getElementById('eventCount');

        const cards = Array.from(document.querySelectorAll('.event-card'));
        const cardsContainer = cards[0]?.parentElement;

        function compareCards(sort, a, b) {
            switch (sort) {
                case 'date_desc':
                    return new Date(b.dataset.date) - new Date(a.dataset.date);
                case 'title_asc':
                    return (a.dataset.title || '').localeCompare(b.dataset.title || '');
                case 'title_desc':
                    return (b.dataset.title || '').localeCompare(a.dataset.title || '');
                case 'difficulty_asc':
                    // Sort on the precise adjusted rating (NPS rating x Trail Class
                    // multiplier) - the same value the difficulty badge is derived from, not
                    // the plain NPS rating, which ignores Trail Class entirely and would sort
                    // a short Class 4 trail as though it were an easy walk. Two trails in the
                    // same band (e.g. both "Minor Climb") still have different adjusted
                    // ratings, and ranking by band alone left same-band pairs in arbitrary
                    // order.
                    return (parseFloat(a.dataset.adjustedRating) || 0) - (parseFloat(b.dataset.adjustedRating) || 0);
                case 'difficulty_desc':
                    return (parseFloat(b.dataset.adjustedRating) || 0) - (parseFloat(a.dataset.adjustedRating) || 0);
                default:
                    return new Date(a.dataset.date) - new Date(b.dataset.date);
            }
        }

        function filterAndSort() {
            const term = (searchInput?.value || '').toLowerCase().trim();
            const trail = trailFilter?.value || 'All';
            const difficulty = difficultyFilter?.value || 'All';
            const sort = sortFilter?.value || 'date_asc';

            const visible = cards.filter(card => {
                const title = card.dataset.title || '';
                const location = card.dataset.location || '';
                const cardDiff = card.dataset.difficulty || '';
                const cardTrailId = card.dataset.trailId || '';

                const matchesSearch = !term || title.includes(term) || location.includes(term);
                const matchesDiff = difficulty === 'All' || cardDiff === difficulty;
                const matchesTrail = trail === 'All' || cardTrailId === trail;
                const show = matchesSearch && matchesDiff && matchesTrail;

                card.style.display = show ? 'flex' : 'none';
                return show;
            });

            visible.sort((a, b) => compareCards(sort, a, b));
            if (cardsContainer) visible.forEach(card => cardsContainer.appendChild(card));

            if (eventCount) eventCount.textContent = visible.length;
            if (noResults) noResults.classList.toggle('hidden', visible.length > 0);
        }

        searchInput?.addEventListener('input', filterAndSort);
        trailFilter?.addEventListener('change', filterAndSort);
        difficultyFilter?.addEventListener('change', filterAndSort);
        sortFilter?.addEventListener('change', filterAndSort);

        filterAndSort();
    });
</script>