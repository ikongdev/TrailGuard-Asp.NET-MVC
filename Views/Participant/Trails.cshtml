@model IEnumerable<TrailGuard.Models.Trail>
@{
    ViewData["Title"] = "Browse Trails";
}

@if (TempData["Success"] != null)
{
    <div id="successMessage" class="fixed top-24 right-4 z-50 bg-emerald-500/90 text-white px-6 py-3 rounded-xl shadow-lg backdrop-blur-sm flex items-center gap-3">
        <i class="fa-solid fa-check-circle"></i>
        <span>@TempData["Success"]</span>
        <button type="button" onclick="this.parentElement.remove()" class="hover:text-gray-200 transition-colors">
            <i class="fa-solid fa-xmark text-lg"></i>
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div id="errorMessage" class="fixed top-24 right-4 z-50 bg-red-500/90 text-white px-6 py-3 rounded-xl shadow-lg backdrop-blur-sm flex items-center gap-3">
        <i class="fa-solid fa-exclamation-triangle"></i>
        <span>@TempData["Error"]</span>
        <button type="button" onclick="this.parentElement.remove()" class="hover:text-gray-200 transition-colors">
            <i class="fa-solid fa-xmark text-lg"></i>
        </button>
    </div>
}

@section PageHero {
    <div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white">Browse Trails</h1>
                <p class="text-gray-400 mt-1 text-sm">Discover trails that match your adventure level and explore hiking destinations.</p>
            </div>
            
            <div class="bg-white/5 border border-white/10 px-4 py-2.5 rounded-full flex items-center gap-2 backdrop-blur-sm">
                <i class="fa-solid fa-mountain text-gray-400"></i>
                <span class="text-sm font-medium text-gray-300">Total Trails: <strong class="text-white" id="trailCount">@Model.Count()</strong></span>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-4 mb-8 bg-white/5 backdrop-blur-xl p-5 rounded-xl border border-white/10">
            
            <div class="relative grow">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input type="text" id="searchInput" placeholder="Search trails by name or location..." 
                    class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-11 pr-4 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none transition-colors placeholder-gray-500">
            </div>

            <div class="relative">
                <select id="sortOrder" class="bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors w-full">
                    <option value="newest" class="bg-surface-card">Sort by: Newest</option>
                    <option value="oldest" class="bg-surface-card">Sort by: Oldest</option>
                    <option value="name_asc" class="bg-surface-card">Name (A-Z)</option>
                    <option value="name_desc" class="bg-surface-card">Name (Z-A)</option>
                    <option value="distance_asc" class="bg-surface-card">Distance (Low to High)</option>
                    <option value="distance_desc" class="bg-surface-card">Distance (High to Low)</option>
                    <option value="elevation_asc" class="bg-surface-card">Elevation (Low to High)</option>
                    <option value="elevation_desc" class="bg-surface-card">Elevation (High to Low)</option>
                </select>
                <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="trailGrid">
            @if (!Model.Any())
            {
                <div class="col-span-full text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl">
                    <i class="fa-solid fa-mountain text-4xl text-slate-600 mb-4"></i>
                    <h3 class="text-xl font-bold text-gray-300">No trails found</h3>
                    <p class="text-gray-500 mt-2">Try searching a different name or clearing the filters.</p>
                </div>
            }
            else
            {
                @foreach (var trail in Model)
                {
                    <div class="trail-card bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden hover:border-white/20 transition-colors flex flex-col"
                         data-date-added="@trail.DateAdded.ToString("yyyy-MM-dd")"
                         data-name="@trail.Name"
                         data-location="@trail.Location"
                         data-distance="@trail.DistanceKm"
                         data-elevation="@trail.ElevationGainMeters">
                        <div class="relative h-48 overflow-hidden bg-black/30">
                            @if (!string.IsNullOrEmpty(trail.ThumbnailUrl))
                            {
                                <img src="@trail.ThumbnailUrl" alt="@trail.Name" class="w-full h-full object-cover">
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <i class="fa-solid fa-image text-4xl text-slate-700"></i>
                                </div>
                            }
                            <div class="absolute inset-0 bg-linear-to-t from-surface-card to-transparent opacity-90"></div>
                        </div>
                        
                        <div class="p-6 flex flex-col grow relative z-10 -mt-10">
                            <h3 class="text-xl font-bold text-white mb-1">@trail.Name</h3>
                            <p class="text-gray-400 text-sm mb-5 flex items-center gap-1.5">
                                <i class="fa-solid fa-location-dot text-accent"></i> @trail.Location
                            </p>
                            
                            <div class="grid grid-cols-2 gap-4 mb-4">
                                <div>
                                    <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Distance</p>
                                    <p class="text-gray-200 text-sm font-medium flex items-center gap-2">
                                        <i class="fa-solid fa-route text-gray-400"></i> @trail.DistanceKm km
                                    </p>
                                </div>
                                <div>
                                    <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Elev. Gain</p>
                                    <p class="text-gray-200 text-sm font-medium flex items-center gap-2">
                                        <i class="fa-solid fa-arrow-trend-up text-gray-400"></i> @trail.ElevationGainMeters m
                                    </p>
                                </div>
                            </div>

                            <div class="mb-6">
                                <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-1.5">Terrain</p>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var t in (trail.Terrain ?? "").Split(',').Select(x => x.Trim()).Where(x => x.Length > 0))
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-gray-300">@t</span>
                                    }
                                </div>
                            </div>

                            <button type="button" onclick="openViewModal(this)"
                                    data-id="@trail.Id"
                                    data-name="@trail.Name"
                                    data-location="@trail.Location"
                                    data-distance="@trail.DistanceKm"
                                    data-elevation="@trail.ElevationGainMeters"
                                    data-terrain="@trail.Terrain"
                                    data-description="@trail.Description"
                                    data-image="@(string.IsNullOrEmpty(trail.ThumbnailUrl) ? "" : trail.ThumbnailUrl)"
                                    data-date-added="@trail.DateAdded.ToString("MMM dd, yyyy")"
                                    class="w-full mt-auto bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-gray-300 hover:text-white py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                <i class="fa-regular fa-eye"></i> View Trail Details
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@section Modals {
    <div id="viewTrailModal" class="fixed inset-0 z-100 modal-hidden">
        <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="closeViewModal()"></div>
        <div class="relative bg-surface-card border border-white/10 rounded-xl shadow-2xl w-full max-w-2xl max-h-[85vh] overflow-hidden flex flex-col" style="z-index: 10;">
            
            <div class="flex justify-between items-center px-5 py-3 border-b border-white/10 shrink-0">
                <h2 class="text-base font-semibold text-white flex items-center gap-2">
                    <i class="fa-solid fa-mountain text-accent"></i>
                    Trail Details
                </h2>
                <button onclick="closeViewModal()" class="text-gray-400 hover:text-white transition-colors">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div class="overflow-y-auto custom-scrollbar">
                
                <div class="relative h-40 overflow-hidden bg-black/30">
                    <img id="viewImage" src="" alt="Trail" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-linear-to-t from-surface-card via-surface-card/40 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-5">
                        <h3 id="viewName" class="text-2xl font-bold text-white"></h3>
                        <p class="text-gray-300 text-sm flex items-center gap-1.5 mt-1">
                            <i class="fa-solid fa-location-dot text-accent"></i>
                            <span id="viewLocation"></span>
                        </p>
                    </div>
                </div>

                <div class="p-5">
                    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm mb-4">
                        <span class="text-gray-300 flex items-center gap-2">
                            <i class="fa-solid fa-route text-gray-500"></i>
                            <span id="viewDistance"></span> km
                        </span>
                        <span class="text-gray-300 flex items-center gap-2">
                            <i class="fa-solid fa-arrow-trend-up text-gray-500"></i>
                            <span id="viewElevation"></span> m
                        </span>
                        <span class="text-gray-300 flex items-center gap-2">
                            <i class="fa-solid fa-tree text-gray-500"></i>
                            <span id="viewTerrainType"></span>
                        </span>
                        <span class="text-gray-500 flex items-center gap-2 text-xs">
                            <i class="fa-regular fa-calendar"></i>
                            Added <span id="viewDateAdded"></span>
                        </span>
                    </div>

                    <p id="viewDescriptionText" class="text-gray-400 text-sm leading-relaxed pb-5 border-b border-white/10"></p>

                    <div class="mt-5">
                        <p class="text-gray-500 text-xs uppercase tracking-wider mb-3 flex items-center gap-2">
                            <i class="fa-regular fa-calendar"></i> Events on this Trail
                        </p>
                        <div id="viewTrailEvents" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="col-span-full text-center text-gray-500 text-sm py-4">Loading events...</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="px-5 py-3 border-t border-white/10 shrink-0 flex justify-end gap-3">
                <button onclick="closeViewModal()" class="px-5 py-2 rounded-full text-sm font-medium text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-colors">
                    Close
                </button>
                <a asp-controller="Participant" asp-action="Events" 
                class="px-5 py-2 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out flex items-center gap-2">
                    <i class="fa-regular fa-calendar"></i> Browse All Events
                </a>
            </div>
        </div>
    </div>

    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgb(139 92 246 / 0.3); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgb(139 92 246 / 0.6); }
        
        .modal-hidden { display: none !important; }

        .modal-visible {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 1rem;
        }
    </style>

    <script>
        setTimeout(function() {
            document.getElementById('successMessage')?.remove();
            document.getElementById('errorMessage')?.remove();
        }, 3000);

        let currentTrailId = null;

        function openViewModal(button) {
            currentTrailId = button.dataset.id;

            document.getElementById('viewName').textContent = button.dataset.name;
            document.getElementById('viewLocation').textContent = button.dataset.location;
            document.getElementById('viewDistance').textContent = button.dataset.distance;
            document.getElementById('viewElevation').textContent = button.dataset.elevation;
            document.getElementById('viewTerrainType').textContent = button.dataset.terrain;
            document.getElementById('viewDescriptionText').textContent = button.dataset.description || 'No description provided.';
            document.getElementById('viewDateAdded').textContent = button.dataset.dateAdded || 'N/A';

            const heroImg = document.getElementById('viewImage');
            heroImg.src = button.dataset.image || '/images/bg-image.png';

            const modal = document.getElementById('viewTrailModal');
            const eventsContainer = document.getElementById('viewTrailEvents');
            eventsContainer.innerHTML = '<div class="col-span-full text-center text-gray-500 text-sm py-4">Loading events...</div>';
            
            modal.classList.remove('modal-hidden');
            modal.classList.add('modal-visible');
            document.body.style.overflow = 'hidden';

            fetch(`/Participant/GetTrailEvents?trailId=${currentTrailId}`)
                .then(response => response.json())
                .then(data => {
                    eventsContainer.innerHTML = '';
                    
                    if (data && data.length > 0) {
                        data.forEach(ev => {
                            // Mirrors DifficultyCalculator.BadgeClass() in C# - this data comes back
                            // as JSON from an AJAX endpoint, so it can't call that helper directly.
                            // Keep these two mappings in sync.
                            const badgeClass = ev.difficulty === 'Easiest' ? 'badge-easy'
                                             : ev.difficulty === 'Moderate' ? 'badge-lime'
                                             : ev.difficulty === 'Moderately Strenuous' ? 'badge-moderate'
                                             : ev.difficulty === 'Strenuous' ? 'badge-orange'
                                             : 'badge-hard';
                            const div = document.createElement('div');
                            div.className = 'bg-white/5 rounded-xl p-3 border border-white/10 hover:border-white/20 transition-colors';
                            div.innerHTML = `
                                <p class="text-white font-medium text-sm">${ev.eventTitle}</p>
                                <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400 mt-2">
                                    <span><i class="fa-regular fa-calendar mr-1"></i>${ev.eventDate}</span>
                                    <span><i class="fa-regular fa-clock mr-1"></i>${ev.eventTime}</span>
                                    <span class="px-2 py-0.5 rounded-full font-medium ${badgeClass}">${ev.difficulty}</span>
                                </div>
                                <a href="/Participant/Details/${ev.id}" class="mt-2 inline-block text-xs font-medium text-accent hover:brightness-125 transition-all">
                                    View Event <i class="fa-solid fa-arrow-right ml-1"></i>
                                </a>
                            `;
                            eventsContainer.appendChild(div);
                        });
                    } else {
                        eventsContainer.innerHTML = `
                            <div class="col-span-full text-center text-gray-500 text-sm py-6">
                                <i class="fa-regular fa-calendar-plus text-2xl block mb-2 text-slate-600"></i>
                                No upcoming events on this trail yet.
                            </div>
                        `;
                    }
                })
                .catch(() => {
                    eventsContainer.innerHTML = '<div class="col-span-full text-center text-red-400 text-sm py-4">Could not load events.</div>';
                });
        }

        function closeViewModal() {
            const modal = document.getElementById('viewTrailModal');
            modal.classList.remove('modal-visible');
            modal.classList.add('modal-hidden');
            document.body.style.overflow = 'auto';
        }

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') closeViewModal();
        });

        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortOrder');
        const trailGrid = document.getElementById('trailGrid');

        function applyFilters() {
            if (!trailGrid) return;

            const cards = Array.from(trailGrid.querySelectorAll('.trail-card'));
            const term = (searchInput?.value || '').toLowerCase().trim();
            const sort = sortSelect?.value || 'newest';

            const visible = cards.filter(card => {
                const name = (card.dataset.name || '').toLowerCase();
                const location = (card.dataset.location || '').toLowerCase();
                const match = !term || name.includes(term) || location.includes(term);
                card.style.display = match ? 'flex' : 'none';
                return match;
            });

            visible.sort((a, b) => {
                switch (sort) {
                    case 'oldest':
                        return new Date(a.dataset.dateAdded) - new Date(b.dataset.dateAdded);
                    case 'name_asc':
                        return (a.dataset.name || '').localeCompare(b.dataset.name || '');
                    case 'name_desc':
                        return (b.dataset.name || '').localeCompare(a.dataset.name || '');
                    case 'distance_asc':
                        return parseFloat(a.dataset.distance) - parseFloat(b.dataset.distance);
                    case 'distance_desc':
                        return parseFloat(b.dataset.distance) - parseFloat(a.dataset.distance);
                    case 'elevation_asc':
                        return parseFloat(a.dataset.elevation) - parseFloat(b.dataset.elevation);
                    case 'elevation_desc':
                        return parseFloat(b.dataset.elevation) - parseFloat(a.dataset.elevation);
                    default:
                        return new Date(b.dataset.dateAdded) - new Date(a.dataset.dateAdded);
                }
            });

            visible.forEach(card => trailGrid.appendChild(card));

            const count = document.getElementById('trailCount');
            if (count) count.textContent = visible.length;

            let noResults = document.getElementById('noResultsMessage');
            if (visible.length === 0) {
                if (!noResults) {
                    noResults = document.createElement('div');
                    noResults.id = 'noResultsMessage';
                    noResults.className = 'col-span-full text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl';
                    noResults.innerHTML = `
                        <i class="fa-solid fa-mountain text-4xl text-slate-600 mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-300">No trails found</h3>
                        <p class="text-gray-500 mt-2">Try searching a different name or clearing the filters.</p>
                    `;
                    trailGrid.appendChild(noResults);
                }
            } else {
                noResults?.remove();
            }
        }

        searchInput?.addEventListener('input', applyFilters);
        sortSelect?.addEventListener('change', applyFilters);
    </script>
}