@using Microsoft.AspNetCore.Identity
@model ParticipantDashboardViewModel
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Participant Dashboard";
    var user = await UserManager.GetUserAsync(User);
    var firstName = user?.FirstName ?? "Participant";
}

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Participant Dashboard</h1>
            <p class="text-gray-400 mt-1 text-sm">Track your hikes, registrations, assessment results, and recommended adventures.</p>
        </div>
        <div class="bg-white/5 border border-white/10 px-4 py-2 rounded-full flex items-center gap-2">
            <i class="fa-regular fa-calendar text-accent"></i>
            <span class="text-sm text-gray-300">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </div>
    </div>

    <div class="flex items-center gap-4 mb-8">
        <div class="w-16 h-16 rounded-full bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 flex items-center justify-center text-white text-2xl font-bold shrink-0 overflow-hidden">
            @if (!string.IsNullOrEmpty(Images.Url(user?.ProfilePictureUrl)))
            {
                <img src="@Images.Url(user?.ProfilePictureUrl)" alt="@firstName" class="w-full h-full object-cover" />
            }
            else
            {
                @(firstName[0].ToString().ToUpper())
            }
        </div>
        <div>
            <h2 class="text-2xl font-bold text-white">Welcome back, @firstName!</h2>
            <p class="text-gray-400">Every trail is a new story. Let's find your next great adventure.</p>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">@Model.UpcomingEventsCount</p>
            <p class="text-gray-400 text-xs">Upcoming Events</p>
        </div>
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">@Model.TotalRegistrations</p>
            <p class="text-gray-400 text-xs">Active Registrations</p>
        </div>
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">@Model.PendingRegistrations</p>
            <p class="text-gray-400 text-xs">Needs Action</p>
        </div>
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">@Model.CompletedHikes</p>
            <p class="text-gray-400 text-xs">Completed</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        
        <div class="lg:col-span-2 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden h-100 flex flex-col">
            <div class="px-5 py-3 border-b border-white/10 shrink-0 flex items-center justify-between">
                <h2 class="text-sm font-semibold text-white flex items-center gap-2">
                    <i class="fa-regular fa-calendar text-accent"></i>
                    Upcoming Events
                </h2>
                <span class="text-xs text-gray-500">Select an event to view saved weather</span>
            </div>
            <div class="flex-1 overflow-y-auto custom-scrollbar">
                @if (Model.UpcomingEvents != null && Model.UpcomingEvents.Any())
                {
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        var weatherPresentation = SavedWeatherPresentation.Create(ev, SavedWeatherDisplayOptions.Dashboard);
                        <div class="border-b border-white/5">
                            <button type="button"
                                    class="w-full flex items-center justify-between gap-3 p-4 text-left hover:bg-white/5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent"
                                    data-weather-toggle
                                    aria-expanded="false"
                                    aria-controls="weather-panel-@ev.Id">
                                <span class="flex-1 min-w-0">
                                    <span class="block text-white font-medium text-sm truncate">@ev.EventTitle</span>
                                    <span class="block text-gray-400 text-xs truncate">@ev.Location</span>
                                    <span class="flex flex-wrap gap-3 text-xs text-gray-500 mt-1">
                                        <span><i class="fa-regular fa-calendar mr-1"></i>@ev.EventDate.ToString("MMM dd, yyyy")</span>
                                        <span><i class="fa-regular fa-clock mr-1"></i>@ev.FormattedEventTime</span>
                                    </span>
                                </span>
                                <span class="flex items-center gap-2 shrink-0">
                                    @if (!string.IsNullOrWhiteSpace(weatherPresentation.RiskLevel))
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap border @SavedWeatherPresentation.RiskBadgeClasses(weatherPresentation.RiskLevel)">
                                            <i class="fa-solid fa-cloud-sun mr-1" aria-hidden="true"></i>@weatherPresentation.RiskLevel Risk
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap text-slate-400 bg-slate-500/15">@weatherPresentation.CollapsedLabel</span>
                                    }
                                    <i class="fa-solid fa-chevron-down text-[10px] text-gray-500 transition-transform duration-200" aria-hidden="true"></i>
                                </span>
                            </button>

                            <div id="weather-panel-@ev.Id" class="hidden px-4 pb-4">
                                <partial name="_SavedWeather" model="weatherPresentation" />
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="flex flex-col items-center justify-center h-full text-center p-6">
                        <i class="fa-regular fa-calendar-plus text-3xl text-slate-600 mb-3"></i>
                        <p class="text-slate-400 text-sm">No upcoming events yet.</p>
                        <a asp-controller="Participant" asp-action="Events" class="text-accent text-sm font-medium mt-2 hover:brightness-125 transition-all">
                            Browse events <i class="fa-solid fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5 min-h-100 flex flex-col">
            <h2 class="text-sm font-semibold text-white mb-4 flex items-center gap-2 shrink-0">
                <i class="fa-solid fa-clipboard-check text-accent"></i>
                Latest Assessment Result
            </h2>
            <div class="flex-1 flex flex-col items-center justify-center py-2">
                @if (Model.LatestAssessment != null)
                {
                    var resultColor = Model.LatestAssessment.Result == "Good-Match" ? "#34d399" :
                                              Model.LatestAssessment.Result == "Borderline" ? "#fbbf24" : "#f87171";
                    var resultTextColor = Model.LatestAssessment.Result == "Good-Match" ? "text-emerald-400" :
                                          Model.LatestAssessment.Result == "Borderline" ? "text-amber-400" : "text-red-400";
                    var modelScore = Model.LatestAssessment.ModelScore;
                    var modelScoreDisplay = TrailGuard.Services.TrailGuardV2Presentation.FormatModelScore(modelScore);
                    var modelScorePercentForDonut = modelScore * 100;

                    @if (Model.LatestAssessment.HasMlPrediction)
                    {
                        <div class="relative" style="width: 128px; height: 128px;">
                            <canvas id="assessmentDonutChart" width="128" height="128"></canvas>
                            <div class="absolute inset-0 flex flex-col items-center justify-center">
                                <span class="text-xl font-bold text-white">@modelScoreDisplay</span>
                                <span class="text-[10px] text-gray-400">Model score</span>
                            </div>
                        </div>
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                var ctx = document.getElementById('assessmentDonutChart')?.getContext('2d');
                                if (ctx) {
                                    new Chart(ctx, {
                                        type: 'doughnut',
                                        data: {
                                            labels: ['Model score', 'Remaining'],
                                            datasets: [{
                                                data: [@modelScorePercentForDonut, @(100 - modelScorePercentForDonut)],
                                                backgroundColor: ['@resultColor', '#374151'],
                                                borderWidth: 0,
                                                cutout: '72%'
                                            }]
                                        },
                                        options: {
                                            responsive: false,
                                            plugins: {
                                                legend: { display: false },
                                                tooltip: {
                                                    callbacks: {
                                                        label: function(context) {
                                                            return context.label === 'Model score'
                                                                ? 'Model score: @modelScoreDisplay'
                                                                : (context.label || '') + ': ' + (context.parsed || 0).toFixed(2) + '%';
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    });
                                }
                            });
                        </script>
                        <p class="text-[10px] text-gray-500 text-center mt-2 max-w-45">
                            Model score, not a guaranteed chance of hike completion.
                        </p>
                    }
                    <div class="text-center mt-4 space-y-1.5 min-w-0">
                        <p class="text-lg font-bold @resultTextColor">@Model.LatestAssessment.Result</p>
                        <p class="text-white text-sm font-medium wrap-break-word">@Model.LatestAssessment.EventTitle</p>
                        <p class="text-gray-400 text-xs wrap-break-word">@Model.LatestAssessment.TrailName &bull; @Model.LatestAssessment.EventDifficulty</p>
                        <p class="text-gray-400 text-xs">
                            <i class="fa-regular fa-clock mr-1"></i>@Model.LatestAssessment.SubmittedAt.ToString("MMM dd, yyyy")
                        </p>
                        <a asp-controller="Assessment" asp-action="Report" asp-route-assessmentId="@Model.LatestAssessment.AssessmentId"
                           class="inline-flex items-center gap-1 mt-2 text-xs text-accent hover:brightness-125 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">
                            View Full Report <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center text-gray-500">
                        <i class="fa-regular fa-file-lines text-3xl block mb-3 text-slate-600"></i>
                        <p class="text-sm text-slate-400">No assessment taken yet</p>
                        <a asp-controller="Participant" asp-action="Events" 
                           class="inline-block mt-2 text-sm text-accent hover:brightness-125 transition-all">
                            Take Assessment <i class="fa-solid fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5">
            <h2 class="text-sm font-semibold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-arrows-rotate text-accent"></i>
                Recommended Events for You
            </h2>
            @if (Model.RecommendedEvents != null && Model.RecommendedEvents.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    @foreach (var ev in Model.RecommendedEvents)
                    {
                        var difficultyColor = TrailGuard.Services.DifficultyCalculator.BadgeClass(ev.Difficulty);

                        <div class="bg-white/5 border border-white/5 rounded-xl p-4 hover:border-white/20 transition-colors">
                            <p class="text-white font-medium text-sm">@ev.EventTitle</p>
                            <p class="text-gray-400 text-xs">@ev.Location</p>
                            <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500 mt-2">
                                <span><i class="fa-regular fa-calendar mr-1"></i>@ev.EventDate.ToString("MMM dd, yyyy")</span>
                                <span><i class="fa-regular fa-clock mr-1"></i>@ev.FormattedEventTime</span>
                                <span class="px-2 py-0.5 rounded-full font-medium @difficultyColor">@TrailGuard.Services.DifficultyCalculator.DisplayLabel(ev.Difficulty)</span>
                            </div>
                            <a asp-controller="Participant" asp-action="Details" asp-route-id="@ev.Id"
                               class="mt-3 inline-block text-xs font-medium text-accent hover:brightness-125 transition-all">
                                View Details <i class="fa-solid fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8">
                    <i class="fa-regular fa-calendar-plus text-2xl block mb-2 text-slate-600"></i>
                    <p class="text-sm text-slate-400">No recommendations yet. Take an assessment to get personalized recommendations.</p>
                </div>
            }
        </div>

        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5">
            <h2 class="text-sm font-semibold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-trophy text-accent"></i>
                Progress &amp; Achievements
            </h2>
            @if (Model.PersonalBestDifficulty != null)
            {
                <div class="space-y-3">
                    <div class="space-y-1">
                        <span class="block text-gray-400 text-sm">Highest Difficulty Completed</span>
                        <span class="block text-white font-semibold wrap-break-word">@Model.PersonalBestDifficulty</span>
                    </div>
                    <div class="flex items-center justify-between gap-6">
                        <span class="min-w-0 text-gray-400 text-sm">Longest Distance</span>
                        <span class="shrink-0 text-right text-white font-semibold">@Model.PersonalBestDistanceKm?.ToString("0.#") km</span>
                    </div>
                    <div class="flex items-center justify-between gap-6">
                        <span class="min-w-0 text-gray-400 text-sm">Highest Elevation</span>
                        <span class="shrink-0 text-right text-white font-semibold">@Model.PersonalBestElevationMeters m</span>
                    </div>
                    <div class="flex items-center justify-between gap-6">
                        <span class="min-w-0 text-gray-400 text-sm">Trail Points</span>
                        <span class="shrink-0 text-right text-white font-semibold">@Model.TrailPoints</span>
                    </div>
                    <div class="pt-4 border-t border-white/10">
                        <p class="text-gray-400 text-sm">All-Time Trail Points Rank</p>
                        @if (Model.IsRanked)
                        {
                            var rankedHikerLabel = Model.TotalHikers == 1 ? "ranked hiker" : "ranked hikers";
                            <p class="text-white font-semibold">Rank @Model.Rank of @Model.TotalHikers @rankedHikerLabel</p>
                        }
                        else
                        {
                            <p class="text-white font-semibold">Not yet ranked</p>
                            <p class="text-gray-500 text-xs mt-1">Complete more hikes to climb the leaderboard.</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-6">
                    <i class="fa-solid fa-mountain text-2xl block mb-2 text-slate-600"></i>
                    <p class="text-sm text-slate-400">No completed hikes yet.</p>
                    <p class="text-gray-500 text-xs mt-1">Not yet ranked</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('[data-weather-toggle]').forEach(function(toggle) {
        toggle.addEventListener('click', function() {
            var panel = document.getElementById(toggle.getAttribute('aria-controls'));
            if (!panel) return;

            var isExpanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!isExpanded));
            panel.classList.toggle('hidden', isExpanded);
            toggle.querySelector('.fa-chevron-down')?.classList.toggle('rotate-180', !isExpanded);
        });
    });
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgb(139 92 246 / 0.3);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgb(139 92 246 / 0.6);
    }
</style>
