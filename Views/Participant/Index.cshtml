@using Microsoft.AspNetCore.Identity
@model ParticipantDashboardViewModel
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Participant Dashboard";
    var user = await UserManager.GetUserAsync(User);
    var firstName = user?.FirstName ?? "Participant";
}

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Participant Dashboard</h1>
            <p class="text-gray-400 mt-1 text-sm">Track your hikes, registrations, assessment results, and recommended adventures.</p>
        </div>
        <div class="bg-white/5 border border-white/10 px-4 py-2 rounded-full flex items-center gap-2">
            <i class="fa-regular fa-calendar text-accent"></i>
            <span class="text-sm text-gray-300">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </div>
    </div>

    <div class="flex items-center gap-4 mb-8">
        <div class="w-16 h-16 rounded-full bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 flex items-center justify-center text-white text-2xl font-bold shrink-0 overflow-hidden">
            @if (!string.IsNullOrEmpty(user?.ProfilePictureUrl))
            {
                <img src="@user.ProfilePictureUrl" alt="@firstName" class="w-full h-full object-cover" />
            }
            else
            {
                @(firstName[0].ToString().ToUpper())
            }
        </div>
        <div>
            <h2 class="text-2xl font-bold text-white">Welcome back, @firstName!</h2>
            <p class="text-gray-400">Every trail is a new story. Let's find your next great adventure.</p>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">@Model.UpcomingEventsCount</p>
            <p class="text-gray-400 text-xs">Upcoming Events</p>
        </div>
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">@Model.TotalRegistrations</p>
            <p class="text-gray-400 text-xs">Active Registrations</p>
        </div>
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">@Model.PendingRegistrations</p>
            <p class="text-gray-400 text-xs">Needs Action</p>
        </div>
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">@Model.CompletedHikes</p>
            <p class="text-gray-400 text-xs">Completed</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        
        <div class="lg:col-span-2 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden h-100 flex flex-col">
            <div class="px-5 py-3 border-b border-white/10 shrink-0 flex items-center justify-between">
                <h2 class="text-sm font-semibold text-white flex items-center gap-2">
                    <i class="fa-regular fa-calendar text-accent"></i>
                    Upcoming Events
                </h2>
                <span class="text-xs text-gray-500">Tap an event for its weather forecast</span>
            </div>
            <div class="flex-1 overflow-y-auto custom-scrollbar">
                @if (Model.UpcomingEvents != null && Model.UpcomingEvents.Any())
                {
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <div class="border-b border-white/5">
                            <div class="flex items-center justify-between gap-3 p-4 hover:bg-white/5 transition-colors"
                                 id="weather-row-@ev.Id" data-event-id="@ev.Id">
                                <div class="flex-1 min-w-0">
                                    <p class="text-white font-medium text-sm truncate">@ev.EventTitle</p>
                                    <p class="text-gray-400 text-xs truncate">@ev.Location</p>
                                    <div class="flex flex-wrap gap-3 text-xs text-gray-500 mt-1">
                                        <span><i class="fa-regular fa-calendar mr-1"></i>@ev.EventDate.ToString("MMM dd, yyyy")</span>
                                        <span><i class="fa-regular fa-clock mr-1"></i>@ev.FormattedEventTime</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap text-slate-400 bg-slate-500/15" id="weather-badge-@ev.Id">
                                        <i class="fa-solid fa-spinner fa-spin mr-1"></i>Loading...
                                    </span>
                                </div>
                            </div>

                            <div id="weather-panel-@ev.Id" class="hidden px-4 pb-4">
                                <div class="bg-surface-card/60 border border-white/10 rounded-xl p-4">
                                    <p class="text-slate-300 text-xs leading-relaxed whitespace-pre-line" id="weather-details-@ev.Id"></p>
                                    <p class="text-slate-400 text-xs leading-relaxed mt-3 pt-3 border-t border-white/5 hidden" id="weather-reminder-wrap-@ev.Id">
                                        <i class="fa-solid fa-circle-info mr-1 text-accent"></i>
                                        <span id="weather-reminder-@ev.Id"></span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="flex flex-col items-center justify-center h-full text-center p-6">
                        <i class="fa-regular fa-calendar-plus text-3xl text-slate-600 mb-3"></i>
                        <p class="text-slate-400 text-sm">No upcoming events yet.</p>
                        <a asp-controller="Participant" asp-action="Events" class="text-accent text-sm font-medium mt-2 hover:brightness-125 transition-all">
                            Browse events <i class="fa-solid fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5 h-100 flex flex-col">
            <h2 class="text-sm font-semibold text-white mb-3 flex items-center gap-2 shrink-0">
                <i class="fa-solid fa-clipboard-check text-accent"></i>
                Latest Assessment Result
            </h2>
            <div class="flex-1 flex flex-col items-center justify-center">
                @if (Model.LatestAssessment != null)
                {
                    var resultColor = Model.LatestAssessment.Result == "Good-Match" ? "#34d399" :
                                              Model.LatestAssessment.Result == "Borderline" ? "#fbbf24" : "#f87171";
                    var resultTextColor = Model.LatestAssessment.Result == "Good-Match" ? "text-emerald-400" :
                                          Model.LatestAssessment.Result == "Borderline" ? "text-amber-400" : "text-red-400";
                    var confidencePct = Math.Round(Model.LatestAssessment.ConfidenceScore * 100, 1);
                    var confidenceDisplay = confidencePct.ToString("0.0");

                    @if (Model.LatestAssessment.HasMlPrediction)
                    {
                        <div class="relative" style="width: 150px; height: 150px;">
                            <canvas id="assessmentDonutChart" width="150" height="150"></canvas>
                            <div class="absolute inset-0 flex flex-col items-center justify-center">
                                <span class="text-2xl font-bold text-white">@confidenceDisplay%</span>
                                <span class="text-[10px] text-gray-400">confidence</span>
                            </div>
                        </div>
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                var ctx = document.getElementById('assessmentDonutChart')?.getContext('2d');
                                if (ctx) {
                                    new Chart(ctx, {
                                        type: 'doughnut',
                                        data: {
                                            labels: ['Confidence', 'Remaining'],
                                            datasets: [{
                                                data: [@confidencePct, @(100 - confidencePct)],
                                                backgroundColor: ['@resultColor', '#374151'],
                                                borderWidth: 0,
                                                cutout: '72%'
                                            }]
                                        },
                                        options: {
                                            responsive: false,
                                            plugins: {
                                                legend: { display: false },
                                                tooltip: {
                                                    callbacks: {
                                                        label: function(context) {
                                                            return (context.label || '') + ': ' + (context.parsed || 0) + '%';
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    });
                                }
                            });
                        </script>
                        <p class="text-[10px] text-gray-500 text-center mt-2 max-w-45">
                            Confidence reflects how certain the model is that this result matches its trained rules. It does not measure whether the recommendation is right for you.
                        </p>
                    }
                    <div class="text-center mt-4">
                        <p class="text-lg font-bold @resultTextColor">@Model.LatestAssessment.Result</p>
                        <p class="text-white text-sm font-medium mt-2">@Model.LatestAssessment.EventTitle</p>
                        <p class="text-gray-400 text-xs">@Model.LatestAssessment.TrailName &bull; @Model.LatestAssessment.EventDifficulty</p>
                        <p class="text-gray-400 text-xs mt-1">
                            <i class="fa-regular fa-clock mr-1"></i>@Model.LatestAssessment.SubmittedAt.ToString("MMM dd, yyyy")
                        </p>
                        <p class="text-gray-500 text-xs mt-2 leading-relaxed">@Model.LatestAssessment.Description</p>
                        <a asp-controller="Assessment" asp-action="Report" asp-route-assessmentId="@Model.LatestAssessment.AssessmentId"
                           class="inline-block mt-2 text-xs text-accent hover:brightness-125 transition-all">
                            View Full Report <i class="fa-solid fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center text-gray-500">
                        <i class="fa-regular fa-file-lines text-3xl block mb-3 text-slate-600"></i>
                        <p class="text-sm text-slate-400">No assessment taken yet</p>
                        <a asp-controller="Participant" asp-action="Events" 
                           class="inline-block mt-2 text-sm text-accent hover:brightness-125 transition-all">
                            Take Assessment <i class="fa-solid fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5">
            <h2 class="text-sm font-semibold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-arrows-rotate text-accent"></i>
                Recommended Events for You
            </h2>
            @if (Model.RecommendedEvents != null && Model.RecommendedEvents.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    @foreach (var ev in Model.RecommendedEvents)
                    {
                        var difficultyColor = ev.Difficulty switch
                        {
                            "Easy" => "badge-easy",
                            "Moderate" => "badge-moderate",
                            "Difficult" => "badge-hard",
                            _ => "text-slate-400 bg-slate-500/15"
                        };

                        <div class="bg-white/5 border border-white/5 rounded-xl p-4 hover:border-white/20 transition-colors">
                            <p class="text-white font-medium text-sm">@ev.EventTitle</p>
                            <p class="text-gray-400 text-xs">@ev.Location</p>
                            <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500 mt-2">
                                <span><i class="fa-regular fa-calendar mr-1"></i>@ev.EventDate.ToString("MMM dd, yyyy")</span>
                                <span><i class="fa-regular fa-clock mr-1"></i>@ev.FormattedEventTime</span>
                                <span class="px-2 py-0.5 rounded-full font-medium @difficultyColor">@ev.Difficulty</span>
                            </div>
                            <a asp-controller="Participant" asp-action="Details" asp-route-id="@ev.Id"
                               class="mt-3 inline-block text-xs font-medium text-accent hover:brightness-125 transition-all">
                                View Details <i class="fa-solid fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8">
                    <i class="fa-regular fa-calendar-plus text-2xl block mb-2 text-slate-600"></i>
                    <p class="text-sm text-slate-400">No recommendations yet. Take an assessment to get personalized recommendations.</p>
                </div>
            }
        </div>

        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5">
            <h2 class="text-sm font-semibold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-trophy text-accent"></i>
                Progress &amp; Achievements
            </h2>
            @if (Model.PersonalBestDifficulty != null)
            {
                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <span class="text-gray-400 text-sm">Highest Difficulty Completed</span>
                        <span class="text-white font-semibold">@Model.PersonalBestDifficulty</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-400 text-sm">Longest Distance</span>
                        <span class="text-white font-semibold">@Model.PersonalBestDistanceKm?.ToString("0.#") km</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-400 text-sm">Highest Elevation</span>
                        <span class="text-white font-semibold">@Model.PersonalBestElevationMeters m</span>
                    </div>
                    <div class="pt-4 border-t border-white/10">
                        <p class="text-gray-400 text-sm">Top Hiker Rank</p>
                        @if (Model.IsRanked)
                        {
                            <p class="text-white font-semibold">Rank @Model.Rank of @Model.TotalHikers hikers</p>
                        }
                        else
                        {
                            <p class="text-white font-semibold">Not yet ranked</p>
                            <p class="text-gray-500 text-xs mt-1">Complete more hikes to climb the leaderboard.</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-6">
                    <i class="fa-solid fa-mountain text-2xl block mb-2 text-slate-600"></i>
                    <p class="text-sm text-slate-400">No completed hikes yet.</p>
                    <p class="text-gray-500 text-xs mt-1">Not yet ranked</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[data-event-id]').forEach(function(row) {
            var eventId = row.dataset.eventId;
            fetch('/Participant/GetEventWeather?eventId=' + eventId)
                .then(function(response) { return response.json(); })
                .then(function(data) { renderWeatherBadge(eventId, data); })
                .catch(function() { renderWeatherBadge(eventId, { success: false }); });
        });
    });

    var riskColors = {
        'Low': 'text-emerald-400 bg-emerald-500/15',
        'Moderate': 'text-amber-400 bg-amber-500/15',
        'Moderate to High': 'text-orange-400 bg-orange-500/15',
        'High (Thunderstorm)': 'text-red-400 bg-red-500/15'
    };

    var unavailableLabels = {
        'TooFarAhead': 'Forecast Not Yet Available',
        'LocationNotFound': 'Location Not Recognized',
        'NoLocation': 'No Location Set',
        'ServiceDown': 'Weather Service Unavailable'
    };

    function renderWeatherBadge(eventId, data) {
        const badge = document.getElementById('weather-badge-' + eventId);
        const row = document.getElementById('weather-row-' + eventId);
        if (!badge) return;

        if (!data.success) {
            const label = unavailableLabels[data.unavailableReason] || 'Forecast Unavailable';
            badge.className = 'px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap text-slate-400 bg-slate-500/15';
            badge.innerHTML = label;
            return;
        }

        const colorClass = riskColors[data.riskLevel] || 'text-slate-400 bg-slate-500/15';
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap ' + colorClass;
        badge.innerHTML = '<i class="fa-solid fa-cloud-sun mr-1"></i>' + data.riskLevel +
            '<i class="fa-solid fa-chevron-down ml-1 text-[10px] transition-transform duration-200" id="chevron-' + eventId + '"></i>';

        const detailsEl = document.getElementById('weather-details-' + eventId);
        if (detailsEl) detailsEl.textContent = data.details || '';

        if (data.reminder) {
            const reminderEl = document.getElementById('weather-reminder-' + eventId);
            const reminderWrap = document.getElementById('weather-reminder-wrap-' + eventId);
            if (reminderEl) reminderEl.textContent = data.reminder;
            if (reminderWrap) reminderWrap.classList.remove('hidden');
        }

        if (row) {
            row.classList.add('cursor-pointer');
            row.onclick = function() { toggleWeather(eventId); };
        }
    }

    function toggleWeather(eventId) {
        const panel = document.getElementById('weather-panel-' + eventId);
        const chevron = document.getElementById('chevron-' + eventId);
        if (!panel) return;

        const isHidden = panel.classList.contains('hidden');
        panel.classList.toggle('hidden');
        if (chevron) {
            chevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
        }
    }
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgb(139 92 246 / 0.3);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgb(139 92 246 / 0.6);
    }
</style>