@model TrailGuard.Models.Event
@using TrailGuard.Models
@{
    ViewData["Title"] = Model.EventTitle;
    var registeredCount = ViewBag.RegisteredCount ?? 0;
    var availableSlots = ViewBag.AvailableSlots ?? 0;
    var isFull = availableSlots <= 0;
    var organizer = ViewBag.Organizer as ApplicationUser;
    var isCompleted = Model.Status == "Completed";
    var isCancelled = Model.Status == "Cancelled";
    var isUpcoming = Model.Status == "Upcoming";

    // Resolved server-side against the authenticated user's own stable ID
    // (see ParticipantController.Details) - never against a client-supplied
    // ID, and never a plain FirstOrDefault over every participant's rows.
    var userRegistration = ViewBag.UserRegistration as EventRegistration;
    var isRegistered = userRegistration != null;
    var registrationStatus = userRegistration?.Status ?? "";
    var isAlternativeRecommended = registrationStatus == "Alternative Recommended";

    // Alternative Recommended is a closed door back to the original event -
    // the recommendation panel below owns every action for this state, so
    // each branch that renders an action in the bottom capacity strip
    // excludes it directly rather than relying on an empty branch to swallow
    // it before the others run.
    var showRegistrationStatusAction = isRegistered
        && registrationStatus != "Cancelled" && registrationStatus != "Rejected" && registrationStatus != "Voided"
        && !isAlternativeRecommended;
    var showRegisterAction = isUpcoming && !isAlternativeRecommended;

    var hasAlternativeEventId = userRegistration?.AlternativeEventId != null;
    var alternativeEvent = userRegistration?.AlternativeEvent;
    var alternativeEventAvailable = alternativeEvent != null && TrailGuard.Services.EventJoinabilityHelper.IsJoinable(alternativeEvent);

    // Minimal safe projection built server-side in ParticipantController.Details
    // (Accepted-only, RegisteredAt-ascending, name + avatar only) - see
    // CLAUDE.md, "Joined Participants" / Models/ParticipantEventJoinedRowViewModel.
    // This view never re-derives that filter and never sees another
    // participant's registration/contact/payment/medical/assessment data.
    var joinedParticipants = ViewBag.JoinedParticipants as List<ParticipantEventJoinedRowViewModel> ?? new List<ParticipantEventJoinedRowViewModel>();
    var totalJoined = joinedParticipants.Count;

    var difficultyBadge = TrailGuard.Services.DifficultyCalculator.BadgeClass(Model.Difficulty);

    // Same status/dot mapping as the Organizer Event Details hero
    // (Views/Event/Details.cshtml) - kept identical so the two pages read the
    // same event status the same way.
    string statusSelectClasses = Model.Status switch
    {
        "Upcoming" => "bg-green-500/10 border-green-500/40 text-green-300",
        "Cancelled" => "bg-red-500/10 border-red-500/40 text-red-300",
        "Postponed" => "bg-yellow-500/10 border-yellow-500/40 text-yellow-300",
        "Completed" => "bg-gray-500/10 border-gray-500/40 text-gray-300",
        _ => "bg-gray-500/10 border-gray-500/40 text-gray-300"
    };
    string statusDotClasses = Model.Status switch
    {
        "Upcoming" => "bg-green-400",
        "Cancelled" => "bg-red-400",
        "Postponed" => "bg-yellow-400",
        "Completed" => "bg-gray-400",
        _ => "bg-gray-400"
    };

    var (regBadgeClass, regBadgeIcon, regBadgeText) = registrationStatus switch
    {
        "Pending" => ("text-amber-400 bg-amber-500/15", "fa-clock", "Pending Approval"),
        "Awaiting Payment" => ("text-amber-400 bg-amber-500/15", "fa-money-bill-wave", "Awaiting Payment"),
        "For Payment Verification" => ("text-blue-400 bg-blue-500/15", "fa-hourglass-half", "Verifying Payment"),
        "Accepted" => ("text-emerald-400 bg-emerald-500/15", "fa-check", "Registered"),
        "Rejected" => ("text-red-400 bg-red-500/15", "fa-xmark", "Registration Rejected"),
        "Cancelled" => ("text-slate-400 bg-slate-500/15", "fa-ban", "Cancelled"),
        "Voided" => ("text-slate-400 bg-slate-500/15", "fa-ban", "Voided"),
        _ => ("", "", "")
    };

    // Same switch reused for every weather risk badge, matching Organizer
    // Event Details (Views/Event/Details.cshtml).
    string WeatherRiskBadgeClasses(string? risk) => risk switch
    {
        "Low" => "bg-green-500/20 text-green-400 border-green-500/30",
        "Moderate" => "bg-amber-500/20 text-amber-400 border-amber-500/30",
        "Moderate to High" => "bg-orange-500/20 text-orange-400 border-orange-500/30",
        "High (Thunderstorm)" => "bg-red-500/20 text-red-400 border-red-500/30",
        _ => "bg-gray-500/20 text-gray-400 border-gray-500/30"
    };

    // Terrain chips: safe split of the stored comma-delimited value - trimmed,
    // blanks dropped, first-occurrence order preserved, case-insensitive
    // de-duplication. Sourced from the Event's own Trail Snapshot
    // (TrailTerrainSnapshot), never a live Event.Trail read - see CLAUDE.md,
    // "Event Trail Snapshot".
    var terrainChips = (Model.TrailTerrainSnapshot ?? string.Empty)
        .Split(',')
        .Select(t => t.Trim())
        .Where(t => t.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    // Stored weather snapshot only - never fetched or written on this page
    // load. Only ever treated as "current" through the same
    // TryValidateForSubmission check Add/Edit Event uses before persisting
    // one, matching Organizer Event Details exactly. See CLAUDE.md, "Remove
    // Participant live-weather mutation".
    var weatherSnapshot = TrailGuard.Services.WeatherSnapshotHelper.TryDeserialize(Model.WeatherSnapshotJson);
    var weatherSnapshotIsCurrent = weatherSnapshot != null &&
        TrailGuard.Services.WeatherSnapshotHelper.TryValidateForSubmission(weatherSnapshot, Model.TrailId, Model.EventDate, out _);
    var weatherSnapshotIsStale = weatherSnapshot != null && !weatherSnapshotIsCurrent;

    var pickupScheduleEntries = TrailGuard.Services.PickupScheduleHelper.ParseStoredEntries(Model.PickupPoints);
}

<div class="pt-24 px-4 max-w-6xl mx-auto min-h-screen text-white pb-12">

    @* Success/Error feedback now goes through the canonical global toast host
       in _Layout.cshtml instead of a page-local banner. *@

    <div class="mb-6">
        <a asp-action="Events" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors group">
            <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform" aria-hidden="true"></i>
            Back to Events
        </a>
    </div>

    <div class="relative rounded-2xl overflow-hidden mb-8">
        @if (!string.IsNullOrEmpty(Model.TrailThumbnailUrlSnapshot))
        {
            <img src="@Model.TrailThumbnailUrlSnapshot" alt="@Model.TrailNameSnapshot" class="w-full h-80 object-cover">
        }
        else
        {
            <div class="w-full h-80 bg-linear-to-r from-orange-500/30 to-purple-500/30 flex items-center justify-center">
                <i class="fa-solid fa-mountain text-6xl text-white/50" aria-hidden="true"></i>
            </div>
        }
        <div class="absolute inset-0 bg-linear-to-t from-surface-card via-surface-card/50 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-8">
            <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="inline-flex items-center gap-2 pl-4 pr-4 py-1.5 rounded-full text-xs font-semibold border @statusSelectClasses">
                    <span class="w-1.5 h-1.5 rounded-full @statusDotClasses" aria-hidden="true"></span>
                    @Model.Status
                </span>
                <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium @difficultyBadge">@(string.IsNullOrEmpty(Model.Difficulty) ? "Unknown" : Model.Difficulty)</span>
                @if (isFull && isUpcoming)
                {
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-red-500/20 text-red-400">
                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> Full
                    </span>
                }
                @if (isRegistered && !string.IsNullOrEmpty(regBadgeText))
                {
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold @regBadgeClass">
                        <i class="fa-solid @regBadgeIcon" aria-hidden="true"></i> @regBadgeText
                    </span>
                }
            </div>
            <h1 class="text-4xl font-bold text-white mb-2 wrap-break-word">@Model.EventTitle</h1>
            <div class="flex flex-wrap gap-4 text-gray-300">
                <span><i class="fa-regular fa-calendar text-accent mr-2" aria-hidden="true"></i>@Model.EventDate.ToString("MMMM dd, yyyy")</span>
                <span><i class="fa-regular fa-clock text-accent mr-2" aria-hidden="true"></i>@Model.FormattedEventTime</span>
                <span class="wrap-break-word"><i class="fa-solid fa-location-dot text-accent mr-2" aria-hidden="true"></i>@Model.Location</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:items-stretch">

        <div class="lg:col-span-2 space-y-6">

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-info-circle text-accent mr-2" aria-hidden="true"></i>Event Overview</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-mountain text-accent mr-1" aria-hidden="true"></i>Trail</p>
                        <p class="text-white font-semibold wrap-break-word">@Model.TrailNameSnapshot</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-route text-accent mr-1" aria-hidden="true"></i>Distance</p>
                        <p class="text-white font-semibold">@Model.TrailDistanceKmSnapshot km</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider mb-1.5"><i class="fa-solid fa-tree text-accent mr-1" aria-hidden="true"></i>Terrain</p>
                        @if (terrainChips.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var chip in terrainChips)
                                {
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-gray-300">@chip</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-gray-500 text-sm italic">Not specified</p>
                        }
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider mb-1.5"><i class="fa-solid fa-signal text-accent mr-1" aria-hidden="true"></i>Difficulty</p>
                        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium @difficultyBadge">@(string.IsNullOrEmpty(Model.Difficulty) ? "Unknown" : Model.Difficulty)</span>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-arrow-trend-up text-accent mr-1" aria-hidden="true"></i>Elevation Gain</p>
                        <p class="text-white font-semibold">@Model.TrailElevationGainMetersSnapshot m</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-hand text-accent mr-1" aria-hidden="true"></i>Trail Class</p>
                        <p class="text-white font-semibold">@TrailGuard.Services.DifficultyCalculator.TrailClassLabel(Model.TrailClassSnapshot)</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider"><i class="fa-solid fa-clock text-accent mr-1" aria-hidden="true"></i>Estimated Duration</p>
                        <p class="text-white font-semibold">@Model.EstimatedDuration hours</p>
                    </div>
                </div>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-cloud-sun text-accent mr-2" aria-hidden="true"></i>Weather</h2>

                @if (weatherSnapshotIsCurrent)
                {
                    var snap = weatherSnapshot!;
                    <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                        <div class="flex items-start justify-between gap-2 mb-3">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-9 h-9 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                    <i class="fa-solid @TrailGuard.Services.WeatherSnapshotHelper.GetIconClass(snap.WeatherCode) text-accent text-sm"></i>
                                </span>
                                <p class="text-sm font-semibold text-white wrap-break-word min-w-0">@snap.Condition</p>
                            </div>
                            @if (!string.IsNullOrEmpty(snap.RiskLevel))
                            {
                                <span class="shrink-0 px-2.5 py-0.5 rounded-full text-xs font-semibold border @WeatherRiskBadgeClasses(snap.RiskLevel)">@snap.RiskLevel Risk</span>
                            }
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                <i class="fa-solid fa-temperature-half text-gray-500 text-xs" aria-hidden="true"></i>
                                <p class="text-sm font-semibold text-white mt-1">
                                    @(snap.TemperatureMinC.HasValue && snap.TemperatureMaxC.HasValue ? $"{snap.TemperatureMinC:F0}°–{snap.TemperatureMaxC:F0}°C" : "—")
                                </p>
                                <p class="text-[10px] text-gray-500 uppercase tracking-wide">Temperature</p>
                            </div>
                            <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                <i class="fa-solid fa-droplet text-gray-500 text-xs" aria-hidden="true"></i>
                                <p class="text-sm font-semibold text-white mt-1">@(snap.ExpectedRainfallMm.HasValue ? $"{snap.ExpectedRainfallMm.Value.ToString("0.#")} mm" : "—")</p>
                                <p class="text-[10px] text-gray-500 uppercase tracking-wide">Expected rainfall</p>
                            </div>
                            <div class="rounded-lg bg-white/5 border border-white/10 px-2 py-2 text-center">
                                <i class="fa-solid fa-wind text-gray-500 text-xs" aria-hidden="true"></i>
                                <p class="text-sm font-semibold text-white mt-1">@(snap.WindSpeedKmh.HasValue ? $"{snap.WindSpeedKmh.Value:F0} km/h" : "—")</p>
                                <p class="text-[10px] text-gray-500 uppercase tracking-wide wrap-break-word">@snap.WindDescription</p>
                            </div>
                        </div>
                        @if (snap.UpdatedAt.HasValue)
                        {
                            <p class="text-[11px] text-gray-500 text-right mt-2">Saved forecast, updated @snap.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</p>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.WeatherForecastAdvisory))
                {
                    <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                        <div class="flex items-center justify-between gap-2 mb-2">
                            <p class="text-sm font-semibold text-gray-300"><i class="fa-solid fa-cloud text-gray-500 mr-1.5" aria-hidden="true"></i>Saved forecast</p>
                            @if (!string.IsNullOrEmpty(Model.WeatherRiskLevel))
                            {
                                <span class="shrink-0 px-2.5 py-0.5 rounded-full text-xs font-semibold border @WeatherRiskBadgeClasses(Model.WeatherRiskLevel)">@Model.WeatherRiskLevel Risk</span>
                            }
                        </div>
                        <p class="text-gray-300 text-sm whitespace-pre-wrap">@Model.WeatherForecastAdvisory</p>
                        @if (weatherSnapshotIsStale)
                        {
                            <div class="mt-3 bg-amber-500/10 border border-amber-500/30 rounded-lg p-3 flex items-start gap-2">
                                <i class="fa-solid fa-triangle-exclamation text-amber-400 mt-0.5 shrink-0" aria-hidden="true"></i>
                                <p class="text-amber-300 text-xs">This structured forecast was saved for a previous trail or date and no longer matches this event - showing the last saved advisory instead.</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-gray-500 italic text-sm">Weather forecast not recorded for this event.</p>
                }

                @if (!string.IsNullOrEmpty(Model.WeatherReminder))
                {
                    <div class="mt-4 pt-4 border-t border-white/10">
                        <p class="text-gray-500 text-xs uppercase tracking-wider mb-1"><i class="fa-regular fa-lightbulb mr-1" aria-hidden="true"></i>Weather Reminder</p>
                        <p class="text-gray-300 text-sm whitespace-pre-wrap">@Model.WeatherReminder</p>
                    </div>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-file-lines text-accent mr-2" aria-hidden="true"></i>Event Description</h2>
                <p class="text-gray-300 leading-relaxed whitespace-pre-wrap">@Model.Description</p>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-regular fa-calendar-plus text-accent mr-2" aria-hidden="true"></i>Schedule and Capacity</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider">Date</p>
                        <p class="text-white font-semibold">@Model.EventDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider">Time</p>
                        <p class="text-white font-semibold">@Model.FormattedEventTime</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-xs uppercase tracking-wider">Total Capacity</p>
                        <p class="text-white font-semibold">@Model.Capacity slots</p>
                    </div>
                    <div>
                        @{
                            // Display-only clamp - never rewrites stored data. A capacity
                            // lowered below the already-registered count must not render as
                            // a negative "available slots" figure.
                            var clampedAvailableSlots = Math.Max(0, availableSlots);
                        }
                        <p class="text-gray-500 text-xs uppercase tracking-wider">Available Slots</p>
                        <p class="text-white font-semibold @(clampedAvailableSlots <= 5 ? "text-orange-400" : "")">
                            @clampedAvailableSlots
                            @if (clampedAvailableSlots <= 5 && clampedAvailableSlots > 0)
                            {
                                <span class="text-xs text-orange-400/70 ml-1">(limited)</span>
                            }
                            @if (isFull)
                            {
                                <span class="text-xs text-red-400 ml-1">(full)</span>
                            }
                        </p>
                    </div>
                </div>

                @if (Model.Capacity > 0)
                {
                    // Display-only clamp - never rewrites stored data. A stale or
                    // over-count can't push the fill bar past what's visually sane.
                    var fillPercentage = Math.Clamp((registeredCount * 100) / Model.Capacity, 0, 100);
                    <div class="mt-4">
                        <div class="flex justify-between text-xs text-gray-400 mb-1">
                            <span>@registeredCount registered</span>
                            <span>@fillPercentage% full</span>
                        </div>
                        <div class="w-full h-2 bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-500 @(fillPercentage >= 90 ? "bg-red-500" : fillPercentage >= 70 ? "bg-yellow-500" : "bg-green-500")"
                                 style="width: @fillPercentage%"></div>
                        </div>
                    </div>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-credit-card text-accent mr-2" aria-hidden="true"></i>Payment Details</h2>
                @if (!string.IsNullOrEmpty(Model.PaymentDetails))
                {
                    <p class="text-gray-300 whitespace-pre-wrap">@Model.PaymentDetails</p>
                }
                else
                {
                    <p class="text-gray-500 italic">No payment details provided for this event.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-bus text-accent mr-2" aria-hidden="true"></i>Pickup Schedules</h2>
                @if (pickupScheduleEntries.Count > 0)
                {
                    <ul class="space-y-2">
                        @foreach (var entry in pickupScheduleEntries)
                        {
                            <li class="flex items-center gap-3 rounded-lg bg-white/5 border border-white/10 px-4 py-2.5">
                                <i class="fa-solid fa-location-dot text-accent shrink-0" aria-hidden="true"></i>
                                <span class="text-gray-300 text-sm wrap-break-word">@entry</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-gray-500 italic">No pickup schedules specified for this event.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-bullhorn text-accent mr-2" aria-hidden="true"></i>Notes & Reminders</h2>
                @if (!string.IsNullOrEmpty(Model.NotesAndReminders))
                {
                    <p class="text-gray-300 whitespace-pre-wrap">@Model.NotesAndReminders</p>
                }
                else
                {
                    <p class="text-gray-500 italic">No announcements for this event.</p>
                }
            </div>
        </div>

        <div class="space-y-6 lg:space-y-0 lg:flex lg:flex-col lg:h-full lg:gap-6">

            <div class="shrink-0 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-user-tie text-accent mr-2" aria-hidden="true"></i>Organizer Details</h2>
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-12 h-12 rounded-full bg-linear-to-r from-orange-500 to-purple-500 flex items-center justify-center overflow-hidden shrink-0">
                        @if (organizer != null && !string.IsNullOrEmpty(organizer.ProfilePictureUrl))
                        {
                            <img src="@organizer.ProfilePictureUrl" alt="" class="w-12 h-12 rounded-full object-cover">
                        }
                        else
                        {
                            <i class="fa-solid fa-user text-white text-lg" aria-hidden="true"></i>
                        }
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-white font-bold wrap-break-word">
                            @if (organizer != null)
                            {
                                @(organizer.FirstName + " " + organizer.LastName)
                            }
                            else
                            {
                                @Model.OrganizedBy
                            }
                        </h3>
                        <p class="text-gray-500 text-xs">Event Organizer</p>
                    </div>
                </div>
                @if (organizer != null)
                {
                    <div class="space-y-2">
                        @if (!string.IsNullOrEmpty(organizer.FacebookLink))
                        {
                            <a href="@organizer.FacebookLink" target="_blank" rel="noopener" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors text-sm break-all">
                                <i class="fa-brands fa-facebook w-5 shrink-0" aria-hidden="true"></i>
                                <span class="break-all">@organizer.FacebookLink</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.Email))
                        {
                            <a href="mailto:@organizer.Email" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors text-sm">
                                <i class="fa-regular fa-envelope w-5 shrink-0" aria-hidden="true"></i>
                                <span class="break-all">@organizer.Email</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.PhoneNumber))
                        {
                            <a href="tel:@organizer.PhoneNumber" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors text-sm">
                                <i class="fa-solid fa-phone w-5 shrink-0" aria-hidden="true"></i>
                                <span>@organizer.PhoneNumber</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.Bio))
                        {
                            <p class="text-gray-400 text-sm mt-2 border-t border-white/10 pt-2 wrap-break-word">@organizer.Bio</p>
                        }
                    </div>
                }
                else
                {
                    <p class="text-gray-500 text-sm">Organizer contact details not available.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 lg:flex-1 lg:min-h-0 lg:flex lg:flex-col">
                <h2 class="shrink-0 text-lg font-bold text-white mb-4">
                    <i class="fa-solid fa-users text-accent mr-2" aria-hidden="true"></i>Joined Participants
                    <span class="text-sm font-normal text-gray-400 ml-2">(@totalJoined)</span>
                </h2>
                @if (joinedParticipants.Count > 0)
                {
                    <div class="space-y-3 lg:flex-1 lg:min-h-0 lg:overflow-y-auto tg-event-participants-scroll lg:pr-1">
                        @foreach (var row in joinedParticipants)
                        {
                            <div class="flex items-center gap-3 p-2 rounded-lg">
                                <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center overflow-hidden shrink-0">
                                    @if (!string.IsNullOrEmpty(row.ProfilePictureUrl))
                                    {
                                        <img src="@row.ProfilePictureUrl" alt="" class="w-8 h-8 rounded-full object-cover">
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-user text-gray-400 text-xs" aria-hidden="true"></i>
                                    }
                                </div>
                                <p class="text-white text-sm font-medium truncate min-w-0">@row.ParticipantName</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-6">
                        <i class="fa-regular fa-user text-2xl text-gray-500 mb-2" aria-hidden="true"></i>
                        <p class="text-sm text-gray-500">No participants registered yet.</p>
                        <p class="text-xs text-gray-600">Be the first to join.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (isAlternativeRecommended)
    {
        <div class="mt-8 bg-blue-500/10 border border-blue-500/20 rounded-2xl p-6" role="region" aria-labelledby="alt-event-heading">
            <h2 id="alt-event-heading" class="text-lg font-bold text-white mb-2 flex items-center gap-2">
                <i class="fa-solid fa-arrows-rotate text-blue-400" aria-hidden="true"></i>
                Alternative event recommended
            </h2>
            <p class="text-blue-200 text-sm leading-relaxed mb-3">
                @(hasAlternativeEventId
                    ? "The organizer suggested another event that may be a better match for you."
                    : "The organizer recommended choosing a different event that may be a better match for you.")
            </p>

            @if (!string.IsNullOrWhiteSpace(userRegistration!.DecisionReason))
            {
                <p class="text-gray-300 text-sm bg-black/20 rounded-lg p-3 mb-4 wrap-break-word">
                    <span class="text-gray-500">Organizer's note:</span> @userRegistration.DecisionReason
                </p>
            }

            @if (hasAlternativeEventId && !alternativeEventAvailable)
            {
                <p class="text-gray-400 text-sm mb-4">The recommended event is no longer available.</p>
            }

            <div class="flex flex-wrap gap-3">
                @if (hasAlternativeEventId && alternativeEventAvailable)
                {
                    <a asp-controller="Participant" asp-action="Details" asp-route-id="@userRegistration.AlternativeEventId"
                       class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-medium bg-accent hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base transition-colors">
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        View Recommended Event
                    </a>
                }
                <a asp-controller="Registration" asp-action="MyRegistrations"
                   class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-gray-300 font-medium bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base transition-colors">
                    <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
                    View My Registrations
                </a>
            </div>
        </div>
    }

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
        <p class="text-gray-400 text-sm">
            <i class="fa-solid fa-users text-accent mr-2" aria-hidden="true"></i>
            <span class="font-semibold text-white">@registeredCount</span> participants registered
            @if (isUpcoming && !isFull)
            {
                <span class="text-emerald-400 ml-2">· @Math.Max(0, availableSlots) slots available</span>
            }
            @if (isFull && isUpcoming)
            {
                <span class="text-red-400 ml-2">· Event is full</span>
            }
            @if (isCompleted)
            {
                <span class="ml-2">· This event has ended</span>
            }
            @if (isCancelled)
            {
                <span class="text-red-400 ml-2">· This event has been cancelled</span>
            }
        </p>

        <div class="flex flex-wrap gap-3">
            @if (showRegistrationStatusAction)
            {
                <a asp-controller="Registration" asp-action="MyRegistrations"
                   class="px-8 py-3 rounded-full text-gray-300 font-semibold bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white transition-colors flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base">
                    <i class="fa-solid @regBadgeIcon" aria-hidden="true"></i> @regBadgeText
                </a>
            }
            else if (isFull && isUpcoming && !isAlternativeRecommended)
            {
                <button disabled class="px-8 py-3 rounded-full text-gray-500 font-semibold bg-white/5 border border-white/10 cursor-not-allowed flex items-center gap-2">
                    <i class="fa-solid fa-ban" aria-hidden="true"></i> Event Full
                </button>
            }
            else if ((isCompleted || isCancelled) && !isAlternativeRecommended)
            {
                <button disabled class="px-8 py-3 rounded-full text-gray-500 font-semibold bg-white/5 border border-white/10 cursor-not-allowed flex items-center gap-2">
                    <i class="fa-solid fa-lock" aria-hidden="true"></i> Registration Closed
                </button>
            }
            else if (showRegisterAction)
            {
                <a asp-controller="Assessment" asp-action="Form" asp-route-eventId="@Model.Id"
                   class="px-8 py-3 rounded-full text-white font-semibold bg-accent hover:bg-accent/90 transition-colors flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base">
                    <i class="fa-regular fa-clipboard" aria-hidden="true"></i>
                    @(isRegistered ? "Retake Assessment & Register" : "Register Now")
                </a>
            }

            @if (isCompleted && isRegistered && registrationStatus == "Accepted")
            {
                @if (ViewBag.HasGivenFeedback != null && (bool)ViewBag.HasGivenFeedback)
                {
                    <button disabled class="px-6 py-3 rounded-full text-gray-500 font-semibold bg-white/5 border border-white/10 cursor-not-allowed flex items-center gap-2">
                        <i class="fa-solid fa-check-circle text-emerald-400" aria-hidden="true"></i> Feedback Given
                    </button>
                }
                else
                {
                    <a asp-controller="Participant" asp-action="Feedback" asp-route-eventId="@Model.Id"
                       class="px-6 py-3 rounded-full text-white font-semibold bg-accent hover:bg-accent/90 transition-colors flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base">
                        <i class="fa-solid fa-comment" aria-hidden="true"></i> Give Feedback
                    </a>
                }
            }
        </div>
    </div>
</div>
