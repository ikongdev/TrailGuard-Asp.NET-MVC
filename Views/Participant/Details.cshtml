@model TrailGuard.Models.Event
@using TrailGuard.Models
@{
    ViewData["Title"] = Model.EventTitle;
    var trail = ViewBag.Trail as TrailGuard.Models.Trail;
    var registrations = ViewBag.Registrations as List<EventRegistration> ?? new List<EventRegistration>();
    var registeredCount = ViewBag.RegisteredCount ?? 0;
    var availableSlots = ViewBag.AvailableSlots ?? 0;
    var isFull = availableSlots <= 0;
    var organizer = ViewBag.Organizer as ApplicationUser;
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
    var isCompleted = Model.Status == "Completed";
    var isCancelled = Model.Status == "Cancelled";
    var isUpcoming = Model.Status == "Upcoming";

    var userRegistration = registrations.FirstOrDefault(r => r.UserId == userId);
    var isRegistered = userRegistration != null;
    var registrationStatus = userRegistration?.Status ?? "";

    var joinedParticipants = registrations
        .Where(r => r.Status == "Accepted")
        .OrderBy(r => r.RegisteredAt)
        .ToList();
    var totalJoined = joinedParticipants.Count;

    var difficultyBadge = TrailGuard.Services.DifficultyCalculator.BadgeClass(Model.Difficulty);

    var eventStatusBadge = Model.Status switch
    {
        "Upcoming" => "text-emerald-400 bg-emerald-500/15",
        "Completed" => "text-slate-400 bg-slate-500/15",
        "Cancelled" => "text-red-400 bg-red-500/15",
        _ => "text-slate-400 bg-slate-500/15"
    };

    var (regBadgeClass, regBadgeIcon, regBadgeText) = registrationStatus switch
    {
        "Pending" => ("text-amber-400 bg-amber-500/15", "fa-clock", "Pending Approval"),
        "Awaiting Payment" => ("text-amber-400 bg-amber-500/15", "fa-money-bill-wave", "Awaiting Payment"),
        "For Payment Verification" => ("text-blue-400 bg-blue-500/15", "fa-hourglass-half", "Verifying Payment"),
        "Accepted" => ("text-emerald-400 bg-emerald-500/15", "fa-check", "Registered"),
        "Rejected" => ("text-red-400 bg-red-500/15", "fa-xmark", "Registration Rejected"),
        "Cancelled" => ("text-slate-400 bg-slate-500/15", "fa-ban", "Cancelled"),
        "Voided" => ("text-slate-400 bg-slate-500/15", "fa-ban", "Voided"),
        _ => ("", "", "")
    };

    var eventTimeText = $"{Model.EventTime.Hours:D2}:{Model.EventTime.Minutes:D2} {(Model.EventTime.Hours >= 12 ? "PM" : "AM")}";
}

<div class="pt-24 px-4 max-w-6xl mx-auto min-h-screen text-white pb-12">
    
    @* Success/Error feedback now goes through the canonical global toast host
       in _Layout.cshtml instead of a page-local banner. *@

    <div class="mb-6">
        <a asp-action="Events" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Events
        </a>
    </div>

    <div class="relative rounded-xl overflow-hidden mb-8">
        @if (!string.IsNullOrEmpty(trail?.ThumbnailUrl))
        {
            <img src="@trail.ThumbnailUrl" alt="@trail.Name" class="w-full h-72 object-cover">
        }
        else
        {
            <div class="w-full h-72 bg-black/30 flex items-center justify-center">
                <i class="fa-solid fa-mountain text-6xl text-slate-700"></i>
            </div>
        }
        <div class="absolute inset-0 bg-linear-to-t from-surface-card via-surface-card/60 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-8">
            <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-2.5 py-1 rounded-full text-xs font-medium @eventStatusBadge">@Model.Status</span>
                <span class="px-2.5 py-1 rounded-full text-xs font-medium @difficultyBadge">@Model.Difficulty</span>
                @if (isFull && isUpcoming)
                {
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium text-red-400 bg-red-500/15">
                        <i class="fa-solid fa-circle-exclamation mr-1"></i>Full
                    </span>
                }
                @if (isRegistered && !string.IsNullOrEmpty(regBadgeText))
                {
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium @regBadgeClass">
                        <i class="fa-solid @regBadgeIcon mr-1"></i>@regBadgeText
                    </span>
                }
            </div>
            <h1 class="text-4xl font-bold text-white mb-2">@Model.EventTitle</h1>
            <div class="flex flex-wrap gap-4 text-sm text-gray-300">
                <span><i class="fa-regular fa-calendar text-accent mr-2"></i>@Model.EventDate.ToString("MMMM dd, yyyy")</span>
                <span><i class="fa-regular fa-clock text-accent mr-2"></i>@eventTimeText</span>
                <span><i class="fa-solid fa-location-dot text-accent mr-2"></i>@Model.Location</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 space-y-6">
            
            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-circle-info text-accent mr-2"></i>Event Overview</h2>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-4">
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Trail</p>
                        <p class="text-white font-semibold text-sm">@trail?.Name</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Distance</p>
                        <p class="text-white font-semibold text-sm">@trail?.DistanceKm km</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Elevation Gain</p>
                        <p class="text-white font-semibold text-sm">@trail?.ElevationGainMeters m</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Trail Class</p>
                        <p class="text-white font-semibold text-sm">@TrailGuard.Services.DifficultyCalculator.TrailClassLabel(trail?.TrailClass ?? 0)</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Duration</p>
                        <p class="text-white font-semibold text-sm">@Model.EstimatedDuration hours</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Terrain</p>
                        <p class="text-white font-semibold text-sm">@trail?.Terrain</p>
                    </div>
                </div>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-bold text-white"><i class="fa-solid fa-cloud-sun text-accent mr-2"></i>Weather</h2>
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap text-slate-400 bg-slate-500/15" id="weather-badge">
                        <i class="fa-solid fa-spinner fa-spin mr-1"></i>Loading...
                    </span>
                </div>
                <p class="text-gray-300 text-sm whitespace-pre-line leading-relaxed" id="weather-details"></p>
                <p class="text-gray-400 text-sm leading-relaxed mt-4 pt-4 border-t border-white/10 hidden" id="weather-reminder-wrap">
                    <i class="fa-solid fa-circle-info mr-1 text-accent"></i>
                    <span id="weather-reminder"></span>
                </p>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-file-lines text-accent mr-2"></i>Event Description</h2>
                <p class="text-gray-300 text-sm leading-relaxed whitespace-pre-line">@Model.Description</p>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-regular fa-calendar-plus text-accent mr-2"></i>Schedule and Capacity</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-5">
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Date</p>
                        <p class="text-white font-semibold text-sm">@Model.EventDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Time</p>
                        <p class="text-white font-semibold text-sm">@eventTimeText</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Total Capacity</p>
                        <p class="text-white font-semibold text-sm">@Model.Capacity slots</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Available Slots</p>
                        <p class="font-semibold text-sm @(availableSlots <= 0 ? "text-red-400" : availableSlots <= 5 ? "text-amber-400" : "text-white")">
                            @availableSlots
                            @if (availableSlots <= 0)
                            {
                                <span class="text-xs">(full)</span>
                            }
                        </p>
                    </div>
                </div>
                
                @if (Model.Capacity > 0)
                {
                    var fillPercentage = (registeredCount * 100) / Model.Capacity;
                    <div>
                        <div class="flex justify-between text-xs text-gray-500 mb-1.5">
                            <span>@registeredCount registered</span>
                            <span>@fillPercentage% full</span>
                        </div>
                        <div class="w-full h-2 bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-500 @(fillPercentage >= 90 ? "bg-red-500" : fillPercentage >= 70 ? "bg-amber-500" : "bg-emerald-500")" 
                                 style="width: @fillPercentage%"></div>
                        </div>
                    </div>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-credit-card text-accent mr-2"></i>Payment Details</h2>
                @if (!string.IsNullOrEmpty(Model.PaymentDetails))
                {
                    <p class="text-gray-300 text-sm leading-relaxed whitespace-pre-line">@Model.PaymentDetails</p>
                }
                else
                {
                    <p class="text-gray-500 text-sm">No payment details provided for this event.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-bus text-accent mr-2"></i>Pickup Points</h2>
                @if (!string.IsNullOrEmpty(Model.PickupPoints))
                {
                    <p class="text-gray-300 text-sm leading-relaxed whitespace-pre-line">@Model.PickupPoints</p>
                }
                else
                {
                    <p class="text-gray-500 text-sm">No pickup points specified for this event.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-bullhorn text-accent mr-2"></i>Notes &amp; Reminders</h2>
                @if (!string.IsNullOrEmpty(Model.NotesAndReminders))
                {
                    <p class="text-gray-300 text-sm leading-relaxed whitespace-pre-line">@Model.NotesAndReminders</p>
                }
                else
                {
                    <p class="text-gray-500 text-sm">No notes or reminders for this event.</p>
                }
            </div>
        </div>

        <div class="space-y-6">
            
            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-chart-simple text-accent mr-2"></i>Summary</h2>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between gap-4">
                        <span class="text-gray-400">Trail</span>
                        <span class="text-white font-semibold text-right">@trail?.Name</span>
                    </div>
                    <div class="flex justify-between gap-4">
                        <span class="text-gray-400">Difficulty</span>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium @difficultyBadge">@Model.Difficulty</span>
                    </div>
                    <div class="flex justify-between gap-4">
                        <span class="text-gray-400">Date &amp; Time</span>
                        <span class="text-white font-semibold text-right">@Model.EventDate.ToString("MMM dd, yyyy")<br />@eventTimeText</span>
                    </div>
                    <div class="flex justify-between gap-4">
                        <span class="text-gray-400">Duration</span>
                        <span class="text-white font-semibold">@Model.EstimatedDuration hrs</span>
                    </div>
                    <div class="flex justify-between gap-4">
                        <span class="text-gray-400">Registered</span>
                        <span class="text-white font-semibold">@registeredCount / @Model.Capacity</span>
                    </div>
                    <div class="flex justify-between gap-4">
                        <span class="text-gray-400">Status</span>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium @eventStatusBadge">@Model.Status</span>
                    </div>
                </div>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-user-tie text-accent mr-2"></i>Organizer</h2>
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-12 h-12 rounded-full bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 flex items-center justify-center overflow-hidden shrink-0">
                        @if (organizer != null && !string.IsNullOrEmpty(organizer.ProfilePictureUrl))
                        {
                            <img src="@organizer.ProfilePictureUrl" alt="Organizer" class="w-full h-full object-cover">
                        }
                        else
                        {
                            <i class="fa-solid fa-user text-white"></i>
                        }
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-white font-semibold truncate">
                            @(organizer != null ? $"{organizer.FirstName} {organizer.LastName}" : Model.OrganizedBy)
                        </h3>
                        <p class="text-gray-500 text-xs">Event Organizer</p>
                    </div>
                </div>
                @if (organizer != null)
                {
                    <div class="space-y-2 text-sm">
                        @if (!string.IsNullOrEmpty(organizer.Email))
                        {
                            <a href="mailto:@organizer.Email" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors">
                                <i class="fa-regular fa-envelope w-4 shrink-0"></i>
                                <span class="truncate">@organizer.Email</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.PhoneNumber))
                        {
                            <a href="tel:@organizer.PhoneNumber" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors">
                                <i class="fa-solid fa-phone w-4 shrink-0"></i>
                                <span>@organizer.PhoneNumber</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.FacebookLink))
                        {
                            <a href="@organizer.FacebookLink" target="_blank" rel="noopener" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors">
                                <i class="fa-brands fa-facebook w-4 shrink-0"></i>
                                <span class="truncate">Facebook</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(organizer.Bio))
                        {
                            <p class="text-gray-400 text-xs mt-3 pt-3 border-t border-white/10 leading-relaxed">@organizer.Bio</p>
                        }
                    </div>
                }
                else
                {
                    <p class="text-gray-500 text-sm">Contact details not available.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4">
                    <i class="fa-solid fa-users text-accent mr-2"></i>Joined Participants
                    <span class="text-sm font-normal text-gray-500">(@totalJoined)</span>
                </h2>
                @if (joinedParticipants.Any())
                {
                    <div class="space-y-3">
                        @foreach (var reg in joinedParticipants.Take(6))
                        {
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center overflow-hidden shrink-0">
                                    @if (!string.IsNullOrEmpty(reg.User?.ProfilePictureUrl))
                                    {
                                        <img src="@reg.User.ProfilePictureUrl" alt="Participant" class="w-full h-full object-cover">
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-user text-gray-400 text-xs"></i>
                                    }
                                </div>
                                <p class="text-white text-sm truncate">@reg.ParticipantName</p>
                            </div>
                        }
                        
                        @if (totalJoined > 6)
                        {
                            <p class="text-gray-500 text-xs pt-2 border-t border-white/10">
                                + @(totalJoined - 6) more participants
                            </p>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-6">
                        <i class="fa-regular fa-user text-2xl text-slate-600 mb-2 block"></i>
                        <p class="text-sm text-slate-400">No participants yet.</p>
                        <p class="text-xs text-gray-600 mt-1">Be the first to join.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
        <p class="text-gray-400 text-sm">
            <i class="fa-solid fa-users text-accent mr-2"></i>
            <span class="font-semibold text-white">@registeredCount</span> participants registered
            @if (isUpcoming && !isFull)
            {
                <span class="text-emerald-400 ml-2">· @availableSlots slots available</span>
            }
            @if (isFull && isUpcoming)
            {
                <span class="text-red-400 ml-2">· Event is full</span>
            }
            @if (isCompleted)
            {
                <span class="ml-2">· This event has ended</span>
            }
            @if (isCancelled)
            {
                <span class="text-red-400 ml-2">· This event has been cancelled</span>
            }
        </p>
        
        <div class="flex flex-wrap gap-3">
            @if (!isLoggedIn)
            {
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" 
                   class="px-8 py-3 rounded-full text-white font-semibold bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out flex items-center gap-2">
                    <i class="fa-solid fa-right-to-bracket"></i> Login to Register
                </a>
            }
            else if (isRegistered && registrationStatus != "Cancelled" && registrationStatus != "Rejected" && registrationStatus != "Voided")
            {
                <a asp-controller="Registration" asp-action="MyRegistrations"
                   class="px-8 py-3 rounded-full text-gray-300 font-semibold bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white transition-colors flex items-center gap-2">
                    <i class="fa-solid @regBadgeIcon"></i> @regBadgeText
                </a>
            }
            else if (isFull && isUpcoming)
            {
                <button disabled class="px-8 py-3 rounded-full text-gray-500 font-semibold bg-white/5 border border-white/10 cursor-not-allowed flex items-center gap-2">
                    <i class="fa-solid fa-ban"></i> Event Full
                </button>
            }
            else if (isCompleted || isCancelled)
            {
                <button disabled class="px-8 py-3 rounded-full text-gray-500 font-semibold bg-white/5 border border-white/10 cursor-not-allowed flex items-center gap-2">
                    <i class="fa-solid fa-lock"></i> Registration Closed
                </button>
            }
            else if (isUpcoming)
            {
                <a asp-controller="Assessment" asp-action="Form" asp-route-eventId="@Model.Id"
                   class="px-8 py-3 rounded-full text-white font-semibold bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out flex items-center gap-2">
                    <i class="fa-regular fa-clipboard"></i>
                    @(isRegistered ? "Retake Assessment & Register" : "Register Now")
                </a>
            }

            @if (isCompleted && isRegistered && registrationStatus == "Accepted")
            {
                @if (ViewBag.HasGivenFeedback != null && (bool)ViewBag.HasGivenFeedback)
                {
                    <button disabled class="px-6 py-3 rounded-full text-gray-500 font-semibold bg-white/5 border border-white/10 cursor-not-allowed flex items-center gap-2">
                        <i class="fa-solid fa-check-circle text-emerald-400"></i> Feedback Given
                    </button>
                }
                else
                {
                    <a asp-controller="Participant" asp-action="Feedback" asp-route-eventId="@Model.Id"
                       class="px-6 py-3 rounded-full text-white font-semibold bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out flex items-center gap-2">
                        <i class="fa-solid fa-comment"></i> Give Feedback
                    </a>
                }
            }
        </div>
    </div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        fetch('/Participant/GetEventWeather?eventId=@Model.Id')
            .then(function(response) { return response.json(); })
            .then(function(data) { renderWeatherBadge(data); })
            .catch(function() { renderWeatherBadge({ success: false }); });
    });

    var riskColors = {
        'Low': 'text-emerald-400 bg-emerald-500/15',
        'Moderate': 'text-amber-400 bg-amber-500/15',
        'Moderate to High': 'text-orange-400 bg-orange-500/15',
        'High (Thunderstorm)': 'text-red-400 bg-red-500/15'
    };

    var unavailableLabels = {
        'TooFarAhead': 'Forecast Not Yet Available',
        'LocationNotFound': 'Location Not Recognized',
        'NoLocation': 'No Location Set',
        'ServiceDown': 'Weather Service Unavailable'
    };

    function renderWeatherBadge(data) {
        const badge = document.getElementById('weather-badge');
        if (!badge) return;

        if (!data.success) {
            const label = unavailableLabels[data.unavailableReason] || 'Forecast Unavailable';
            badge.className = 'px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap text-slate-400 bg-slate-500/15';
            badge.innerHTML = label;
            const detailsEl = document.getElementById('weather-details');
            if (detailsEl) detailsEl.textContent = 'No weather forecast available for this event.';
            return;
        }

        const colorClass = riskColors[data.riskLevel] || 'text-slate-400 bg-slate-500/15';
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap ' + colorClass;
        badge.innerHTML = data.riskLevel;

        const detailsEl = document.getElementById('weather-details');
        if (detailsEl) detailsEl.textContent = data.details || '';

        if (data.reminder) {
            const reminderEl = document.getElementById('weather-reminder');
            const reminderWrap = document.getElementById('weather-reminder-wrap');
            if (reminderEl) reminderEl.textContent = data.reminder;
            if (reminderWrap) reminderWrap.classList.remove('hidden');
        }
    }
</script>
</div>