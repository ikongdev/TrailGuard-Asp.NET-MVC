@using Microsoft.AspNetCore.Mvc.ViewFeatures

@{
    ViewData["Title"] = "Home";
}


@* Hero Section *@
@section PageHero {
    <div class="relative w-full min-h-screen flex flex-col justify-center items-center text-center px-4 pt-12 pb-12">
        <div class="max-w-3xl mx-auto px-6">

            <div class="hero-fade inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/10 backdrop-blur-sm mb-6" style="--delay: 0ms">
                <span class="text-sm text-accent tracking-wide">
                    • Smarter Trails. Safer Adventure •
                </span>
            </div>

            <h1 class="hero-fade text-4xl md:text-6xl lg:text-5xl font-extrabold leading-tight text-white mb-6" style="--delay: 120ms">
                Find Your
                <span class="bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 bg-clip-text text-transparent">
                    Perfect Trail
                </span>
            </h1>

            <p class="hero-fade max-w-2xl mx-auto text-base md:text-lg text-slate-200 leading-relaxed mb-8" style="--delay: 240ms">
                Hike smarter, not harder. TrailGuard assesses your fitness,
                matches you with the right mountain, and guides you safely from base camp
                to summit — across the most breathtaking peaks of the Philippines.
            </p>

            <div class="hero-fade" style="--delay: 360ms">
                <partial name="Components/UI/_PrimaryButton"
                    view-data='new ViewDataDictionary(ViewData)
                    {
                        { "Text", "Get Started " },
                        { "Href", "/Account/Register" },
                        { "Icon", "fa-solid fa-arrow-right" }
                    }' />
            </div>
        </div>
        
        <div class="hero-fade absolute bottom-5 left-1/2 -translate-x-1/2" style="--delay: 520ms">
            <a href="#about" id="scroll-to-about" class="text-white/60 hover:text-white transition-colors duration-300 flex justify-center">
                <i class="fa-solid fa-arrow-down text-xl md:text-2xl animate-bounce"></i>
            </a>
        </div>

    </div>
}

@* About Section *@
<section id="about" class="scroll-reveal opacity-0 translate-y-12 transition-all duration-1000 ease-out py-24 bg-surface-base">

    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full">

        <div class="rounded-xl border border-white/10 bg-surface-raised/70 px-5 py-10 sm:px-8 md:px-14 md:py-14">

            <div class="text-center mb-8 md:mb-10">
                <p class="inline-flex items-center gap-3 text-xl md:text-2xl font-semibold tracking-wide">
                    <span class="text-accent">•</span>
                    <span class="text-accent">
                        WHAT IS TRAILGUARD
                    </span>
                    <span class="text-accent">•</span>
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 items-center">

                <div class="relative flex justify-center items-center w-full h-64 sm:h-80 md:h-96 overflow-visible order-1">
                    <lottie-player 
                        src="/animation/animation.json" 
                        background="transparent" 
                        speed="1" 
                        class="w-64 h-64 sm:w-80 sm:h-80 md:w-96 md:h-96 scale-110 md:scale-140"
                        loop 
                        autoplay>
                    </lottie-player>
                </div>

                <div class="order-2">
                    <p class="text-white text-lg md:text-xl font-semibold leading-snug mb-8">
                        A web-based hiking event management and participant
                        suitability assessment system.
                    </p>

                    <div class="space-y-6">

                        <div class="flex gap-4">
                            <div class="w-9 h-9 shrink-0 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center">
                                <i class="fa-solid fa-clipboard-list text-accent text-sm"></i>
                            </div>
                            <div>
                                <h3 class="text-white font-semibold text-sm mb-1">For organizers</h3>
                                <p class="text-slate-400 text-sm leading-relaxed">
                                    Manage trails, events, registrations, and participant
                                    screening in one place.
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <div class="w-9 h-9 shrink-0 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center">
                                <i class="fa-solid fa-person-hiking text-accent text-sm"></i>
                            </div>
                            <div>
                                <h3 class="text-white font-semibold text-sm mb-1">For hikers</h3>
                                <p class="text-slate-400 text-sm leading-relaxed">
                                    Know before you register whether a trail actually
                                    matches your fitness and experience.
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <div class="w-9 h-9 shrink-0 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center">
                                <i class="fa-solid fa-brain text-accent text-sm"></i>
                            </div>
                            <div>
                                <h3 class="text-white font-semibold text-sm mb-1">Powered by machine learning</h3>
                                <p class="text-slate-400 text-sm leading-relaxed">
                                    Every assessment returns Good Match, Borderline, or
                                    Not Recommended — along with the reasons behind it.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

