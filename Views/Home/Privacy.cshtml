@{
    ViewData["Title"] = "Privacy Policy";
}
<main class="min-h-screen px-4 pb-14 pt-24 text-white sm:pb-16">
    <div class="mx-auto max-w-4xl">
        <header class="mb-8 sm:mb-10">
            <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-accent">TrailGuard</p>
            <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Privacy Policy</h1>
            <p class="mt-3 max-w-3xl leading-relaxed text-gray-300">
                This notice explains how TrailGuard handles personal information when you use its hiking-event,
                trail-management, and suitability-assessment features. TrailGuard is developed as a capstone project.
            </p>
        </header>

        <div class="space-y-5 sm:space-y-6">
            <section aria-labelledby="privacy-about" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">1</span>
                    <div>
                        <h2 id="privacy-about" class="text-xl font-bold text-white">About this notice</h2>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            This policy applies to TrailGuard's public pages and signed-in features. It describes the
                            information used to operate accounts, hiking events, registrations, and assessments. It does
                            not replace notices required by a school, event organizer, hosting provider, or another
                            organization that may separately handle information.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="privacy-collected" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">2</span>
                    <div class="min-w-0">
                        <h2 id="privacy-collected" class="text-xl font-bold text-white">Information TrailGuard collects</h2>
                        <p class="mt-3 leading-relaxed text-gray-300">Depending on the features you use, TrailGuard may collect:</p>
                        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-gray-300 marker:text-accent">
                            <li>account and contact information, such as your name, email address, phone number, and account profile details you choose to provide;</li>
                            <li>assessment answers, including exercise and hiking experience, gear, body measurements, and disclosed health or medical-condition information;</li>
                            <li>event-registration and workflow information, including contact and emergency details, pickup choices, payment or review details, and documents you upload, such as receipts or medical-clearance documents; and</li>
                            <li>assessment-result history, including model scores and recommendations, model and feature snapshots used for provenance, and explanation factors shown through SHAP.</li>
                        </ul>
                        <p class="mt-3 leading-relaxed text-gray-400">
                            TrailGuard does not claim to collect information that is not provided through these features or generated by their documented workflows.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="privacy-use" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">3</span>
                    <div class="min-w-0">
                        <h2 id="privacy-use" class="text-xl font-bold text-white">How information is used</h2>
                        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-gray-300 marker:text-accent">
                            <li>to create and manage accounts, Trails, Events, and registrations;</li>
                            <li>to run assessment and clearance-related workflows and present their results;</li>
                            <li>to let authorized organizers and system roles perform the event workflows available to them;</li>
                            <li>to operate, secure, troubleshoot, and improve the system; and</li>
                            <li>where consent and project rules permit, to support academic evaluation, research, and statistical analysis using aggregate or anonymized reporting.</li>
                        </ul>
                        <p class="mt-3 leading-relaxed text-gray-400">
                            An individual assessment is not used to automatically retrain the active model.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="privacy-automated" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">4</span>
                    <div>
                        <h2 id="privacy-automated" class="text-xl font-bold text-white">Automated assessment</h2>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            TrailGuard processes supported assessment answers together with the selected Event's stored trail details to generate a suitability recommendation and explanation factors. These outputs are decision support for organizers; they do not guarantee completion probabilities, diagnose a medical condition, or automatically approve or reject a registration.
                        </p>
                        <p class="mt-3 leading-relaxed text-gray-400">
                            Medical screening and clearance requirements are separate from the active model and remain part of the registration workflow.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="privacy-access" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">5</span>
                    <div>
                        <h2 id="privacy-access" class="text-xl font-bold text-white">Access and service providers</h2>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            Access is role- and relationship-based: participants access their own records; organizers access records for the Events they organize; and administrators access management functions assigned to their role. Profile information is not available to anonymous visitors. Authorized signed-in roles may see information only through the screens and event relationships the application permits.
                        </p>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            TrailGuard uses PostgreSQL for application data. The repository's development configuration is local, while the application also supports a Supabase PostgreSQL target and Supabase Storage for public images and private documents when configured. In local development, uploads use application-controlled storage outside the public web root. This notice does not identify a verified production hosting provider or storage location.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="privacy-retention" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">6</span>
                    <div>
                        <h2 id="privacy-retention" class="text-xl font-bold text-white">Storage and retention</h2>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            TrailGuard retains registration and assessment histories that are part of Event and workflow records. Cancelling an Event closes further processing, but does not itself erase registrations, assessments, results, receipts, documents, or historical snapshots.
                        </p>
                        <p class="mt-3 leading-relaxed text-gray-400">
                            The project does not currently publish an owner-approved retention schedule or deletion timetable. Records are not represented here as automatically erased after a fixed period.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="privacy-security" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">7</span>
                    <div>
                        <h2 id="privacy-security" class="text-xl font-bold text-white">Cookies and security</h2>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            TrailGuard uses functional authentication cookies to maintain a signed-in session. This notice does not claim advertising or analytics-cookie use.
                        </p>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            The application includes authenticated role-based access, ownership and Event-scope checks on relevant workflows, antiforgery protection for state-changing forms, and HTTPS redirection. These measures reduce risk, but no online system can guarantee absolute security.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="privacy-rights" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">8</span>
                    <div>
                        <h2 id="privacy-rights" class="text-xl font-bold text-white">Consent and privacy rights</h2>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            Subject to applicable law, including the Data Privacy Act of 2012 (Republic Act No. 10173), you may ask to access or correct personal information, object to processing in appropriate circumstances, withdraw consent, or request erasure where the law allows. Withdrawal or erasure can affect features that need the information, and may be limited where records must be retained for lawful or legitimate workflow purposes.
                        </p>
                        <p class="mt-3 leading-relaxed text-gray-400">
                            TrailGuard does not currently provide a self-service privacy-request flow, an official privacy-request email, or a published Data Protection Officer contact in the application. Do not send sensitive personal or medical information through an unverified channel; an owner-approved contact channel must be published before external deployment.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="privacy-updates" class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">9</span>
                    <div>
                        <h2 id="privacy-updates" class="text-xl font-bold text-white">Changes and references</h2>
                        <p class="mt-3 leading-relaxed text-gray-300">
                            This page may be updated as TrailGuard's documented practices or legal requirements change. Review it when you use the service and before submitting new information.
                        </p>
                        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed marker:text-accent">
                            <li><a href="https://privacy.gov.ph/data-privacy-act/" target="_blank" rel="noopener noreferrer" class="text-accent underline decoration-accent/50 underline-offset-4 hover:brightness-125 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base">National Privacy Commission — Data Privacy Act of 2012</a></li>
                            <li><a href="https://privacy.gov.ph/data-subject-rights/" target="_blank" rel="noopener noreferrer" class="text-accent underline decoration-accent/50 underline-offset-4 hover:brightness-125 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base">National Privacy Commission — Data Subject Rights</a></li>
                        </ul>
                    </div>
                </div>
            </section>
        </div>
    </div>
</main>
