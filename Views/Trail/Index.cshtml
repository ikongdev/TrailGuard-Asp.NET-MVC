        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }
        
        /* Modal visibility now uses Tailwind's own hidden/flex toggle (DESIGN.md's
           documented modal pattern), not a bespoke .modal-hidden/.modal-visible
           pair with hardcoded padding-top hacks to force the panel on screen -
           the flex centering plus each panel's own max-h-[calc(100vh-2rem)] is
           enough on its own. */

        @@keyframes fadeOut {
            from { opacity: 1; transform: scale(1); }
            to { opacity: 0; transform: scale(0.95); }
        }

        /* The card grid uses Tailwind's .flex utility (display: flex), which has the
           same specificity as the browser's default [hidden] rule and would otherwise
           win by source order. !important guarantees a hidden card actually disappears
           instead of silently staying flex-displayed. */
        .trail-card[hidden] {
            display: none !important;
        }
    </style>

    <script>
        // Single reusable implementation of dialog open/close mechanics for all
        // three modals on this page - focus trapping, focus restoration, Escape,
        // background inert + scroll lock - so each modal's own open/close function
        // only has to handle what's actually specific to it (populating fields,
        // resetting a form). Only one of the three modals is ever open at a time in
        // this page's flow (Trail Details closes itself before Edit opens), so this
        // deliberately doesn't track a stack of concurrently-open modals.
        const TrailModal = (function () {
            let activeModal = null;
            let lastFocusedElement = null;
            let inertedElements = [];
            let bodyOverflowBeforeModal = null;

            function getFocusableElements(container) {
                return Array.from(container.querySelectorAll(
                    'a[href], button:not([disabled]), textarea:not([disabled]), ' +
                    'input:not([disabled]):not([type="hidden"]), select:not([disabled]), ' +
                    '[tabindex]:not([tabindex="-1"])'
                )).filter(function (el) { return el.offsetParent !== null; });
            }

            // Walks upward from the modal root rather than assuming it's a direct
            // child of <body> - at each ancestor level it inerts only that
            // element's siblings, never the modal or any of its own ancestors, and
            // stops once it reaches body. Skips (and never tracks) anything that
            // was already inert for some other reason, so close only ever undoes
            // what this function itself added.
            function makeBackgroundInert(modalRoot) {
                inertedElements = [];
                let current = modalRoot;

                while (current && current !== document.body) {
                    const parent = current.parentElement;
                    if (!parent) break;

                    Array.from(parent.children).forEach(function (sibling) {
                        if (sibling === current || sibling.hasAttribute('inert')) return;
                        // The global toast host must stay interactive and in the
                        // accessibility tree no matter which modal is open - see
                        // wwwroot/js/toast.js.
                        if (window.tgToastHostExempt && window.tgToastHostExempt(sibling)) return;
                        sibling.setAttribute('inert', '');
                        inertedElements.push(sibling);
                    });

                    current = parent;
                }
            }

            function restoreBackgroundInert() {
                inertedElements.forEach(function (element) {
                    element.removeAttribute('inert');
                });
                inertedElements = [];
            }

            function handleKeydown(event) {
                if (!activeModal) return;

                if (event.key === 'Escape') {
                    closeModal(activeModal.id);
                    return;
                }

                if (event.key === 'Tab') {
                    // A visible toast's dismiss button is a permitted extra stop in
                    // this trap (see wwwroot/js/toast.js) - nothing else in the
                    // background is ever included.
                    const toastCloseButtons = window.tgGetToastCloseButtons ? window.tgGetToastCloseButtons() : [];
                    const focusable = getFocusableElements(activeModal).concat(toastCloseButtons);
                    if (focusable.length === 0) {
                        event.preventDefault();
                        return;
                    }
                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];
                    if (event.shiftKey && document.activeElement === first) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey && document.activeElement === last) {
                        event.preventDefault();
                        first.focus();
                    }
                }
            }

            function openModal(id) {
                const modal = document.getElementById(id);
                if (!modal) return;

                lastFocusedElement = document.activeElement;
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                activeModal = modal;
                makeBackgroundInert(modal);
                bodyOverflowBeforeModal = document.body.style.overflow;
                document.body.style.overflow = 'hidden';
                document.addEventListener('keydown', handleKeydown);

                const focusable = getFocusableElements(modal);
                const target = focusable[0] || modal;
                if (target && typeof target.focus === 'function') {
                    target.focus();
                }
            }

            function closeModal(id) {
                const modal = document.getElementById(id);
                if (!modal) return;

                // Any open custom-select dropdown belonging to this modal must
                // close before the modal itself does, so it can't be left
                // floating (position: fixed, so it isn't hidden just by an
                // ancestor's overflow) once its trigger is no longer visible.
                if (window.CustomSelect) window.CustomSelect.closeAll();

                if (activeModal !== modal) {
                    // Not the active modal - just hide it. None of the tracked
                    // teardown (focus restore, inert, scroll lock, keydown
                    // listener) belongs to this modal right now, so leave it alone.
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                    return;
                }

                modal.classList.add('hidden');
                modal.classList.remove('flex');
                activeModal = null;
                restoreBackgroundInert();
                document.body.style.overflow = bodyOverflowBeforeModal || '';
                bodyOverflowBeforeModal = null;
                document.removeEventListener('keydown', handleKeydown);

                if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                    lastFocusedElement.focus();
                }
                lastFocusedElement = null;
            }

            // Switches the active modal (Trail Details -> Edit) without running
            // the intermediate close/open teardown: lastFocusedElement, the body
            // scroll lock, bodyOverflowBeforeModal, and the keydown listener all
            // stay exactly as they are for the whole transition, so the eventual
            // close still restores focus to whichever control opened the *first*
            // modal in the chain - not to the now-hidden modal that started it,
            // and not even briefly to the background trigger. No timeout is
            // needed since there's no close/open animation to wait out.
            //
            // Background inert state is fully recomputed rather than patched:
            // restoreBackgroundInert() undoes only what was tracked for fromModal
            // (never anything pre-existing), then makeBackgroundInert(toModal)
            // walks toModal's own ancestor chain from scratch. Patching just
            // toModal's own inert attribute (the previous implementation) only
            // worked because both modals happen to be direct siblings under
            // <body> today - if either were ever nested under its own wrapper,
            // an inert ancestor of toModal would survive the transition and
            // leave the "active" modal non-interactive.
            function replaceModal(fromId, toId) {
                const fromModal = document.getElementById(fromId);
                const toModal = document.getElementById(toId);
                if (!fromModal || !toModal || activeModal !== fromModal) return;

                if (window.CustomSelect) window.CustomSelect.closeAll();

                fromModal.classList.add('hidden');
                fromModal.classList.remove('flex');

                restoreBackgroundInert();

                toModal.classList.remove('hidden');
                toModal.classList.add('flex');
                activeModal = toModal;

                makeBackgroundInert(toModal);

                const focusable = getFocusableElements(toModal);
                const target = focusable[0] || toModal;
                if (target && typeof target.focus === 'function') {
                    target.focus();
                }
            }

            return { open: openModal, close: closeModal, replace: replaceModal };
        })();

        // Realtime, client-side trail search. Every trail for the current Sort By
        // order is already in the DOM (the controller no longer filters), so this
        // only ever hides/shows what's already rendered - it never reorders cards
        // and never touches the server.
        (function initTrailSearch() {
            const searchInput = document.getElementById('searchInput');
            const cardGrid = document.getElementById('trailCardGrid');
            const announcerEl = document.getElementById('resultCountAnnouncer');
            const noMatchEl = document.getElementById('noSearchResults');
            const clearSearchBtn = document.getElementById('clearSearchBtn');
            if (!searchInput || !cardGrid) return;

            const totalTrailCount = @totalTrailCount;
            let debounceTimer = null;

            function getTrailCards() {
                return Array.from(cardGrid.querySelectorAll('.trail-card'));
            }

            function buildResultText(term, visibleCount) {
                if (term) {
                    return 'Showing ' + visibleCount + ' of ' + totalTrailCount +
                        ' trail' + (totalTrailCount === 1 ? '' : 's') + ' for “' + term + '”';
                }
                return 'Showing ' + totalTrailCount + ' trail' + (totalTrailCount === 1 ? '' : 's');
            }

            // Runs on every keystroke - hides/shows cards and updates the visible
            // count text immediately. The URL and the screen-reader announcement are
            // handled separately (debounced) by the caller so this stays cheap.
            function applySearchFilter() {
                const rawTerm = searchInput.value;
                const term = rawTerm.trim();
                const normalizedTerm = term.toLowerCase();
                const cards = getTrailCards();
                let visibleCount = 0;

                cards.forEach(function (card) {
                    const haystack = (card.getAttribute('data-search') || '').toLowerCase();
                    const matches = !normalizedTerm || haystack.includes(normalizedTerm);
                    card.hidden = !matches;
                    if (matches) visibleCount++;
                });

                const text = buildResultText(term, visibleCount);
                if (noMatchEl) noMatchEl.hidden = !(cards.length > 0 && visibleCount === 0);

                return { term: term, text: text };
            }

            function updateUrlSearchParam(term) {
                const url = new URL(window.location.href);
                if (term) {
                    url.searchParams.set('searchString', term);
                } else {
                    url.searchParams.delete('searchString');
                }
                history.replaceState(history.state, '', url.pathname + url.search + url.hash);
            }

            function handleSearchInput() {
                const result = applySearchFilter();
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    updateUrlSearchParam(result.term);
                    if (announcerEl) announcerEl.textContent = result.text;
                }, 400);
            }

            function syncSearchFromUrl() {
                const url = new URL(window.location.href);
                searchInput.value = url.searchParams.get('searchString') || '';
                const result = applySearchFilter();
                if (announcerEl) announcerEl.textContent = result.text;
            }

            searchInput.addEventListener('input', handleSearchInput);
            window.addEventListener('popstate', syncSearchFromUrl);

            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', function () {
                    searchInput.value = '';
                    clearTimeout(debounceTimer);
                    const result = applySearchFilter();
                    updateUrlSearchParam('');
                    if (announcerEl) announcerEl.textContent = result.text;
                    searchInput.focus();
                });
            }

            // Restores the filtered view immediately on load (including after a Sort
            // By navigation that carried the search text along) and sets the initial
            // announcer text without waiting for the debounce.
            const initialResult = applySearchFilter();
            if (announcerEl) announcerEl.textContent = initialResult.text;
        })();

        let currentEditTrailId = null;
        let currentEditTerrainType = null;
        let currentTrailImage = null;
        let currentTrailTerrain = null;

        // Card thumbnails render once and never reopen, so replacing the failed <img>
        // outright is fine. Reused across every broken/missing "no photo" case in this
        // page - no external placeholder service, per the project's asset policy.
        function handleTrailImageError(img) {
            img.onerror = null;
            // Same markup as the server-rendered "no ThumbnailUrl" fallback below,
            // so a broken image URL and a missing one look identical - no separate
            // background/icon treatment for what is the same user-visible state.
            const fallback = document.createElement('div');
            fallback.className = 'w-full h-full flex items-center justify-center';
            const icon = document.createElement('i');
            icon.className = 'fa-solid fa-image text-4xl text-slate-700';
            icon.setAttribute('aria-hidden', 'true');
            fallback.appendChild(icon);
            img.replaceWith(fallback);
        }

        // Same idea for the small photo-grid thumbnails inside the modals - those grids
        // are rebuilt from scratch every time a modal opens, so replacing the <img> is
        // safe there too.
        function handleThumbGridImageError(img) {
            img.onerror = null;
            const fallback = document.createElement('div');
            fallback.className = 'w-full h-full flex items-center justify-center bg-gray-900';
            fallback.setAttribute('role', 'img');
            fallback.setAttribute('aria-label', 'Photo unavailable');
            fallback.innerHTML = '<i class="fa-solid fa-image text-lg text-gray-600" aria-hidden="true"></i>';
            img.replaceWith(fallback);
        }

        // The view modal's hero image IS reused across opens (the modal markup stays in
        // the DOM), so it toggles a sibling placeholder rather than replacing the <img>
        // node - replacing it would leave #viewImage missing on the next open.
        function setViewHeroImage(url, altText) {
            const img = document.getElementById('viewImage');
            const placeholder = document.getElementById('viewImagePlaceholder');
            img.onerror = null;

            if (url) {
                img.src = url;
                img.alt = altText;
                img.classList.remove('hidden');
                placeholder.classList.add('hidden');
                placeholder.classList.remove('flex');
                img.onerror = function () {
                    img.classList.add('hidden');
                    placeholder.classList.remove('hidden');
                    placeholder.classList.add('flex');
                };
            } else {
                img.removeAttribute('src');
                img.alt = '';
                img.classList.add('hidden');
                placeholder.classList.remove('hidden');
                placeholder.classList.add('flex');
            }
        }

        // Mirrors DifficultyCalculator.TrailClassLabel() in C# - this modal is
        // populated from data-* attributes without a server round trip, so it
        // can't call that method directly. Keep these two mappings in sync.
        const TRAIL_CLASS_LABELS = { '1': 'Walking', '2': 'Hiking', '3': 'Scrambling', '4': 'Simple Climbing' };
        function trailClassLabel(value) {
            const label = TRAIL_CLASS_LABELS[value];
            return label ? (value + ' — ' + label) : 'N/A';
        }

        // Single authoritative source for the Technical Trail Class
        // description panel - shared by Add and Edit so neither drifts into a
        // second, contradictory copy of the wording. The native <option> text
        // is now the short "N — Label" form (see addTrailClass/editTrailClass
        // markup); every technical detail the four long option strings used
        // to carry inline still exists here, just moved into the panel shown
        // below the dropdown instead of the menu itself.
        const TRAIL_CLASS_DESCRIPTIONS = {
            '1': 'Walking — flat, clear, often paved or packed earth. No fall risk, no need to use your hands for balance.',
            '2': 'Hiking — rugged or rocky trails with some ascent. You may hold onto roots or branches for balance, but it stays safe.',
            '3': 'Scrambling — steep sections where you genuinely need hands and feet to climb over boulders or roots. Rope not strictly required, but real care is needed. e.g. Mt. Maculot Rockies, Mt. Pamitinan.',
            '4': 'Simple Climbing — steeper and more dangerous, with exposure such as cliffs or drop-offs. Ropes are normally fixed for hiker safety, since a fall could be fatal. e.g. Mt. Guiting-Guiting, Mt. Mantalingajan.'
        };
        const TRAIL_CLASS_DESCRIPTION_PLACEHOLDER = 'Select a class above to see its full description.';

        function updateTrailClassDescription(panelId, value) {
            const panel = document.getElementById(panelId);
            if (!panel) return;
            panel.textContent = TRAIL_CLASS_DESCRIPTIONS[value] || TRAIL_CLASS_DESCRIPTION_PLACEHOLDER;
        }

        document.getElementById('addTrailClass')?.addEventListener('change', function () {
            updateTrailClassDescription('addTrailClassDescription', this.value);
        });
        document.getElementById('editTrailClass')?.addEventListener('change', function () {
            updateTrailClassDescription('editTrailClassDescription', this.value);
        });

        // Same parsing convention used everywhere else on this page (the card,
        // Participant/Trails.cshtml): split on comma, trim, drop empty pieces.
        // Each chip is built as a real element with textContent - never innerHTML -
        // since terrain text is organizer-entered and must never be parsed as markup.
        function renderTerrainChips(container, terrainString) {
            container.innerHTML = '';
            (terrainString || '').split(',')
                .map(function (t) { return t.trim(); })
                .filter(function (t) { return t.length > 0; })
                .forEach(function (value) {
                    const chip = document.createElement('span');
                    chip.className = 'px-2.5 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-gray-300';
                    chip.textContent = value;
                    container.appendChild(chip);
                });
        }

        // Builds one photo-grid thumbnail safely. The photo URL is assigned as a
        // real property (img.src = url), never concatenated into an HTML string -
        // the filename portion of a stored photo URL is organizer-controlled (it
        // comes from the uploaded file's own name), so building markup by string
        // interpolation around it would let a crafted filename break out of the
        // src attribute.
        function buildPhotoThumb(url, deletePhotoId) {
            const wrapper = document.createElement('div');
            wrapper.className = deletePhotoId
                ? 'relative aspect-square rounded-lg overflow-hidden border border-gray-600 group'
                : 'aspect-square rounded-lg overflow-hidden border border-gray-700';

            const img = document.createElement('img');
            img.src = url;
            img.alt = '';
            img.className = 'w-full h-full object-cover';
            img.addEventListener('error', function () { handleThumbGridImageError(img); });
            wrapper.appendChild(img);

            if (deletePhotoId) {
                const overlay = document.createElement('div');
                overlay.className = 'absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity';
                wrapper.appendChild(overlay);

                const deleteBtn = document.createElement('button');
                deleteBtn.type = 'button';
                deleteBtn.className = 'delete-photo-btn absolute top-1 right-1 w-6 h-6 bg-red-600 hover:bg-red-700 text-white rounded-full flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity z-20 focus:outline-none focus:ring-2 focus:ring-white';
                deleteBtn.setAttribute('data-photo-id', String(deletePhotoId));
                deleteBtn.setAttribute('aria-label', 'Remove photo');
                deleteBtn.innerHTML = '<i class="fa-solid fa-xmark" aria-hidden="true"></i>';
                wrapper.appendChild(deleteBtn);
            }

            return wrapper;
        }

        function openViewModal(button) {
            currentEditTrailId = button.getAttribute('data-id');
            currentEditTerrainType = button.getAttribute('data-terrain-type');

            const name = button.getAttribute('data-name');
            const location = button.getAttribute('data-location');
            const distance = button.getAttribute('data-distance');
            const elevation = button.getAttribute('data-elevation');
            const terrain = button.getAttribute('data-terrain');
            const description = button.getAttribute('data-description');
            const image = button.getAttribute('data-image');
            const dateAdded = button.getAttribute('data-date-added') || 'N/A';

            document.getElementById('viewName').textContent = name;
            document.getElementById('viewLocation').textContent = location;
            document.getElementById('viewDistance').textContent = distance;
            document.getElementById('viewElevation').textContent = elevation;
            document.getElementById('viewTrailClass').textContent = trailClassLabel(currentEditTerrainType);
            document.getElementById('viewDescriptionText').textContent = description || 'No description provided.';
            document.getElementById('viewDateAdded').textContent = dateAdded;
            renderTerrainChips(document.getElementById('viewTerrainChips'), terrain);

            currentTrailImage = image;
            currentTrailTerrain = terrain;
            setViewHeroImage(image, name ? name + ' trail photo' : '');

            const additionalContainer = document.getElementById('viewAdditionalPhotos');
            additionalContainer.innerHTML = '<div class="col-span-full text-center text-gray-500 text-sm py-4">Loading photos...</div>';

            TrailModal.open('viewTrailModal');

            fetch(`/Trail/GetTrailPhotos?trailId=${currentEditTrailId}`)
                .then(response => response.json())
                .then(data => {
                    additionalContainer.innerHTML = '';

                    if (data && data.length > 0) {
                        data.forEach(photo => {
                            additionalContainer.appendChild(buildPhotoThumb(photo.url, null));
                        });
                    } else {
                        additionalContainer.innerHTML = '<div class="col-span-full text-center text-gray-500 text-sm py-4">No additional photos</div>';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    additionalContainer.innerHTML = '<div class="col-span-full text-center text-red-500 text-sm py-4">Error loading photos</div>';
                });
        }

        function closeViewModal() {
            TrailModal.close('viewTrailModal');
        }

        // Transitions Trail Details straight into Edit via TrailModal.replace -
        // no setTimeout: there's no close/open animation to wait out, and View is
        // still fully populated at this point, so every value below is read
        // synchronously before anything is torn down.
        function closeViewModalAndOpenEdit() {
            if (!currentEditTrailId) return;

            const fakeButton = document.createElement('button');
            fakeButton.setAttribute('data-id', currentEditTrailId);
            fakeButton.setAttribute('data-name', document.getElementById('viewName').textContent);
            fakeButton.setAttribute('data-location', document.getElementById('viewLocation').textContent);
            fakeButton.setAttribute('data-distance', document.getElementById('viewDistance').textContent);
            fakeButton.setAttribute('data-elevation', document.getElementById('viewElevation').textContent);
            fakeButton.setAttribute('data-terrain', currentTrailTerrain || '');
            fakeButton.setAttribute('data-terrain-type', currentEditTerrainType);
            fakeButton.setAttribute('data-description', document.getElementById('viewDescriptionText').textContent);
            fakeButton.setAttribute('data-image', currentTrailImage || '');

            openEditModal(fakeButton, 'viewTrailModal');
        }

        function handleAddThumbnailPreview(input) {
            const box = document.getElementById('thumbnailBox');
            const previewContainer = document.getElementById('thumbnailPreviewContainer');
            const previewImage = document.getElementById('thumbnailPreviewImage');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    box.classList.add('hidden');
                    previewContainer.classList.remove('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removeAddThumbnail() {
            document.getElementById('thumbnailInput').value = '';
            document.getElementById('thumbnailPreviewContainer').classList.add('hidden');
            document.getElementById('thumbnailPreviewImage').src = '';
            document.getElementById('thumbnailBox').classList.remove('hidden');
        }

        let additionalFilesArray = [];
        function handleAdditionalPhotos(input) {
            if (!input.files || input.files.length === 0) return;
            for (let i = 0; i < input.files.length; i++) {
                additionalFilesArray.push(input.files[i]);
            }
            updateAdditionalUIAndInput();
        }

        function removeAdditionalPhoto(index) {
            additionalFilesArray.splice(index, 1);
            updateAdditionalUIAndInput();
        }

        function updateAdditionalUIAndInput() {
            const grid = document.getElementById('additionalPhotosGrid');
            const input = document.getElementById('additionalInput');
            grid.innerHTML = '';

            const dataTransfer = new DataTransfer();
            additionalFilesArray.forEach((file, index) => {
                dataTransfer.items.add(file);
                const reader = new FileReader();
                reader.onload = function(e) {
                    const div = document.createElement('div');
                    div.className = 'relative aspect-square rounded-lg overflow-hidden border border-gray-600 group';
                    div.innerHTML = `
                        <img src="${e.target.result}" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <button type="button" onclick="removeAdditionalPhoto(${index})" aria-label="Remove photo ${index + 1}" class="absolute top-2 right-2 w-8 h-8 bg-gray-900/80 hover:bg-gray-700 text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity shadow-lg z-20 focus:outline-none focus:ring-2 focus:ring-accent">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    `;
                    grid.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
            input.files = dataTransfer.files;
        }

        // Unchecks every checkbox in a terrain chip group and removes any chip
        // injected for a legacy value on a previous Edit open - shared by Add's
        // reset-on-close and Edit's populate/reset, so both stay in sync.
        function resetTerrainChips(idPrefix) {
            const container = document.getElementById(idPrefix + 'TerrainChips');
            if (!container) return;
            container.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
                cb.checked = false;
            });
            container.querySelectorAll('[data-injected-terrain="true"]').forEach(function (chip) {
                chip.remove();
            });
        }

        function openAddTrailModal() {
            TrailModal.open('addTrailModal');
        }

        (function openRequestedAddTrailModal() {
            const url = new URL(window.location.href);
            if (url.searchParams.get('openModal') !== 'add') return;

            url.searchParams.delete('openModal');
            history.replaceState(history.state, '', url.pathname + url.search + url.hash);
            openAddTrailModal();
        })();

        function closeAddTrailModal() {
            TrailModal.close('addTrailModal');
            document.getElementById('addTrailForm').reset();
            resetTerrainChips('add');
            resetTerrainValidation('add');
            resetSubmitButton('addSubmitBtn', 'addSubmitBtnLabel', 'Save Trail');
            // form.reset() fires a native 'reset' event, which custom-select.js
            // listens for on its own to resync the trigger label - only the
            // Trail-Class-specific description panel needs resetting here.
            updateTrailClassDescription('addTrailClassDescription', '');
            removeAddThumbnail();
            additionalFilesArray = [];
            updateAdditionalUIAndInput();
        }

        // Checks every chip whose value matches a value from the trail's stored
        // Terrain string, and injects an extra pre-checked chip for any stored
        // value that isn't one of the checkbox options - mirroring the same
        // preservation the old single-select injected an <option> for, so opening
        // Edit and saving again (without touching Terrain) doesn't silently drop
        // a legacy value. Matching is case-insensitive but the injected chip's
        // label and submitted value keep the original stored casing.
        function populateTerrainChips(idPrefix, terrainString) {
            resetTerrainChips(idPrefix);
            const container = document.getElementById(idPrefix + 'TerrainChips');
            if (!container) return;

            const values = (terrainString || '').split(',')
                .map(function (t) { return t.trim(); })
                .filter(function (t) { return t.length > 0; });
            const checkboxes = Array.from(container.querySelectorAll('input[type="checkbox"]'));

            values.forEach(function (value) {
                const match = checkboxes.find(function (cb) {
                    return cb.value.toLowerCase() === value.toLowerCase();
                });
                if (match) {
                    match.checked = true;
                    return;
                }

                const inputId = idPrefix + 'Terrain-legacy-' + Math.random().toString(36).slice(2);
                const label = document.createElement('label');
                label.setAttribute('for', inputId);
                label.setAttribute('data-injected-terrain', 'true');
                label.title = value + ' (not in the standard list - existing stored value)';
                label.className = 'group relative inline-flex items-center gap-1.5 cursor-pointer select-none px-3 py-1.5 rounded-full text-xs font-medium bg-surface-card border border-gray-700 text-gray-300 has-checked:bg-accent/15 has-checked:border-accent has-checked:text-white hover:border-gray-500 transition-colors focus-within:ring-2 focus-within:ring-accent';

                const input = document.createElement('input');
                input.type = 'checkbox';
                input.id = inputId;
                input.name = 'TerrainValues';
                input.value = value;
                input.checked = true;
                input.className = 'sr-only';

                const icon = document.createElement('i');
                icon.className = 'fa-solid fa-check text-[10px] hidden group-has-checked:inline-block';
                icon.setAttribute('aria-hidden', 'true');

                const text = document.createElement('span');
                text.textContent = value;

                label.appendChild(input);
                label.appendChild(icon);
                label.appendChild(text);
                container.appendChild(label);
            });
        }

        // replaceModalId is set when this is a Trail Details -> Edit transition
        // (see closeViewModalAndOpenEdit) so TrailModal.replace can be used
        // instead of open; omitted when Edit is opened directly from a card.
        async function openEditModal(button, replaceModalId) {
            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            const location = button.getAttribute('data-location');
            const distance = button.getAttribute('data-distance');
            const elevation = button.getAttribute('data-elevation');
            const terrain = button.getAttribute('data-terrain');
            const terrainType = button.getAttribute('data-terrain-type');
            const description = button.getAttribute('data-description');
            const image = button.getAttribute('data-image');

            document.getElementById('editTrailId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editLocation').value = location;
            document.getElementById('editDistance').value = distance;
            document.getElementById('editElevation').value = elevation;

            // Clear any leftover invalid state from a previous Edit session
            // before applying this trail's actual saved selections.
            resetTerrainValidation('edit');
            resetSubmitButton('editSubmitBtn', 'editSubmitBtnLabel', 'Save Changes');
            populateTerrainChips('edit', terrain);

            const editTrailClassSelect = document.getElementById('editTrailClass');
            editTrailClassSelect.value = terrainType;
            // A raw .value assignment fires no change event, so the custom
            // trigger and the description panel are resynced explicitly.
            CustomSelect.refresh(editTrailClassSelect);
            updateTrailClassDescription('editTrailClassDescription', terrainType);
            document.getElementById('editDescription').value = description;

            const box = document.getElementById('editThumbnailBox');
            const previewContainer = document.getElementById('editThumbnailPreviewContainer');
            const previewImage = document.getElementById('editThumbnailPreviewImage');

            if (image && image !== '') {
                previewImage.src = image;
                box.classList.add('hidden');
                previewContainer.classList.remove('hidden');
            } else {
                removeEditThumbnail();
            }

            editAdditionalFilesArray = [];
            updateEditAdditionalUIAndInput();

            const existingGrid = document.getElementById('existingPhotosGrid');
            existingGrid.innerHTML = '<div class="col-span-full text-center text-gray-500 text-sm py-4">Loading existing photos...</div>';

            if (replaceModalId) {
                TrailModal.replace(replaceModalId, 'editTrailModal');
            } else {
                TrailModal.open('editTrailModal');
            }

            try {
                const response = await fetch(`/Trail/GetTrailPhotos?trailId=${id}`);
                const photos = await response.json();

                existingGrid.innerHTML = '';

                if (photos && photos.length > 0) {
                    photos.forEach(function (photo) {
                        existingGrid.appendChild(buildPhotoThumb(photo.url, photo.id));
                    });
                } else {
                    existingGrid.innerHTML = '<div class="col-span-full text-center text-gray-500 text-sm py-4">No additional photos yet</div>';
                }
            } catch (error) {
                console.error('Error loading existing photos:', error);
                existingGrid.innerHTML = '<div class="col-span-full text-center text-red-500 text-sm py-4">Error loading photos</div>';
            }
        }

        async function deleteExistingPhoto(buttonElement, event) {
            if (event) event.preventDefault();
            if (event) event.stopPropagation();
            
            const photoId = parseInt(buttonElement.getAttribute('data-photo-id'));
            const photoDiv = buttonElement.closest('.group');
            
            buttonElement.disabled = true;
            photoDiv.style.opacity = '0.5';
            
            try {
                const response = await postJson('/Trail/DeleteTrailPhoto', { photoId: photoId });
                
                const result = await response.json();
                
                if (result.success) {
                    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    const removeDelay = reduceMotion ? 0 : 300;
                    if (!reduceMotion) {
                        photoDiv.style.animation = 'fadeOut 0.3s ease-out forwards';
                    }
                    setTimeout(() => {
                        photoDiv.remove();
                        const existingGrid = document.getElementById('existingPhotosGrid');
                        if (existingGrid && existingGrid.children.length === 0) {
                            existingGrid.innerHTML = '<div class="col-span-full text-center text-gray-500 text-sm py-4">No additional photos yet</div>';
                        }
                        showToast('Photo deleted successfully', 'success');
                    }, removeDelay);
                } else {
                    buttonElement.disabled = false;
                    photoDiv.style.opacity = '1';
                    showToast('Error deleting photo: ' + (result.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error deleting photo:', error);
                buttonElement.disabled = false;
                photoDiv.style.opacity = '1';
                showToast('Error deleting photo', 'error');
            }
        }

        async function deleteTrail(id, name) {
            if (!confirm(`Are you sure you want to delete "${name}"? This action cannot be undone.`)) {
                return;
            }
            
            try {
                const response = await postJson('/Trail/DeleteTrail', { id: id });
                
                const result = await response.json();
                
                if (result.success) {
                    showToast('Trail deleted successfully', 'success');
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    showToast('Error deleting trail: ' + result.message, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Error deleting trail', 'error');
            }
        }

        // showToast(message, type) is now the canonical implementation in
        // wwwroot/js/toast.js, loaded globally from _Layout.cshtml.

        document.addEventListener('click', function(e) {
            const deletePhotoBtn = e.target.closest('.delete-photo-btn');
            if (deletePhotoBtn) {
                e.preventDefault();
                e.stopPropagation();
                deleteExistingPhoto(deletePhotoBtn, e);
                return;
            }

            // Trail ID and name travel as data-* attributes (Razor-encoded on render,
            // read back as plain text via getAttribute) rather than as literal
            // arguments in an inline onclick - a name containing an apostrophe used to
            // break the generated JavaScript outright.
            const deleteTrailBtn = e.target.closest('.delete-trail-btn');
            if (deleteTrailBtn) {
                const trailId = Number(deleteTrailBtn.getAttribute('data-trail-id'));
                const trailName = deleteTrailBtn.getAttribute('data-trail-name') || '';
                deleteTrail(trailId, trailName);
            }
        });

        function closeEditTrailModal() {
            TrailModal.close('editTrailModal');
            document.getElementById('editTrailForm').reset();
            resetTerrainChips('edit');
            resetTerrainValidation('edit');
            resetSubmitButton('editSubmitBtn', 'editSubmitBtnLabel', 'Save Changes');
            updateTrailClassDescription('editTrailClassDescription', '');
            removeEditThumbnail();
            editAdditionalFilesArray = [];
            updateEditAdditionalUIAndInput();
        }

        function handleEditThumbnailPreview(input) {
            const box = document.getElementById('editThumbnailBox');
            const previewContainer = document.getElementById('editThumbnailPreviewContainer');
            const previewImage = document.getElementById('editThumbnailPreviewImage');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    box.classList.add('hidden');
                    previewContainer.classList.remove('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removeEditThumbnail() {
            document.getElementById('editThumbnailInput').value = '';
            document.getElementById('editThumbnailPreviewContainer').classList.add('hidden');
            document.getElementById('editThumbnailPreviewImage').src = '';
            document.getElementById('editThumbnailBox').classList.remove('hidden');
        }

        let editAdditionalFilesArray = [];
        function handleEditAdditionalPhotos(input) {
            if (!input.files || input.files.length === 0) return;
            for (let i = 0; i < input.files.length; i++) {
                editAdditionalFilesArray.push(input.files[i]);
            }
            updateEditAdditionalUIAndInput();
        }

        function removeEditAdditionalPhoto(index) {
            editAdditionalFilesArray.splice(index, 1);
            updateEditAdditionalUIAndInput();
        }

        function updateEditAdditionalUIAndInput() {
            const grid = document.getElementById('editAdditionalPhotosGrid');
            const input = document.getElementById('editAdditionalInput');
            grid.innerHTML = '';

            const dataTransfer = new DataTransfer();
            editAdditionalFilesArray.forEach((file, index) => {
                dataTransfer.items.add(file);
                const reader = new FileReader();
                reader.onload = function(e) {
                    const div = document.createElement('div');
                    div.className = 'relative aspect-square rounded-lg overflow-hidden border border-gray-600 group';
                    div.innerHTML = `
                        <img src="${e.target.result}" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <button type="button" onclick="removeEditAdditionalPhoto(${index})" aria-label="Remove photo ${index + 1}" class="absolute top-2 right-2 w-8 h-8 bg-gray-900/80 hover:bg-gray-700 text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity shadow-lg z-20 focus:outline-none focus:ring-2 focus:ring-accent">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    `;
                    grid.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
            input.files = dataTransfer.files;
        }

        // Escape, focus trapping, and focus restoration are handled once by
        // TrailModal for whichever of the three modals is currently active - see
        // its handleKeydown - so there's no separate blanket listener here.

        // At least one Terrain chip must be checked - HTML's native `required`
        // can't express that for a checkbox group. Reported as a visible inline
        // error next to the group (role="alert", so it's announced the moment it
        // appears) rather than a native validation bubble anchored to an sr-only
        // checkbox - a bubble like that would point at an invisible element and
        // isn't a reliable pattern across browsers/assistive tech. aria-invalid
        // on the group and aria-describedby (set once, in _TerrainChips.cshtml)
        // linking it to the error keep the two programmatically associated even
        // while the error itself is hidden.
        function setTerrainGroupInvalid(idPrefix, invalid) {
            const group = document.getElementById(idPrefix + 'TerrainChips');
            const error = document.getElementById(idPrefix + 'TerrainError');
            if (group) group.setAttribute('aria-invalid', invalid ? 'true' : 'false');
            if (error) error.hidden = !invalid;
        }

        function resetTerrainValidation(idPrefix) {
            setTerrainGroupInvalid(idPrefix, false);
        }

        function validateTerrainSelection(idPrefix, form, focusOnInvalid) {
            const checkboxes = Array.from(form.querySelectorAll('input[name="TerrainValues"]'));
            const anyChecked = checkboxes.some(function (cb) { return cb.checked; });
            setTerrainGroupInvalid(idPrefix, !anyChecked);
            if (!anyChecked && focusOnInvalid && checkboxes[0]) {
                checkboxes[0].focus();
            }
            return anyChecked;
        }

        // Clears the error immediately once any chip (including one injected for
        // a legacy value) is checked - delegated on the group container so it
        // covers chips added dynamically by populateTerrainChips too.
        function wireTerrainGroup(idPrefix) {
            const container = document.getElementById(idPrefix + 'TerrainChips');
            if (!container) return;
            container.addEventListener('change', function (event) {
                if (!event.target || event.target.name !== 'TerrainValues') return;
                const anyChecked = Array.from(container.querySelectorAll('input[name="TerrainValues"]'))
                    .some(function (cb) { return cb.checked; });
                if (anyChecked) {
                    setTerrainGroupInvalid(idPrefix, false);
                }
            });
        }

        wireTerrainGroup('add');
        wireTerrainGroup('edit');

        function resetSubmitButton(submitBtnId, submitLabelId, defaultText) {
            const btn = document.getElementById(submitBtnId);
            const label = document.getElementById(submitLabelId);
            if (btn) btn.disabled = false;
            if (label) label.textContent = defaultText;
        }

        // Guards a Trail form against duplicate submissions: disables the submit
        // button and swaps its label only once Terrain validation has actually
        // passed and submission will proceed - never on a failed validation, so
        // the button stays usable for a retry. This is a full-page POST (not
        // fetch), so the button doesn't need to be re-enabled on success; the
        // page navigates away either way.
        function guardTrailFormSubmit(idPrefix, formId, submitBtnId, submitLabelId, savingText) {
            const form = document.getElementById(formId);
            const submitBtn = document.getElementById(submitBtnId);
            const submitLabel = document.getElementById(submitLabelId);
            if (!form || !submitBtn) return;

            form.addEventListener('submit', function (event) {
                if (!validateTerrainSelection(idPrefix, form, true)) {
                    event.preventDefault();
                    return;
                }
                submitBtn.disabled = true;
                if (submitLabel) submitLabel.textContent = savingText;
            });
        }

        guardTrailFormSubmit('add', 'addTrailForm', 'addSubmitBtn', 'addSubmitBtnLabel', 'Saving...');
        guardTrailFormSubmit('edit', 'editTrailForm', 'editSubmitBtn', 'editSubmitBtnLabel', 'Saving...');
    </script>
}
