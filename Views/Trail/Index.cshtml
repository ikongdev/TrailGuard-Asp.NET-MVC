@model IEnumerable<TrailGuard.Models.Trail>
@{
    ViewData["Title"] = "Trail Management";
    var currentFilter = ViewData["CurrentFilter"] as string ?? string.Empty;
    var currentSort = ViewData["CurrentSort"] as string ?? TrailGuard.Controllers.TrailController.DefaultSortOrder;
    var totalTrailCount = Model.Count();
}

@* Success/Error feedback for this page now goes through the canonical global
   toast host in _Layout.cshtml (window.showToast, fed by TempData via
   #tg-toast-tempdata) instead of a page-local fixed banner - see the
   notification centralization pass. *@

@section PageHero {
    <div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
        <header class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
            <div>
                <h1 class="text-3xl font-bold text-white">Trail Management</h1>
                <p class="text-gray-400 mt-1 text-sm">Manage trail listings, review trail details, and keep your hiking catalog up to date.</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <span class="bg-white/5 border border-white/10 px-4 py-2 rounded-full text-sm text-gray-300">
                    <i class="fa-solid fa-mountain text-accent mr-2" aria-hidden="true"></i>Total Trails: <strong class="text-white">@totalTrailCount</strong>
                </span>

                <button type="button" onclick="openAddTrailModal()" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base transition duration-200 ease-out">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>Add Trail
                </button>
            </div>
        </header>

        <form method="get" asp-action="Index" id="filterForm" onsubmit="return false" class="mb-2">
            <div class="flex flex-col lg:flex-row gap-3 mb-8 bg-white/5 backdrop-blur-xl p-5 rounded-xl border border-white/10">

                <div class="relative grow">
                    <label for="searchInput" class="sr-only">Search trails by name or location</label>
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
                    <input type="search" name="searchString" id="searchInput" value="@currentFilter" placeholder="Search trails by name or location..." autocomplete="off"
                        class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-11 pr-4 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none transition-colors placeholder-gray-500">
                </div>

                <div class="relative shrink-0 w-full lg:w-64">
                    <label for="sortOrder" class="sr-only">Sort trails by</label>
                    <!-- data-custom-select-portal: the filter bar
                         (bg-white/5 backdrop-blur-xl) uses a CSS backdrop
                         blur, which per the containing-block spec becomes
                         the containing block for the enhanced menu's
                         position:fixed coordinates - portal mode appends the
                         menu to document.body instead, the same fix already
                         used for every filter select on Accounts/Records/
                         Registrations and the Add Account Role select. The
                         trigger-class override reproduces this select's own
                         existing visual recipe (rounded-full, bg-black/20,
                         accent focus) so enhancement is a no-op visually.
                         onchange is untouched - custom-select.js dispatches a
                         real native 'change' event on the underlying select
                         when the user picks an option, which this existing
                         inline handler still receives exactly as before. -->
                    <select id="sortOrder" name="sortOrder" data-custom-select data-custom-select-portal
                            data-cs-decorative-chevron="sortOrderChevron"
                            data-cs-trigger-class="flex w-full items-center justify-between gap-2 px-5 py-3 rounded-full bg-black/20 border border-white/10 text-white text-sm text-left focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors cursor-pointer hover:bg-white/10"
                            onchange="document.getElementById('filterForm').submit()"
                            class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors">
                        <option value="newest" selected="@(currentSort == "newest" ? "selected" : null)" class="bg-surface-card text-white">Sort by: Newest</option>
                        <option value="oldest" selected="@(currentSort == "oldest" ? "selected" : null)" class="bg-surface-card text-white">Sort by: Oldest</option>
                        <option value="name_asc" selected="@(currentSort == "name_asc" ? "selected" : null)" class="bg-surface-card text-white">Name (A-Z)</option>
                        <option value="name_desc" selected="@(currentSort == "name_desc" ? "selected" : null)" class="bg-surface-card text-white">Name (Z-A)</option>
                        <option value="distance_asc" selected="@(currentSort == "distance_asc" ? "selected" : null)" class="bg-surface-card text-white">Distance (Low to High)</option>
                        <option value="distance_desc" selected="@(currentSort == "distance_desc" ? "selected" : null)" class="bg-surface-card text-white">Distance (High to Low)</option>
                        <option value="elevation_asc" selected="@(currentSort == "elevation_asc" ? "selected" : null)" class="bg-surface-card text-white">Elevation (Low to High)</option>
                        <option value="elevation_desc" selected="@(currentSort == "elevation_desc" ? "selected" : null)" class="bg-surface-card text-white">Elevation (High to Low)</option>
                    </select>
                    <div id="sortOrderChevron" class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                        <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
        </form>

        <p id="resultCountAnnouncer" class="sr-only" role="status" aria-live="polite"></p>

        <div id="trailCardGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (!Model.Any())
            {
                <div class="col-span-full text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl">
                    <i class="fa-solid fa-mountain text-4xl text-slate-600 mb-4" aria-hidden="true"></i>
                    <h3 class="text-xl font-bold text-gray-300">No trails yet</h3>
                    <p class="text-gray-500 mt-2">Add your first trail to start building the catalog.</p>
                    <button type="button" onclick="openAddTrailModal()" class="inline-block mt-4 text-accent text-sm font-medium hover:brightness-125 focus:outline-none focus:ring-2 focus:ring-accent rounded">
                        Add Trail <i class="fa-solid fa-plus ml-1" aria-hidden="true"></i>
                    </button>
                </div>
            }
            else
            {
                @foreach (var trail in Model)
                {
                    <div class="trail-card group bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden hover:border-white/20 transition-colors flex flex-col"
                         data-search="@trail.Name @trail.Location">
                        <div class="relative h-48 overflow-hidden bg-black/30">
                            @if (!string.IsNullOrEmpty(trail.ThumbnailUrl))
                            {
                                <img src="@trail.ThumbnailUrl" alt="@trail.Name" class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transform-none motion-reduce:transition-none" onerror="handleTrailImageError(this)">
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <i class="fa-solid fa-image text-4xl text-slate-700" aria-hidden="true"></i>
                                </div>
                            }
                            <div class="absolute inset-0 bg-linear-to-t from-surface-card to-transparent opacity-90"></div>
                        </div>

                        <div class="p-6 flex flex-col grow relative z-10 -mt-10">
                            <h3 class="text-xl font-bold text-white mb-1">@trail.Name</h3>
                            <p class="text-gray-400 text-sm mb-5 flex items-center gap-1.5">
                                <i class="fa-solid fa-location-dot text-accent" aria-hidden="true"></i> @trail.Location
                            </p>

                            <div class="grid grid-cols-2 gap-4 mb-4">
                                <div>
                                    <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Distance</p>
                                    <p class="text-gray-200 text-sm font-medium flex items-center gap-2">
                                        <i class="fa-solid fa-route text-gray-400" aria-hidden="true"></i> @trail.DistanceKm km
                                    </p>
                                </div>
                                <div>
                                    <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-0.5">Elev. Gain</p>
                                    <p class="text-gray-200 text-sm font-medium flex items-center gap-2">
                                        <i class="fa-solid fa-arrow-trend-up text-gray-400" aria-hidden="true"></i> @trail.ElevationGainMeters m
                                    </p>
                                </div>
                            </div>

                            <div class="mb-6">
                                <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-1.5">Terrain</p>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var t in (trail.Terrain ?? "").Split(',').Select(x => x.Trim()).Where(x => x.Length > 0))
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-gray-300">@t</span>
                                    }
                                </div>
                            </div>

                            <div class="flex gap-2 mt-auto">
                                <button type="button" onclick="openViewModal(this)"
                                        data-id="@trail.Id"
                                        data-name="@trail.Name"
                                        data-location="@trail.Location"
                                        data-distance="@trail.DistanceKm"
                                        data-elevation="@trail.ElevationGainMeters"
                                        data-terrain="@trail.Terrain"
                                        data-terrain-type="@trail.TrailClass"
                                        data-description="@trail.Description"
                                        data-image="@(string.IsNullOrEmpty(trail.ThumbnailUrl) ? "" : trail.ThumbnailUrl)"
                                        data-date-added="@trail.DateAdded.ToString("MMM dd, yyyy")"
                                        aria-label="View details for @trail.Name"
                                        class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-gray-300 hover:text-white py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i> View
                                </button>
                                <button type="button" onclick="openEditModal(this)"
                                        data-id="@trail.Id"
                                        data-name="@trail.Name"
                                        data-location="@trail.Location"
                                        data-distance="@trail.DistanceKm"
                                        data-elevation="@trail.ElevationGainMeters"
                                        data-terrain="@trail.Terrain"
                                        data-terrain-type="@trail.TrailClass"
                                        data-description="@trail.Description"
                                        data-image="@(string.IsNullOrEmpty(trail.ThumbnailUrl) ? "" : trail.ThumbnailUrl)"
                                        aria-label="Edit @trail.Name"
                                        class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-gray-300 hover:text-white py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-pen" aria-hidden="true"></i> Edit
                                </button>
                                <button type="button"
                                        data-trail-id="@trail.Id"
                                        data-trail-name="@trail.Name"
                                        aria-label="Delete @trail.Name"
                                        class="delete-trail-btn bg-red-500/20 hover:bg-red-500 border border-red-500/30 hover:border-red-500 text-red-400 hover:text-white py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center w-12">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <div id="noSearchResults" hidden class="col-span-full text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl">
                    <i class="fa-solid fa-magnifying-glass text-4xl text-slate-600 mb-4" aria-hidden="true"></i>
                    <h3 class="text-xl font-bold text-gray-300">No trails found</h3>
                    <p class="text-gray-500 mt-2">No trails match your search. Try a different name or location.</p>
                    <button type="button" id="clearSearchBtn" class="inline-block mt-4 text-accent text-sm font-medium hover:brightness-125 focus:outline-none focus:ring-2 focus:ring-accent rounded">
                        Clear search <i class="fa-solid fa-arrow-right ml-1" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>
    </div>
}

@section Modals {
    <div id="viewTrailModal" class="fixed inset-0 z-60 hidden items-center justify-center p-4">
        <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-60" onclick="closeViewModal()" aria-hidden="true"></div>
        <div role="dialog" aria-modal="true" aria-labelledby="viewTrailModalTitle"
             class="relative bg-surface-card border border-white/10 rounded-xl shadow-2xl w-full max-w-4xl max-h-[calc(100vh-2rem)] overflow-hidden flex flex-col z-60">

            <div class="flex justify-between items-center px-5 py-3 border-b border-white/10 shrink-0">
                <h2 id="viewTrailModalTitle" class="text-base font-semibold text-white flex items-center gap-2">
                    <i class="fa-solid fa-mountain text-accent" aria-hidden="true"></i>
                    Trail Details
                </h2>
                <button type="button" onclick="closeViewModal()" aria-label="Close" class="text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded">
                    <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
                </button>
            </div>

            <div class="overflow-y-auto custom-scrollbar flex-1">
                <div class="relative h-40 sm:h-56 overflow-hidden bg-black/30">
                    <img id="viewImage" src="" alt="" class="w-full h-full object-cover">
                    <div id="viewImagePlaceholder" class="hidden w-full h-full items-center justify-center">
                        <i class="fa-solid fa-image text-4xl text-gray-600" aria-hidden="true"></i>
                    </div>
                    <div class="absolute inset-0 bg-linear-to-t from-surface-card via-surface-card/40 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-5">
                        <h3 id="viewName" class="text-2xl font-bold text-white"></h3>
                        <p class="text-gray-300 text-sm flex items-center gap-1.5 mt-1">
                            <i class="fa-solid fa-location-dot text-red-400" aria-hidden="true"></i>
                            <span id="viewLocation"></span>
                        </p>
                    </div>
                </div>

                <div class="p-5">
                    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm mb-4">
                        <span class="text-gray-300 flex items-center gap-2">
                            <i class="fa-solid fa-route text-gray-500" aria-hidden="true"></i>
                            <span id="viewDistance"></span> km
                        </span>
                        <span class="text-gray-300 flex items-center gap-2">
                            <i class="fa-solid fa-arrow-trend-up text-gray-500" aria-hidden="true"></i>
                            <span id="viewElevation"></span> m
                        </span>
                        <span class="text-gray-300 flex items-center gap-2">
                            <i class="fa-solid fa-hand text-gray-500" aria-hidden="true"></i>
                            Class <span id="viewTrailClass"></span>
                        </span>
                        <span class="text-gray-500 flex items-center gap-2 text-xs">
                            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                            Added <span id="viewDateAdded"></span>
                        </span>
                    </div>

                    <div class="mb-4">
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-1.5">Terrain</p>
                        <div id="viewTerrainChips" class="flex flex-wrap gap-1.5"></div>
                    </div>

                    <p id="viewDescriptionText" class="text-gray-400 text-sm leading-relaxed pb-5 border-b border-white/10"></p>

                    <div class="mt-5">
                        <p class="text-gray-500 text-[11px] uppercase tracking-wider mb-3">Additional Photos</p>
                        <div id="viewAdditionalPhotos" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3"></div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-white/10 shrink-0">
                <button type="button" onclick="closeViewModal()" class="px-5 py-2.5 rounded-full text-sm font-semibold text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
                    Close
                </button>
                <button type="button" onclick="closeViewModalAndOpenEdit()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base">
                    <i class="fa-solid fa-pen" aria-hidden="true"></i> Edit Trail
                </button>
            </div>
        </div>
    </div>

    <div id="addTrailModal" class="fixed inset-0 z-60 hidden items-center justify-center p-4">
        <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-60" onclick="closeAddTrailModal()" aria-hidden="true"></div>
        <div role="dialog" aria-modal="true" aria-labelledby="addTrailModalTitle"
             class="relative bg-surface-card border border-white/10 rounded-xl shadow-2xl w-full max-w-5xl max-h-[calc(100vh-2rem)] overflow-hidden flex flex-col z-60">

            <div class="flex items-start justify-between gap-4 px-6 py-4 border-b border-white/10 shrink-0">
                <div class="flex items-center gap-3 min-w-0">
                    <span class="w-9 h-9 rounded-full bg-linear-to-r from-orange-500 to-violet-500 flex items-center justify-center shrink-0" aria-hidden="true">
                        <i class="fa-solid fa-plus text-white text-sm"></i>
                    </span>
                    <div class="min-w-0">
                        <h2 id="addTrailModalTitle" class="text-lg font-bold text-white">Add Trail</h2>
                        <p class="text-xs text-gray-400">Create a new trail listing for hikers and organizers.</p>
                    </div>
                </div>
                <button type="button" onclick="closeAddTrailModal()" aria-label="Close" class="shrink-0 text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded">
                    <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
                </button>
            </div>

            <form id="addTrailForm" asp-controller="Trail" asp-action="AddTrail" method="post" enctype="multipart/form-data" class="flex flex-col flex-1 overflow-hidden">
                <div class="overflow-y-auto custom-scrollbar flex-1 p-6">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <div class="flex flex-col gap-5">
                            <div>
                                <label for="addName" class="block text-sm font-medium text-gray-300 mb-2">Trail Name <span class="text-red-400">*</span></label>
                                <input id="addName" name="Name" required class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., Mount Pulag" />
                            </div>

                            <div>
                                <label for="addLocation" class="block text-sm font-medium text-gray-300 mb-2">Location <span class="text-red-400">*</span></label>
                                <input id="addLocation" name="Location" required class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., Kabayan, Benguet" />
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label for="addDistance" class="block text-sm font-medium text-gray-300 mb-2">Distance (km) <span class="text-red-400">*</span></label>
                                    <input id="addDistance" name="DistanceKm" type="number" step="0.1" min="0" required class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., 12" />
                                </div>
                                <div>
                                    <label for="addElevation" class="block text-sm font-medium text-gray-300 mb-2">Elevation Gain (m) <span class="text-red-400">*</span></label>
                                    <input id="addElevation" name="ElevationGainMeters" type="number" min="0" required class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm" placeholder="e.g., 850" />
                                </div>
                            </div>

                            <div>
                                <p id="addTerrainLabel" class="block text-sm font-medium text-gray-300 mb-2">Terrain <span class="text-red-400">*</span></p>
                                @await Html.PartialAsync("_TerrainChips", "add")
                                <p class="text-xs text-gray-500 mt-2">Select every terrain type that applies.</p>
                                <p id="addTerrainError" hidden class="text-xs text-red-400 mt-1.5 flex items-center gap-1.5" role="alert">
                                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                                    <span>Select at least one terrain type.</span>
                                </p>
                            </div>

                            <div>
                                <label for="addTrailClass" class="block text-sm font-medium text-gray-300 mb-2">Technical Trail Class <span class="text-red-400">*</span></label>
                                <select id="addTrailClass" name="TrailClass" required data-custom-select data-cs-describedby="addTrailClassDescription" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm appearance-none cursor-pointer"
                                        style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%239CA3AF%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 12px center; background-size: 16px;">
                                    <option value="" disabled selected class="text-gray-500">Select Technical Trail Class</option>
                                    <option value="1" class="bg-surface-card">1 — Walking</option>
                                    <option value="2" class="bg-surface-card">2 — Hiking</option>
                                    <option value="3" class="bg-surface-card">3 — Scrambling</option>
                                    <option value="4" class="bg-surface-card">4 — Simple Climbing</option>
                                </select>
                                <p class="text-xs text-gray-500 mt-2">Technical characteristics of the trail used when calculating difficulty for linked events. This is not the event's difficulty rating.</p>
                                <p id="addTrailClassDescription" class="text-xs text-gray-400 mt-2 bg-white/5 border border-white/10 rounded-lg px-3 py-2" aria-live="polite">Select a class above to see its full description.</p>
                            </div>

                            <div>
                                <label for="addDescription" class="block text-sm font-medium text-gray-300 mb-2">Description <span class="text-red-400">*</span></label>
                                <textarea id="addDescription" name="Description" required rows="6" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors text-sm resize-none" placeholder="Write a brief overview..."></textarea>
                                <p class="text-xs text-gray-500 mt-2">Provide details about the trail, highlights, and what hikers can expect.</p>
                            </div>
                        </div>

                        <div class="flex flex-col gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1">Cover Photo <span class="text-red-400">*</span></label>
                                <p class="text-xs text-gray-500 mb-2">The main image shown on trail cards and listings.</p>
