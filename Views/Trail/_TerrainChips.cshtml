@model string
@{
    // Model is the id prefix ("add" or "edit") so checkbox ids stay unique when
    // both the Add and Edit modals exist in the DOM at the same time. Every
    // checkbox starts unchecked here - Add stays that way; Edit's JS checks the
    // right ones (and injects an extra chip for non-Mixed legacy values) when it
    // opens for a specific trail. Rendering from TrailTerrainOptions.AllowedValues
    // keeps this the one place the selectable option list is spelled out.
    var idPrefix = Model;
    var inputName = idPrefix == "add" ? "AddTrail.TerrainValues" : "TerrainValues";
    var selectedValues = ViewData["SelectedTerrainValues"] as IEnumerable<string> ?? Enumerable.Empty<string>();
    var errorDescription = idPrefix == "add" ? "addTerrainError addTerrainServerError" : $"{idPrefix}TerrainError";
}
<div id="@(idPrefix)TerrainChips" role="group" aria-labelledby="@(idPrefix)TerrainLabel" aria-describedby="@errorDescription" aria-invalid="false" class="flex flex-wrap gap-2">
    @for (var i = 0; i < TrailGuard.Services.TrailTerrainOptions.AllowedValues.Length; i++)
    {
        var terrain = TrailGuard.Services.TrailTerrainOptions.AllowedValues[i];
        var inputId = $"{idPrefix}Terrain-{i}";
        var isSelected = selectedValues.Contains(terrain, StringComparer.OrdinalIgnoreCase);
        <label for="@inputId" class="relative inline-flex items-center cursor-pointer select-none px-3 py-1.5 rounded-full text-xs font-medium bg-surface-card border border-gray-700 text-gray-300 has-checked:bg-accent/15 has-checked:border-accent has-checked:text-white hover:border-gray-500 transition-colors focus-within:ring-2 focus-within:ring-accent">
            <input type="checkbox" id="@inputId" name="@inputName" value="@terrain" data-supported-terrain="true" class="sr-only" @Html.Raw(isSelected ? "checked" : "")>
            <span>@terrain</span>
        </label>
    }
</div>
