@model TrailGuard.Models.AssessmentReportViewModel
@{
    ViewData["Title"] = "Assessment Report";
    var isGoodMatch = Model?.Result == "Good-Match";
    var isBorderline = Model?.Result == "Borderline";
    var isNotRecommended = Model?.Result == "Not Recommended";

    var resultColor = isGoodMatch ? "text-emerald-400" : isBorderline ? "text-amber-400" : "text-red-400";
    var resultBg = isGoodMatch ? "bg-emerald-500/20 border-emerald-500/50" : isBorderline ? "bg-amber-500/20 border-amber-500/50" : "bg-red-500/20 border-red-500/50";
    var resultIcon = isGoodMatch ? "fa-check-circle" : isBorderline ? "fa-triangle-exclamation" : "fa-xmark-circle";
    var donutColor = isGoodMatch ? "#34d399" : isBorderline ? "#fbbf24" : "#f87171";

    var eventItem = ViewBag.Assessment?.Event as TrailGuard.Models.Event;

    // Trail-derived figures come from the Event's own frozen Trail Snapshot,
    // never a live read of Event.Trail - an assessment report is a historical
    // record and must not change if the Trail is edited afterward. See
    // CLAUDE.md, "Event Trail Snapshot".
    var trailDistanceKm = eventItem?.TrailDistanceKmSnapshot ?? 0;
    var trailElevationGainMeters = eventItem?.TrailElevationGainMetersSnapshot ?? 0;
    var trailTerrain = eventItem != null ? eventItem.TrailTerrainSnapshot : null;
    var trailName = eventItem != null ? eventItem.TrailNameSnapshot : null;

    var confidencePct = Math.Round((Model?.ConfidenceScore ?? 0) * 100, 1);
    var confidenceDisplay = confidencePct.ToString("0.0");

    // What registration will actually ask for - same trigger RegistrationRulesHelper
    // uses, computed once in the controller so this can't drift from the form again.
    var requiresClearance = Model?.RequiresMedicalClearance == true;
    var requiresPlan = Model?.RequiresPreparationPlan == true;
    // A gate-flagged health condition is the more serious reason and wins the
    // headline message even when Not Recommended would also require clearance on
    // its own; the itemized list below still shows everything that's required
    // either way, so nothing goes unmentioned.
    var clearanceReasonText = Model?.MedicalClearanceRequired == true
        ? "Your assessment flagged a health condition that needs medical clearance before you can register."
        : "This trail is significantly beyond your current readiness. Registration will require a medical clearance and a preparation plan.";

    var trailClass = eventItem?.TrailClassSnapshot ?? 0;
    var terrainTypeLabel = TrailGuard.Services.DifficultyCalculator.TrailClassLabel(trailClass);
    var terrainTypeColor = trailClass switch
    {
        1 => "bg-green-500",
        2 => "bg-yellow-500",
        3 => "bg-orange-500",
        4 => "bg-red-500",
        _ => "bg-gray-500"
    };
    var terrainTypePct = trailClass switch
    {
        1 => 25,
        2 => 50,
        3 => 75,
        4 => 100,
        _ => 0
    };
}

<div class="pt-24 px-4 max-w-6xl mx-auto min-h-screen text-white pb-12">

    <div class="mb-6">
        <a asp-controller="Participant" asp-action="Events" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors group">
            <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
            Back to Events
        </a>
    </div>

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-8 mb-8">
        <div class="flex flex-col md:flex-row items-center gap-6">
            @if (Model?.HasMlPrediction == true)
            {
                <div class="relative shrink-0" style="width: 120px; height: 120px;">
                    <canvas id="confidenceDonutChart" width="120" height="120"></canvas>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-xl font-bold text-white">@confidenceDisplay%</span>
                        <span class="text-[8px] text-gray-400">confidence</span>
                    </div>
                </div>
            }
            <div class="text-center md:text-left flex-1">
                <div class="flex items-center gap-3 justify-center md:justify-start">
                    <div class="w-10 h-10 rounded-full @resultBg flex items-center justify-center shrink-0">
                        <i class="fa-solid @resultIcon text-xl @resultColor"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold @resultColor">@Model?.Result</h1>
                        <p class="text-gray-400 text-sm">
                            <span class="font-semibold text-white">@Model?.EventTitle</span>
                            <span class="mx-2">•</span>
                            <span class="text-gray-500">Difficulty: @Model?.EventDifficulty (@TrailGuard.Services.DifficultyCalculator.PmRangeFor(Model?.EventDifficulty))</span>
                        </p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-4 mt-3 text-sm">
                    <span class="text-gray-400">Assessment ID: <span class="text-white font-semibold">#@Model?.AssessmentId</span></span>
                </div>
            </div>
            <div class="flex flex-col gap-2">
                @if (isGoodMatch || isBorderline)
                {
                    <a asp-controller="Registration" asp-action="Register" asp-route-eventId="@Model?.EventId" asp-route-assessmentId="@Model?.AssessmentId"
                       class="px-6 py-3 rounded-full text-white font-semibold bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out text-center" id="headerProceedBtn">
                        <i class="fa-regular fa-clipboard mr-2"></i> Proceed to Registration
                    </a>
                }
                @if (isBorderline || isNotRecommended)
                {
                    <a asp-controller="Assessment" asp-action="Form" asp-route-eventId="@Model?.EventId"
                       class="px-6 py-2 rounded-full text-amber-400 font-medium bg-amber-500/10 border border-amber-500/30 hover:bg-amber-500/20 transition-colors text-center text-sm">
                        <i class="fa-solid fa-rotate mr-2"></i> Retake Assessment
                    </a>
                }
            </div>
        </div>
    </div>

    @if (requiresClearance)
    {
        <div class="bg-red-500/10 border border-red-500/30 rounded-xl p-4 mb-8 flex items-start gap-3">
            <i class="fa-solid fa-notes-medical text-red-400 text-xl mt-0.5"></i>
            <div>
                <p class="text-red-400 font-semibold text-sm">Registration will require additional documents</p>
                <p class="text-gray-300 text-sm mt-1">@clearanceReasonText</p>
                <ul class="text-gray-300 text-sm mt-2 space-y-1">
                    <li><i class="fa-solid fa-check text-red-400/70 mr-2"></i>Medical clearance document</li>
                    @if (requiresPlan)
                    {
                        <li><i class="fa-solid fa-check text-red-400/70 mr-2"></i>Preparation plan</li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <div class="lg:col-span-2 space-y-6">

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-mountain text-accent mr-2"></i>Trail Demands</h2>
                @if (Model?.HasMlPrediction == true)
                {
                    <p class="text-sm text-gray-400 mb-4">
                        This trail rates <span class="text-white font-semibold">@Model.NpsScore.ToString("0.0")</span> on the NPS Shenandoah hiking difficulty scale,
                        which maps onto the PinoyMountaineer difficulty tier
                        <span class="text-white font-semibold">@Model.NpsBand</span>
                        <span class="text-gray-500">(@TrailGuard.Services.DifficultyCalculator.PmRangeFor(Model.NpsBand))</span>.
                    </p>
                }
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-300">Distance</span>
                            <span class="text-white font-semibold">@(trailDistanceKm) km</span>
                        </div>
                        <div class="w-full h-2.5 bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-700 @((trailDistanceKm) >= 15 ? "bg-red-500" : (trailDistanceKm) >= 10 ? "bg-yellow-500" : "bg-green-500")"
                                 style="width: @(Math.Min(((trailDistanceKm) / 20) * 100, 100))%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-300">Elevation Gain</span>
                            <span class="text-white font-semibold">@(trailElevationGainMeters) m</span>
                        </div>
                        <div class="w-full h-2.5 bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-700 @((trailElevationGainMeters) >= 1000 ? "bg-red-500" : (trailElevationGainMeters) >= 600 ? "bg-yellow-500" : "bg-green-500")"
                                 style="width: @(Math.Min(((double)(trailElevationGainMeters) / 1500) * 100, 100))%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-300">Estimated Duration</span>
                            <span class="text-white font-semibold">@(eventItem?.EstimatedDuration ?? 0) hrs</span>
                        </div>
                        <div class="w-full h-2.5 bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-700 @((eventItem?.EstimatedDuration ?? 0) >= 8 ? "bg-red-500" : (eventItem?.EstimatedDuration ?? 0) >= 6 ? "bg-yellow-500" : "bg-green-500")"
                                 style="width: @(Math.Min(((eventItem?.EstimatedDuration ?? 0) / 10) * 100, 100))%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-300">Trail Class</span>
                            <span class="text-white font-semibold">@terrainTypeLabel</span>
                        </div>
                        <div class="w-full h-2.5 bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-700 @terrainTypeColor"
                                 style="width: @terrainTypePct%"></div>
                        </div>
                    </div>
                    <div class="sm:col-span-2">
                        <span class="text-gray-300 text-sm">Terrain</span>
                        <span class="text-white text-sm ml-2">@(trailTerrain ?? "N/A")</span>
                    </div>
                </div>
            </div>

            @if (Model?.HasMlPrediction == true && Model.ShapFactors.Any())
            {
                <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                    <div class="flex items-start justify-between mb-1">
                        <h2 class="text-lg font-bold text-white">
                            <i class="fa-solid fa-brain text-accent mr-2"></i>Why This Result?
                        </h2>
                        <div class="text-right">
                            <div class="text-xs text-gray-400">Model Confidence</div>
                            <div class="text-lg font-bold text-accent">@confidenceDisplay%</div>
                        </div>
                    </div>
                    <p class="text-sm text-gray-400 mb-1">
                        These are the factors that most influenced your assessment result.
                    </p>
                    <p class="text-xs text-gray-500 mb-5">
                        Confidence reflects how certain the model is that this result matches its trained rules. It does not measure whether the recommendation is right for you.
                    </p>

                    @if (Model.GateApplied)
                    {
                        <div class="mb-5 p-3 bg-amber-500/10 border border-amber-500/30 rounded-lg">
                            <p class="text-amber-300 text-sm">
                                <i class="fa-solid fa-shield-halved mr-1"></i> @Model.GateReason
                            </p>
                        </div>
                    }

                    <div class="space-y-4">
                        @foreach (var factor in Model.ShapFactors)
                        {
                            <div>
                                <div class="flex justify-between items-center text-sm mb-1.5">
                                    <span class="text-gray-300">@factor.FriendlyName</span>
                                    <span class="@(factor.IsPositive ? "text-emerald-400" : "text-red-400") font-semibold text-xs">
                                        <i class="fa-solid @(factor.IsPositive ? "fa-arrow-up" : "fa-arrow-down") mr-1"></i>
                                        @(factor.IsPositive ? "Helped" : "Reduced") · @factor.BarWidth.ToString("0.#")%
                                    </span>
                                </div>
                                <div class="w-full h-2.5 bg-gray-700 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full transition-all duration-700 @(factor.IsPositive ? "bg-emerald-500" : "bg-red-500")"
                                         style="width: @factor.BarWidth%"></div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-5 pt-4 border-t border-white/10">
                        <p class="text-xs text-gray-500">
                            <i class="fa-solid fa-circle-info mr-1"></i>
                            Assessment generated by machine learning model (@Model.ModelVersion). Green factors supported your result; red factors worked against it.
                        </p>
                    </div>
                </div>
            }

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-lightbulb text-accent mr-2"></i>Recommendations</h2>
                @if (Model?.Recommendations != null && Model.Recommendations.Any())
                {
                    <ul class="space-y-2">
                        @foreach (var rec in Model.Recommendations)
                        {
                            <li class="flex items-start gap-2 text-gray-300 text-sm">
                                <i class="fa-solid fa-check-circle text-emerald-400 mt-0.5"></i>
                                <span>@rec</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-gray-500 text-sm">No recommendations available.</p>
                }
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4">
                    <i class="fa-solid fa-arrows-rotate text-accent mr-2"></i>
                    @if (isGoodMatch)
                    {
                        <span>Other Events for You</span>
                    }
                    else
                    {
                        <span>Recommended Alternatives</span>
                    }
                </h2>
                @if (Model?.AlternativeEvents != null && Model.AlternativeEvents.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @foreach (var altEvent in Model.AlternativeEvents)
                        {
                            var difficultyBadge = TrailGuard.Services.DifficultyCalculator.BadgeClass(altEvent.Difficulty);

                            <div class="bg-white/5 border border-white/5 rounded-xl p-4 hover:border-white/20 transition-colors">
                                <p class="text-white font-medium text-sm">@altEvent.EventTitle</p>
                                <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500 mt-2">
                                    <span><i class="fa-regular fa-calendar mr-1"></i>@altEvent.EventDate.ToString("MMM dd, yyyy")</span>
                                    <span><i class="fa-regular fa-clock mr-1"></i>@altEvent.EstimatedDuration hrs</span>
                                    <span class="px-2 py-0.5 rounded-full font-medium @difficultyBadge">@altEvent.Difficulty</span>
                                </div>
                                <a asp-controller="Participant" asp-action="Details" asp-route-id="@altEvent.Id"
                                   class="mt-3 inline-block text-xs font-medium text-accent hover:brightness-125 transition-all">
                                    View Details <i class="fa-solid fa-arrow-right ml-1"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-gray-500 text-sm py-4">
                        <i class="fa-regular fa-calendar-plus text-2xl block mb-2 opacity-50"></i>
                        No alternative events available at this time.
                    </div>
                }
            </div>
        </div>

        <div class="space-y-6 flex flex-col">

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-chart-simple text-accent mr-2"></i>Result Summary</h2>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-gray-400">Result</span>
                        <span class="font-bold @resultColor">@Model?.Result</span>
                    </div>
                    @if (Model?.HasMlPrediction == true)
                    {
                        <div class="flex justify-between">
                            <span class="text-gray-400">Model Confidence</span>
                            <span class="text-accent font-semibold">@confidenceDisplay%</span>
                        </div>
                    }
                    <div class="flex justify-between">
                        <span class="text-gray-400">Event</span>
                        <span class="text-white font-semibold text-right">@Model?.EventTitle</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Trail</span>
                        <span class="text-white font-semibold text-right">@(trailName ?? "N/A")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Difficulty</span>
                        <span class="text-white font-semibold">@Model?.EventDifficulty</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Date</span>
                        <span class="text-white font-semibold">@(eventItem?.EventDate.ToString("MMM dd, yyyy") ?? "N/A")</span>
                    </div>
                </div>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6 flex flex-col flex-1">
                <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-file-signature text-accent mr-2"></i>Acknowledgement</h2>

                @if (isGoodMatch)
                {
                    <div class="flex items-start gap-3 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl">
                        <input type="checkbox" id="acknowledgeGoodMatch" class="w-5 h-5 mt-0.5 accent-emerald-500 cursor-pointer shrink-0" />
                        <label for="acknowledgeGoodMatch" class="text-gray-300 text-sm cursor-pointer">
                            <span class="font-medium text-emerald-400">I acknowledge my Good-Match assessment result</span> and confirm that I am prepared for this event. I understand the trail demands and agree to follow all safety guidelines.
                        </label>
                    </div>
                }
                else if (isBorderline)
                {
                    <div class="flex items-start gap-3 p-4 bg-amber-500/10 border border-amber-500/30 rounded-xl">
                        <input type="checkbox" id="acknowledgeBorderline" class="w-5 h-5 mt-0.5 accent-amber-500 cursor-pointer shrink-0" />
                        <label for="acknowledgeBorderline" class="text-gray-300 text-sm cursor-pointer">
                            <span class="font-medium text-amber-400">I acknowledge my Borderline assessment result</span> and understand the recommended preparation steps before continuing. I agree to take necessary precautions and follow the organizer's advice.
                        </label>
                    </div>
                }
                else if (isNotRecommended)
                {
                    <div class="flex items-start gap-3 p-4 bg-red-500/10 border border-red-500/30 rounded-xl">
                        <input type="checkbox" id="acknowledgeNotRecommended" class="w-5 h-5 mt-0.5 accent-red-500 cursor-pointer shrink-0" />
                        <label for="acknowledgeNotRecommended" class="text-gray-300 text-sm cursor-pointer">
                            <span class="font-medium text-red-400">I acknowledge my Not Recommended assessment result</span> and understand the significant risks involved. I accept full responsibility for my decision to proceed and agree to follow all safety guidelines.
                        </label>
                    </div>
                }

                <p class="mt-2 text-xs text-gray-500">
                    <i class="fa-regular fa-circle-check mr-1"></i>
                    Please check the box to confirm your acknowledgement before proceeding to registration.
                </p>

                <div class="mt-4 pt-4 border-t border-white/10 space-y-2">
                    @if (isGoodMatch || isBorderline)
                    {
                        <a asp-controller="Registration" asp-action="Register" asp-route-eventId="@Model?.EventId" asp-route-assessmentId="@Model?.AssessmentId"
                           class="w-full px-6 py-3 rounded-full text-white font-semibold bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out text-center block" id="proceedButton">
                            <i class="fa-regular fa-clipboard mr-2"></i> Proceed to Registration
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Registration" asp-action="Register" asp-route-eventId="@Model?.EventId" asp-route-assessmentId="@Model?.AssessmentId"
                           class="w-full px-6 py-3 rounded-full text-white font-semibold bg-linear-to-r from-red-600 to-amber-600 hover:brightness-110 hover:scale-[1.02] transition duration-200 ease-out text-center block" id="proceedButton">
                            <i class="fa-solid fa-triangle-exclamation mr-2"></i> Proceed with Additional Requirements
                        </a>
                        <p class="text-xs text-red-400/80 text-center">
                            <i class="fa-solid fa-circle-info mr-1"></i> You'll need to submit a medical clearance and a preparation plan.
                        </p>
                    }
                    <a asp-controller="Assessment" asp-action="Form" asp-route-eventId="@Model?.EventId"
                       class="w-full px-6 py-2.5 rounded-full text-gray-300 font-medium bg-gray-800 hover:bg-gray-700 transition-colors text-center block text-sm">
                        <i class="fa-solid fa-rotate mr-2"></i> Retake Assessment
                    </a>
                    <a asp-controller="Participant" asp-action="Events"
                       class="w-full px-6 py-2.5 rounded-full text-gray-400 font-medium hover:text-white transition-colors text-center block text-sm">
                        <i class="fa-solid fa-arrow-left mr-2"></i> Back to Events
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var ctx = document.getElementById('confidenceDonutChart')?.getContext('2d');
        if (ctx) {
            var confidencePct = @confidencePct;
            var color = '@donutColor';

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Confidence', 'Remaining'],
                    datasets: [{
                        data: [confidencePct, 100 - confidencePct],
                        backgroundColor: [color, '#374151'],
                        borderWidth: 0,
                        cutout: '72%'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return (context.label || '') + ': ' + (context.parsed || 0) + '%';
                                }
                            }
                        }
                    }
                }
            });
        }

        var acknowledgeCheckbox = document.querySelector('input[id^="acknowledge"]');
        var proceedButton = document.getElementById('proceedButton');
        var headerProceedBtn = document.getElementById('headerProceedBtn');

        if (acknowledgeCheckbox && proceedButton) {
            proceedButton.style.opacity = '0.5';
            proceedButton.style.pointerEvents = 'none';
            if (headerProceedBtn) {
                headerProceedBtn.style.opacity = '0.5';
                headerProceedBtn.style.pointerEvents = 'none';
            }

            acknowledgeCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    proceedButton.style.opacity = '1';
                    proceedButton.style.pointerEvents = 'auto';
                    if (headerProceedBtn) {
                        headerProceedBtn.style.opacity = '1';
                        headerProceedBtn.style.pointerEvents = 'auto';
                    }
                } else {
                    proceedButton.style.opacity = '0.5';
                    proceedButton.style.pointerEvents = 'none';
                    if (headerProceedBtn) {
                        headerProceedBtn.style.opacity = '0.5';
                        headerProceedBtn.style.pointerEvents = 'none';
                    }
                }
            });
        }
    });
</script>
