@model IEnumerable<TrailGuard.Models.RegistrationWithAssessmentViewModel>
@{
    ViewData["Title"] = "Registrations";

    var totalRegistrations = Model.Count();
    var goodMatchCount = Model.Count(r => r.AssessmentResult == "Good-Match");
    var borderlineCount = Model.Count(r => r.AssessmentResult == "Borderline");
    var notRecommendedCount = Model.Count(r => r.AssessmentResult == "Not Recommended");
    var registrationWord = totalRegistrations == 1 ? "registration" : "registrations";

    // Plain semantic text, no pill shell - see DESIGN.md, Registration Status.
    Func<string, string> statusTextClass = status => status switch
    {
        "Pending" => "text-amber-400",
        "Awaiting Payment" => "text-amber-400",
        "For Payment Verification" => "text-blue-400",
        "Accepted" => "text-emerald-400",
        "Alternative Recommended" => "text-blue-400",
        "Rejected" => "text-red-400",
        "Cancelled" => "text-slate-400",
        "Voided" => "text-slate-400",
        _ => "text-gray-300"
    };

    Func<string?, string> resultTextClass = value => value switch
    {
        "Good-Match" => "text-emerald-400",
        "Borderline" => "text-amber-400",
        "Not Recommended" => "text-red-400",
        _ => "text-gray-400"
    };
}

@* Success/Error feedback now goes through the canonical global toast host
   in _Layout.cshtml instead of a page-local banner. *@

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Registrations</h1>
            <p class="text-gray-400 mt-1 text-sm">Manage participant registrations and assessment results.</p>
        </div>
        <div class="bg-white/5 border border-white/10 px-4 py-2 rounded-full flex items-center gap-2">
            <i class="fa-regular fa-clipboard text-accent" aria-hidden="true"></i>
            <span class="text-sm text-gray-300" id="registrationCountLabel">@totalRegistrations @registrationWord</span>
        </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center flex flex-col justify-center">
            <p class="text-2xl font-bold text-white">@totalRegistrations</p>
            <p class="text-gray-400 text-xs mt-1">Total Registrations</p>
        </div>
        <div class="bg-white/5 border border-emerald-500/30 rounded-xl p-4 text-center flex flex-col justify-center">
            <p class="text-2xl font-bold text-emerald-400">@goodMatchCount</p>
            <p class="text-gray-400 text-xs mt-1">Good-Match</p>
        </div>
        <div class="bg-white/5 border border-amber-500/30 rounded-xl p-4 text-center flex flex-col justify-center">
            <p class="text-2xl font-bold text-amber-400">@borderlineCount</p>
            <p class="text-gray-400 text-xs mt-1">Borderline</p>
        </div>
        <div class="bg-white/5 border border-red-500/30 rounded-xl p-4 text-center flex flex-col justify-center">
            <p class="text-2xl font-bold text-red-400">@notRecommendedCount</p>
            <p class="text-gray-400 text-xs mt-1">Not Recommended</p>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-4 mb-8 bg-white/5 backdrop-blur-xl p-5 rounded-xl border border-white/10">
        <div class="relative grow">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
            <input type="text" id="searchInput" placeholder="Search by participant or event..."
                   class="w-full bg-black/20 border border-white/10 text-white text-sm rounded-full pl-11 pr-4 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none transition-colors placeholder-gray-500">
        </div>

        <div class="flex flex-wrap sm:flex-nowrap gap-3">
            <div class="relative inline-block">
                <label for="statusFilter" class="sr-only">Registration status</label>
                <select id="statusFilter" data-custom-select data-custom-select-portal
                        data-cs-decorative-chevron="statusFilterChevron"
                        data-cs-trigger-class="flex w-full items-center justify-between gap-2 px-4 py-3 rounded-full bg-black/20 border border-white/10 text-white text-sm text-left focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors cursor-pointer hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed"
                        class="bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors w-full">
                    <option value="All" class="bg-surface-card">All Status</option>
                    <option value="Pending" class="bg-surface-card">Pending</option>
                    <option value="Accepted" class="bg-surface-card">Accepted</option>
                    <option value="Rejected" class="bg-surface-card">Rejected</option>
                    <option value="Cancelled" class="bg-surface-card">Cancelled</option>
                </select>
                <div id="statusFilterChevron" class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                </div>
            </div>

            <div class="relative inline-block">
                <label for="assessmentFilter" class="sr-only">Assessment result</label>
                <select id="assessmentFilter" data-custom-select data-custom-select-portal
                        data-cs-decorative-chevron="assessmentFilterChevron"
                        data-cs-trigger-class="flex w-full items-center justify-between gap-2 px-4 py-3 rounded-full bg-black/20 border border-white/10 text-white text-sm text-left focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors cursor-pointer hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed"
                        data-cs-menu-class="overflow-x-hidden"
                        data-cs-menu-width-class="w-48"
                        class="bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors w-full">
                    <option value="All" class="bg-surface-card">All Results</option>
                    <option value="Good-Match" class="bg-surface-card">Good-Match</option>
                    <option value="Borderline" class="bg-surface-card">Borderline</option>
                    <option value="Not Recommended" class="bg-surface-card">Not Recommended</option>
                    <option value="N/A" class="bg-surface-card">No Assessment</option>
                </select>
                <div id="assessmentFilterChevron" class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                </div>
            </div>

            <div class="relative inline-block">
                <label for="sortFilter" class="sr-only">Sort registrations</label>
                <select id="sortFilter" data-custom-select data-custom-select-portal
                        data-cs-decorative-chevron="sortFilterChevron"
                        data-cs-trigger-class="flex w-full items-center justify-between gap-2 px-4 py-3 rounded-full bg-black/20 border border-white/10 text-white text-sm text-left focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors cursor-pointer hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed"
                        class="bg-black/20 border border-white/10 text-white text-sm rounded-full pl-5 pr-10 py-3 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none cursor-pointer appearance-none hover:bg-white/10 transition-colors w-full">
                    <option value="date_desc" class="bg-surface-card">Sort by: Newest</option>
                    <option value="date_asc" class="bg-surface-card">Sort by: Oldest</option>
                    <option value="participant_asc" class="bg-surface-card">Participant (A-Z)</option>
                    <option value="participant_desc" class="bg-surface-card">Participant (Z-A)</option>
                </select>
                <div id="sortFilterChevron" class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden">
            <div class="hidden lg:grid lg:grid-cols-[minmax(0,2.2fr)_minmax(0,2fr)_minmax(0,1.3fr)_minmax(0,0.9fr)_minmax(0,1fr)] gap-4 px-5 py-3 border-b border-white/10 text-xs font-medium text-gray-400 uppercase tracking-wider">
                <span>Participant</span>
                <span>Event</span>
                <span>Assessment</span>
                <span>Status</span>
                <span>Registered</span>
            </div>

            <div class="relative">
                <ul id="registrationList" role="list" aria-label="Registration records" class="list-none m-0 p-0 divide-y divide-white/10 overflow-y-auto">
                @foreach (var item in Model)
                {
                    var assessmentLabel = item.AssessmentResult ?? "Not assessed";
                    string? confidenceLabel = item.AssessmentResult == null
                        ? null
                        : (item.AssessmentConfidence.HasValue
                            ? $"Confidence: {(item.AssessmentConfidence.Value * 100).ToString("0.0")}%"
                            : "Confidence unavailable");

                    <li>
                        <a asp-controller="Organizer" asp-action="RegistrationDetails" asp-route-id="@item.RegistrationId"
                           data-participant="@item.ParticipantName.ToLowerInvariant()"
                           data-email="@item.Email.ToLowerInvariant()"
                           data-event="@item.EventTitle.ToLowerInvariant()"
                           data-status="@item.Status"
                           data-assessment="@(item.AssessmentResult ?? "")"
                           data-registered-at="@item.RegisteredAt.ToString("o")"
                           class="grid grid-cols-1 lg:grid-cols-[minmax(0,2.2fr)_minmax(0,2fr)_minmax(0,1.3fr)_minmax(0,0.9fr)_minmax(0,1fr)] gap-2 lg:gap-4 lg:items-center px-5 py-4 hover:bg-white/5 focus:outline-none focus-visible:bg-white/5 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset transition-colors cursor-pointer">

                            <div>
                                <p class="lg:sr-only text-[11px] uppercase tracking-wider text-gray-500 mb-1">Participant</p>
                                <p class="text-white font-medium wrap-break-word">@item.ParticipantName</p>
                                <p class="text-gray-400 text-sm wrap-break-word">@item.Email</p>
                            </div>

                            <div>
                                <p class="lg:sr-only text-[11px] uppercase tracking-wider text-gray-500 mb-1">Event</p>
                                <p class="text-white font-medium wrap-break-word">@item.EventTitle</p>
                                <p class="text-gray-400 text-sm flex flex-wrap items-center gap-x-1.5 gap-y-0.5 mt-0.5">
                                    <span class="inline-flex items-center gap-1"><i class="fa-regular fa-calendar text-accent" aria-hidden="true"></i>@item.EventDate</span>
                                    <span class="inline-flex items-center gap-1"><i class="fa-regular fa-clock text-accent" aria-hidden="true"></i>@item.EventTime</span>
                                </p>
                            </div>

                            <div>
                                <p class="lg:sr-only text-[11px] uppercase tracking-wider text-gray-500 mb-1">Assessment</p>
                                <p class="font-semibold wrap-break-word @resultTextClass(item.AssessmentResult)">@assessmentLabel</p>
                                @if (confidenceLabel != null)
                                {
                                    <p class="text-gray-400 text-sm mt-0.5">@confidenceLabel</p>
                                }
                                @if (item.MedicalClearanceRequired)
                                {
                                    var clearanceMissing = string.IsNullOrEmpty(item.MedicalClearanceUrl);
                                    <span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full font-medium mt-1 @(clearanceMissing ? "bg-red-500/20 text-red-400" : "bg-blue-500/20 text-blue-400")">
                                        <i class="fa-solid fa-file-medical" aria-hidden="true"></i>
                                        @(clearanceMissing ? "Clearance missing" : "Clearance required")
                                    </span>
                                }
                            </div>

                            <div>
                                <p class="lg:sr-only text-[11px] uppercase tracking-wider text-gray-500 mb-1">Status</p>
                                <p class="font-semibold wrap-break-word @statusTextClass(item.Status)">@item.Status</p>
                            </div>

                            <div>
                                <p class="lg:sr-only text-[11px] uppercase tracking-wider text-gray-500 mb-1">Registered</p>
                                <p class="text-gray-400 text-sm whitespace-nowrap">@item.RegisteredAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        </a>
                    </li>
                }
                </ul>
                <div id="registrationScrollCueTop" class="registrations-scroll-cue registrations-scroll-cue-top" aria-hidden="true">
                    <span><i class="fa-solid fa-chevron-up mr-1"></i>Scroll for more</span>
                </div>
                <div id="registrationScrollCueBottom" class="registrations-scroll-cue registrations-scroll-cue-bottom" aria-hidden="true">
                    <span>Scroll for more<i class="fa-solid fa-chevron-down ml-1"></i></span>
                </div>
            </div>

            <div id="noResultsMessage" hidden class="text-center py-16 px-5">
                <i class="fa-solid fa-magnifying-glass text-4xl text-slate-600 mb-4" aria-hidden="true"></i>
                <h3 class="text-xl font-bold text-gray-300">No registrations found</h3>
                <p class="text-gray-500 mt-2">No registrations match your search or filters.</p>
                <button type="button" id="clearFiltersBtn" class="inline-block mt-4 text-accent text-sm font-medium hover:brightness-125 focus:outline-none focus:ring-2 focus:ring-accent rounded">
                    Clear filters <i class="fa-solid fa-arrow-right ml-1" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-20 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl">
            <i class="fa-regular fa-clipboard text-5xl text-gray-500 mb-4" aria-hidden="true"></i>
            <h3 class="text-xl font-bold text-gray-300">No registrations found</h3>
            <p class="text-gray-500 mt-2">Registrations will appear here once participants sign up for your events.</p>
        </div>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const assessmentFilter = document.getElementById('assessmentFilter');
        const sortFilter = document.getElementById('sortFilter');
        const list = document.getElementById('registrationList');
        const noResults = document.getElementById('noResultsMessage');
        const countLabel = document.getElementById('registrationCountLabel');
        const clearFiltersBtn = document.getElementById('clearFiltersBtn');

        if (!list) return;

        // ------------------------------------------------------------------
        // Five-record desktop scroll viewport + top/bottom scroll cues.
        //
        // Rows wrap and vary in height (long names, wrapped statuses, the
        // confidence line appearing/not), so the viewport height can't be a
        // fixed pixel guess - it's measured from the actual gap between the
        // top of the first visible record and the top of the sixth, which
        // equals the combined rendered height of the first five regardless
        // of how tall each one is. Only ever applied at lg (1024px) and up;
        // below that the list keeps natural height and normal page scroll.
        //
        // Cue visuals/toggle mirror Organizer/Index.cshtml's Dashboard
        // scroll-cue pattern (single owner of visibility via the
        // .is-visible class, never mixed with the native `hidden`
        // attribute), extended with a second, top-edge cue - see
        // wwwroot/css/input.css for why.
        // ------------------------------------------------------------------
        const cueTop = document.getElementById('registrationScrollCueTop');
        const cueBottom = document.getElementById('registrationScrollCueBottom');
        const desktopQuery = window.matchMedia('(min-width: 1024px)');
        let recalcScheduled = false;

        function updateScrollCues() {
            if (!cueTop || !cueBottom) return;
            const hasOverflow = list.scrollHeight > list.clientHeight + 1;
            const atTop = list.scrollTop <= 1;
            const atBottom = Math.ceil(list.scrollTop + list.clientHeight) >= list.scrollHeight - 1;
            cueTop.classList.toggle('is-visible', hasOverflow && !atTop);
            cueBottom.classList.toggle('is-visible', hasOverflow && !atBottom);
        }

        function applyFiveRecordViewport() {
            const visibleItems = Array.from(list.children).filter(function (li) {
                return li.style.display !== 'none';
            });

            if (!desktopQuery.matches || visibleItems.length <= 5) {
                // Natural height below lg, or when everything already fits -
                // no forced blank space, no scrollbar.
                list.style.maxHeight = '';
                updateScrollCues();
                return;
            }

            const firstTop = visibleItems[0].getBoundingClientRect().top;
            const sixthTop = visibleItems[5].getBoundingClientRect().top;
            list.style.maxHeight = (sixthTop - firstTop) + 'px';
            updateScrollCues();
        }

        // Coalesces any number of calls within one frame into a single
        // measurement/update pass - resize fires far more often than once
        // per frame, and this also means a resize handler and a filter
        // change in the same tick never produce two recalculations.
        function scheduleViewportRecalc() {
            if (recalcScheduled) return;
            recalcScheduled = true;
            requestAnimationFrame(function () {
                recalcScheduled = false;
                applyFiveRecordViewport();
            });
        }

        // Only ever called from a filter/sort/clear change, never from the
        // scroll or resize listeners below - scrolling the list yourself
        // must never yank you back to the top.
        function resetListScrollAndRecalc() {
            list.scrollTop = 0;
            scheduleViewportRecalc();
        }

        list.addEventListener('scroll', updateScrollCues, { passive: true });
        window.addEventListener('resize', scheduleViewportRecalc);
        if (typeof desktopQuery.addEventListener === 'function') {
            desktopQuery.addEventListener('change', scheduleViewportRecalc);
        } else if (typeof desktopQuery.addListener === 'function') {
            desktopQuery.addListener(scheduleViewportRecalc);
        }

        function filterAndSort() {
            const items = Array.from(list.querySelectorAll(':scope > li'));
            if (items.length === 0) return;

            const searchTerm = searchInput.value.toLowerCase().trim();
            const status = statusFilter.value;
            const assessment = assessmentFilter.value;
            const sort = sortFilter.value;

            let visibleItems = items.filter(function (li) {
                const link = li.querySelector('a');
                if (!link) return false;

                const participant = link.dataset.participant || '';
                const email = link.dataset.email || '';
                const eventTitle = link.dataset.event || '';
                const statusValue = link.dataset.status || '';
                const assessmentValue = link.dataset.assessment || '';

                const matchesSearch = participant.includes(searchTerm) ||
                                     email.includes(searchTerm) ||
                                     eventTitle.includes(searchTerm);

                const matchesStatus = status === 'All' || statusValue === status;

                const matchesAssessment = assessment === 'All' ||
                    (assessment === 'N/A' ? assessmentValue === '' : assessmentValue === assessment);

                const shouldShow = matchesSearch && matchesStatus && matchesAssessment;
                li.style.display = shouldShow ? '' : 'none';
                return shouldShow;
            });

            visibleItems.sort(function (a, b) {
                const linkA = a.querySelector('a');
                const linkB = b.querySelector('a');

                if (sort === 'participant_asc') return linkA.dataset.participant.localeCompare(linkB.dataset.participant);
                if (sort === 'participant_desc') return linkB.dataset.participant.localeCompare(linkA.dataset.participant);
                if (sort === 'date_asc') return new Date(linkA.dataset.registeredAt) - new Date(linkB.dataset.registeredAt);
                if (sort === 'date_desc') return new Date(linkB.dataset.registeredAt) - new Date(linkA.dataset.registeredAt);
                return 0;
            });

            visibleItems.forEach(function (li) { list.appendChild(li); });

            if (noResults) {
                noResults.hidden = visibleItems.length !== 0;
            }

            if (countLabel) {
                const count = visibleItems.length;
                countLabel.textContent = count + ' ' + (count === 1 ? 'registration' : 'registrations');
            }

            resetListScrollAndRecalc();
        }

        searchInput.addEventListener('input', filterAndSort);
        statusFilter.addEventListener('change', filterAndSort);
        assessmentFilter.addEventListener('change', filterAndSort);
        sortFilter.addEventListener('change', filterAndSort);

        if (clearFiltersBtn) {
            // statusFilter/assessmentFilter/sortFilter are enhanced by the
            // shared custom-select component (wwwroot/js/custom-select.js,
            // opt-in via data-custom-select on each <select>). The native
            // <select> stays the source of truth - setting .value here does
            // not dispatch 'change' (so filterAndSort() below still runs
            // exactly once, not once per control), but it also leaves the
            // component's own trigger label/aria-selected/active-option
            // state pointing at the old value until something tells it to
            // resync. window.CustomSelect.refresh(select) is that component's
            // own public API for exactly this - it re-reads the native
            // select and updates its presentation without dispatching
            // 'change' or running any page logic itself, so calling it three
            // times here still only ever produces one filtering pass.
            clearFiltersBtn.addEventListener('click', function () {
                searchInput.value = '';
                statusFilter.value = 'All';
                assessmentFilter.value = 'All';
                sortFilter.value = 'date_desc';

                if (window.CustomSelect && typeof window.CustomSelect.refresh === 'function') {
                    window.CustomSelect.refresh(statusFilter);
                    window.CustomSelect.refresh(assessmentFilter);
                    window.CustomSelect.refresh(sortFilter);
                }

                filterAndSort();
                searchInput.focus();
            });
        }

        filterAndSort();
    });
</script>
