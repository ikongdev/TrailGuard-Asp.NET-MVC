@model List<TrailGuard.Models.ComparisonResult>
@{ ViewData["Title"]="Event Comparison"; var e=ViewBag.Event as TrailGuard.Models.Event; var recorded=Model.Count(x=>x.Completed!=null); var completed=Model.Count(x=>x.Completed==true); var safety=Model.Count(x=>x.IsSafetyCritical); }
<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12"><a asp-controller="Event" asp-action="Details" asp-route-id="@e?.Id" class="text-gray-400 hover:text-white">← Back to Event Details</a><div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-8 mt-6"><h1 class="text-2xl font-bold">Pre-Hike vs Post-Hike Comparison</h1><p class="text-gray-400 text-sm">@e?.EventTitle</p>
@if(Model.Any()){<div class="grid grid-cols-2 md:grid-cols-4 gap-4 my-6"><div class="bg-white/5 rounded-xl p-4 text-center"><p class="text-2xl font-bold">@recorded</p><p class="text-xs text-gray-400">Recorded outcomes</p></div><div class="bg-emerald-500/10 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-emerald-400">@completed</p><p class="text-xs text-gray-400">Completed</p></div><div class="bg-amber-500/10 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-amber-400">@(recorded-completed)</p><p class="text-xs text-gray-400">Did not complete</p></div><div class="bg-red-500/10 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-red-400">@safety</p><p class="text-xs text-gray-400">Good Match misses</p></div></div>
<div class="mt-6 overflow-x-auto rounded-xl border border-white/10"><table class="w-full text-left text-sm"><thead><tr class="border-b border-white/10 text-gray-300"><th class="p-4">Participant</th><th class="p-4">Prediction</th><th class="p-4">Recorded outcome</th><th class="p-4">Comparison</th><th class="p-4">Difficulty experience</th></tr></thead><tbody class="divide-y divide-white/10">@foreach(var x in Model){<tr class="@(x.IsSafetyCritical?"bg-red-500/5 border-l-2 border-l-red-500":"")"><th class="p-4">@x.ParticipantName</th><td class="p-4"><p>@x.PredictedLabel</p><p class="text-xs text-gray-400">@(x.CompletionProbability.HasValue?$"{x.CompletionProbability.Value*100:F1}% estimated completion":"Prediction unavailable")</p></td><td class="p-4">@(x.Completed is null?"Pending":x.Completed.Value?"Completed":$"Did not complete — {x.NonCompletionReason}")</td><td class="p-4 font-semibold @(x.IsSafetyCritical?"text-red-300":"text-gray-300")">@x.Comparison</td><td class="p-4 text-gray-300">@x.ConservativeDifficultyExperience</td></tr>}</tbody></table></div>
<div class="mt-6 p-4 bg-white/5 border border-white/10 rounded-xl text-sm text-gray-400"><span class="text-emerald-400">Accurate</span>: Good Match completed or Not Recommended did not complete. <span class="text-amber-400">Over-cautious</span>: Not Recommended completed. <span class="text-red-300">Missed risk</span>: Good Match did not complete. <span class="text-gray-200">Borderline outcome</span>: uncertainty, so either outcome is not an error. Pending means no recorded completion yet.</div>}else{<p class="text-gray-500 text-center py-16">No participant comparison data available for this event.</p>}</div></div>
