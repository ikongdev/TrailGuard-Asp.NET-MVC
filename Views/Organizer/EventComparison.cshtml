@model List<TrailGuard.Models.ComparisonResult>
@{
    ViewData["Title"] = "Event Comparison";
    var eventItem = ViewBag.Event as TrailGuard.Models.Event;
    var participantWord = Model.Count == 1 ? "participant" : "participants";
    string Outcome(bool? completed, string? reason) => completed is null ? "Pending" : completed.Value ? "Completed" : $"Did not complete — {reason}";
}

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
    <div class="mb-6"><a asp-controller="Event" asp-action="Details" asp-route-id="@eventItem?.Id" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors group focus:outline-none focus:ring-2 focus:ring-accent rounded"><i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform" aria-hidden="true"></i>Back to Event Details</a></div>
    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-8">
        <div class="mb-6"><h1 class="text-2xl font-bold text-white">Pre-Hike vs Post-Hike Comparison</h1><p class="text-gray-400 text-sm mt-1">Compare assessment data for <span class="text-gray-300 font-medium">@eventItem?.EventTitle</span></p></div>
        <div class="bg-white/5 border border-blue-500/20 rounded-xl p-4 mb-6"><p class="text-white font-semibold">@eventItem?.EventTitle</p><div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-400 mt-2"><span class="flex items-center gap-2"><i class="fa-regular fa-calendar text-accent"></i>@eventItem?.EventDate.ToString("MMMM dd, yyyy")</span><span class="flex items-center gap-2"><i class="fa-regular fa-clock text-accent"></i>@eventItem?.FormattedEventTime</span><span class="flex items-center gap-2"><i class="fa-solid fa-users text-accent"></i>@Model.Count @participantWord</span></div></div>

        <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-6 text-sm"><p class="text-amber-300 font-semibold">Label-agreement comparison is unavailable</p><p class="text-amber-300/80 mt-1">Stage 3 stores completion separately from difficulty experience. The comparison sections remain in place; Stage 5 will supply outcome-based agreement metrics.</p></div>

        @if (Model.Any())
        {
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-white/5 border border-emerald-500/30 rounded-xl p-4 text-center"><p class="text-sm font-bold text-emerald-400">Unavailable</p><p class="text-gray-400 text-xs mt-1">Accurate</p></div>
                <div class="bg-white/5 border border-amber-500/30 rounded-xl p-4 text-center"><p class="text-sm font-bold text-amber-400">Unavailable</p><p class="text-gray-400 text-xs mt-1">Over-cautious</p></div>
                <div class="bg-white/5 border border-red-500/30 rounded-xl p-4 text-center"><p class="text-sm font-bold text-red-400">Unavailable</p><p class="text-red-300 text-xs mt-1 font-semibold">Missed risk</p></div>
                <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center"><p class="text-sm font-bold text-gray-400">Unavailable</p><p class="text-gray-400 text-xs mt-1">Insufficient data</p></div>
            </div>

            <div class="hidden lg:block overflow-x-auto rounded-xl border border-white/10"><table class="w-full text-left text-sm border-collapse"><caption class="sr-only">Pre-hike assessment, two submitted post-hike reports, separately resolved difficulty experience, and recorded completion for each participant.</caption><thead><tr class="border-b border-white/10"><th class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Participant</th><th class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Pre-Hike</th><th class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Participant Feedback</th><th class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Organizer Assessment</th><th class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Final Result</th><th class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Saved Recommendation</th><th class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider text-center">Comparison</th></tr></thead><tbody class="divide-y divide-white/10">@foreach (var item in Model) { <tr><th class="px-5 py-4 text-white font-medium whitespace-nowrap">@item.ParticipantName</th><td class="px-5 py-4 text-gray-300">@item.PreHikeAssessment</td><td class="px-5 py-4 text-gray-200"><p>@item.ParticipantDifficultyExperience</p><p class="text-gray-500 text-xs mt-1">@item.ParticipantCompletion</p></td><td class="px-5 py-4 text-gray-200"><p>@item.OrganizerDifficultyExperience</p><p class="text-gray-500 text-xs mt-1">@item.OrganizerCompletion</p></td><td class="px-5 py-4 text-gray-200"><p>@item.ConservativeDifficultyExperience</p><p class="text-gray-500 text-xs mt-1">Conservative difficulty resolution</p></td><td class="px-5 py-4 text-gray-200">@Outcome(item.Completed, item.NonCompletionReason)</td><td class="px-5 py-4 text-center font-semibold text-gray-400">Unavailable pending Stage 5</td></tr> }</tbody></table></div>

            <div class="lg:hidden space-y-4">@foreach (var item in Model) { <article class="bg-white/5 border border-white/10 rounded-xl p-4"><h3 class="text-white font-semibold text-base mb-3">@item.ParticipantName</h3><dl class="space-y-3 text-sm"><div><dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Pre-Hike</dt><dd class="text-gray-200">@item.PreHikeAssessment</dd></div><div><dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Participant Feedback</dt><dd class="text-gray-200">@item.ParticipantDifficultyExperience</dd><dd class="text-gray-500 text-xs mt-1">@item.ParticipantCompletion</dd></div><div><dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Organizer Assessment</dt><dd class="text-gray-200">@item.OrganizerDifficultyExperience</dd><dd class="text-gray-500 text-xs mt-1">@item.OrganizerCompletion</dd></div><div><dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Final Result</dt><dd class="text-gray-200">@item.ConservativeDifficultyExperience</dd><dd class="text-gray-500 text-xs mt-1">Conservative difficulty resolution</dd></div><div><dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Saved Recommendation</dt><dd class="text-gray-200">@Outcome(item.Completed, item.NonCompletionReason)</dd></div><div><dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Comparison</dt><dd class="font-semibold text-gray-400">Unavailable pending Stage 5</dd></div></dl></article> }</div>

            <div class="mt-6 p-4 bg-white/5 border border-white/10 rounded-xl"><p class="text-sm font-semibold text-gray-300 mb-3">Legend</p><div class="flex flex-wrap gap-x-6 gap-y-3 text-sm"><div class="flex items-start gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-400 mt-1 shrink-0"></span><span><span class="text-gray-200 font-medium">Accurate</span> <span class="text-gray-400">— unavailable pending Stage 5</span></span></div><div class="flex items-start gap-2"><span class="w-2.5 h-2.5 rounded-full bg-amber-400 mt-1 shrink-0"></span><span><span class="text-gray-200 font-medium">Over-cautious</span> <span class="text-gray-400">— unavailable pending Stage 5</span></span></div><div class="flex items-start gap-2"><span class="w-2.5 h-2.5 rounded-full bg-red-400 mt-1 shrink-0"></span><span><span class="text-red-300 font-semibold">Missed risk</span> <span class="text-gray-400">— unavailable pending Stage 5</span></span></div><div class="flex items-start gap-2"><span class="w-2.5 h-2.5 rounded-full border border-gray-500 mt-1 shrink-0"></span><span><span class="text-gray-200 font-medium">Pending</span> <span class="text-gray-400">— no recorded completion yet</span></span></div></div></div>
        }
        else
        {
            <div class="bg-white/5 border border-white/10 rounded-xl text-center py-16"><i class="fa-regular fa-users-slash text-3xl text-gray-500 mb-3 block"></i><p class="text-gray-300 text-sm font-medium">No participant comparison data available for this event.</p><p class="text-gray-500 text-xs mt-2">Complete post-event assessments to see recorded outcomes.</p></div>
        }
    </div>
</div>
