@model List<TrailGuard.Models.ComparisonResult>
@{
    ViewData["Title"] = "Event Comparison";
    var eventItem = ViewBag.Event as TrailGuard.Models.Event;
    var participantWord = Model.Count == 1 ? "participant" : "participants";

    // Shared text-color mappings so the desktop table and mobile cards below render
    // identical classes from one definition instead of two copies that could drift.
    // Plain semantic text, not a badge - see DESIGN.md/EventComparison notes on why
    // "Not Recommended" and "Much harder" read better unenclosed than pill-wrapped.
    Func<string, string> preHikeTextClass = value => value switch
    {
        "Good-Match" => "text-emerald-400",
        "Borderline" => "text-amber-400",
        "Not Recommended" => "text-red-400",
        _ => "text-gray-400"
    };

    // Mirrors PostEventAssessment.cshtml's outcomePillClasses exactly, including
    // routing "Insufficient data" and any unrecognized value to the neutral fallback
    // rather than the previous behavior of showing it in the red "harder" bucket.
    Func<string, string> finalResultTextClass = value => value switch
    {
        "Much easier than expected" or "Matched perfectly" => "text-emerald-400",
        "Matched but challenging" or "Harder than expected" => "text-amber-400",
        "Much harder" or "Could not finish - turned back" or "Could not finish - injured" => "text-red-400",
        _ => "text-gray-400"
    };

    Func<string?, string> finalLabelTextClass = value => value switch
    {
        "Good-Match" => "text-emerald-400",
        "Borderline" => "text-amber-400",
        "Not Recommended" => "text-red-400",
        _ => "text-gray-400"
    };
}

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">

    <div class="mb-6">
        <a asp-controller="Event" asp-action="Details" asp-route-id="@eventItem?.Id"
           class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors group focus:outline-none focus:ring-2 focus:ring-accent rounded">
            <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform" aria-hidden="true"></i>
            Back to Event Details
        </a>
    </div>

    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-8">
        <!-- Header -->
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-white">Pre-Hike vs Post-Hike Comparison</h1>
            <p class="text-gray-400 text-sm mt-1">Compare assessment accuracy for <span class="text-gray-300 font-medium">@eventItem?.EventTitle</span></p>
        </div>

        <!-- Event Info -->
        <div class="bg-white/5 border border-blue-500/20 rounded-xl p-4 mb-6">
            <p class="text-white font-semibold">@eventItem?.EventTitle</p>
            <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-400 mt-2">
                <span class="flex items-center gap-2"><i class="fa-regular fa-calendar text-accent" aria-hidden="true"></i>@eventItem?.EventDate.ToString("MMMM dd, yyyy")</span>
                <span class="flex items-center gap-2"><i class="fa-regular fa-clock text-accent" aria-hidden="true"></i>@eventItem?.FormattedEventTime</span>
                <span class="flex items-center gap-2"><i class="fa-solid fa-users text-accent" aria-hidden="true"></i>@Model.Count @participantWord</span>
            </div>
        </div>

        @if (Model.Any())
        {
            <!-- Summary Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-white/5 border border-emerald-500/30 rounded-xl p-4 text-center flex flex-col justify-center">
                    <p class="text-2xl font-bold text-emerald-400">@Model.Count(m => m.Comparison == "Accurate")</p>
                    <p class="text-gray-400 text-xs mt-1">Accurate</p>
                </div>
                <div class="bg-white/5 border border-amber-500/30 rounded-xl p-4 text-center flex flex-col justify-center">
                    <p class="text-2xl font-bold text-amber-400">@Model.Count(m => m.Comparison == "Over-cautious")</p>
                    <p class="text-gray-400 text-xs mt-1">Over-cautious</p>
                </div>
                <div class="bg-white/5 border border-red-500/30 rounded-xl p-4 text-center flex flex-col justify-center">
                    <p class="text-2xl font-bold text-red-400">@Model.Count(m => m.IsMissedRisk)</p>
                    <p class="text-red-300 text-xs mt-1 font-semibold">Missed risk</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center flex flex-col justify-center">
                    <p class="text-2xl font-bold text-gray-400">@Model.Count(m => m.Comparison == "Insufficient data")</p>
                    <p class="text-gray-400 text-xs mt-1">Insufficient data</p>
                </div>
            </div>

            <!-- Desktop table (readable width and up) -->
            <div class="hidden lg:block overflow-x-auto rounded-xl border border-white/10">
                <table class="w-full text-left text-sm border-collapse">
                    <caption class="sr-only">
                        Comparison of each participant's pre-hike suitability prediction against their post-hike
                        feedback, organizer assessment, final result, saved recommendation, and outcome accuracy
                        for this event.
                    </caption>
                    <thead>
                        <tr class="border-b border-white/10">
                            <th scope="col" class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Participant</th>
                            <th scope="col" class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Pre-Hike</th>
                            <th scope="col" class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Participant Feedback</th>
                            <th scope="col" class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Organizer Assessment</th>
                            <th scope="col" class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Final Result</th>
                            <th scope="col" class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider">Saved Recommendation</th>
                            <th scope="col" class="px-5 py-3 text-xs font-semibold text-gray-300 uppercase tracking-wider text-center">Comparison</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/10">
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.IsMissedRisk ? "bg-red-500/5 border-l-2 border-l-red-500" : "")">
                                <th scope="row" class="px-5 py-4 text-white font-medium whitespace-nowrap">@item.ParticipantName</th>
                                <td class="px-5 py-4">
                                    <span class="font-semibold @preHikeTextClass(item.PreHikeAssessment)">@item.PreHikeAssessment</span>
                                </td>
                                <td class="px-5 py-4 text-gray-200 wrap-break-word">@item.ParticipantFeedback</td>
                                <td class="px-5 py-4 text-gray-200 wrap-break-word">@item.OrganizerAssessment</td>
                                <td class="px-5 py-4">
                                    <span class="font-semibold @finalResultTextClass(item.FinalResult)">@item.FinalResult</span>
                                </td>
                                <td class="px-5 py-4">
                                    @if (!string.IsNullOrEmpty(item.FinalLabel))
                                    {
                                        <span class="font-semibold @finalLabelTextClass(item.FinalLabel)">@item.FinalLabel</span>
                                    }
                                    else
                                    {
                                        <span class="font-semibold text-gray-500">Pending</span>
                                    }
                                </td>
                                <td class="px-5 py-4 text-center">
                                    <span class="font-semibold @item.ComparisonTextClass">@item.Comparison</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile/narrow-width participant cards - same server-provided values as the table above -->
            <div class="lg:hidden space-y-4">
                @foreach (var item in Model)
                {
                    <article class="bg-white/5 border border-white/10 rounded-xl p-4 @(item.IsMissedRisk ? "border-l-2 border-l-red-500 bg-red-500/5" : "")">
                        <h3 class="text-white font-semibold text-base mb-3 wrap-break-word">@item.ParticipantName</h3>
                        <dl class="space-y-3 text-sm">
                            <div>
                                <dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Pre-Hike</dt>
                                <dd class="font-semibold @preHikeTextClass(item.PreHikeAssessment)">@item.PreHikeAssessment</dd>
                            </div>
                            <div>
                                <dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Participant Feedback</dt>
                                <dd class="text-gray-200 wrap-break-word">@item.ParticipantFeedback</dd>
                            </div>
                            <div>
                                <dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Organizer Assessment</dt>
                                <dd class="text-gray-200 wrap-break-word">@item.OrganizerAssessment</dd>
                            </div>
                            <div>
                                <dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Final Result</dt>
                                <dd class="font-semibold @finalResultTextClass(item.FinalResult)">@item.FinalResult</dd>
                            </div>
                            <div>
                                <dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Saved Recommendation</dt>
                                <dd>
                                    @if (!string.IsNullOrEmpty(item.FinalLabel))
                                    {
                                        <span class="font-semibold @finalLabelTextClass(item.FinalLabel)">@item.FinalLabel</span>
                                    }
                                    else
                                    {
                                        <span class="font-semibold text-gray-500">Pending</span>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt class="text-gray-400 text-xs uppercase tracking-wide mb-1">Comparison</dt>
                                <dd class="font-semibold @item.ComparisonTextClass">@item.Comparison</dd>
                            </div>
                        </dl>
                    </article>
                }
            </div>

            <!-- Legend -->
            <div class="mt-6 p-4 bg-white/5 border border-white/10 rounded-xl">
                <p class="text-sm font-semibold text-gray-300 mb-3">Legend</p>
                <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
                    <div class="flex items-start gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 mt-1 shrink-0" aria-hidden="true"></span>
                        <span><span class="text-gray-200 font-medium">Accurate</span> <span class="text-gray-400">&mdash; assessment matched actual experience</span></span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 mt-1 shrink-0" aria-hidden="true"></span>
                        <span><span class="text-gray-200 font-medium">Over-cautious</span> <span class="text-gray-400">&mdash; predicted harder than actual. Inefficient, not unsafe</span></span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-400 mt-1 shrink-0" aria-hidden="true"></span>
                        <span><span class="text-red-300 font-semibold">Missed risk</span> <span class="text-gray-400">&mdash; predicted easier than actual. Safety-critical: a participant was told they were ready, and they weren't</span></span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-gray-400 mt-1 shrink-0" aria-hidden="true"></span>
                        <span><span class="text-gray-200 font-medium">Insufficient data</span> <span class="text-gray-400">&mdash; missing feedback or assessment</span></span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="w-2.5 h-2.5 rounded-full border border-gray-500 mt-1 shrink-0" aria-hidden="true"></span>
                        <span><span class="text-gray-200 font-medium">Pending</span> <span class="text-gray-400">&mdash; no saved recommendation yet; neither side has submitted feedback</span></span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white/5 border border-white/10 rounded-xl text-center py-16">
                <i class="fa-regular fa-users-slash text-3xl text-gray-500 mb-3 block" aria-hidden="true"></i>
                <p class="text-gray-300 text-sm font-medium">No participant comparison data available for this event.</p>
                <p class="text-gray-500 text-xs mt-2">Complete post-event assessments to see comparison data.</p>
            </div>
        }
    </div>
</div>
