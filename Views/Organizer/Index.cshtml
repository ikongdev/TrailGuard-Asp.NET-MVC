@using System.Text.Json
@using TrailGuard.Models
@model OrganizerDashboardViewModel
@{
    ViewData["Title"] = "Organizer Dashboard";
    var chartData = JsonSerializer.Serialize(Model.TrendData);
    var suitabilityData = JsonSerializer.Serialize(Model.SuitabilityBreakdown);
    var registrationsHaveActivity = Model.TrendData.Any(item => item.Count > 0);
}

<div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
    @* Success/Error feedback now goes through the canonical global toast host
       in _Layout.cshtml (role="status"/"alert" + polite/assertive live regions
       are built into every toast there) instead of a page-local banner. *@
    <header class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-3xl font-bold text-white">Organizer Dashboard</h1>
            <p class="text-gray-400 mt-1 text-sm">Keep registrations, payments, and upcoming events moving.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <span class="bg-white/5 border border-white/10 px-4 py-2 rounded-full text-sm text-gray-300">
                <i class="fa-regular fa-calendar text-accent mr-2"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")
            </span>
            <a asp-controller="Event" asp-action="Index" asp-route-openModal="add" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold text-white bg-linear-to-r from-orange-500 via-pink-500 to-violet-500 hover:brightness-110 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base transition duration-200 ease-out">
                <i class="fa-solid fa-calendar-plus"></i>Add Event
            </a>
            <a asp-controller="Trail" asp-action="Index" asp-route-openModal="add" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-base transition-colors">
                <i class="fa-solid fa-mountain"></i>Add Trail
            </a>
        </div>
    </header>

    <section aria-label="Organizer summary" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
        <a asp-controller="Event" asp-action="Index" class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 hover:border-white/20 focus:outline-none focus:ring-2 focus:ring-accent transition-colors">
            <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-full bg-accent/15 text-accent flex items-center justify-center"><i class="fa-regular fa-calendar"></i></span><div><p class="text-2xl font-bold">@Model.UpcomingEventsCount</p><p class="text-gray-300 text-sm">Upcoming Events</p></div></div>
            <p class="text-gray-500 text-xs mt-3">Organizer-owned events scheduled for today or later.</p>
        </a>
        <a asp-controller="Organizer" asp-action="Registrations" asp-route-statusFilter="Pending" class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 hover:border-white/20 focus:outline-none focus:ring-2 focus:ring-accent transition-colors">
            <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-full bg-amber-500/15 text-amber-400 flex items-center justify-center"><i class="fa-regular fa-clipboard"></i></span><div><p class="text-2xl font-bold">@Model.PendingReviewCount</p><p class="text-gray-300 text-sm">Pending Review</p></div></div>
            <p class="text-gray-500 text-xs mt-3">Organizer-owned registrations awaiting a decision.</p>
        </a>
        <a asp-controller="Organizer" asp-action="Registrations" asp-route-statusFilter="For Payment Verification" class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 hover:border-white/20 focus:outline-none focus:ring-2 focus:ring-accent transition-colors">
            <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-full bg-blue-500/15 text-blue-400 flex items-center justify-center"><i class="fa-solid fa-receipt"></i></span><div><p class="text-2xl font-bold">@Model.PaymentsToVerifyCount</p><p class="text-gray-300 text-sm">Payments to Verify</p></div></div>
            <p class="text-gray-500 text-xs mt-3">Receipts awaiting verification for your events.</p>
        </a>
        <a asp-controller="Organizer" asp-action="Registrations" asp-route-statusFilter="Accepted" class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 hover:border-white/20 focus:outline-none focus:ring-2 focus:ring-accent transition-colors">
            <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-full bg-emerald-500/15 text-emerald-400 flex items-center justify-center"><i class="fa-solid fa-user-check"></i></span><div><p class="text-2xl font-bold">@Model.AcceptedRegistrationsCount</p><p class="text-gray-300 text-sm">Accepted Registrations</p></div></div>
            <p class="text-gray-500 text-xs mt-3">Accepted registration records across your events.</p>
        </a>
    </section>

    <section class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5 mb-6" aria-labelledby="attention-heading">
        <div class="flex items-center justify-between gap-3 mb-3"><h2 id="attention-heading" class="text-sm font-semibold"><i class="fa-solid fa-bell text-amber-400 mr-2"></i>Needs Attention</h2><span class="text-xs text-gray-500">@Model.AttentionItems.Count item@(Model.AttentionItems.Count == 1 ? "" : "s")</span></div>
        @if (Model.AttentionItems.Any())
        {
            <div class="relative">
                <div id="attentionScrollRegion" data-scroll-cue="attentionScrollCue" tabindex="0" aria-label="All items needing attention" class="dashboard-scroll-region max-h-64 overflow-y-auto divide-y divide-white/5 pr-2 focus:outline-none focus:ring-2 focus:ring-accent rounded">
                    @foreach (var item in Model.AttentionItems)
                    {
                        <div class="py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                            <div class="min-w-0"><p class="font-medium text-sm truncate">@item.Title</p><p class="text-gray-400 text-xs mt-1">@item.Detail</p></div>
                            <a asp-controller="@item.Controller" asp-action="@item.Action" asp-route-id="@item.Id" class="shrink-0 text-sm font-medium text-accent hover:brightness-125 focus:outline-none focus:ring-2 focus:ring-accent rounded transition-colors">@item.ActionLabel <i class="fa-solid fa-arrow-right ml-1 text-xs"></i></a>
                        </div>
                    }
                </div>
                <div id="attentionScrollCue" class="dashboard-scroll-cue" aria-hidden="true"><span>Scroll for more <i class="fa-solid fa-chevron-down ml-1"></i></span></div>
            </div>
        }
        else
        {
            <div class="flex items-center gap-3 py-2 text-sm text-gray-300"><span class="w-9 h-9 rounded-full bg-emerald-500/15 text-emerald-400 flex items-center justify-center"><i class="fa-solid fa-check"></i></span><span>You’re all caught up.</span></div>
        }
    </section>

    <div class="grid grid-cols-1 xl:grid-cols-5 gap-6 mb-6">
        <section class="xl:col-span-3 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden" aria-labelledby="upcoming-heading">
            <div class="px-5 py-4 border-b border-white/10 flex items-center justify-between"><h2 id="upcoming-heading" class="text-sm font-semibold"><i class="fa-regular fa-calendar text-accent mr-2"></i>Upcoming Events</h2><a asp-controller="Event" asp-action="Index" class="text-xs text-accent hover:brightness-125 focus:outline-none focus:ring-2 focus:ring-accent rounded">Manage events</a></div>
            @if (Model.UpcomingEvents.Any())
            {
                <div class="relative">
                    <div id="upcomingScrollRegion" data-scroll-cue="upcomingScrollCue" tabindex="0" aria-label="All upcoming events" class="dashboard-scroll-region max-h-64 overflow-y-auto divide-y divide-white/5 pr-2 focus:outline-none focus:ring-2 focus:ring-accent rounded">
                        @foreach (var item in Model.UpcomingEvents)
                        {
                            var weatherBadgeClass = item.WeatherRiskLevel switch
                            {
                                "Low" => "text-emerald-400 bg-emerald-500/15",
                                "Moderate" => "text-amber-400 bg-amber-500/15",
                                "Moderate to High" => "text-orange-400 bg-orange-500/15",
                                "High (Thunderstorm)" => "text-red-400 bg-red-500/15",
                                _ => "text-slate-400 bg-slate-500/15"
                            };
                            <article class="p-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3"><div class="min-w-0"><h3 class="font-medium text-sm truncate">@item.EventTitle</h3><p class="text-gray-400 text-xs mt-1"><i class="fa-regular fa-calendar mr-1"></i>@item.EventDate.ToString("MMM dd, yyyy") <span class="mx-1">•</span><i class="fa-regular fa-clock mr-1"></i>@item.FormattedEventTime</p>@if (!string.IsNullOrWhiteSpace(item.WeatherRiskLevel)){<span class="inline-flex items-center gap-1.5 mt-2 px-2.5 py-1 rounded-full text-xs font-medium @weatherBadgeClass"><i class="fa-solid fa-cloud-sun" aria-hidden="true"></i>@item.WeatherRiskLevel</span>}</div><a asp-controller="Event" asp-action="Details" asp-route-id="@item.EventId" class="shrink-0 text-sm font-medium text-accent hover:brightness-125 focus:outline-none focus:ring-2 focus:ring-accent rounded">Manage <i class="fa-solid fa-arrow-right ml-1 text-xs"></i></a></article>
                        }
                    </div>
                    <div id="upcomingScrollCue" class="dashboard-scroll-cue" aria-hidden="true"><span>Scroll for more <i class="fa-solid fa-chevron-down ml-1"></i></span></div>
                </div>
            }
            else
            {
                <div class="text-center py-10"><i class="fa-regular fa-calendar-plus text-3xl text-slate-600 mb-3"></i><p class="text-slate-400 text-sm">No upcoming events yet.</p><a asp-controller="Event" asp-action="Index" class="inline-block mt-2 text-accent text-sm font-medium hover:brightness-125 focus:outline-none focus:ring-2 focus:ring-accent rounded">Manage events <i class="fa-solid fa-arrow-right ml-1"></i></a></div>
            }
        </section>

        <section class="xl:col-span-2 bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5" aria-labelledby="activity-heading">
            <h2 id="activity-heading" class="text-sm font-semibold"><i class="fa-solid fa-chart-line text-accent mr-2"></i>Registrations Received — Last 6 Months</h2><p class="text-gray-500 text-xs mt-1">All organizer-owned registration records, grouped by received date.</p>
            <div class="h-56 mt-4"><canvas id="registrationsChart" role="img" aria-label="Registration activity over the last six months" aria-describedby="registrationActivityData"></canvas></div>
            <ul id="registrationActivityData" class="sr-only">
                @foreach (var item in Model.TrendData)
                {
                    <li>@item.Month: @item.Count registration@(item.Count == 1 ? "" : "s") received</li>
                }
            </ul>
            @if (!registrationsHaveActivity) { <p class="text-center text-gray-400 text-sm mt-3">No registrations received in this period.</p> }
        </section>
    </div>

    <section class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5" aria-labelledby="suitability-heading">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4"><div><h2 id="suitability-heading" class="text-sm font-semibold"><i class="fa-solid fa-chart-pie text-accent mr-2"></i>Participant Suitability</h2><p class="text-gray-500 text-xs mt-1">Registered participants with an eligible assessment for one of your events.</p></div><span class="text-xs text-gray-400">@Model.TotalAssessments eligible assessment@(Model.TotalAssessments == 1 ? "" : "s")</span></div>
        @if (Model.TotalAssessments > 0)
        {
            <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-5 items-center"><div class="h-44"><canvas id="suitabilityChart" role="img" aria-label="Participant suitability breakdown" aria-describedby="suitabilityBreakdown"></canvas></div><ul id="suitabilityBreakdown" class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm" aria-label="Suitability breakdown details">@foreach (var item in Model.SuitabilityBreakdown){var color = item.Result == "Good-Match" ? "text-emerald-400" : item.Result == "Borderline" ? "text-amber-400" : "text-red-400";<li class="bg-white/5 border border-white/5 rounded-xl p-3"><p class="@color font-medium">@item.Result</p><p class="text-white text-xl font-bold mt-1">@item.Count <span class="text-gray-500 text-xs font-normal">(@item.Percentage%)</span></p></li>}</ul></div>
        }
        else
        {
            <div class="text-center py-8"><i class="fa-regular fa-chart-pie text-3xl text-slate-600 mb-3"></i><p class="text-slate-400 text-sm">No eligible registered assessment data yet.</p></div>
        }
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        function initializeScrollCue(region) {
            const cue = document.getElementById(region.dataset.scrollCue);
            if (!cue) return;

            const updateCue = function () {
                const hasOverflow = region.scrollHeight > region.clientHeight + 1;
                const isAtBottom = Math.ceil(region.scrollTop + region.clientHeight) >= region.scrollHeight - 1;
                cue.classList.toggle('is-visible', hasOverflow && !isAtBottom);
            };

            region.addEventListener('scroll', updateCue, { passive: true });
            window.addEventListener('resize', updateCue);
            window.addEventListener('load', updateCue, { once: true });
            requestAnimationFrame(updateCue);
        }

        document.querySelectorAll('[data-scroll-cue]').forEach(initializeScrollCue);

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const trendData = @Html.Raw(chartData);
        const registrationsCtx = document.getElementById('registrationsChart')?.getContext('2d');
        if (registrationsCtx) new Chart(registrationsCtx, { type: 'line', data: { labels: trendData.map(x => x.Month), datasets: [{ label: 'Registrations received', data: trendData.map(x => x.Count), borderColor: '#8b5cf6', backgroundColor: 'rgba(139, 92, 246, .12)', fill: true, tension: .3, borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#8b5cf6' }] }, options: { responsive: true, maintainAspectRatio: false, animation: reduceMotion ? false : undefined, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1, color: '#9ca3af' }, grid: { color: 'rgba(255,255,255,.08)' } }, x: { ticks: { color: '#9ca3af' }, grid: { display: false } } } } });
        const suitabilityCtx = document.getElementById('suitabilityChart')?.getContext('2d');
        const suitability = @Html.Raw(suitabilityData);
        if (suitabilityCtx && suitability.some(x => x.Count > 0)) new Chart(suitabilityCtx, { type: 'doughnut', data: { labels: suitability.map(x => x.Result), datasets: [{ data: suitability.map(x => x.Count), backgroundColor: ['#34d399', '#fbbf24', '#f87171'], borderWidth: 0 }] }, options: { responsive: true, maintainAspectRatio: false, animation: reduceMotion ? false : undefined, plugins: { legend: { display: false } } } });
    });
</script>

<style>
    .dashboard-scroll-region {
        scrollbar-width: thin;
        scrollbar-color: rgba(139, 92, 246, .65) transparent;
    }

    .dashboard-scroll-region::-webkit-scrollbar {
        width: 6px;
    }

    .dashboard-scroll-region::-webkit-scrollbar-track {
        background: transparent;
    }

    .dashboard-scroll-region::-webkit-scrollbar-thumb {
        background: rgba(139, 92, 246, .65);
        border-radius: 9999px;
    }

    .dashboard-scroll-cue {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        display: none;
        justify-content: center;
        padding: 2rem .5rem .5rem;
        pointer-events: none;
        color: #9ca3af;
        font-size: .75rem;
        background: linear-gradient(to top, rgb(15 23 42), rgb(15 23 42 / .9), transparent);
    }

    .dashboard-scroll-cue.is-visible {
        display: flex;
    }
</style>
