                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Add Account</span>
                </a>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-4 mb-8 bg-white/5 backdrop-blur-xl p-5 rounded-2xl border border-white/10 shadow-2xl">
            <div class="relative grow">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
                <label for="searchInput" class="sr-only">Search accounts by name or email</label>
                <input type="text" id="searchInput" placeholder="Search by name or email..."
