@using TrailGuard.Services
@model TrailGuard.Models.AccountManagementViewModel
@{
    ViewData["Title"] = "Account Management";

    // Plain semantic text, no pill shell - see DESIGN.md, Registration Status,
    // and the identical Func<> convention on Records/Index.cshtml and
    // Organizer/Registrations.cshtml.
    Func<RoleIntegrityStatus, string> roleTextClass = status => status switch
    {
        RoleIntegrityStatus.Admin => "text-amber-400",
        RoleIntegrityStatus.Organizer => "text-blue-400",
        RoleIntegrityStatus.Participant => "text-accent",
        RoleIntegrityStatus.Conflict => "text-amber-400",
        RoleIntegrityStatus.Missing => "text-red-400",
        _ => "text-gray-400"
    };

    Func<RoleIntegrityStatus, string> roleFilterValue = status => status switch
    {
        RoleIntegrityStatus.Admin => "admin",
        RoleIntegrityStatus.Organizer => "organizer",
        RoleIntegrityStatus.Participant => "participant",
        // Conflict/Missing never match a specific role filter option - they
        // only ever match "Needs Attention" (see the JS filter below).
        _ => status.ToString().ToLowerInvariant()
    };

    Func<bool, string> statusTextClass = active => active ? "text-emerald-400" : "text-red-400";
    Func<bool, string> statusText = active => active ? "Active" : "Inactive";

    // A normally configured single-role Admin can never change their own
    // role here (RoleAssignmentService.ReplaceRoleAsync enforces this
    // server-side too) - the one exception is a conflicted account that
    // still holds Admin, which may repair itself to Admin-only.
    Func<TrailGuard.Models.AccountItemViewModel, bool> canChangeRole = a =>
        !a.IsCurrentUser || (a.RoleStatus == RoleIntegrityStatus.Conflict && a.AssignedRoles.Contains("Admin"));

    var accountWord = Model?.TotalAccounts == 1 ? "account" : "accounts";
}

@* Success/Error feedback now goes through the canonical global toast host
   in _Layout.cshtml instead of a page-local banner. *@

@section PageHero {
    <div class="pt-24 px-4 max-w-7xl mx-auto min-h-screen text-white pb-12">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white">Account Management</h1>
                <p class="text-gray-400 mt-1 text-sm">Manage user roles, statuses, and system access.</p>
