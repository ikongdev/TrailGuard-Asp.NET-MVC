@using TrailGuard.Services
@model TrailGuard.Models.UpdateProfileViewModel
@{
    ViewData["Title"] = "Settings";
    var isParticipant = ViewBag.IsParticipant == true;
    var hasCurrentProfileConsent = ViewBag.HasCurrentProfileConsent == true;
    var automaticallyOpenProfileConsent = isParticipant && ViewBag.IsActive == true && !hasCurrentProfileConsent;
    var profileConsentNotice = ParticipantProfileConsent.CurrentNotice;
    var participantBirthdayMin = ViewBag.ParticipantBirthdayMin as string;
    var participantBirthdayMax = ViewBag.ParticipantBirthdayMax as string;
    var emailConfirmed = ViewBag.EmailConfirmed == true;
    var pendingEmailChange = ViewBag.PendingEmailChange as string;
}



<div class="pt-24 px-4 max-w-6xl mx-auto min-h-screen text-white pb-12">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-white">Settings</h1>
        <p class="text-gray-400 mt-1 text-sm">Manage your profile and account security.</p>
    </div>


    <div class="space-y-6">


        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-6">
                <span class="w-10 h-10 rounded-full bg-accent/15 text-accent flex items-center justify-center shrink-0" aria-hidden="true">
                    <i class="fa-solid fa-circle-info"></i>
                </span>
                <h2 class="text-lg font-semibold text-white">Account Information</h2>
            </div>

            <dl class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-white/10 text-sm">
                <div class="py-3 first:pt-0 sm:py-0 sm:px-6 sm:first:pl-0">
                    <dt class="text-gray-400 text-xs">Role</dt>
                    <dd class="text-white font-semibold mt-1">@ViewBag.Role</dd>
                    @if (ViewBag.RoleNeedsAttention != null && (bool)ViewBag.RoleNeedsAttention)
                    {
                        <p class="text-amber-400 text-xs mt-1">Contact an Administrator to resolve this.</p>
                    }
                </div>
                <div class="py-3 sm:py-0 sm:px-6">
                    <dt class="text-gray-400 text-xs">Date Joined</dt>
                    <dd class="text-white font-semibold mt-1">@ViewBag.DateJoined</dd>
                </div>
                <div class="py-3 last:pb-0 sm:py-0 sm:px-6 sm:last:pr-0">
                    <dt class="text-gray-400 text-xs">Account Status</dt>
                    <dd class="mt-1 font-semibold">
                        @if (ViewBag.IsActive != null && (bool)ViewBag.IsActive)
                        {
                            <span class="text-green-400"><i class="fa-solid fa-circle-check mr-1.5" aria-hidden="true"></i>Active</span>
                        }
                        else
                        {
                            <span class="text-red-400"><i class="fa-solid fa-circle-xmark mr-1.5" aria-hidden="true"></i>Disabled</span>
                        }
                    </dd>
                </div>
            </dl>
        </div>

        @if (isParticipant)
        {
            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8">
                <div class="flex items-start gap-3">
                    <span class="w-10 h-10 rounded-full bg-accent/15 text-accent flex items-center justify-center shrink-0" aria-hidden="true"><i class="fa-solid fa-envelope-circle-check"></i></span>
                    <div class="min-w-0 flex-1">
                        <h2 class="text-lg font-semibold text-white">Email verification</h2>
                        <p class="mt-1 text-sm text-gray-400">Current trusted email: <span class="text-gray-200 break-all">@Model.Email</span></p>
                        @if (emailConfirmed)
                        {
                            <p class="mt-2 text-sm text-emerald-400"><i class="fa-solid fa-circle-check mr-1" aria-hidden="true"></i>Email verified</p>
                        }
                        else
                        {
                            <p class="mt-2 text-sm text-amber-300"><i class="fa-solid fa-clock mr-1" aria-hidden="true"></i>Email not yet verified</p>
                            <form asp-action="SendCurrentEmailVerification" method="post" class="mt-4">
                                @Html.AntiForgeryToken()
                                <button type="submit" data-tg-pending-label="Sending…" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-accent hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-accent">Send verification email</button>
                            </form>
                        }
                        @if (!string.IsNullOrWhiteSpace(pendingEmailChange))
                        {
                            <p class="mt-4 rounded-xl border border-amber-400/20 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">Pending replacement email: <span class="font-medium break-all">@pendingEmailChange</span>. Your current trusted email will not change until this address is confirmed.</p>
                        }
                    </div>
                </div>
                <form asp-action="RequestEmailChange" method="post" class="mt-6 grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-4">
                    @Html.AntiForgeryToken()
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 min-w-0">
                        <div>
                            <label for="NewEmail" class="block text-sm font-medium text-gray-300 mb-2">Replacement email</label>
                            <input id="NewEmail" name="NewEmail" type="email" autocomplete="email" required maxlength="256" data-tg-email-address data-tg-email-error="replacementEmailError" placeholder="you@example.com" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent" />
                            <p id="replacementEmailError" class="hidden mt-1 text-xs text-red-400" role="alert"></p>
                        </div>
                        <div>
                            <label for="EmailChangeCurrentPassword" class="block text-sm font-medium text-gray-300 mb-2">Current password</label>
                            <input id="EmailChangeCurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent" />
                        </div>
                    </div>
                    <button type="submit" data-tg-pending-label="Sending…" class="self-end inline-flex items-center justify-center px-5 py-3 rounded-full text-sm font-semibold text-white bg-accent hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-accent">Confirm replacement</button>
                </form>
            </div>
        }


        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-6">
                <span class="w-10 h-10 rounded-full bg-accent/15 text-accent flex items-center justify-center shrink-0" aria-hidden="true">
                    <i class="fa-solid fa-user"></i>
                </span>
                <div>
                    <h2 class="text-lg font-semibold text-white">Profile Information</h2>
                    <p class="text-gray-400 text-sm">Update your personal and contact details.</p>
                    @if (isParticipant)
                    {
                        <button type="button" id="viewProfileConsentBtn" onclick="openProfileConsentModal(this)"
                                class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-white focus:outline-none focus:ring-2 focus:ring-accent rounded">
                            <i class="fa-solid fa-shield-heart" aria-hidden="true"></i> View Privacy Notice &amp; Consent
                        </button>
                    }
                </div>
            </div>

            <form id="profileForm" asp-controller="Settings" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="confirmPassword" id="profileConfirmPassword" value="" />
                <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-400"></div>


                <div class="flex items-center gap-4 pb-6 mb-6 border-b border-white/10">
                    <div class="relative shrink-0 w-20 h-20">
                        @if (!string.IsNullOrEmpty(Images.Url(Model.CurrentProfilePictureUrl)))
                        {
                            <img id="currentAvatar" src="@Images.Url(Model.CurrentProfilePictureUrl)" alt="" class="w-20 h-20 rounded-full object-cover border border-white/10">
                        }
                        else
                        {
                            <div id="defaultAvatar" class="w-20 h-20 rounded-full bg-accent flex items-center justify-center text-2xl font-bold text-white">
                                @{
                                    var firstInit = string.IsNullOrEmpty(Model.FirstName) ? '?' : Model.FirstName[0];
                                    var lastInit = string.IsNullOrEmpty(Model.LastName) ? ' ' : Model.LastName[0];
                                }
                                @firstInit.ToString().ToUpper()@lastInit.ToString().ToUpper()
                            </div>
                        }
                        <div id="previewContainer" class="hidden absolute inset-0">
                            <img id="previewImage" class="w-full h-full rounded-full object-cover border border-white/10" alt="" />
                        </div>


                        <button type="button" id="changePhotoBtn" aria-label="Change profile photo"
                                class="absolute -bottom-1 -right-1 w-10 h-10 rounded-full bg-accent hover:brightness-110 flex items-center justify-center text-white transition-colors border-2 border-surface-card focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card">
                            <i class="fa-solid fa-camera" aria-hidden="true"></i>
                        </button>
                        <button type="button" id="removePreviewBtn" aria-label="Cancel pending profile photo selection"
                                class="hidden absolute -top-1 -right-1 w-10 h-10 rounded-full bg-surface-card hover:bg-white/10 items-center justify-center text-white transition-colors border border-white/20 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="min-w-0">
                        <p class="text-white text-sm font-medium">Profile Photo</p>
                        <p class="text-gray-400 text-xs mt-0.5">JPG or PNG, up to 5MB.</p>
                        <p id="profileImageClientError" class="hidden text-red-400 text-xs mt-1" role="alert"></p>
                        <span asp-validation-for="ProfileImage" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <input type="file" id="profileImageInput" name="ProfileImage" accept="image/jpeg,image/png"
                           class="sr-only" tabindex="-1" aria-hidden="true" />
                </div>


                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 min-w-0">
                    <div>
                        <label asp-for="FirstName" class="block text-sm font-medium text-gray-300 mb-2">First Name</label>
                        <input asp-for="FirstName" autocomplete="given-name" placeholder="Enter first name" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                        <span asp-validation-for="FirstName" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="LastName" class="block text-sm font-medium text-gray-300 mb-2">Last Name</label>
                        <input asp-for="LastName" autocomplete="family-name" placeholder="Enter last name" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                        <span asp-validation-for="LastName" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="MiddleName" class="block text-sm font-medium text-gray-300 mb-2">Middle Name <span class="text-gray-500 text-xs">(Optional)</span></label>
                        <input asp-for="MiddleName" autocomplete="additional-name" placeholder="Enter middle name" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                    </div>
                    <div>
                        <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-300 mb-2">
                            Phone Number
                            @if (isParticipant)
                            {
                                <span class="text-red-400" aria-hidden="true">*</span><span class="sr-only">required</span>
                            }
                            else
                            {
                                <span class="text-gray-500 text-xs">(Optional)</span>
                            }
                        </label>
                        @if (isParticipant)
                        {
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center border-r border-gray-700 pl-4 pr-3 text-sm text-gray-400 pointer-events-none">+63</span>
                                <input asp-for="PhoneNumber" type="text" inputmode="tel" autocomplete="tel-national" required aria-required="true" aria-describedby="phoneClientError" placeholder="912 345 6789" class="participant-phone-required block w-full px-4 py-3 pl-16 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                            </div>
                            <p id="phoneClientError" class="hidden mt-1 text-xs text-red-400" role="alert"></p>
                        }
                        else
                        {
                            <input asp-for="PhoneNumber" autocomplete="tel" placeholder="+63 912 345 6789" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                        }
                        <span asp-validation-for="PhoneNumber" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    @if (isParticipant)
                    {
                        <div>
                            <label asp-for="Birthday" class="block text-sm font-medium text-gray-300 mb-2">Birthday</label>
                            <input asp-for="Birthday" type="date" autocomplete="bday" min="@participantBirthdayMin" max="@participantBirthdayMax" aria-describedby="birthdayClientError" class="participant-birthday-picker block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                            <p id="birthdayClientError" class="hidden mt-1 text-xs text-red-400" role="alert"></p>
                            <span asp-validation-for="Birthday" class="text-red-400 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="Gender" class="block text-sm font-medium text-gray-300 mb-2">Gender</label>
                            <select asp-for="Gender" data-custom-select class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors appearance-none cursor-pointer">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Prefer not to say">Prefer not to say</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-red-400 text-xs mt-1 block"></span>
                        </div>
                    }
                    <div class="sm:col-span-2">
                        <label asp-for="Email" class="block text-sm font-medium text-gray-300 mb-2">Email Address</label>
                        <input asp-for="Email" type="email" autocomplete="email" required maxlength="256" data-tg-email-address data-tg-email-error="profileEmailError" placeholder="you@example.com" readonly="@(isParticipant ? "readonly" : null)" aria-readonly="@(isParticipant ? "true" : null)" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors wrap-break-word @(isParticipant ? "cursor-not-allowed opacity-75" : "")" />
                        @if (isParticipant)
                        {
                            <p class="mt-1 text-xs text-gray-500">Use Email verification above to change this address.</p>
                        }
                        <span id="profileEmailError" asp-validation-for="Email" class="text-red-400 text-xs mt-1 block" role="alert"></span>
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="FacebookLink" class="block text-sm font-medium text-gray-300 mb-2">Facebook Link <span class="text-gray-500 text-xs">(Optional)</span></label>
                        <input asp-for="FacebookLink" placeholder="https://facebook.com/username" class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors wrap-break-word" />
                        <span asp-validation-for="FacebookLink" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="Bio" class="block text-sm font-medium text-gray-300 mb-2">Bio <span class="text-gray-500 text-xs">(Optional)</span></label>
                        <textarea asp-for="Bio" rows="3" placeholder="Tell us a bit about yourself..." class="block w-full px-4 py-3 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors resize-none"></textarea>
                        <span asp-validation-for="Bio" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="mt-8 flex justify-center sm:justify-end">
                    <button type="button" id="saveProfileBtn" onclick="showPasswordModal()"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 min-h-10 rounded-full text-sm font-semibold text-white bg-accent hover:brightness-110 transition focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card">
                        <i class="fa-regular fa-floppy-disk" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>



        <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-6">
                <span class="w-10 h-10 rounded-full bg-accent/15 text-accent flex items-center justify-center shrink-0" aria-hidden="true">
                    <i class="fa-solid fa-lock"></i>
                </span>
                <div>
                    <h2 class="text-lg font-semibold text-white">Security</h2>
                    <p class="text-gray-400 text-sm">Change your account password.</p>
                </div>
            </div>

            <form asp-controller="Settings" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div>
                        <label asp-for="CurrentPassword" class="block text-sm font-medium text-gray-300 mb-2">Current Password</label>
                        <div class="relative">
                            <input asp-for="CurrentPassword" type="password" id="currentPassword" autocomplete="current-password" placeholder="Enter current password"
                                   class="block w-full px-4 py-3 pr-12 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                            <button type="button" onclick="togglePassword('currentPassword')" aria-label="Show current password"
                                    class="absolute inset-y-0 right-0 w-11 flex items-center justify-center text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded-xl">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="NewPassword" class="block text-sm font-medium text-gray-300 mb-2">New Password</label>
                        <div class="relative">
                            <input asp-for="NewPassword" type="password" id="newPassword" autocomplete="new-password" placeholder="Create a new password"
                                   class="block w-full px-4 py-3 pr-12 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                            <button type="button" onclick="togglePassword('newPassword')" aria-label="Show new password"
                                    class="absolute inset-y-0 right-0 w-11 flex items-center justify-center text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded-xl">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-300 mb-2">Confirm New Password</label>
                        <div class="relative">
                            <input asp-for="ConfirmPassword" type="password" id="confirmNewPassword" autocomplete="new-password" placeholder="Confirm new password"
                                   class="block w-full px-4 py-3 pr-12 rounded-xl bg-surface-card border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                            <button type="button" onclick="togglePassword('confirmNewPassword')" aria-label="Show confirm new password"
                                    class="absolute inset-y-0 right-0 w-11 flex items-center justify-center text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded-xl">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="mt-8 flex justify-center sm:justify-end">
                    <button type="submit"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 min-h-10 rounded-full text-sm font-semibold text-white bg-accent hover:brightness-110 transition focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card">
                        <i class="fa-solid fa-key" aria-hidden="true"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Modals {
    @if (isParticipant)
    {
        <div id="profileConsentModal" data-auto-open="@automaticallyOpenProfileConsent.ToString().ToLowerInvariant()" data-consent-accepted="@hasCurrentProfileConsent.ToString().ToLowerInvariant()" class="fixed inset-0 z-60 hidden items-center justify-center p-4">
            <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-60" onclick="closeProfileConsentModal()"></div>
            <div class="relative z-60 flex max-h-[85vh] w-full max-w-lg flex-col overflow-hidden rounded-2xl border border-white/10 bg-surface-card shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="profileConsentTitle" aria-describedby="profileConsentDescription">
                <div class="flex shrink-0 items-center justify-between border-b border-white/10 px-6 py-4">
                    <div class="flex items-center gap-3">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent/15 text-accent" aria-hidden="true"><i class="fa-solid fa-shield-heart text-sm"></i></span>
                        <h2 id="profileConsentTitle" class="text-lg font-bold text-white">@profileConsentNotice.Title</h2>
                    </div>
                    <button id="profileConsentCloseButton" type="button" onclick="closeProfileConsentModal()" aria-label="Close privacy notice" class="rounded text-gray-400 transition-colors hover:text-white focus:outline-none focus:ring-2 focus:ring-accent"><i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i></button>
                </div>
                <div class="tg-settings-consent-scroll overflow-y-auto p-6 text-sm leading-relaxed text-gray-300">
                    <p id="profileConsentDescription">@profileConsentNotice.Description</p>
                    <ul class="mt-4 list-disc space-y-3 pl-5 marker:text-accent">
                        @foreach (var statement in profileConsentNotice.Statements)
                        {
                            <li>@statement</li>
                        }
                    </ul>
                    <p class="mt-4">@profileConsentNotice.PrivacyPolicyPrompt<a asp-controller="@profileConsentNotice.PrivacyPolicyController" asp-action="@profileConsentNotice.PrivacyPolicyAction" target="@profileConsentNotice.PrivacyPolicyLinkTarget" rel="@profileConsentNotice.PrivacyPolicyLinkRel" class="font-medium text-accent hover:text-white focus:outline-none focus:ring-2 focus:ring-accent rounded">@profileConsentNotice.PrivacyPolicyLinkText</a>@profileConsentNotice.PrivacyPolicyTrailingText</p>
                    <p class="mt-4 text-gray-400">@profileConsentNotice.DeclineMessage</p>

                    <form id="profileConsentForm" asp-controller="Settings" asp-action="AcceptProfileConsent" method="post" class="mt-5">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Version" value="@profileConsentNotice.Version" />
                        @if (!hasCurrentProfileConsent)
                        {
                            <div id="profileConsentChoice" class="flex items-start gap-3">
                                <input id="profileConsentCheckbox" name="Accepted" value="true" type="checkbox" data-modal-initial class="mt-1 h-4 w-4 rounded border-gray-600 bg-surface-card text-accent focus:ring-2 focus:ring-accent" />
                                <label for="profileConsentCheckbox" class="text-sm text-gray-200">@profileConsentNotice.AffirmationLabel</label>
                            </div>
                        }
                        <p id="profileConsentError" class="hidden mt-3 text-sm text-red-400" role="alert"></p>
                        <p id="profileConsentAccepted" class="@(hasCurrentProfileConsent ? "" : "hidden") mt-3 text-sm text-green-300" role="status"><i class="fa-solid fa-circle-check mr-1" aria-hidden="true"></i>@profileConsentNotice.AcceptedMessage</p>
                        <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                            @if (hasCurrentProfileConsent)
                            {
                                <button id="profileConsentFooterClose" type="button" onclick="closeProfileConsentModal()" class="min-h-10 rounded-full border border-white/15 px-5 py-2 text-sm font-semibold text-gray-200 transition hover:border-white/30 hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-accent">Close</button>
                            }
                            else
                            {
                                <button id="profileConsentCancelBtn" type="button" onclick="closeProfileConsentModal()" class="inline-flex min-h-10 items-center justify-center rounded-full border border-white/15 px-5 py-2 text-sm font-semibold text-gray-200 transition hover:border-white/30 hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-accent">Cancel</button>
                                <button type="submit" id="profileConsentAgreeBtn" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-full bg-accent px-5 py-2 text-sm font-semibold text-white transition hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card"><i class="fa-solid fa-check" aria-hidden="true"></i> Agree</button>
                                <button id="profileConsentFooterClose" type="button" onclick="closeProfileConsentModal()" hidden class="min-h-10 rounded-full border border-white/15 px-5 py-2 text-sm font-semibold text-gray-200 transition hover:border-white/30 hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-accent">Close</button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <div id="passwordModal" class="fixed inset-0 z-60 hidden items-center justify-center p-4">
        <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-60" onclick="closePasswordModal()"></div>
        <div class="relative bg-surface-card border border-white/10 rounded-2xl shadow-2xl w-full max-w-md overflow-hidden flex flex-col z-60" role="dialog" aria-modal="true" aria-labelledby="passwordModalTitle">
            <div class="flex justify-between items-center px-6 py-4 border-b border-white/10 shrink-0">
                <div class="flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-accent/15 flex items-center justify-center" aria-hidden="true">
                        <i class="fa-solid fa-lock text-accent text-sm"></i>
                    </span>
                    <h2 id="passwordModalTitle" class="text-lg font-bold text-white">Confirm Password</h2>
                </div>
                <button type="button" onclick="closePasswordModal()" aria-label="Close" class="text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded">
                    <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
                </button>
            </div>
            <div class="p-6">
                <p class="text-gray-400 text-sm mb-4">Please enter your current password to save profile changes.</p>
                <label for="modalPasswordInput" class="sr-only">Current password</label>
                <div class="relative">
                    <input type="password" id="modalPasswordInput" data-modal-initial autocomplete="current-password" placeholder="Enter current password"
                           class="block w-full px-4 py-3 pr-12 rounded-xl bg-surface-base border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
                    <button type="button" onclick="togglePassword('modalPasswordInput')" aria-label="Show password"
                            class="absolute inset-y-0 right-0 w-11 flex items-center justify-center text-gray-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-accent rounded-xl">
                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <p id="modalError" class="text-red-400 text-xs mt-2 hidden">Password is required.</p>
            </div>
            <div class="px-6 py-4 border-t border-white/10 shrink-0 flex justify-end gap-3">
                <button type="button" onclick="closePasswordModal()" class="px-5 py-2.5 rounded-full text-sm font-medium text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
                    Cancel
                </button>
                <button type="button" id="modalConfirmBtn" onclick="confirmPassword()" class="px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-accent hover:brightness-110 transition focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-card">
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<script src="~/js/philippine-mobile-number.js" asp-append-version="true"></script>
<script>
    // Toggle password visibility - keeps the icon and the button's own
    // accessible name in sync (the icon itself is decorative).
    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        if (!input) return;
        const button = input.parentElement.querySelector('button');
        const icon = button ? button.querySelector('i') : null;
        const showing = input.type === 'password';
        input.type = showing ? 'text' : 'password';
        if (icon) {
            icon.classList.toggle('fa-eye', !showing);
            icon.classList.toggle('fa-eye-slash', showing);
        }
        if (button) {
            button.setAttribute('aria-label', showing ? 'Hide password' : 'Show password');
        }
    }

    // The selected file is not persisted until the password-confirmed form submit.
    // A request counter makes late image callbacks harmless after cancellation or
    // replacement, while object URLs avoid keeping a second base64 copy in memory.
    (function initProfilePhotoControls() {
        const cameraBtn = document.getElementById('changePhotoBtn');
        const fileInput = document.getElementById('profileImageInput');
        const removeBtn = document.getElementById('removePreviewBtn');
        const previewContainer = document.getElementById('previewContainer');
        const previewImage = document.getElementById('previewImage');
        const defaultAvatar = document.getElementById('defaultAvatar');
        const currentAvatar = document.getElementById('currentAvatar');
        const clientError = document.getElementById('profileImageClientError');
        let previewRequest = 0;
        let previewUrl = null;

        if (!cameraBtn || !fileInput || !removeBtn || !previewContainer || !previewImage) return;

        function showError(message) {
            clientError.textContent = message;
            clientError.classList.remove('hidden');
        }

        function clearError() {
            clientError.textContent = '';
            clientError.classList.add('hidden');
        }

        function restoreSavedAvatar() {
            previewContainer.classList.add('hidden');
            previewImage.removeAttribute('src');
            if (currentAvatar) {
                currentAvatar.classList.remove('hidden');
            } else if (defaultAvatar) {
                defaultAvatar.classList.remove('hidden');
            }
            cameraBtn.classList.remove('hidden');
            cameraBtn.classList.add('flex');
            removeBtn.classList.remove('flex');
            removeBtn.classList.add('hidden');
        }

        function discardPendingSelection(clearInput) {
            previewRequest++;
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
            if (clearInput) fileInput.value = '';
            restoreSavedAvatar();
        }

        function validateAndPreview() {
            const file = fileInput.files && fileInput.files[0];
            if (!file) return; // File-picker cancellation leaves an existing state untouched.

            discardPendingSelection(false);
            clearError();

            if ((file.type !== 'image/jpeg' && file.type !== 'image/png') ||
                file.size > 5 * 1024 * 1024) {
                fileInput.value = '';
                restoreSavedAvatar();
                showError(file.size > 5 * 1024 * 1024
                    ? 'Profile picture must be 5MB or smaller.'
                    : 'Profile picture must be a JPG or PNG image.');
                return;
            }

            const request = ++previewRequest;
            const candidateUrl = URL.createObjectURL(file);
            previewUrl = candidateUrl;
            cameraBtn.classList.remove('flex');
            cameraBtn.classList.add('hidden');
            removeBtn.classList.remove('hidden');
            removeBtn.classList.add('flex');

            const image = new Image();
            image.onload = function () {
                if (request !== previewRequest || previewUrl !== candidateUrl) {
                    URL.revokeObjectURL(candidateUrl);
                    return;
                }

                previewImage.src = candidateUrl;
                previewContainer.classList.remove('hidden');
                if (defaultAvatar) defaultAvatar.classList.add('hidden');
                if (currentAvatar) currentAvatar.classList.add('hidden');
            };
            image.onerror = function () {
                if (request !== previewRequest || previewUrl !== candidateUrl) {
                    URL.revokeObjectURL(candidateUrl);
                    return;
                }

                previewUrl = null;
                URL.revokeObjectURL(candidateUrl);
                fileInput.value = '';
                restoreSavedAvatar();
                showError('The selected image could not be read. Please choose a JPG or PNG image.');
            };
            image.src = candidateUrl;
        }

        cameraBtn.addEventListener('click', function () {
            fileInput.click();
        });
        fileInput.addEventListener('change', validateAndPreview);
        removeBtn.addEventListener('click', function () {
            discardPendingSelection(true);
            clearError();
        });
        window.addEventListener('beforeunload', function () {
            if (previewUrl) URL.revokeObjectURL(previewUrl);
        });
    })();

    // Settings has two modal workflows. They share one visibility, focus, Escape,
    // and body-scroll owner so one cannot leave the other in a conflicting state.
    let activeSettingsModal = null;
    let settingsModalTrigger = null;
    let settingsModalPreviousOverflow = '';

    function isVisibleSettingsFocusable(element) {
        return !!element
            && !element.disabled
            && !element.inert
            && !element.closest('.hidden, [hidden], [aria-hidden="true"], [inert]')
            && element.getClientRects().length > 0;
    }

    function settingsFocusable(modal) {
        return Array.from(modal.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'))
            .filter(isVisibleSettingsFocusable);
    }

    function openSettingsModal(id, trigger) {
        const modal = document.getElementById(id);
        if (!modal) return;
        if (activeSettingsModal && activeSettingsModal !== modal) closeSettingsModal(activeSettingsModal.id, false);
        activeSettingsModal = modal;
        settingsModalTrigger = trigger || document.activeElement;
        settingsModalPreviousOverflow = document.body.style.overflow;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        const initial = modal.querySelector('[data-modal-initial]');
        const target = isVisibleSettingsFocusable(initial) ? initial : settingsFocusable(modal)[0];
        if (target) requestAnimationFrame(function () { target.focus(); });
    }

    function closeSettingsModal(id, restoreFocus) {
        const modal = document.getElementById(id);
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        if (activeSettingsModal === modal) {
            activeSettingsModal = null;
            document.body.style.overflow = settingsModalPreviousOverflow;
            if (restoreFocus !== false && settingsModalTrigger && document.contains(settingsModalTrigger)) settingsModalTrigger.focus();
            settingsModalTrigger = null;
        }
    }

    function openProfileConsentModal(trigger) { openSettingsModal('profileConsentModal', trigger); }
    function closeProfileConsentModal() { closeSettingsModal('profileConsentModal'); }

    function showPasswordModal() {
        const profileForm = document.getElementById('profileForm');
        const facebookLink = document.getElementById('FacebookLink');
        if (facebookLink && !facebookLink.value.trim()) facebookLink.value = '';
        const participantPhone = profileForm.querySelector('.participant-phone-required');
        if (participantPhone) participantPhone.dispatchEvent(new Event('input'));
        if (!profileForm.checkValidity()) {
            profileForm.reportValidity();
            return;
        }
        document.getElementById('modalPasswordInput').value = '';
        document.getElementById('modalError').classList.add('hidden');
        openSettingsModal('passwordModal', document.getElementById('saveProfileBtn'));
    }

    function closePasswordModal() {
        document.getElementById('modalError').classList.add('hidden');
        closeSettingsModal('passwordModal');
    }

    function confirmPassword() {
        const password = document.getElementById('modalPasswordInput').value;
        if (!password) {
            document.getElementById('modalError').classList.remove('hidden');
            return;
        }
        document.getElementById('modalError').classList.add('hidden');
        document.getElementById('profileConfirmPassword').value = password;

        const confirmBtn = document.getElementById('modalConfirmBtn');
        const saveBtn = document.getElementById('saveProfileBtn');
        const profileForm = document.getElementById('profileForm');
        if (confirmBtn) confirmBtn.disabled = true;
        if (saveBtn && profileForm && window.TrailGuardActionPending) {
            window.TrailGuardActionPending.begin(saveBtn, 'Saving…', profileForm);
        } else if (saveBtn) {
            saveBtn.disabled = true;
        }
        // Validity was checked before opening this password gate. Submit directly so
        // the shared pending-state listener does not treat this already-pending form
        // as a duplicate submission.
        profileForm.submit();
    }

    (function initializeParticipantPhoneRequirement() {
        const phone = document.querySelector('.participant-phone-required');
        const error = document.getElementById('phoneClientError');
        if (!phone || !error) return;
        window.TrailGuardPhilippineMobileNumber.attachLocalDigitLimit(
            phone,
            error,
            'Phone Number is required.');
        function validatePhone(showError) {
            window.TrailGuardPhilippineMobileNumber.updateValidity(
                phone,
                showError ? error : null,
                true,
                'Phone Number is required.');
        }
        phone.addEventListener('input', function () { validatePhone(true); });
        phone.addEventListener('change', function () { validatePhone(true); });
        phone.addEventListener('blur', function () { validatePhone(true); });
        // Surface malformed legacy values on initial render rather than hiding the
        // custom-validity message until the participant edits the field.
        validatePhone(true);
    })();

    (function initializeParticipantBirthdayPolicy() {
        const birthday = document.querySelector('.participant-birthday-picker');
        const error = document.getElementById('birthdayClientError');
        if (!birthday || !error) return;
        function validateBirthday() {
            let message = '';
            if (birthday.value && (birthday.value < birthday.min || birthday.value > birthday.max)) {
                message = "TrailGuard's participation policy is for ages 18 through 60, measured in completed years.";
            }
            birthday.setCustomValidity(message);
            error.textContent = message;
            error.classList.toggle('hidden', !message);
        }
        birthday.addEventListener('input', validateBirthday);
        birthday.addEventListener('change', validateBirthday);
        validateBirthday();
    })();

    document.addEventListener('DOMContentLoaded', function initializeProfileConsent() {
        const modal = document.getElementById('profileConsentModal');
        const form = document.getElementById('profileConsentForm');
        if (!modal || !form) return;
        const checkbox = document.getElementById('profileConsentCheckbox');
        const agree = document.getElementById('profileConsentAgreeBtn');
        const cancel = document.getElementById('profileConsentCancelBtn');
        const footerClose = document.getElementById('profileConsentFooterClose');
        const error = document.getElementById('profileConsentError');
        const accepted = document.getElementById('profileConsentAccepted');
        const choice = document.getElementById('profileConsentChoice');
        const closeButton = document.getElementById('profileConsentCloseButton');

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            if (!checkbox || !agree) return;
            if (!checkbox.checked) {
                error.textContent = 'Select the checkbox to explicitly agree to the Profile Privacy Notice.';
                error.classList.remove('hidden');
                checkbox.focus();
                return;
            }
            error.classList.add('hidden');
            if (!window.TrailGuardActionPending || !window.TrailGuardActionPending.begin(agree, 'Recording…', form)) {
                error.textContent = 'Unable to begin recording your agreement. Please reload and try again.';
                error.classList.remove('hidden');
                return;
            }

            let succeeded = false;
            const requestAbort = new AbortController();
            const requestTimeout = window.setTimeout(function () { requestAbort.abort(); }, 20_000);
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    credentials: 'same-origin',
                    signal: requestAbort.signal
                });
                const payload = await response.json().catch(function () { return null; });
                const failureMessage = payload && typeof payload.message === 'string'
                    ? payload.message
                    : 'Unable to record your agreement. Please try again.';
                if (!response.ok) throw new Error(failureMessage);

                const submittedVersion = form.elements.Version && form.elements.Version.value;
                if (!payload || payload.version !== submittedVersion || typeof payload.acceptedAtUtc !== 'string' || Number.isNaN(Date.parse(payload.acceptedAtUtc))) {
                    throw new Error('Unable to confirm that your agreement was recorded. Please try again.');
                }

                modal.dataset.consentAccepted = 'true';
                modal.dataset.consentVersion = payload.version;
                modal.dataset.consentedAtUtc = payload.acceptedAtUtc;
                modal.dataset.autoOpen = 'false';
                checkbox.checked = true;
                checkbox.disabled = true;
                if (choice) {
                    choice.classList.remove('flex');
                    choice.classList.add('hidden');
                    choice.setAttribute('aria-hidden', 'true');
                }
                accepted.classList.remove('hidden');
                if (cancel) cancel.remove();
                if (footerClose) footerClose.hidden = false;

                // Clear the shared pending marker before closing so the form never
                // carries a stale Recording state into a later reopen.
                window.TrailGuardActionPending.restore(agree, form);
                agree.remove();
                succeeded = true;
                closeProfileConsentModal();
                if (window.showToast) window.showToast('Profile Privacy Notice accepted.', 'success');
            } catch (failure) {
                error.textContent = requestAbort.signal.aborted
                    ? 'We could not confirm your agreement before the connection timed out. It may have been recorded; reopen Settings to check before retrying.'
                    : failure && typeof failure.message === 'string'
                        ? failure.message
                        : 'Unable to record your agreement. Please try again.';
                error.classList.remove('hidden');
            } finally {
                window.clearTimeout(requestTimeout);
                if (!succeeded) {
                    window.TrailGuardActionPending.restore(agree, form);
                }
            }
        });

        if (modal.dataset.autoOpen === 'true') openProfileConsentModal(document.getElementById('viewProfileConsentBtn'));
    });

    document.addEventListener('keydown', function (event) {
        if (!activeSettingsModal) return;
        if (event.key === 'Escape') {
            event.preventDefault();
            closeSettingsModal(activeSettingsModal.id);
            return;
        }
        if (event.key !== 'Tab') return;
        const focusable = settingsFocusable(activeSettingsModal);
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
